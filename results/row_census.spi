///- --package .
:# row_census static =
    :< testing

:== tally = i32 * i32

:~ counted \* t. ((ok, bad) : tally) (d : arena_rows::decoded t) : tally =
    :< arena_rows
    ?= d ?|
    | Decoded _ => ok + 1i32, bad
    | Rejected _ => ok, bad + 1i32

:~ arena_line (t : tally) (line : string) : tally = counted t (arena_rows::row_of_line line)

:~ arm_line (t : tally) (line : string) : tally = counted t (arena_rows::arm_step_of_line line)

:= tally_of (f : tally -> string -> tally) (tables : list table_rows::table_row) : tally =
    := ~runtime = tables
    listm::fold (\ t table => table_rows::fold_data f t table) (0i32, 0i32) runtime

:= arena_a () : list table_rows::table_row =
    [
        rows::arena_results::table ()
        rows::arena_results_cyclops::table ()
        rows::arena_results_cyclops_leadtrace::table ()
    ]

