:= arena_tables () : list table_rows::table_row =
    listm::concat [
        arena_a (); arena_b (); arena_c (); arena_d (); arena_e (); arena_f (); arena_g ()
        arena_h (); arena_i (); arena_j (); arena_k (); arena_l (); arena_m (); arena_n ()
        arena_o ()
    ]

:= arm_tables () : list table_rows::table_row =
    listm::concat [
        arm_a (); arm_b (); arm_c (); arm_d (); arm_e (); arm_f (); arm_g (); arm_h ()
    ]

///> rust
:# every_arena_row_decodes =
    := ~expected = 1075i32
    tally_of arena_line (arena_tables ()) |> _assert_eq (expected, 0i32)

///> rust
:# every_arm_step_row_decodes =
    := ~expected = 284i32
    tally_of arm_line (arm_tables ()) |> _assert_eq (expected, 0i32)