        ^^ "2026-10-14T10:39:08\tnexbot\t1\tcyclops\t3\t\t\t\t\t\t0\t0\t0\t\t\n"
        ^^ "2026-10-14T16:32:44\tnexbot\t1\tcyclops\t3\t\t\t\t\t\t0\t0\t0\t\t"
