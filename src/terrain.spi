:~ arena_sight_blocked (p : geometry.position) : bool =
    ? inside_arena_spot p ?> arena_bit_set arena_sight_bits p |: !-

:~ arena_protection_zone (dx : i32) (dy : i32) : bool =
    ? dy = (0 - 29)
    ?> (dx >= 41 && dx <= 43) || dx = 45
    |? dy = (0 - 28)
    ?> (dx >= 41 && dx <= 43) || dx = 45
    |? dy = (0 - 27)
    ?> dx >= 40 && dx <= 45
    |? dy = (0 - 26)
    ?> dx >= 41 && dx <= 45
    |? dy = (0 - 25)
    ?> dx >= 41 && dx <= 45
    |? dy = (0 - 24)
    ?> dx >= 41 && dx <= 45
    |? dy = (0 - 23)
    ?> dx >= 41 && dx <= 45
    |? dy = (0 - 22)
    ?> dx >= 41 && dx <= 45
    |? dy = (0 - 21)
    ?> dx >= 38 && dx <= 45
    |? dy = (0 - 20)
    ?> dx >= 38 && dx <= 45
    |? dy = (0 - 19)
    ?> dx >= 38 && dx <= 45
    |? dy = (0 - 18)
    ?> dx >= 38 && dx <= 45
    |? dy = (0 - 10)
    ?>
        (dx >= 7 && dx <= 14)
        || (dx >= 21 && dx <= 23)
        || (dx >= 25 && dx <= 27)
        || (dx >= 29 && dx <= 31)
        || (dx >= 33 && dx <= 40)
    |? dy = (0 - 9)
    ?>
        (dx >= 7 && dx <= 14)
        || (dx >= 21 && dx <= 23)
        || (dx >= 25 && dx <= 27)
        || (dx >= 29 && dx <= 31)
        || (dx >= 33 && dx <= 40)
    |? dy = (0 - 8)
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = (0 - 7)
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = (0 - 6)
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = (0 - 5)
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = (0 - 4)
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = (0 - 3)
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = (0 - 2)
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = (0 - 1)
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = 0
    ?> (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    |? dy = 1
    ?> (dx >= 8 && dx <= 14) || (dx >= 33 && dx <= 40)
    |? dy = 2
    ?> dx >= 33 && dx <= 40
    |? dy = 3
    ?> dx >= 33 && dx <= 40
    |? dy = 4
    ?> dx >= 33 && dx <= 40
    |? dy = 5
    ?> dx >= 33 && dx <= 40
    |: !-

:= arena_spot_world_x () : i32 = 1933
:= arena_spot_world_y () : i32 = 1350

:~ arena_spot_protected (p : geometry.position) : bool = arena_protection_zone (p.x - 100) (p.y - 100)

:= arena_world_protected (x : i32) (y : i32) : bool =
    arena_protection_zone (x - arena_spot_world_x ()) (y - arena_spot_world_y ())

:= walls (l : layout) (p : geometry.position) : bool =
    ?= l ?|
    | OpenField => !-
    | EastCorridor => p.y <> corridor_row () || p.x < corridor_mouth ()
    | RoomAndCorridor => p.x < 100 && p.y <> corridor_row ()
    | ArenaSpot => arena_spot_blocked p
    | ArenaHunt => arena_spot_blocked p

:= sight_blocks (l : layout) (p : geometry.position) : bool =
    ?= l ?|
    | ArenaSpot => arena_sight_blocked p
    | ArenaHunt => arena_sight_blocked p
    | _ => walls l p

:= blocked (l : layout) (p : geometry.position) : bool =
    ?= l ?|
    | ArenaSpot => arena_spot_blocked p || arena_spot_protected p
    | ArenaHunt => arena_spot_blocked p || arena_spot_protected p
    | _ => walls l p

:= free (l : layout) (taken : geometry.position -> bool) (p : geometry.position) : bool =
    blocked l p = !- && taken p = !-

:= direction_of (n : i32) : i32 = ? n > 0 ?> 1 |? n < 0 ?> -1 |: 0

:= shifted (dx : i32) (dy : i32) (from : geometry.position) : geometry.position =
    geometry.position (from.x + dx) (from.y + dy) from.z

:= best_step
    (l : layout) (taken : geometry.position -> bool) (improves : geometry.position -> bool) (sx : i32) (sy : i32)
    (from : geometry.position)
    : geometry.position
    =
    := usable p = free l taken p && improves p
    := both = shifted sx sy from
    := across = shifted sx 0 from
    := along = shifted 0 sy from
    := left = ? sy = 0 ?> shifted sx 1 from |: shifted 1 sy from
    := right = ? sy = 0 ?> shifted sx -1 from |: shifted -1 sy from
    ? usable both
    ?> both
    |? usable across
    ?> across
    |? usable along
    ?> along
    |? usable left
    ?> left
    |? usable right
    ?> right
    |: from

:= greedy_step_toward
    (l : layout) (taken : geometry.position -> bool) (target : geometry.position) (from : geometry.position)
    : geometry.position
    =
    := distance = geometry.chebyshev_distance target from
    best_step l taken
        \ p => geometry.chebyshev_distance target p < distance
        (direction_of (target.x - from.x))
        (direction_of (target.y - from.y))
        from

:= region_rows () : i32 = 2 * arena_spot_radius () + 1
:= region_words () : i32 = (region_rows () + row_word_bits () - 1) / row_word_bits ()
:= all_bits () : u32 = 4294967295u32
:= region_word_mask (word : i32) : u32 =
    := valid = region_rows () - word * row_word_bits ()
    ? valid >= row_word_bits () ?> all_bits () |: (1u32 <<< valid) - 1u32

:| route_choice =
    | GoEast
    | GoWest
    | GoSouth
    | GoNorth
    | Arrived
    | NoRoute

:= route_offset (c : route_choice) : i32 * i32 =
    ?= c ?|
    | GoEast => 1, 0
    | GoWest => -1, 0
    | GoSouth => 0, 1
    | GoNorth => 0, -1
    | _ => 0, 0

:= region_bit (x : i32) : i32 = x - 100 + arena_spot_radius ()
:= region_row (y : i32) : i32 = y - 100 + arena_spot_radius ()
:= inside_region (x : i32) (y : i32) : bool =
    region_bit x >= 0 && region_bit x < region_rows () && region_row y >= 0 && region_row y < region_rows ()

:= word_holds (word : u32) (bit : i32) : bool = ((word >>> bit) &&& 1u32) = 1u32

:~ route_between
    (tx : i32) (ty : i32) (fx : i32) (fy : i32) (free_east : bool) (free_west : bool) (free_south : bool)
    (free_north : bool)
    : route_choice
    =
    := rows = region_rows ()
    := width = region_words ()
    := cells = rows * width
    := reach : array_base u32 = !!!!ArrayCreate(`u32, cells)
    := openings : array_base u32 = !!!!ArrayCreate(`u32, cells)
    := above : array_base u32 = !!!!ArrayCreate(`u32, width)
    := grown : array_base u32 = !!!!ArrayCreate(`u32, width)
    := reach_at (row : i32) (word : i32) : u32 =
        ? row < 0 || row >= rows || word < 0 || word >= width
        ?> 0u32
        |: !!!!ArrayIndex(reach, row * width + word)
    :~ ^ prepare (cell : i32) : () =
        ? cell < cells ?>
            !!!!ArrayIndexSet(reach, cell, 0u32)
            := open_bits = arena_spot_bits (cell % width) (cell / width) ^^^ region_word_mask (cell % width)
            !!!!ArrayIndexSet(openings, cell, open_bits)
            prepare (cell + 1)
    prepare 0
    := is_open (x : i32) (y : i32) : bool =
        ? inside_region x y = !- ?> !-
        |:
            := bit = region_bit x
            := open_bits : u32 = !!!!ArrayIndex(openings, region_row y * width + bit / row_word_bits ())
            word_holds open_bits (bit % row_word_bits ())
    := reached (x : i32) (y : i32) : bool =
        ? inside_region x y = !- ?> !-
        |:
            := bit = region_bit x
            word_holds (reach_at (region_row y) (bit / row_word_bits ())) (bit % row_word_bits ())
    := mark (x : i32) (y : i32) : () =
        ? inside_region x y && is_open x y ?>
            := bit = region_bit x
            := row = region_row y
            := word = bit / row_word_bits ()
            := marked = reach_at row word ||| (1u32 <<< (bit % row_word_bits ()))
            !!!!ArrayIndexSet(reach, row * width + word, marked)
    :~ ^ seed (k : i32) : () =
        ? k < 9 ?>
            mark (tx + k % 3 - 1) (ty + k / 3 - 1)
            seed (k + 1)
    seed 0
    :~ ^ forget_above (word : i32) : () =
        ? word < width ?>
            !!!!ArrayIndexSet(above, word, 0u32)
            forget_above (word + 1)
    :~ ^ sweep (row : i32) (changed : bool) : bool =
        ? row >= rows
        ?> changed
        |:
            :~ ^ grow (word : i32) : () =
                ? word < width
                ?>
                    := here = reach_at row word
                    := open_bits : u32 = !!!!ArrayIndex(openings, row * width + word)
                    := up : u32 = !!!!ArrayIndex(above, word)
                    := spread =
                        here
                        ||| (here <<< 1)
                        ||| (here >>> 1)
                        ||| (reach_at row (word + 1) <<< 31)
                        ||| (reach_at row (word - 1) >>> 31)
                        ||| up
                        ||| reach_at (row + 1) word
                    !!!!ArrayIndexSet(grown, word, spread &&& open_bits)
                    grow (word + 1)
            grow 0
            :~ ^ commit (word : i32) (changed : bool) : bool =
                ? word >= width ?> changed
                |:
                    := here = reach_at row word
                    := next : u32 = !!!!ArrayIndex(grown, word)
                    !!!!ArrayIndexSet(above, word, here)
                    !!!!ArrayIndexSet(reach, row * width + word, next)
                    commit (word + 1) (changed || next <> here)
            sweep (row + 1) (commit 0 changed)
    := sweep_all () : bool =
        forget_above 0
        sweep 0 !-
    := along_x = (? tx - fx < 0 ?> fx - tx |: tx - fx) >= (? ty - fy < 0 ?> fy - ty |: ty - fy)
    := east_first = tx >= fx
    := south_first = ty >= fy
    := leads (c : route_choice) : bool =
        := dx, dy = route_offset c
        := free = ?= c ?| GoEast => free_east | GoWest => free_west | GoSouth => free_south | _ => free_north
        free && reached (fx + dx) (fy + dy)
    := x_toward = ? east_first ?> GoEast |: GoWest
    := x_away = ? east_first ?> GoWest |: GoEast
    := y_toward = ? south_first ?> GoSouth |: GoNorth
    := y_away = ? south_first ?> GoNorth |: GoSouth
    := first, second = ? along_x ?> x_toward, y_toward |: y_toward, x_toward
    := choose () : route_choice =
        ? leads first
        ?> first
        |? leads second
        ?> second
        |? leads y_away
        ?> y_away
        |? leads x_away
        ?> x_away
        |: NoRoute
    := still_searching (c : route_choice) : bool = ?= c ?| NoRoute => !+ | _ => !-
    :~ ^ layers (k : i32) : route_choice =
        := c = choose ()
        ? still_searching c && k < rows * 2 && sweep_all () ?> layers (k + 1) |: c
    ? reached fx fy ?> Arrived |: layers 0

:= straight_step_weight () : i32 = 10
:= diagonal_step_weight () : i32 = 25
:= unreachable_weight () : i32 = 1000000
:= window_margin () : i32 = 6

:= direction_dx (k : i32) : i32 =
    ? k = 0
    ?> 1
    |? k = 1
    ?> -1
    |? k = 2
    ?> 0
    |? k = 3
    ?> 0
    |? k = 4 || k = 6
    ?> 1
    |: -1
:= direction_dy (k : i32) : i32 =
    ? k = 0 || k = 1
    ?> 0
    |? k = 2
    ?> 1
    |? k = 3
    ?> -1
    |? k = 4 || k = 5
    ?> 1
    |: -1
:= direction_weight (k : i32) : i32 = ? k < 4 ?> straight_step_weight () |: diagonal_step_weight ()

:~ weighted_choice
    (tx : i32) (ty : i32) (fx : i32) (fy : i32) (x0 : i32) (y0 : i32) (w : i32) (h : i32) (passable : array_base i32)
    : i32
    =
    := cells = w * h
    := distance : array_base i32 = !!!!ArrayCreate(`i32, cells)
    := inside (x : i32) (y : i32) : bool = x >= x0 && x < x0 + w && y >= y0 && y < y0 + h
    := cell (x : i32) (y : i32) : i32 = (y - y0) * w + (x - x0)
    := passable_at (x : i32) (y : i32) : bool =
        ? inside x y ?>
            := walkable : i32 = !!!!ArrayIndex(passable, (cell x y))
            walkable = 1
        |: !-
    := distance_at (x : i32) (y : i32) : i32 =
        ? inside x y ?>
            := d : i32 = !!!!ArrayIndex(distance, (cell x y))
            d
        |: unreachable_weight ()
    :~ ^ seed (c : i32) : () =
        ? c < cells
        ?>
            := x = x0 + c % w
            := y = y0 + c / w
            := goal =
                passable_at x y
                && geometry.chebyshev_distance (geometry.position x y 7) (geometry.position tx ty 7) <= 1
                && (x <> tx || y <> ty)
            := start = ? goal ?> 0 |: unreachable_weight ()
            !!!!ArrayIndexSet(distance, c, start)
            seed (c + 1)
    seed 0
    := relax (c : i32) : bool =
        := x = x0 + c % w
        := y = y0 + c / w
        ? passable_at x y = !- ?> !-
        |:
            :~ ^ best (k : i32) (current : i32) : i32 =
                ? k >= 8 ?> current
                |:
                    := through = distance_at (x + direction_dx k) (y + direction_dy k) + direction_weight k
                    best (k + 1) (? through < current ?> through |: current)
            := old = distance_at x y
            := improved = best 0 old
            ? improved < old ?>
                !!!!ArrayIndexSet(distance, c, improved)
                !+
            |: !-
    :~ ^ forward (c : i32) (changed : bool) : bool =
        ? c >= cells
        ?> changed
        |: forward (c + 1) (relax c || changed)
    :~ ^ backward (c : i32) (changed : bool) : bool =
        ? c < 0
        ?> changed
        |: backward (c - 1) (relax c || changed)
    :~ ^ settle (round : i32) : () =
        ? round < 40 ?>
            := a = forward 0 !-
            := b = backward (cells - 1) !-
            ? a || b ?> settle (round + 1)
    settle 0
    ? distance_at fx fy = 0
    ?> 8
    |:
        :~ ^ pick (k : i32) (best_k : i32) (best_score : i32) : i32 =
            ? k >= 8
            ?> best_k
            |:
                := nx = fx + direction_dx k
                := ny = fy + direction_dy k
                := d = distance_at nx ny
                := score =
                    ? passable_at nx ny && d < unreachable_weight ()
                    ?> d + direction_weight k
                    |: unreachable_weight ()
                ? score < best_score ?> pick (k + 1) k score |: pick (k + 1) best_k best_score
        pick 0 8 (unreachable_weight ())

:= weighted_step
    (l : layout) (taken : geometry.position -> bool) (target : geometry.position) (from : geometry.position)
    : geometry.position
    =
    := m = window_margin ()
    := low_x = (? from.x < target.x ?> from.x |: target.x) - m
    := low_y = (? from.y < target.y ?> from.y |: target.y) - m
    := high_x = (? from.x > target.x ?> from.x |: target.x) + m
    := high_y = (? from.y > target.y ?> from.y |: target.y) + m
    := w = high_x - low_x + 1
    := h = high_y - low_y + 1
    := cells = w * h
    := passable : array_base i32 = !!!!ArrayCreate(`i32, cells)
    :~ ^ fill (c : i32) : () =
        ? c < cells ?>
            := p = geometry.position (low_x + c % w) (low_y + c / w) from.z
            := walkable : i32 = ? blocked l p || (taken p && geometry.same_tile p from = !-) ?> 0i32 |: 1i32
            !!!!ArrayIndexSet(passable, c, walkable)
            fill (c + 1)
    fill 0
    := k = weighted_choice target.x target.y from.x from.y low_x low_y w h passable
    ? k >= 8 ?> from |: shifted (direction_dx k) (direction_dy k) from
:= routed_step
    (l : layout) (taken : geometry.position -> bool) (target : geometry.position) (from : geometry.position)
    : geometry.position
    =
    := usable dx dy = free l taken (shifted dx dy from)
    ?= route_between target.x target.y from.x from.y (usable 1 0) (usable -1 0) (usable 0 1) (usable 0 -1) ?|
    | Arrived => from
    | NoRoute => from
    | c =>
        := dx, dy = route_offset c
        shifted dx dy from

:= step_toward
    (l : layout) (taken : geometry.position -> bool) (target : geometry.position) (from : geometry.position)
    : geometry.position
    =
    ?= l ?|
    | ArenaHunt => routed_step l taken target from
    | ArenaSpot => weighted_step l taken target from
    | _ => greedy_step_toward l taken target from

:= step_away
    (l : layout) (taken : geometry.position -> bool) (threat : geometry.position) (from : geometry.position)
    : geometry.position
    =
    := distance = geometry.chebyshev_distance threat from
    best_step l taken
        \ p => geometry.chebyshev_distance threat p > distance
        (direction_of (from.x - threat.x))
        (direction_of (from.y - threat.y))
        from

:= step_away_like_the_live_probe
    (l : layout) (taken : geometry.position -> bool) (threat : geometry.position) (from : geometry.position)
    : geometry.position
    =
    := sx = direction_of (from.x - threat.x)
    := sy = direction_of (from.y - threat.y)
    := usable p = geometry.same_tile p from = !- && free l taken p
    := both = shifted sx sy from
    := across = shifted sx 0 from
    := along = shifted 0 sy from
    := left = ? sx = 0 ?> shifted 1 sy from |? sy = 0 ?> shifted sx 1 from |: from
    := right = ? sx = 0 ?> shifted -1 sy from |? sy = 0 ?> shifted sx -1 from |: from
    ? usable both
    ?> both
    |? usable across
    ?> across
    |? usable along
    ?> along
    |? usable left
    ?> left
    |? usable right
    ?> right
    |: from
:== footing = { away : i32; room : i32; crowd : i32; align : i32; diagonal : i32 }

:= neighbor (k : i32) (from : geometry.position) : geometry.position =
    := dx = ? k = 0 || k = 3 || k = 5 ?> -1 |? k = 2 || k = 4 || k = 7 ?> 1 |: 0
    := dy = ? k = 0 || k = 1 || k = 2 ?> -1 |? k = 5 || k = 6 || k = 7 ?> 1 |: 0
    shifted dx dy from

:= walkable_around (l : layout) (p : geometry.position) : i32 =
    :~ ^ count (k : i32) (acc : i32) : i32 =
        ? k >= 8 ?> acc |: count (k + 1) (? blocked l (neighbor k p) ?> acc |: acc + 1)
    count 0 0

:= footing_score
    (l : layout) (foes_near : geometry.position -> i32) (w : footing) (threat : geometry.position)
    (from : geometry.position) (c : geometry.position)
    : i32
    =
    := alignment =
        (c.x - from.x) * direction_of (from.x - threat.x) + (c.y - from.y) * direction_of (from.y - threat.y)
    := slanted = ? c.x <> from.x && c.y <> from.y ?> 1 |: 0
    w.away * geometry.chebyshev_distance threat c
    + w.room * walkable_around l c
    - w.crowd * foes_near c
    + w.align * alignment
    - w.diagonal * slanted

:= scored_step
    (l : layout) (taken : geometry.position -> bool) (foes_near : geometry.position -> i32) (w : footing)
    (threat : geometry.position) (from : geometry.position)
    : geometry.position
    =
    := distance = geometry.chebyshev_distance threat from
    := sx = direction_of (from.x - threat.x)
    := sy = direction_of (from.y - threat.y)
    := usable p = free l taken p && geometry.chebyshev_distance threat p > distance
    := score p = footing_score l foes_near w threat from p
    := consider (c : geometry.position) (best : geometry.position) : geometry.position =
        ? usable c && (geometry.same_tile best from || score c > score best) ?> c |: best
    := both = shifted sx sy from
    := across = shifted sx 0 from
    := along = shifted 0 sy from
    := left = ? sy = 0 ?> shifted sx 1 from |: shifted 1 sy from
    := right = ? sy = 0 ?> shifted sx -1 from |: shifted -1 sy from
    from |> consider both |> consider across |> consider along |> consider left |> consider right

:= ground_step_percent (l : layout) : i32 =
    ?= l ?|
    | ArenaSpot => 108
    | ArenaHunt => 108
    | _ => 100

:= on_ground (l : layout) (step_ms : i32) : i32 = step_ms * ground_step_percent l / 100

:= arena_ground_speed () : i32 = 160
:= road_ground_speed () : i32 = 100
:= grass_ground_speed () : i32 = 150

:= ground_speed_at (l : layout) (from : geometry.position) : i32 =
    ?= l ?|
    | ArenaSpot => ? arena_road from ?> road_ground_speed () |: arena_ground_speed ()
    | ArenaHunt => ? arena_road from ?> road_ground_speed () |: arena_ground_speed ()
    | _ => grass_ground_speed ()

:= on_the_server_map (l : layout) (from : geometry.position) (step_ms : i32) : i32 =
    ? arena_road from
    ?> step_ms * ground_step_percent l * road_ground_speed () / (100 * arena_ground_speed ())
    |: on_ground l step_ms

:= on_ground_at (l : layout) (from : geometry.position) (step_ms : i32) : i32 =
    ?= l ?|
    | ArenaHunt => on_the_server_map l from step_ms
    | ArenaSpot => on_the_server_map l from step_ms
    | _ => on_ground l step_ms

:= grave () : geometry.position = geometry.position 0 0 15

:= more_spawn_points (l : layout) : geometry.position * geometry.position * geometry.position =
    ?= l ?|
    | ArenaHunt => geometry.position 117 95 7, geometry.position 120 105 7, geometry.position 108 104 7
    | _ => grave (), grave (), grave ()

:= player_start (l : layout) : geometry.position =
    ?= l ?|
    | ArenaSpot => geometry.position 99 99 7
    | ArenaHunt => geometry.position 103 86 7
    | _ => geometry.position 100 100 7

:= spawn_points (l : layout) : geometry.position * geometry.position * geometry.position =
    ?= l ?|
    | OpenField => geometry.position 106 103 7, geometry.position 104 107 7, geometry.position 108 98 7
    | EastCorridor => geometry.position 102 100 7, geometry.position 104 100 7, geometry.position 106 100 7
    | RoomAndCorridor => geometry.position 103 100 7, geometry.position 104 102 7, geometry.position 104 98 7
    | ArenaSpot => geometry.position 99 101 7, geometry.position 98 102 7, geometry.position 98 103 7
    | ArenaHunt => geometry.position 125 86 7, geometry.position 120 96 7, geometry.position 110 84 7

///> c
test a_corridor_turns_a_diagonal_approach_into_a_straight_one =
    := ~x = 103i32
    := nobody (p : geometry.position) = !-
    := step = step_toward EastCorridor nobody (geometry.position 100 100 7) (geometry.position x 100 7)
    (step.x, step.y) |> _assert_eq (102i32, 100i32)
    := open_step = step_toward OpenField nobody (geometry.position 100 100 7) (geometry.position x 103 7)
    (open_step.x, open_step.y) |> _assert_eq (102i32, 102i32)

///> c
test a_taken_tile_is_walked_around_or_waited_for =
    := ~x = 102i32
    := knight = geometry.position 100 100 7
    := ahead (p : geometry.position) = p.x = 101i32 && p.y = 100i32
    := in_corridor = step_toward EastCorridor ahead knight (geometry.position x 100 7)
    (in_corridor.x, in_corridor.y) |> _assert_eq (102i32, 100i32)
    := in_field = step_toward OpenField ahead knight (geometry.position x 100 7)
    (in_field.x, in_field.y) |> _assert_eq (101i32, 101i32)

///> wgsl
test corridor_steps_on_gpu =
    := ~x = 103i32
    := nobody (p : geometry.position) = !-
    := step = step_toward EastCorridor nobody (geometry.position 100 100 7) (geometry.position x 100 7)
    ? step.x = 102i32 && step.y = 100i32 ?> 0i32 |: 1i32

///> c
test the_arena_spot_matches_the_live_scan_and_the_server_map =
    := ~x = 100i32
    := at dx dy = walls ArenaSpot (geometry.position (x + dx) (100 + dy) 7)
    (at 0 0, at -1 0, at 1 0, at 4 -4, at -7 0, at 8 0, at -1 1)
    |> _assert_eq (!-, !+, !-, !-, !-, !-, !-)

///> c
test a_scored_step_can_prefer_room_over_distance =
    := ~x = 100i32
    := nobody (p : geometry.position) = !-
    := alone (p : geometry.position) = 0i32
    := threat = geometry.position (x + 1) 100 7
    := run =
        scored_step RoomAndCorridor nobody alone
            { away = 10; room = 0; crowd = 0; align = 0; diagonal = 0 }
            threat
            (geometry.position x 100 7)
    := roomy =
        scored_step RoomAndCorridor nobody alone
            { away = 0; room = 10; crowd = 0; align = 0; diagonal = 0 }
            threat
            (geometry.position x 100 7)
    (run.x, walkable_around RoomAndCorridor (geometry.position 98 100 7), roomy.x) |> _assert_eq (99i32, 2i32, 99i32)

///> c
test the_arena_hunt_spawns_and_start_are_open_ground =
    := ~x = 0i32
    := a, b, c = spawn_points ArenaHunt
    := d, e, f = more_spawn_points ArenaHunt
    := s = player_start ArenaHunt
    (
        blocked ArenaHunt a,
        blocked ArenaHunt b,
        blocked ArenaHunt c,
        blocked ArenaHunt d,
        blocked ArenaHunt e,
        blocked ArenaHunt f,
        blocked ArenaHunt s,
        x
    )
    |> _assert_eq (!-, !-, !-, !-, !-, !-, !-, 0i32)

///> c
test on_the_hunting_ground_a_route_goes_where_a_greedy_step_sticks =
    := ~x = 110i32
    := nobody (p : geometry.position) = !-
    := target = geometry.position 115 93 7
    := from = geometry.position x 88 7
    := greedy = greedy_step_toward ArenaHunt nobody target from
    :~ ^ walk (steps : i32) (at : geometry.position) : i32 * geometry.position =
        ? geometry.chebyshev_distance target at <= 1 || steps >= 100 ?> steps, at
        |: walk (steps + 1) (step_toward ArenaHunt nobody target at)
    := steps, last = walk 0 from
    (greedy.x, greedy.y, steps, last.x, last.y) |> _assert_eq (110i32, 88i32, 9i32, 115i32, 92i32)

///> c
test on_the_server_map_a_road_tile_speeds_the_next_step_up_at_the_spot_and_on_the_hunting_ground =
    := ~cyclops_ms = 650i32
    (
        on_ground_at ArenaHunt (geometry.position 115 93 7) cyclops_ms,
        on_ground_at ArenaHunt (geometry.position 115 89 7) cyclops_ms,
        on_ground_at ArenaSpot (geometry.position 115 89 7) cyclops_ms,
        on_ground_at ArenaSpot (geometry.position 99 99 7) cyclops_ms,
        arena_road (geometry.position 99 99 7)
    )
    |> _assert_eq (702i32, 438i32, 438i32, 702i32, !-)

///> c
test on_the_arena_spot_a_monster_detours_around_another_with_a_diagonal_step =
    := ~x = 98i32
    := blocker (p : geometry.position) = p.x = 99i32 && p.y = 101i32
    := knight = geometry.position 100 100 7
    := first = step_toward ArenaSpot blocker knight (geometry.position x 102 7)
    := second = step_toward ArenaSpot blocker knight first
    := greedy = greedy_step_toward ArenaSpot blocker knight (geometry.position x 102 7)
    (first.x, first.y, second.x, second.y, greedy.x, greedy.y)
    |> _assert_eq (99i32, 102i32, 100i32, 101i32, 98i32, 102i32)

///> c
test ramps_and_stairs_near_the_arena_spot_are_walls_because_cyclopes_never_take_them =
    := ~west = 1833i32
    := at x y = geometry.position (x - west) (y - 1250) 7
    := l = ArenaSpot
    (
        blocked l (at 1940 1372),
        blocked l (at 1941 1372),
        blocked l (at 1927 1337),
        blocked l (at 1958 1345),
        blocked l (at 1939 1371)
    )
    |> _assert_eq (!+, !+, !+, !+, !-)

///> c
test the_protection_zones_east_of_the_spot_stop_walkers_but_not_arrows =
    := ~west = 1833i32
    := at x y = geometry.position (x - west) (y - 1250) 7
    := l = ArenaSpot
    (
        blocked l (at 1942 1351),
        walls l (at 1942 1351),
        blocked ArenaHunt (at 1960 1343),
        blocked l (at 1942 1352),
        blocked l (at 1960 1358),
        arena_world_protected (west + 110) 1351
    )
    |> _assert_eq (!+, !-, !+, !-, !-, !+)

///> c
test the_server_map_ground_speed_is_160_off_the_road_100_on_it_and_150_on_open_grass =
    := ~x = 115i32
    (
        ground_speed_at ArenaHunt (geometry.position x 93 7),
        ground_speed_at ArenaHunt (geometry.position x 89 7),
        ground_speed_at OpenField (geometry.position x 89 7)
    )
    |> _assert_eq (160i32, 100i32, 150i32)
