///- --package .
test terrain static =
    :< testing

:| layout =
    | OpenField
    | EastCorridor
    | RoomAndCorridor
    | ArenaSpot
    | ArenaHunt

:= corridor_row () : i32 = 100
:= corridor_mouth () : i32 = 99

