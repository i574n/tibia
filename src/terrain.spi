let arena_protection_zone (dx : i32) (dy : i32) : bool =
    if dy = (0 - 29)
    then (dx >= 41 && dx <= 43) || dx = 45
    elif dy = (0 - 28)
    then (dx >= 41 && dx <= 43) || dx = 45
    elif dy = (0 - 27)
    then dx >= 40 && dx <= 45
    elif dy = (0 - 26)
    then dx >= 41 && dx <= 45
    elif dy = (0 - 25)
    then dx >= 41 && dx <= 45
    elif dy = (0 - 24)
    then dx >= 41 && dx <= 45
    elif dy = (0 - 23)
    then dx >= 41 && dx <= 45
    elif dy = (0 - 22)
    then dx >= 41 && dx <= 45
    elif dy = (0 - 21)
    then dx >= 38 && dx <= 45
    elif dy = (0 - 20)
    then dx >= 38 && dx <= 45
    elif dy = (0 - 19)
    then dx >= 38 && dx <= 45
    elif dy = (0 - 18)
    then dx >= 38 && dx <= 45
    elif dy = (0 - 10)
    then
        (dx >= 7 && dx <= 14)
        || (dx >= 21 && dx <= 23)
        || (dx >= 25 && dx <= 27)
        || (dx >= 29 && dx <= 31)
        || (dx >= 33 && dx <= 40)
    elif dy = (0 - 9)
    then
        (dx >= 7 && dx <= 14)
        || (dx >= 21 && dx <= 23)
        || (dx >= 25 && dx <= 27)
        || (dx >= 29 && dx <= 31)
        || (dx >= 33 && dx <= 40)
    elif dy = (0 - 8)
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = (0 - 7)
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = (0 - 6)
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = (0 - 5)
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = (0 - 4)
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = (0 - 3)
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = (0 - 2)
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = (0 - 1)
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = 0
    then (dx >= 7 && dx <= 14) || (dx >= 21 && dx <= 40)
    elif dy = 1
    then (dx >= 8 && dx <= 14) || (dx >= 33 && dx <= 40)
    elif dy = 2
    then dx >= 33 && dx <= 40
    elif dy = 3
    then dx >= 33 && dx <= 40
    elif dy = 4
    then dx >= 33 && dx <= 40
    elif dy = 5
    then dx >= 33 && dx <= 40
    else false

inl arena_spot_world_x () : i32 = 1933
inl arena_spot_world_y () : i32 = 1350

let arena_spot_protected (p : geometry.position) : bool = arena_protection_zone (p.x - 100) (p.y - 100)

inl arena_world_protected (x : i32) (y : i32) : bool =
    arena_protection_zone (x - arena_spot_world_x ()) (y - arena_spot_world_y ())

inl walls (l : layout) (p : geometry.position) : bool =
    match l with
    | OpenField => false
    | EastCorridor => p.y <> corridor_row () || p.x < corridor_mouth ()
    | RoomAndCorridor => p.x < 100 && p.y <> corridor_row ()
    | ArenaSpot => arena_spot_blocked p
    | ArenaHunt => arena_spot_blocked p

inl sight_blocks (l : layout) (p : geometry.position) : bool =
    match l with
    | ArenaSpot => arena_sight_blocked p
    | ArenaHunt => arena_sight_blocked p
    | _ => walls l p

inl blocked (l : layout) (p : geometry.position) : bool =
    match l with
    | ArenaSpot => arena_spot_blocked p || arena_spot_protected p
    | ArenaHunt => arena_spot_blocked p || arena_spot_protected p
    | _ => walls l p

inl free (l : layout) (taken : geometry.position -> bool) (p : geometry.position) : bool =
    blocked l p = false && taken p = false

inl direction_of (n : i32) : i32 = if n > 0 then 1 elif n < 0 then -1 else 0

inl shifted (dx : i32) (dy : i32) (from : geometry.position) : geometry.position =
    geometry.position (from.x + dx) (from.y + dy) from.z

inl best_step
    (l : layout) (taken : geometry.position -> bool) (improves : geometry.position -> bool) (sx : i32) (sy : i32)
    (from : geometry.position)
    : geometry.position
    =
    inl usable p = free l taken p && improves p
    inl both = shifted sx sy from
    inl across = shifted sx 0 from
    inl along = shifted 0 sy from
    inl left = if sy = 0 then shifted sx 1 from else shifted 1 sy from
    inl right = if sy = 0 then shifted sx -1 from else shifted -1 sy from
    if usable both
    then both
    elif usable across
    then across
    elif usable along
    then along
    elif usable left
    then left
    elif usable right
    then right
    else from

inl greedy_step_toward
    (l : layout) (taken : geometry.position -> bool) (target : geometry.position) (from : geometry.position)
    : geometry.position
    =
    inl distance = geometry.chebyshev_distance target from
    best_step l taken
        fun p => geometry.chebyshev_distance target p < distance
        (direction_of (target.x - from.x))
        (direction_of (target.y - from.y))
        from

inl region_rows () : i32 = 2 * arena_spot_radius () + 1
inl region_words () : i32 = (region_rows () + row_word_bits () - 1) / row_word_bits ()
inl all_bits () : u32 = 4294967295u32
inl region_word_mask (word : i32) : u32 =
    inl valid = region_rows () - word * row_word_bits ()
    if valid >= row_word_bits () then all_bits () else (1u32 <<< valid) - 1u32

union route_choice =
    | GoEast
    | GoWest
    | GoSouth
    | GoNorth
    | Arrived
    | NoRoute

inl route_offset (c : route_choice) : i32 * i32 =
    match c with
    | GoEast => 1, 0
    | GoWest => -1, 0
    | GoSouth => 0, 1
    | GoNorth => 0, -1
    | _ => 0, 0

inl region_bit (x : i32) : i32 = x - 100 + arena_spot_radius ()
inl region_row (y : i32) : i32 = y - 100 + arena_spot_radius ()
inl inside_region (x : i32) (y : i32) : bool =
    region_bit x >= 0 && region_bit x < region_rows () && region_row y >= 0 && region_row y < region_rows ()

inl word_holds (word : u32) (bit : i32) : bool = ((word >>> bit) &&& 1u32) = 1u32

let route_between
    (tx : i32) (ty : i32) (fx : i32) (fy : i32) (free_east : bool) (free_west : bool) (free_south : bool)
    (free_north : bool)
    : route_choice
    =
    inl rows = region_rows ()
    inl width = region_words ()
    inl cells = rows * width
    inl reach : array_base u32 = !!!!ArrayCreate(`u32, cells)
    inl openings : array_base u32 = !!!!ArrayCreate(`u32, cells)
    inl above : array_base u32 = !!!!ArrayCreate(`u32, width)
    inl grown : array_base u32 = !!!!ArrayCreate(`u32, width)
    inl reach_at (row : i32) (word : i32) : u32 =
        if row < 0 || row >= rows || word < 0 || word >= width
        then 0u32
        else !!!!ArrayIndex(reach, row * width + word)
    let rec prepare (cell : i32) : () =
        if cell < cells then
            !!!!ArrayIndexSet(reach, cell, 0u32)
            inl open_bits = arena_spot_bits (cell % width) (cell / width) ^^^ region_word_mask (cell % width)
            !!!!ArrayIndexSet(openings, cell, open_bits)
            prepare (cell + 1)
    prepare 0
    inl is_open (x : i32) (y : i32) : bool =
        if inside_region x y = false then false
        else
            inl bit = region_bit x
            inl open_bits : u32 = !!!!ArrayIndex(openings, region_row y * width + bit / row_word_bits ())
            word_holds open_bits (bit % row_word_bits ())
    inl reached (x : i32) (y : i32) : bool =
        if inside_region x y = false then false
        else
            inl bit = region_bit x
            word_holds (reach_at (region_row y) (bit / row_word_bits ())) (bit % row_word_bits ())
    inl mark (x : i32) (y : i32) : () =
        if inside_region x y && is_open x y then
            inl bit = region_bit x
            inl row = region_row y
            inl word = bit / row_word_bits ()
            inl marked = reach_at row word ||| (1u32 <<< (bit % row_word_bits ()))
            !!!!ArrayIndexSet(reach, row * width + word, marked)
    let rec seed (k : i32) : () =
        if k < 9 then
            mark (tx + k % 3 - 1) (ty + k / 3 - 1)
            seed (k + 1)
    seed 0
    let rec forget_above (word : i32) : () =
        if word < width then
            !!!!ArrayIndexSet(above, word, 0u32)
            forget_above (word + 1)
    let rec sweep (row : i32) (changed : bool) : bool =
        if row >= rows
        then changed
        else
            let rec grow (word : i32) : () =
                if word < width
                then
                    inl here = reach_at row word
                    inl open_bits : u32 = !!!!ArrayIndex(openings, row * width + word)
                    inl up : u32 = !!!!ArrayIndex(above, word)
                    inl spread =
                        here
                        ||| (here <<< 1)
                        ||| (here >>> 1)
                        ||| (reach_at row (word + 1) <<< 31)
                        ||| (reach_at row (word - 1) >>> 31)
                        ||| up
                        ||| reach_at (row + 1) word
                    !!!!ArrayIndexSet(grown, word, spread &&& open_bits)
                    grow (word + 1)
            grow 0
            let rec commit (word : i32) (changed : bool) : bool =
                if word >= width then changed
                else
                    inl here = reach_at row word
                    inl next : u32 = !!!!ArrayIndex(grown, word)
                    !!!!ArrayIndexSet(above, word, here)
                    !!!!ArrayIndexSet(reach, row * width + word, next)
                    commit (word + 1) (changed || next <> here)
            sweep (row + 1) (commit 0 changed)
    inl sweep_all () : bool =
        forget_above 0
        sweep 0 false
    inl along_x = (if tx - fx < 0 then fx - tx else tx - fx) >= (if ty - fy < 0 then fy - ty else ty - fy)
    inl east_first = tx >= fx
    inl south_first = ty >= fy
    inl leads (c : route_choice) : bool =
        inl dx, dy = route_offset c
        inl free = match c with GoEast => free_east | GoWest => free_west | GoSouth => free_south | _ => free_north
        free && reached (fx + dx) (fy + dy)
    inl x_toward = if east_first then GoEast else GoWest
    inl x_away = if east_first then GoWest else GoEast
    inl y_toward = if south_first then GoSouth else GoNorth
    inl y_away = if south_first then GoNorth else GoSouth
    inl first, second = if along_x then x_toward, y_toward else y_toward, x_toward
    inl choose () : route_choice =
        if leads first
        then first
        elif leads second
        then second
        elif leads y_away
        then y_away
        elif leads x_away
        then x_away
        else NoRoute
    inl still_searching (c : route_choice) : bool = match c with NoRoute => true | _ => false
    let rec layers (k : i32) : route_choice =
        inl c = choose ()
        if still_searching c && k < rows * 2 && sweep_all () then layers (k + 1) else c
    if reached fx fy then Arrived else layers 0

inl straight_step_weight () : i32 = 10
inl diagonal_step_weight () : i32 = 25
inl unreachable_weight () : i32 = 1000000
inl window_margin () : i32 = 6

inl direction_dx (k : i32) : i32 =
    if k = 0
    then 1
    elif k = 1
    then -1
    elif k = 2
    then 0
    elif k = 3
    then 0
    elif k = 4 || k = 6
    then 1
    else -1
inl direction_dy (k : i32) : i32 =
    if k = 0 || k = 1
    then 0
    elif k = 2
    then 1
    elif k = 3
    then -1
    elif k = 4 || k = 5
    then 1
    else -1
inl direction_weight (k : i32) : i32 = if k < 4 then straight_step_weight () else diagonal_step_weight ()

let weighted_choice
    (tx : i32) (ty : i32) (fx : i32) (fy : i32) (x0 : i32) (y0 : i32) (w : i32) (h : i32) (passable : array_base i32)
    : i32
    =
    inl cells = w * h
    inl distance : array_base i32 = !!!!ArrayCreate(`i32, cells)
    inl inside (x : i32) (y : i32) : bool = x >= x0 && x < x0 + w && y >= y0 && y < y0 + h
    inl cell (x : i32) (y : i32) : i32 = (y - y0) * w + (x - x0)
    inl passable_at (x : i32) (y : i32) : bool =
        if inside x y then
            inl walkable : i32 = !!!!ArrayIndex(passable, (cell x y))
            walkable = 1
        else false
    inl distance_at (x : i32) (y : i32) : i32 =
        if inside x y then
            inl d : i32 = !!!!ArrayIndex(distance, (cell x y))
            d
        else unreachable_weight ()
    let rec seed (c : i32) : () =
        if c < cells
        then
            inl x = x0 + c % w
            inl y = y0 + c / w
            inl goal =
                passable_at x y
                && geometry.chebyshev_distance (geometry.position x y 7) (geometry.position tx ty 7) <= 1
                && (x <> tx || y <> ty)
            inl start = if goal then 0 else unreachable_weight ()
            !!!!ArrayIndexSet(distance, c, start)
            seed (c + 1)
    seed 0
    inl relax (c : i32) : bool =
        inl x = x0 + c % w
        inl y = y0 + c / w
        if passable_at x y = false then false
        else
            let rec best (k : i32) (current : i32) : i32 =
                if k >= 8 then current
                else
                    inl through = distance_at (x + direction_dx k) (y + direction_dy k) + direction_weight k
                    best (k + 1) (if through < current then through else current)
            inl old = distance_at x y
            inl improved = best 0 old
            if improved < old then
                !!!!ArrayIndexSet(distance, c, improved)
                true
            else false
    let rec forward (c : i32) (changed : bool) : bool =
        if c >= cells
        then changed
        else forward (c + 1) (relax c || changed)
    let rec backward (c : i32) (changed : bool) : bool =
        if c < 0
        then changed
        else backward (c - 1) (relax c || changed)
    let rec settle (round : i32) : () =
        if round < 40 then
            inl a = forward 0 false
            inl b = backward (cells - 1) false
            if a || b then settle (round + 1)
    settle 0
    if distance_at fx fy = 0
    then 8
    else
        let rec pick (k : i32) (best_k : i32) (best_score : i32) : i32 =
            if k >= 8
            then best_k
            else
                inl nx = fx + direction_dx k
                inl ny = fy + direction_dy k
                inl d = distance_at nx ny
                inl score =
                    if passable_at nx ny && d < unreachable_weight ()
                    then d + direction_weight k
                    else unreachable_weight ()
                if score < best_score then pick (k + 1) k score else pick (k + 1) best_k best_score
        pick 0 8 (unreachable_weight ())

inl weighted_step
    (l : layout) (taken : geometry.position -> bool) (target : geometry.position) (from : geometry.position)
    : geometry.position
    =
    inl m = window_margin ()
    inl low_x = (if from.x < target.x then from.x else target.x) - m
    inl low_y = (if from.y < target.y then from.y else target.y) - m
    inl high_x = (if from.x > target.x then from.x else target.x) + m
    inl high_y = (if from.y > target.y then from.y else target.y) + m
    inl w = high_x - low_x + 1
    inl h = high_y - low_y + 1
    inl cells = w * h
    inl passable : array_base i32 = !!!!ArrayCreate(`i32, cells)
    let rec fill (c : i32) : () =
        if c < cells then
            inl p = geometry.position (low_x + c % w) (low_y + c / w) from.z
            inl walkable : i32 = if blocked l p || (taken p && geometry.same_tile p from = false) then 0i32 else 1i32
            !!!!ArrayIndexSet(passable, c, walkable)
            fill (c + 1)
    fill 0
    inl k = weighted_choice target.x target.y from.x from.y low_x low_y w h passable
    if k >= 8 then from else shifted (direction_dx k) (direction_dy k) from
inl routed_step
    (l : layout) (taken : geometry.position -> bool) (target : geometry.position) (from : geometry.position)
    : geometry.position
    =
    inl usable dx dy = free l taken (shifted dx dy from)
    match route_between target.x target.y from.x from.y (usable 1 0) (usable -1 0) (usable 0 1) (usable 0 -1) with
    | Arrived => from
    | NoRoute => from
    | c =>
        inl dx, dy = route_offset c
        shifted dx dy from

inl step_toward
    (l : layout) (taken : geometry.position -> bool) (target : geometry.position) (from : geometry.position)
    : geometry.position
    =
    match l with
    | ArenaHunt => routed_step l taken target from
    | ArenaSpot => weighted_step l taken target from
    | _ => greedy_step_toward l taken target from

inl step_away
    (l : layout) (taken : geometry.position -> bool) (threat : geometry.position) (from : geometry.position)
    : geometry.position
    =
    inl distance = geometry.chebyshev_distance threat from
    best_step l taken
        fun p => geometry.chebyshev_distance threat p > distance
        (direction_of (from.x - threat.x))
        (direction_of (from.y - threat.y))
        from

inl step_away_like_the_live_probe
    (l : layout) (taken : geometry.position -> bool) (threat : geometry.position) (from : geometry.position)
    : geometry.position
    =
    inl sx = direction_of (from.x - threat.x)
    inl sy = direction_of (from.y - threat.y)
    inl usable p = geometry.same_tile p from = false && free l taken p
    inl both = shifted sx sy from
    inl across = shifted sx 0 from
    inl along = shifted 0 sy from
    inl left = if sx = 0 then shifted 1 sy from elif sy = 0 then shifted sx 1 from else from
    inl right = if sx = 0 then shifted -1 sy from elif sy = 0 then shifted sx -1 from else from
    if usable both
    then both
    elif usable across
    then across
    elif usable along
    then along
    elif usable left
    then left
    elif usable right
    then right
    else from
type footing = { away : i32; room : i32; crowd : i32; align : i32; diagonal : i32 }

inl neighbor (k : i32) (from : geometry.position) : geometry.position =
    inl dx = if k = 0 || k = 3 || k = 5 then -1 elif k = 2 || k = 4 || k = 7 then 1 else 0
    inl dy = if k = 0 || k = 1 || k = 2 then -1 elif k = 5 || k = 6 || k = 7 then 1 else 0
    shifted dx dy from

inl walkable_around (l : layout) (p : geometry.position) : i32 =
    let rec count (k : i32) (acc : i32) : i32 =
        if k >= 8 then acc else count (k + 1) (if blocked l (neighbor k p) then acc else acc + 1)
    count 0 0

inl footing_score
    (l : layout) (foes_near : geometry.position -> i32) (w : footing) (threat : geometry.position)
    (from : geometry.position) (c : geometry.position)
    : i32
    =
    inl alignment =
        (c.x - from.x) * direction_of (from.x - threat.x) + (c.y - from.y) * direction_of (from.y - threat.y)
    inl slanted = if c.x <> from.x && c.y <> from.y then 1 else 0
    w.away * geometry.chebyshev_distance threat c
    + w.room * walkable_around l c
    - w.crowd * foes_near c
    + w.align * alignment
    - w.diagonal * slanted

inl scored_step
    (l : layout) (taken : geometry.position -> bool) (foes_near : geometry.position -> i32) (w : footing)
    (threat : geometry.position) (from : geometry.position)
    : geometry.position
    =
    inl distance = geometry.chebyshev_distance threat from
    inl sx = direction_of (from.x - threat.x)
    inl sy = direction_of (from.y - threat.y)
    inl usable p = free l taken p && geometry.chebyshev_distance threat p > distance
    inl score p = footing_score l foes_near w threat from p
    inl consider (c : geometry.position) (best : geometry.position) : geometry.position =
        if usable c && (geometry.same_tile best from || score c > score best) then c else best
    inl both = shifted sx sy from
    inl across = shifted sx 0 from
    inl along = shifted 0 sy from
    inl left = if sy = 0 then shifted sx 1 from else shifted 1 sy from
    inl right = if sy = 0 then shifted sx -1 from else shifted -1 sy from
    from |> consider both |> consider across |> consider along |> consider left |> consider right

inl ground_step_percent (l : layout) : i32 =
    match l with
    | ArenaSpot => 108
    | ArenaHunt => 108
    | _ => 100

inl on_ground (l : layout) (step_ms : i32) : i32 = step_ms * ground_step_percent l / 100

inl arena_ground_speed () : i32 = 160
inl road_ground_speed () : i32 = 100
inl grass_ground_speed () : i32 = 150

inl ground_speed_at (l : layout) (from : geometry.position) : i32 =
    match l with
    | ArenaSpot => if arena_road from then road_ground_speed () else arena_ground_speed ()
    | ArenaHunt => if arena_road from then road_ground_speed () else arena_ground_speed ()
    | _ => grass_ground_speed ()

inl on_the_server_map (l : layout) (from : geometry.position) (step_ms : i32) : i32 =
    if arena_road from
    then step_ms * ground_step_percent l * road_ground_speed () / (100 * arena_ground_speed ())
    else on_ground l step_ms

inl on_ground_at (l : layout) (from : geometry.position) (step_ms : i32) : i32 =
    match l with
    | ArenaHunt => on_the_server_map l from step_ms
    | ArenaSpot => on_the_server_map l from step_ms
    | _ => on_ground l step_ms

inl grave () : geometry.position = geometry.position 0 0 15

inl more_spawn_points (l : layout) : geometry.position * geometry.position * geometry.position =
    match l with
    | ArenaHunt => geometry.position 117 95 7, geometry.position 120 105 7, geometry.position 108 104 7
    | _ => grave (), grave (), grave ()

inl player_start (l : layout) : geometry.position =
    match l with
    | ArenaSpot => geometry.position 99 99 7
    | ArenaHunt => geometry.position 103 86 7
    | _ => geometry.position 100 100 7

inl spawn_points (l : layout) : geometry.position * geometry.position * geometry.position =
    match l with
    | OpenField => geometry.position 106 103 7, geometry.position 104 107 7, geometry.position 108 98 7
    | EastCorridor => geometry.position 102 100 7, geometry.position 104 100 7, geometry.position 106 100 7
    | RoomAndCorridor => geometry.position 103 100 7, geometry.position 104 102 7, geometry.position 104 98 7
    | ArenaSpot => geometry.position 99 101 7, geometry.position 98 102 7, geometry.position 98 103 7
    | ArenaHunt => geometry.position 125 86 7, geometry.position 120 96 7, geometry.position 110 84 7

///> c
test a_corridor_turns_a_diagonal_approach_into_a_straight_one =
    inl ~x = 103i32
    inl nobody (p : geometry.position) = false
    inl step = step_toward EastCorridor nobody (geometry.position 100 100 7) (geometry.position x 100 7)
    (step.x, step.y) |> _assert_eq (102i32, 100i32)
    inl open_step = step_toward OpenField nobody (geometry.position 100 100 7) (geometry.position x 103 7)
    (open_step.x, open_step.y) |> _assert_eq (102i32, 102i32)

///> c
test a_taken_tile_is_walked_around_or_waited_for =
    inl ~x = 102i32
    inl knight = geometry.position 100 100 7
    inl ahead (p : geometry.position) = p.x = 101i32 && p.y = 100i32
    inl in_corridor = step_toward EastCorridor ahead knight (geometry.position x 100 7)
    (in_corridor.x, in_corridor.y) |> _assert_eq (102i32, 100i32)
    inl in_field = step_toward OpenField ahead knight (geometry.position x 100 7)
    (in_field.x, in_field.y) |> _assert_eq (101i32, 101i32)

///> wgsl
test corridor_steps_on_gpu =
    inl ~x = 103i32
    inl nobody (p : geometry.position) = false
    inl step = step_toward EastCorridor nobody (geometry.position 100 100 7) (geometry.position x 100 7)
    if step.x = 102i32 && step.y = 100i32 then 0i32 else 1i32

///> c
test the_arena_spot_matches_the_live_scan_and_the_server_map =
    inl ~x = 100i32
    inl at dx dy = walls ArenaSpot (geometry.position (x + dx) (100 + dy) 7)
    (at 0 0, at -1 0, at 1 0, at 4 -4, at -7 0, at 8 0, at -1 1)
    |> _assert_eq (false, true, false, false, false, false, false)

///> c
test a_scored_step_can_prefer_room_over_distance =
    inl ~x = 100i32
    inl nobody (p : geometry.position) = false
    inl alone (p : geometry.position) = 0i32
    inl threat = geometry.position (x + 1) 100 7
    inl run =
        scored_step RoomAndCorridor nobody alone
            { away = 10; room = 0; crowd = 0; align = 0; diagonal = 0 }
            threat
            (geometry.position x 100 7)
    inl roomy =
        scored_step RoomAndCorridor nobody alone
            { away = 0; room = 10; crowd = 0; align = 0; diagonal = 0 }
            threat
            (geometry.position x 100 7)
    (run.x, walkable_around RoomAndCorridor (geometry.position 98 100 7), roomy.x) |> _assert_eq (99i32, 2i32, 99i32)

///> c
test the_arena_hunt_spawns_and_start_are_open_ground =
    inl ~x = 0i32
    inl a, b, c = spawn_points ArenaHunt
    inl d, e, f = more_spawn_points ArenaHunt
    inl s = player_start ArenaHunt
    (
        blocked ArenaHunt a,
        blocked ArenaHunt b,
        blocked ArenaHunt c,
        blocked ArenaHunt d,
        blocked ArenaHunt e,
        blocked ArenaHunt f,
        blocked ArenaHunt s,
        x
    )
    |> _assert_eq (false, false, false, false, false, false, false, 0i32)

///> c
test on_the_hunting_ground_a_route_goes_where_a_greedy_step_sticks =
    inl ~x = 110i32
    inl nobody (p : geometry.position) = false
    inl target = geometry.position 115 93 7
    inl from = geometry.position x 88 7
    inl greedy = greedy_step_toward ArenaHunt nobody target from
    let rec walk (steps : i32) (at : geometry.position) : i32 * geometry.position =
        if geometry.chebyshev_distance target at <= 1 || steps >= 100 then steps, at
        else walk (steps + 1) (step_toward ArenaHunt nobody target at)
    inl steps, last = walk 0 from
    (greedy.x, greedy.y, steps, last.x, last.y) |> _assert_eq (110i32, 88i32, 9i32, 115i32, 92i32)

///> c
test on_the_server_map_a_road_tile_speeds_the_next_step_up_at_the_spot_and_on_the_hunting_ground =
    inl ~cyclops_ms = 650i32
    (
        on_ground_at ArenaHunt (geometry.position 115 93 7) cyclops_ms,
        on_ground_at ArenaHunt (geometry.position 115 89 7) cyclops_ms,
        on_ground_at ArenaSpot (geometry.position 115 89 7) cyclops_ms,
        on_ground_at ArenaSpot (geometry.position 99 99 7) cyclops_ms,
        arena_road (geometry.position 99 99 7)
    )
    |> _assert_eq (702i32, 438i32, 438i32, 702i32, false)

///> c
test on_the_arena_spot_a_monster_detours_around_another_with_a_diagonal_step =
    inl ~x = 98i32
    inl blocker (p : geometry.position) = p.x = 99i32 && p.y = 101i32
    inl knight = geometry.position 100 100 7
    inl first = step_toward ArenaSpot blocker knight (geometry.position x 102 7)
    inl second = step_toward ArenaSpot blocker knight first
    inl greedy = greedy_step_toward ArenaSpot blocker knight (geometry.position x 102 7)
    (first.x, first.y, second.x, second.y, greedy.x, greedy.y)
    |> _assert_eq (99i32, 102i32, 100i32, 101i32, 98i32, 102i32)

///> c
test ramps_and_stairs_near_the_arena_spot_are_walls_because_cyclopes_never_take_them =
    inl ~west = 1833i32
    inl at x y = geometry.position (x - west) (y - 1250) 7
    inl l = ArenaSpot
    (
        blocked l (at 1940 1372),
        blocked l (at 1941 1372),
        blocked l (at 1927 1337),
        blocked l (at 1958 1345),
        blocked l (at 1939 1371)
    )
    |> _assert_eq (true, true, true, true, false)

///> c
test the_protection_zones_east_of_the_spot_stop_walkers_but_not_arrows =
    inl ~west = 1833i32
    inl at x y = geometry.position (x - west) (y - 1250) 7
    inl l = ArenaSpot
    (
        blocked l (at 1942 1351),
        walls l (at 1942 1351),
        blocked ArenaHunt (at 1960 1343),
        blocked l (at 1942 1352),
        blocked l (at 1960 1358),
        arena_world_protected (west + 110) 1351
    )
    |> _assert_eq (true, false, true, false, false, true)

///> c
test the_server_map_ground_speed_is_160_off_the_road_100_on_it_and_150_on_open_grass =
    inl ~x = 115i32
    (
        ground_speed_at ArenaHunt (geometry.position x 93 7),
        ground_speed_at ArenaHunt (geometry.position x 89 7),
        ground_speed_at OpenField (geometry.position x 89 7)
    )
    |> _assert_eq (160i32, 100i32, 150i32)
