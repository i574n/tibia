:= arena_spot_radius () : i32 = 45
:= row_word_bits () : i32 = 32

:= arena_bit_set (bits : i32 -> i32 -> u32) (p : geometry.position) : bool =
    := r = arena_spot_radius ()
    := bit = p.x - 100 + r
    ((bits (bit / row_word_bits ()) (p.y - 100 + r) >>> (bit % row_word_bits ())) &&& 1u32) = 1u32

:= inside_arena_spot (p : geometry.position) : bool =
    := r = arena_spot_radius ()
    p.x - 100 >= 0 - r && p.x - 100 <= r && p.y - 100 >= 0 - r && p.y - 100 <= r

:~ arena_spot_blocked (p : geometry.position) : bool =
    ? inside_arena_spot p
    ?> arena_bit_set arena_spot_bits p
    |: !+

