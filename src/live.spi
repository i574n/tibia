///- --package .
test live static =
    :< testing

:= reach_of_code (code : i32) : policy.reach =
    :< policy
    ? code = 1 ?> InReach |? code = 2 ?> OutOfReach |: NoTarget

:= observation_of (health : i32) (heal_ready : bool) (strike_ready : bool) (target_code : i32) : policy.observation =
    { health = health; heal_ready = heal_ready; strike_ready = strike_ready; target = reach_of_code target_code }

:= main () =
    := heals
        (heal_below : i32) (strike_above : i32) (health : i32) (heal_ready : bool) (strike_ready : bool)
        (target_code : i32)
        : bool
        =
        policy.heals
            { heal_below = heal_below; strike_above = strike_above }
            (observation_of health heal_ready strike_ready target_code)
    := engagement
        (heal_below : i32) (strike_above : i32) (health : i32) (heal_ready : bool) (strike_ready : bool)
        (target_code : i32)
        : i32
        =
        policy.engagement_code (
            policy.engages
                { heal_below = heal_below; strike_above = strike_above }
                (observation_of health heal_ready strike_ready target_code)
        )
    := prefers
        (a_current : bool) (a_distance : i32) (a_health : i32) (b_current : bool) (b_distance : i32) (b_health : i32)
        : bool
        =
        policy.prefers_by
            (:< policy ;; CurrentFirst)
            { is_current = a_current; distance = a_distance; health_percent = a_health }
            { is_current = b_current; distance = b_distance; health_percent = b_health }
    := network_decision
        (heal_below : i32) (max_health : i32) (kite_at : i32) (health : i32) (attackers : i32)
        (target_health_percent : i32) (target_distance : i32) (heal_ready : bool) (strike_ready : bool)
        : i32
        =
        := healer = network.threshold_healer (network.fraction_below heal_below max_health)
        := w = ? kite_at > 0 ?> network.with_kiting kite_at healer |: healer
        := x =
            network.inputs_of
                (health * network.one () / max_health)
                attackers
                (target_health_percent * network.one () / 100)
                target_distance
                heal_ready
                strike_ready
                !-
        := d = network.decide w x
        (? d.heal ?> 1 |: 0) + (? d.engage ?> 2 |: 0) + (? d.retreat ?> 4 |: 0)
    := retreats (retreat_at : i32) (attackers : i32) : bool =
        policy.retreats { heal_base = 0; heal_per_attacker = 0; strike_above = 0; retreat_at = retreat_at } attackers
    := prefers_reach
        (a_current : bool) (a_distance : i32) (a_health : i32) (b_current : bool) (b_distance : i32) (b_health : i32)
        : bool
        =
        policy.prefers_by
            (:< policy ;; ReachFirst)
            { is_current = a_current; distance = a_distance; health_percent = a_health }
            { is_current = b_current; distance = b_distance; health_percent = b_health }
    heals, engagement, prefers, network_decision, retreats, prefers_reach

///> c
///> lua
test probe_rules_follow_the_policy_thresholds =
    := heals, engagement, _, _, retreats, _ = main ()
    := ~health = 159i32
    heals 160 0 health !+ !+ 1 |> _assert_eq !+
    heals 160 0 (health + 1) !+ !+ 1 |> _assert_eq !-
    heals 160 0 health !- !+ 1 |> _assert_eq !-
    engagement 160 0 health !+ !+ 1 |> _assert_eq 1i32
    engagement 160 0 health !+ !- 1 |> _assert_eq 0i32
    engagement 160 0 health !+ !+ 2 |> _assert_eq 2i32
    engagement 160 0 health !+ !+ 0 |> _assert_eq 0i32
    engagement 160 (health + 1) health !+ !+ 1 |> _assert_eq 0i32
    retreats 2 2 |> _assert_eq !+
    retreats 2 1 |> _assert_eq !-

///> c
///> lua
test probe_targeting_orders =
    := _, _, prefers, _, _, prefers_reach = main ()
    := ~far = 3i32
    prefers !+ far 100 !- 1 10 |> _assert_eq !+
    prefers !- 1 10 !+ far 100 |> _assert_eq !-
    prefers_reach !- 1 100 !+ far 10 |> _assert_eq !+
    prefers_reach !+ far 10 !- 1 100 |> _assert_eq !-

///> c
///> lua
test probe_network_heals_at_the_rules_threshold_and_kites =
    := heals, _, _, network_decision, _, _ = main ()
    := ~max_health = 300i32
    network_decision 160 max_health 0 100 1 50 1 !+ !+ |> _assert_eq 3i32
    network_decision 160 max_health 0 250 1 50 1 !+ !+ |> _assert_eq 2i32
    := heal_bit_at_159 : bool = network_decision 160 max_health 0 159 1 50 1 !+ !+ % 2 = 1
    heal_bit_at_159 |> _assert_eq (heals 160 0 159 !+ !+ 1)
    := heal_bit_at_160 : bool = network_decision 160 max_health 0 160 1 50 1 !+ !+ % 2 = 1
    heal_bit_at_160 |> _assert_eq (heals 160 0 160 !+ !+ 1)
    network_decision 160 max_health 2 250 2 50 1 !+ !- |> _assert_eq 4i32
    network_decision 160 max_health 2 250 2 50 1 !+ !+ |> _assert_eq 2i32
    network_decision 160 max_health 2 250 1 50 1 !+ !- |> _assert_eq 2i32
