///- --package .
test policy static =
    :< testing

:== thresholds = { heal_below : i32; strike_above : i32 }

:| reach =
    | InReach
    | OutOfReach
    | NoTarget

:== observation = { health : i32; heal_ready : bool; strike_ready : bool; target : reach }

:| engagement =
    | Strike
    | Approach
    | Hold

:== candidate = { is_current : bool; distance : i32; health_percent : i32 }

:= evolved_against_cyclops () : thresholds = { heal_below = 124; strike_above = 23 }

:== adaptive = { heal_base : i32; heal_per_attacker : i32; strike_above : i32; retreat_at : i32 }

:= thresholds_of (a : adaptive) (attackers : i32) : thresholds =
    { heal_below = a.heal_base + a.heal_per_attacker * attackers; strike_above = a.strike_above }

:= never_retreat () : i32 = 99

:= fixed (t : thresholds) : adaptive =
    { heal_base = t.heal_below; heal_per_attacker = 0; strike_above = t.strike_above; retreat_at = never_retreat () }

:= retreats (a : adaptive) (attackers : i32) : bool = attackers >= a.retreat_at

:| temperament =
    | Stands
    | Flees

:== by_temperament a = { standing : a; fleeing : a }

:== temperate = { heal_base : i32; heal_per : by_temperament i32; strike_above : i32; retreat_at : by_temperament i32 }

:= temperate_thresholds (r : temperate) (crowd : by_temperament i32) : thresholds =
    {
        heal_below = r.heal_base + r.heal_per.standing * crowd.standing + r.heal_per.fleeing * crowd.fleeing
        strike_above = r.strike_above
    }

:= temperate_retreats (r : temperate) (crowd : by_temperament i32) : bool =
    crowd.standing >= r.retreat_at.standing || crowd.fleeing >= r.retreat_at.fleeing

:= heals (t : thresholds) (o : observation) : bool =
    o.heal_ready && o.health < t.heal_below

:= engages (t : thresholds) (o : observation) : engagement =
    ?= o.target ?|
    | InReach => ? o.strike_ready && o.health >= t.strike_above ?> Strike |: Hold
    | OutOfReach => ? o.health >= t.strike_above ?> Approach |: Hold
    | NoTarget => Hold

:= in_reach (c : candidate) : bool = c.distance <= 1

:== aim = { current : i32; reach : i32; health : i32; distance : i32 }

:| targeting =
    | ReachFirst
    | CurrentFirst
    | Scored : aim

:= weaker_or_nearer (a : candidate) (b : candidate) : bool =
    ? a.health_percent <> b.health_percent ?> a.health_percent < b.health_percent
    |: a.distance < b.distance

:= aim_score (w : aim) (c : candidate) : i32 =
    ? c.is_current
    ?> w.current
    |: 0
    + (? in_reach c ?> w.reach |: 0)
    + w.health * c.health_percent / 100
    + w.distance * c.distance

:= prefers_by (order : targeting) (a : candidate) (b : candidate) : bool =
    ?= order ?|
    | ReachFirst =>
        ? in_reach a <> in_reach b ?> in_reach a
        |? a.is_current <> b.is_current ?> a.is_current
        |: weaker_or_nearer a b
    | CurrentFirst =>
        ? a.is_current <> b.is_current ?> a.is_current
        |? in_reach a <> in_reach b ?> in_reach a
        |: weaker_or_nearer a b
    | Scored w =>
        := sa = aim_score w a
        := sb = aim_score w b
        ? sa <> sb ?> sa > sb |: weaker_or_nearer a b

:= prefers (a : candidate) (b : candidate) : bool = prefers_by ReachFirst a b

:= engagement_code (e : engagement) : i32 =
    ?= e ?|
    | Strike => 1
    | Approach => 2
    | Hold => 0

///> c
///> lua
test heals_only_below_threshold_when_ready =
    := ~health = 100i32
    := t = evolved_against_cyclops ()
    heals t { health = health; heal_ready = !+; strike_ready = !+; target = InReach } |> _assert_eq !+
    heals t { health = health; heal_ready = !-; strike_ready = !+; target = InReach } |> _assert_eq !-
    heals t { health = health + 24; heal_ready = !+; strike_ready = !+; target = InReach } |> _assert_eq !-

///> c
///> lua
test strikes_only_in_reach_ready_and_healthy_enough =
    := ~health = 23i32
    := t = evolved_against_cyclops ()
    engagement_code (engages t { health = health; heal_ready = !+; strike_ready = !+; target = InReach })
    |> _assert_eq 1i32
    engagement_code (engages t { health = health - 1; heal_ready = !+; strike_ready = !+; target = InReach })
    |> _assert_eq 0i32
    engagement_code (engages t { health = health; heal_ready = !+; strike_ready = !-; target = InReach })
    |> _assert_eq 0i32
    engagement_code (engages t { health = health; heal_ready = !+; strike_ready = !+; target = OutOfReach })
    |> _assert_eq 2i32
    engagement_code (engages t { health = health - 1; heal_ready = !+; strike_ready = !+; target = OutOfReach })
    |> _assert_eq 0i32
    engagement_code (engages t { health = health; heal_ready = !+; strike_ready = !+; target = NoTarget })
    |> _assert_eq 0i32

///> c
test strike_is_not_a_bool fails "Unification failure" =
    engages (evolved_against_cyclops ()) { health = 50; heal_ready = !+; strike_ready = !+; target = InReach }
    |> _assert_eq !+

///> c
///> lua
test prefers_reach_then_current_then_weakest_then_nearest =
    := ~far = 3i32
    prefers { is_current = !-; distance = 1; health_percent = 90 } {
        is_current = !+
        distance = far
        health_percent = 10
    }
    |> _assert_eq !+
    prefers { is_current = !+; distance = 1; health_percent = 90 } {
        is_current = !-
        distance = 1
        health_percent = 10
    }
    |> _assert_eq !+
    prefers { is_current = !-; distance = 1; health_percent = 40 } {
        is_current = !-
        distance = 1
        health_percent = 60
    }
    |> _assert_eq !+
    prefers { is_current = !-; distance = far; health_percent = 50 } {
        is_current = !-
        distance = far - 1
        health_percent = 50
    }
    |> _assert_eq !-

///> wgsl
test decisions_on_gpu =
    := ~health = 23i32
    := t = evolved_against_cyclops ()
    := strike =
        engagement_code (engages t { health = health; heal_ready = !+; strike_ready = !+; target = InReach })
    := approach =
        engagement_code (engages t { health = health; heal_ready = !+; strike_ready = !+; target = OutOfReach })
    ?
        strike = 1i32
        && approach = 2i32
        && heals t { health = health; heal_ready = !+; strike_ready = !+; target = InReach }
    ?> 0i32
    |: 1i32

///> c
///> lua
test current_first_keeps_a_fleeing_target =
    := ~far = 4i32
    := fleeing = { is_current = !+; distance = far; health_percent = 20 }
    := fresh = { is_current = !-; distance = 1; health_percent = 100 }
    prefers_by CurrentFirst fleeing fresh |> _assert_eq !+
    prefers_by ReachFirst fleeing fresh |> _assert_eq !-

///> c
test adaptive_healing_rises_with_attackers =
    := ~attackers = 3i32
    := a = { heal_base = 60; heal_per_attacker = 25; strike_above = 10; retreat_at = 2 }
    retreats a attackers |> _assert_eq !+
    retreats (fixed (evolved_against_cyclops ())) attackers |> _assert_eq !-
    (thresholds_of a attackers).heal_below |> _assert_eq 135i32
    (thresholds_of a 0).heal_below |> _assert_eq 60i32
    (thresholds_of (fixed (evolved_against_cyclops ())) attackers).heal_below |> _assert_eq 124i32

///> c
test temperate_rules_count_standing_and_fleeing_attackers_apart =
    := ~standing = 1i32
    := r =
        {
            heal_base = 40
            heal_per = { standing = 100; fleeing = 5 }
            strike_above = 0
            retreat_at = { standing = 2; fleeing = never_retreat () }
        }
    := one_cyclops_two_trolls = { standing = standing; fleeing = 2 }
    := three_trolls = { standing = standing - 1; fleeing = 3 }
    := two_cyclops = { standing = standing + 1; fleeing = 0 }
    (
        (temperate_thresholds r one_cyclops_two_trolls).heal_below,
        (temperate_thresholds r three_trolls).heal_below,
        temperate_retreats r one_cyclops_two_trolls,
        temperate_retreats r three_trolls,
        temperate_retreats r two_cyclops
    )
    |> _assert_eq (150i32, 55i32, !-, !-, !+)

///> c
test a_scored_aim_can_express_reach_first =
    := ~d = 1i32
    := reachlike = Scored { current = 50; reach = 100; health = 0; distance = 0 }
    := near = { is_current = !-; distance = d; health_percent = 90 }
    := far_current = { is_current = !+; distance = d + 2; health_percent = 40 }
    (
        prefers_by reachlike near far_current,
        prefers_by ReachFirst near far_current,
        prefers_by CurrentFirst near far_current
    )
    |> _assert_eq (!+, !+, !-)
