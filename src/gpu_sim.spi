///- --package . --timeout 900000
test gpu_sim static =
    :< testing

///> c
test ten_ticks_of_a_troll_pack_on_the_oracle =
    :< hunting_pack
    :< creatures
    := ~seed = 7u32
    :~ ^ run (tick : i32) (p : pack) : pack =
        ? tick >= 10
        ?> p
        |: run (tick + 1) (advance (uniform_camp Troll) (cavebot (:< policy ;; ReachFirst)) seed tick p)
    := p = run 0 (start (uniform_camp Troll))
    (quantity.value_of p.hunter.health, (slot 0 p).at.x, (slot 0 p).at.y, p.kills)
    |> _assert_eq (185i32, 105i32, 102i32, 0i32)

///> wgsl
test ten_ticks_of_a_troll_pack_on_gpu =
    :< hunting_pack
    :< creatures
    := ~seed = 7u32
    :~ ^ run (tick : i32) (p : pack) : pack =
        ? tick >= 10
        ?> p
        |: run (tick + 1) (advance (uniform_camp Troll) (cavebot (:< policy ;; ReachFirst)) seed tick p)
    := p = run 0 (start (uniform_camp Troll))
    ?
        quantity.value_of p.hunter.health = 185i32
        && (slot 0 p).at.x = 105i32
        && (slot 0 p).at.y = 102i32
        && p.kills = 0i32
    ?> 0i32
    |: 1i32

///> c
test a_full_troll_hunt_and_five_cyclops_clears_on_the_oracle =
    :< hunting_pack
    :< creatures
    := ~seed = 7u32
    := hunt = simulate (uniform_camp Troll) (cavebot (:< policy ;; ReachFirst)) seed (scenario_ticks ())
    := spot = uniform_camp Cyclops |> on_layout (:< terrain ;; ArenaSpot)
    := clears = clear_ledger_of spot (cavebot_with_heal 160) (seed + 994u32) 5
    (hunt.kills, hunt.escapes, hunt.deaths, clears.clear_potions, clears.clear_deaths, clears.clear_ms)
    |> _assert_eq (6i32, 18i32, 0i32, 84i32, 0i32, 453000i32)

///> wgsl
test a_full_troll_hunt_and_five_cyclops_clears_on_gpu =
    :< hunting_pack
    :< creatures
    := ~seed = 7u32
    := hunt = simulate (uniform_camp Troll) (cavebot (:< policy ;; ReachFirst)) seed (scenario_ticks ())
    := spot = uniform_camp Cyclops |> on_layout (:< terrain ;; ArenaSpot)
    := clears = clear_ledger_of spot (cavebot_with_heal 160) (seed + 994u32) 5
    ?
        hunt.kills = 6i32
        && hunt.escapes = 18i32
        && hunt.deaths = 0i32
        && clears.clear_potions = 84i32
        && clears.clear_deaths = 0i32
        && clears.clear_ms = 453000i32
    ?> 0i32
    |: 1i32

///> c
test a_hunting_ground_hunt_with_routing_on_the_oracle =
    :< hunting_pack
    := ~seed = 1001u32
    := p = simulate (arena_hunt ()) (cavebot_with_heal 110 |> sweeping_spawns) seed (scenario_ticks ())
    (p.kills, p.experience, p.hunter.potions, p.deaths) |> _assert_eq (23i32, 1370i32, 24i32, 0i32)

///> wgsl
test a_hunting_ground_hunt_with_routing_on_gpu =
    :< hunting_pack
    := ~seed = 1001u32
    := p = simulate (arena_hunt ()) (cavebot_with_heal 110 |> sweeping_spawns) seed (scenario_ticks ())
    ? p.kills = 23i32 && p.experience = 1370i32 && p.hunter.potions = 24i32 && p.deaths = 0i32 ?> 0i32 |: 1i32
