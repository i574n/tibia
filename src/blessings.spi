///- --package .
test blessings static =
    :< testing

:| death_cover =
    | Unprotected : i32
    | AmuletOfLoss
    | Skulled

:| carried =
    | ContainerItem
    | EquippedItem

:= item_loss_percent (blessings : i32) : i32 =
    ? blessings <= 0
    ?> 100
    |? blessings = 1
    ?> 70
    |? blessings = 2
    ?> 45
    |? blessings = 3
    ?> 25
    |? blessings = 4
    ?> 10
    |: 0

:= roll_scale () : i32 = 10000

:= dropped (cover : death_cover) (item : carried) (roll : i32) : bool =
    ?= cover ?|
    | Skulled => !+
    | AmuletOfLoss => !-
    | Unprotected blessings =>
        := chance = item_loss_percent blessings * 100
        := item_chance = ?= item ?| | ContainerItem => chance | EquippedItem => chance / 10
        roll <= item_chance

:= drops_over_every_roll (cover : death_cover) (item : carried) : i32 =
    :~ ^ count (roll : i32) (total : i32) : i32 =
        ? roll > roll_scale () ?> total |: count (roll + 1) (? dropped cover item roll ?> total + 1 |: total)
    count 1 0

///> c
test an_unblessed_knight_always_drops_the_backpack_and_each_other_item_one_time_in_ten =
    := ~bless = 0i32
    (drops_over_every_roll (Unprotected bless) ContainerItem, drops_over_every_roll (Unprotected bless) EquippedItem)
    |> _assert_eq (10000i32, 1000i32)

///> c
test blessings_amulet_of_loss_and_skulls_follow_canary_blessing_lua =
    := ~one = 1i32
    (
        drops_over_every_roll (Unprotected one) ContainerItem,
        drops_over_every_roll (Unprotected one) EquippedItem,
        drops_over_every_roll (Unprotected (one + 3)) EquippedItem,
        drops_over_every_roll (Unprotected (one + 4)) ContainerItem,
        drops_over_every_roll AmuletOfLoss ContainerItem,
        drops_over_every_roll Skulled EquippedItem
    )
    |> _assert_eq (7000i32, 700i32, 100i32, 0i32, 0i32, 10000i32)

///> wgsl
test unblessed_drops_on_gpu =
    := ~roll = 1000i32
    ?
        dropped (Unprotected 0) EquippedItem roll
        && dropped (Unprotected 0) EquippedItem (roll + 1) = !-
        && dropped (Unprotected 0) ContainerItem 10000
    ?> 0i32
    |: 1i32
