///- --package .
test hunting_pack static =
    :< testing

:= tick_ms () : i32 = 100
:= band_size () : i32 = 6
:= scenario_ticks () : i32 = 3000
:= escape_distance () : i32 = 8
:= sight_range () : i32 = 7
:= knight_max_health (level : i32) : i32 = 185 + 15 * (level - 8)
:= training_first () : u32 = 1
:= training_count () : i32 = 100
:= held_out_first () : u32 = 1001
:= resampled_first (block : i32) (generation : i32) : u32 = 10001u32 + conv (generation * block)
:= held_out_count () : i32 = 100
:= creature_strike_ms () : i32 = 2000
:= chase_step_factor () : i32 = 1
:= knight_sample_step_ms () : i32 = 650
:= parity_action_gap_ms () : i32 = 250
:= client_decision_ms () : i32 = 100
:= death_penalty () : i32 = 50
:= death_experience_penalty () : i32 = 5000

:= purpose_player_hit () : u32 = 11
:= purpose_player_heal () : u32 = 12
:= purpose_creature_hit () : u32 = 13
:= purpose_loot () : u32 = 14
:= purpose_random_control () : u32 = 15
:= purpose_wander () : u32 = 16
:= purpose_creature_shot () : u32 = 17
:= purpose_dance () : u32 = 18
:= purpose_poll () : u32 = 19

:= purpose_entry () : u32 = 20
:= client_lag_ms () : i32 = 8

:= target_nearby_step_factor () : i32 = 2
:= canary_static_attack_chance () : i32 = 90

:== foe =
    {
        at : geometry.position
        spawn : geometry.position
        life : vitality.vitality vitality.alive
        strikes_at : i32
        next_step_at : i32
        met_target : bool
        returns_at : i32
        check_until : i32
        nearby : i32
        acquired_at : i32
        aims_at : i32
        entrant : i32
        in_view : i32
        damage_first : i32
        damage_second : i32
        retarget_at : i32
        last_x : i32
        last_y : i32
    }

:== hunter =
    {
        at : geometry.position
        health : quantity.amount quantity.hitpoints
        next_step_at : i32
        timers : cooldowns.timers
        target : i32
        potions : i32
        block_charges : i32
        next_charge_at : i32
        next_action_at : quantity.amount quantity.milliseconds
        next_decision_at : i32
        hits_taken : i32
        damage_taken : quantity.amount quantity.hitpoints
        waypoint : i32
        retreats : i32
        cornered : i32
        call_sign : i32
    }

:== pack =
    {
        hunter : hunter
        ally : hunter
        ally_in_world : bool
        foes : views.band foe
        kills : i32
        experience : i32
        escapes : i32
        deaths : i32
        gold : quantity.amount quantity.gold_coins
    }

:= with_hunter (h : hunter) (p : pack) : pack = { p ?| hunter = h }

:= with_ally (h : hunter) (p : pack) : pack = { p ?| ally = h }

:= now_in_world (p : pack) : pack = { p ?| ally_in_world = !+ }

:= turned (p : pack) : pack = { p ?| hunter = p.ally; ally = p.hunter }

:= party_potions (p : pack) : i32 = p.hunter.potions + p.ally.potions

:| brain =
    | Rules : policy.adaptive
    | Network : network.weights
    | Temperate : policy.temperate
    | RandomControl

:| footing_rule =
    | StepAway
    | StepAwayLikeTheLiveProbe
    | ScoredStep : terrain.footing

:== patrol_route = { points : views.band geometry.position; count : i32 }

:| patrol =
    | Stays
    | Patrols : patrol_route
    | SweepsSpawns
    | SweepsTerritory : i32

:== tactic = { brain : brain; order : policy.targeting; footing : footing_rule; patrol : patrol }

:== offense = { level : i32; weapon_attack : i32; weapon_skill : i32; step_ms : i32; heal_low : i32; heal_high : i32 }

:= offense_against (kind : creatures.arena_creature) : offense =
    :< creatures
    ?= kind ?|
    | Cyclops =>
        {
            level = 30
            weapon_attack = 21
            weapon_skill = 60
            step_ms = knight_sample_step_ms ()
            heal_low = 125
            heal_high = 175
        }
    | Hunter =>
        {
            level = 30
            weapon_attack = 21
            weapon_skill = 60
            step_ms = knight_sample_step_ms ()
            heal_low = 125
            heal_high = 175
        }
    | _ =>
        {
            level = 8
            weapon_attack = 20
            weapon_skill = 30
            step_ms = knight_sample_step_ms ()
            heal_low = 30
            heal_high = 60
        }

:= never () : i32 = 2147483647

:= fresh_foe (kind : creatures.arena_creature) (spawn : geometry.position) : foe =
    {
        at = spawn
        spawn = spawn
        life = vitality.spawn (creatures.stats_of kind).max_health
        strikes_at = 0
        next_step_at = 0
        met_target = !-
        returns_at = never ()
        check_until = 0
        nearby = 0
        acquired_at = never ()
        aims_at = -1
        entrant = 0
        in_view = 0
        damage_first = 0
        damage_second = 0
        retarget_at = 0
        last_x = -1
        last_y = -1
    }

:= buried_foe (kind : creatures.arena_creature) : foe =
    := grave = fresh_foe kind (geometry.position 0 0 15)
    { grave ?| strikes_at = never (); next_step_at = never () }

:| respawn_rule =
    | Respawning
    | Clearing
    | RespawningAfter : i32

:| swing_after_step =
    | SwingKeepsItsTime
    | SwingWaitsForThinkOrMove

:| idle_behavior =
    | StandsStill
    | WandersLikeCanary

:| knight_placement =
    | AtLayoutStart
    | StandsAt : geometry.position

:| melee_timing =
    | MeleeWhenReady
    | MeleeWhenReadyEvery : i32
    | MeleeEveryOnceTargeted : i32
    | MeleeOnCanaryRounds : i32

:| follow_timing =
    | FollowsAtOnce
    | FollowsOnThink

:| knight_pace =
    | SamplePace
    | PacedLikeCanary

:| dance_rule =
    | NeverDances
    | DancesLikeCanary

:| knight_view =
    | SeesThisTick
    | SeesLastTick
    | SeesAtItsPoll

:| ground_timing =
    | ScaledFromGrass
    | SteppedByCanaryFormula

:| acquisition_rule =
    | ChasesAtOnce
    | ChasesAThinkAfterAcquiring

:| approach_rule =
    | ApproachesAtOnce
    | ApproachesAfterAFreshWalkDelay

:| sight_rule =
    | SightStopsAtUnpassableTiles
    | SightStopsAtProjectileBlockers

:| chase_pace =
    | ChasesAtTheServerPace
    | ChasesAtTheProbePace

:| retreat_pace =
    | RetreatsAtTheServerPace
    | RetreatsAtTheProbePace

:| ally_entry =
    | EntersWithTheKnight
    | EntersAfterMeasuredDelay

:== camp =
    {
        kinds : views.band creatures.arena_creature
        size : i32
        hunter_level : i32
        rule : respawn_rule
        layout : terrain.layout
        potion_budget : i32
        party : i32
        ally_enters : ally_entry
        party_targeting : bool
        wakes_at : i32
        swing : swing_after_step
        melee : melee_timing
        idle : idle_behavior
        follow : follow_timing
        pace : knight_pace
        dance : dance_rule
        view : knight_view
        ground : ground_timing
        acquisition : acquisition_rule
        approach : approach_rule
        sight : sight_rule
        retreat_pace : retreat_pace
        chase_pace : chase_pace
        placement : knight_placement
        ranged : bool
    }

:= unlimited_potions () : i32 = 1000000

:= hardest_kind (kinds : views.band creatures.arena_creature) (size : i32) : creatures.arena_creature =
    := harder (a : creatures.arena_creature) (b : creatures.arena_creature) =
        ? (offense_against b).level > (offense_against a).level
        ?> b
        |: a
    :~ ^ pick (i : i32) (best : creatures.arena_creature) : creatures.arena_creature =
        ? i >= size
        ?> best
        |: pick (i + 1) (harder best (views.band_at i kinds))
    pick 1 (views.band_at 0 kinds)

:= default_hunter_level (kinds : views.band creatures.arena_creature) (size : i32) : i32 =
    (offense_against (hardest_kind kinds size)).level

:= uniform_camp (kind : creatures.arena_creature) : camp =
    {
        kinds = views.band_of kind
        size = 3
        hunter_level = default_hunter_level (views.band_of kind) 3
        rule = Respawning
        layout =
            :< terrain
            OpenField
        potion_budget = unlimited_potions ()
        party = 1
        ally_enters = EntersWithTheKnight
        party_targeting = !-
        wakes_at = 0
        swing = SwingKeepsItsTime
        melee = MeleeWhenReady
        idle = StandsStill
        follow = FollowsAtOnce
        pace = SamplePace
        dance = NeverDances
        view = SeesThisTick
        ground = ScaledFromGrass
        acquisition = ChasesAtOnce
        approach = ApproachesAtOnce
        sight = SightStopsAtUnpassableTiles
        retreat_pace = RetreatsAtTheServerPace
        chase_pace = ChasesAtTheServerPace
        placement = AtLayoutStart
        ranged = creatures.is_ranged kind
    }

:= with_hunter_level (level : i32) (c : camp) : camp = { c ?| hunter_level = level }

:= with_potion_budget (count : i32) (c : camp) : camp = { c ?| potion_budget = count }

:= with_party (knights : i32) (c : camp) : camp = { c ?| party = knights }

:= with_delayed_ally_entry (c : camp) : camp = { c ?| ally_enters = EntersAfterMeasuredDelay }

:= ally_enters_with_the_knight (c : camp) : bool =
    ?= c.ally_enters ?|
    | EntersWithTheKnight => !+
    | EntersAfterMeasuredDelay => !-

:= ally_starts_in_world (c : camp) : bool = c.party > 1 && ally_enters_with_the_knight c

:= targeting_like_canary (c : camp) : camp = { c ?| party_targeting = !+ }

:= waking_at (ms : i32) (c : camp) : camp = { c ?| wakes_at = ms }

:= live_wake_ms () : i32 = 10000

:= swinging_like_canary (c : camp) : camp = { c ?| swing = SwingWaitsForThinkOrMove }

:= wandering_while_idle (c : camp) : camp = { c ?| idle = WandersLikeCanary }

:= knight_standing_at (at : geometry.position) (c : camp) : camp = { c ?| placement = StandsAt at }

:= live_creature_strike_ms () : i32 = 2166

:= meleeing_every (ms : i32) (c : camp) : camp = { c ?| melee = MeleeWhenReadyEvery ms }

:= meleeing_every_once_targeted (ms : i32) (c : camp) : camp = { c ?| melee = MeleeEveryOnceTargeted ms }

:= mirroring_the_live_arena (c : camp) : camp =
    c
    |> waking_at (live_wake_ms ())
    |> wandering_while_idle
    |> meleeing_every_once_targeted (live_creature_strike_ms ())
    |> swinging_like_canary

:= following_on_think (c : camp) : camp = { c ?| follow = FollowsOnThink }

:= meleeing_on_canary_rounds (ms : i32) (c : camp) : camp = { c ?| melee = MeleeOnCanaryRounds ms }

:= paced_like_canary (c : camp) : camp = { c ?| pace = PacedLikeCanary }

:= dancing_like_canary (c : camp) : camp = { c ?| dance = DancesLikeCanary }

:= seeing_a_tick_late (c : camp) : camp = { c ?| view = SeesLastTick }

:= seeing_at_its_poll (c : camp) : camp = { c ?| view = SeesAtItsPoll }

:= stepping_by_canary_formula (c : camp) : camp = { c ?| ground = SteppedByCanaryFormula }

:= acquiring_like_canary (c : camp) : camp = { c ?| acquisition = ChasesAThinkAfterAcquiring }

:= following_like_canary (c : camp) : camp = { c ?| approach = ApproachesAfterAFreshWalkDelay }

:= sighting_like_canary (c : camp) : camp = { c ?| sight = SightStopsAtProjectileBlockers }

:= live_probe_step_ms () : i32 = 650
:= live_chase_step_ms () : i32 = 558
:= chasing_at_the_live_probe_pace (c : camp) : camp = { c ?| chase_pace = ChasesAtTheProbePace }

:= pacing_retreats_like_the_live_probe (c : camp) : camp = { c ?| retreat_pace = RetreatsAtTheProbePace }

:= blocks_sight (camp : camp) (p : geometry.position) : bool =
    ?= camp.sight ?|
    | SightStopsAtUnpassableTiles => terrain.walls camp.layout p
    | SightStopsAtProjectileBlockers => terrain.sight_blocks camp.layout p

:= mirroring_the_current_arena (c : camp) : camp =
    c
    |> mirroring_the_live_arena
    |> waking_at 0
    |> following_on_think
    |> meleeing_on_canary_rounds (live_creature_strike_ms ())
    |> paced_like_canary
    |> dancing_like_canary
    |> seeing_at_its_poll
    |> stepping_by_canary_formula
    |> acquiring_like_canary
    |> following_like_canary
    |> sighting_like_canary
    |> pacing_retreats_like_the_live_probe

:= canary_spawn_check_ms () : i32 = 30000

:= canary_unblockable_spawn_delay_ms () : i32 = 3 * 1400

:~ ^ greatest_common_divisor (a : i32) (b : i32) : i32 = ? b = 0 ?> a |: greatest_common_divisor b (a % b)

:= canary_respawn_ms (spawntime_ms : i32) : i32 =
    := check = greatest_common_divisor (canary_spawn_check_ms ()) spawntime_ms
    (1 + (spawntime_ms + check - 1) / check) * check + canary_unblockable_spawn_delay_ms ()

:= respawning_like_canary (spawntime_ms : i32) (c : camp) : camp =
    { c ?| rule = RespawningAfter (canary_respawn_ms spawntime_ms) }

:= player_think_ms () : i32 = 1000

:= live_think_period_ms () : i32 = live_creature_strike_ms () / 2

:= next_think_at (ms : i32) : i32 =
    (ms + live_think_period_ms () - 1) / live_think_period_ms () * live_think_period_ms ()

:= swing_is_waiting (held : cooldowns.timers) : bool = held.strike_ready_at > held.attack_ready_at

:= swing_resumes_at (now : i32) (held : cooldowns.timers) : cooldowns.timers =
    ? swing_is_waiting held && now >= held.attack_ready_at ?> { held ?| strike_ready_at = now } |: held

:= swing_after_step (camp : camp) (now : i32) (held : cooldowns.timers) : cooldowns.timers =
    ?= camp.swing ?|
    | SwingKeepsItsTime => held
    | SwingWaitsForThinkOrMove =>
        := due = cooldowns.ready_at (cooldowns.strike_spell ()) held
        ? swing_is_waiting held ?> swing_resumes_at now held
        |? due <= now ?> held
        |: { held ?| attack_ready_at = due; strike_ready_at = next_think_at due }

:= swing_after_target_moves (camp : camp) (now : i32) (held : cooldowns.timers) : cooldowns.timers =
    ?= camp.swing ?|
    | SwingKeepsItsTime => held
    | SwingWaitsForThinkOrMove => swing_resumes_at now held

:= clearing (c : camp) : camp = { c ?| rule = Clearing }

:= on_layout (l : terrain.layout) (c : camp) : camp = { c ?| layout = l }

:= spawns_of (c : camp) : geometry.position * geometry.position * geometry.position =
    ?= c.rule, c.layout ?|
    | Clearing, OpenField => geometry.position 100 102 7, geometry.position 99 103 7, geometry.position 99 104 7
    | _ => terrain.spawn_points c.layout

:= camp_of_entries (entries : catalog.entry * catalog.entry * catalog.entry) : camp =
    := a, b, c = entries
    := first, second, third = catalog.entry_creature a, catalog.entry_creature b, catalog.entry_creature c
    {
        kinds = views.band (first, second, third, first, first, first)
        size = 3
        hunter_level = default_hunter_level (views.band (first, second, third, first, first, first)) 3
        rule = Respawning
        layout =
            :< terrain
            OpenField
        potion_budget = unlimited_potions ()
        party = 1
        ally_enters = EntersWithTheKnight
        party_targeting = !-
        wakes_at = 0
        swing = SwingKeepsItsTime
        melee = MeleeWhenReady
        idle = StandsStill
        follow = FollowsAtOnce
        pace = SamplePace
        dance = NeverDances
        view = SeesThisTick
        ground = ScaledFromGrass
        acquisition = ChasesAtOnce
        approach = ApproachesAtOnce
        sight = SightStopsAtUnpassableTiles
        retreat_pace = RetreatsAtTheServerPace
        chase_pace = ChasesAtTheServerPace
        placement = AtLayoutStart
        ranged = creatures.is_ranged first || creatures.is_ranged second || creatures.is_ranged third
    }

:= hunter_of (c : camp) : offense =
    := base = offense_against (hardest_kind c.kinds c.size)
    := step_ms =
        ?= c.pace ?|
        | SamplePace => base.step_ms
        | PacedLikeCanary => creatures.player_step_ms c.hunter_level
    { base ?| level = c.hunter_level; step_ms = step_ms }

:= step_ms_at (camp : camp) (at : geometry.position) (speed : i32) (grass_step_ms : i32) : i32 =
    ?= camp.ground ?|
    | ScaledFromGrass => terrain.on_ground_at camp.layout at grass_step_ms
    | SteppedByCanaryFormula => creatures.step_ms_from_canary_formula speed (terrain.ground_speed_at camp.layout at)

:= hunter_step_ms_at (camp : camp) (at : geometry.position) : i32 =
    step_ms_at camp at (creatures.knight_speed camp.hunter_level) (hunter_of camp).step_ms

:= retreat_step_ms_at (camp : camp) (at : geometry.position) : i32 =
    := server = hunter_step_ms_at camp at
    ?= camp.retreat_pace ?|
    | RetreatsAtTheServerPace => server
    | RetreatsAtTheProbePace => ? server > live_probe_step_ms () ?> server |: live_probe_step_ms ()

:= player_max_health (c : camp) : quantity.amount quantity.hitpoints =
    quantity.hp (knight_max_health (hunter_of c).level)

:= kind_of (index : i32) (c : camp) : creatures.arena_creature =
    views.band_at index c.kinds

:= knight_start (camp : camp) (sign : i32) : geometry.position =
    := first = ?= camp.placement ?| AtLayoutStart => terrain.player_start camp.layout | StandsAt at => at
    ? sign = 0 ?> first |: geometry.position (first.x + 1) first.y first.z

:~ start (camp : camp) : pack =
    := a, b, c = spawns_of camp
    := d, e, g = terrain.more_spawn_points camp.layout
    := placed (i : i32) (at : geometry.position) : foe =
        ? i < camp.size
        ?> fresh_foe (kind_of i camp) at
        |: buried_foe (kind_of i camp)
    := knight (sign : i32) : hunter =
        {
            at = knight_start camp sign
            health = player_max_health camp
            next_step_at = 0
            timers = cooldowns.idle_timers ()
            target = -1
            potions = 0
            block_charges = combat.max_block_charges ()
            next_charge_at = combat.block_charge_ms ()
            next_action_at = quantity.ms 0
            next_decision_at = 0
            hits_taken = 0
            damage_taken = quantity.hp 0
            waypoint = 0
            retreats = 0
            cornered = 0
            call_sign = sign
        }
    := second = knight 1
    {
        hunter = knight 0
        ally = ? ally_starts_in_world camp ?> second |: { second ?| at = terrain.grave () }
        ally_in_world = ally_starts_in_world camp
        foes = views.band (placed 0 a, placed 1 b, placed 2 c, placed 3 d, placed 4 e, placed 5 g)
        kills = 0
        experience = 0
        escapes = 0
        deaths = 0
        gold = quantity.gp 0
    }

:= slot (index : i32) (p : pack) : foe =
    views.band_at index p.foes

:= with_slot (index : i32) (f : foe) (p : pack) : pack =
    { p ?| foes = views.band_with index f p.foes }

:= taken_by_others (index : i32) (p : pack) (q : geometry.position) : bool =
    :~ ^ other (i : i32) : bool =
        ? i >= band_size ()
        ?> !-
        |? i <> index && geometry.same_tile q (slot i p).at
        ?> !+
        |: other (i + 1)
    geometry.same_tile q p.hunter.at || geometry.same_tile q p.ally.at || other 0

:= taken_by_foes (p : pack) (q : geometry.position) : bool =
    views.counted (\ (f : foe) => geometry.same_tile q f.at) p.foes > 0 || geometry.same_tile q p.ally.at

:= key (seed : u32) (tick : i32) (entity : i32) (purpose : u32) : rng.roll_key =
    rng.roll_key seed (conv tick) (conv entity) purpose

:= distance_to (f : foe) (p : pack) : i32 = geometry.chebyshev_distance p.hunter.at f.at

:= creature_hits_hunter (camp : camp) (seed : u32) (tick : i32) (index : i32) (struck : foe) (p : pack) : pack =
    := stats = creatures.stats_of (kind_of index camp)
    := h = p.hunter
    := shielded = h.block_charges > 0
    := hurt =
        combat.creature_hit stats.melee_max
            (combat.knight_sample_gear ())
            shielded
            (key seed tick index (purpose_creature_hit ()))
    with_slot index struck (
        p
        |> with_hunter { h ?|
            health = quantity.minus h.health (quantity.hp hurt)
            block_charges =
                ? shielded
                ?> h.block_charges - 1
                |: h.block_charges
            hits_taken =
                ? hurt > 0
                ?> h.hits_taken + 1
                |: h.hits_taken
            damage_taken = quantity.plus h.damage_taken (quantity.hp hurt)
        }
    )

:= hunter_takes_arrow (arrow : combat.ranged_attack) (seed : u32) (tick : i32) (index : i32) (p : pack) : pack =
    := h = p.hunter
    := hurt, charges =
        combat.ranged_hit_spending_a_charge arrow
            (combat.knight_sample_gear ())
            h.block_charges
            (key seed tick index (purpose_creature_shot ()))
    p
    |> with_hunter { h ?|
        health = quantity.minus h.health (quantity.hp hurt)
        block_charges = charges
        hits_taken =
            ? hurt > 0
            ?> h.hits_taken + 1
            |: h.hits_taken
        damage_taken = quantity.plus h.damage_taken (quantity.hp hurt)
    }

:= creature_shoots
    (camp : camp) (seed : u32) (tick : i32) (now : i32) (index : i32) (arrow : combat.ranged_attack) (g : foe)
    (p : pack)
    : pack
    =
    := distance = distance_to g p
    ?
        g.strikes_at > now
        || combat.ranged_in_reach arrow distance (
            geometry.sight_line_clear (blocks_sight camp) g.at p.hunter.at
           )
           = !-
    ?> p
    |:
        := timed = { g ?| strikes_at = now + arrow.every_ms }
        := meleed =
            ? distance <= 1
            ?> creature_hits_hunter camp seed tick index timed p
            |: with_slot index timed p
        ? combat.ranged_fires arrow (key seed tick (index + 100) (purpose_creature_shot ()))
        ?> hunter_takes_arrow arrow seed tick index meleed
        |: meleed

:= creature_think_phase_ms (seed : u32) (index : i32) : i32 = conv ((seed + conv index * 7u32) % 10u32) * tick_ms ()

:= thinks_now (seed : u32) (index : i32) (now : i32) : bool =
    now % player_think_ms () = creature_think_phase_ms seed index

:= cardinal_step (k : i32) (from : geometry.position) : geometry.position =
    ? k = 0
    ?> terrain.shifted 0 -1 from
    |? k = 1
    ?> terrain.shifted -1 0 from
    |? k = 2
    ?> terrain.shifted 1 0 from
    |: terrain.shifted 0 1 from

:= open_cardinal_count (free_at : i32 -> bool) : i32 =
    :~ ^ count (k : i32) (acc : i32) : i32 =
        ? k >= 4
        ?> acc
        |? free_at k
        ?> count (k + 1) (acc + 1)
        |: count (k + 1) acc
    count 0 0

:= nth_open_cardinal (free_at : i32 -> bool) (pick : i32) : i32 =
    :~ ^ nth (k : i32) (left : i32) : i32 =
        ? free_at k
        ?>
            ? left = 1
            ?> k
            |: nth (k + 1) (left - 1)
        |: nth (k + 1) left
    nth 0 pick

:= wanders (camp : camp) (seed : u32) (tick : i32) (now : i32) (index : i32) (p : pack) : pack =
    := f = slot index p
    := open_step k = terrain.free camp.layout (taken_by_others index p) (cardinal_step k f.at)
    := count_open = open_cardinal_count open_step
    ? f.next_step_at >= never () || thinks_now seed index now = !- || now < f.next_step_at || count_open = 0
    ?> p
    |:
        := pick : i32 = conv (rng.roll_between 1 (conv count_open) (key seed tick index (purpose_wander ())))
        := toward = cardinal_step (nth_open_cardinal open_step pick) f.at
        := stats = creatures.stats_of (kind_of index camp)
        with_slot index
            { f ?|
                at = toward
                next_step_at =
                    now + geometry.step_cost (step_ms_at camp f.at stats.speed stats.step_ms) f.at toward
            }
            p

:= dance_step (camp : camp) (now : i32) (index : i32) (pick_key : rng.roll_key) (p : pack) : pack =
    := f = slot index p
    := centre = p.hunter.at
    := offset_x, offset_y = f.at.x - centre.x, f.at.y - centre.y
    := reach = geometry.chebyshev_distance f.at centre
    := keeps_its_reach k =
        := q = cardinal_step k f.at
        (? k = 0 ?> offset_y >= 0 |? k = 1 ?> offset_x >= 0 |? k = 2 ?> offset_x <= 0 |: offset_y <= 0)
        && geometry.chebyshev_distance q centre = reach
        && terrain.free camp.layout (taken_by_others index p) q
        && (reach <= 1 || geometry.sees q centre)
    := count_open = open_cardinal_count keeps_its_reach
    ? count_open = 0
    ?> p
    |:
        := pick : i32 = conv (rng.roll_between 1 (conv count_open) pick_key)
        := toward = cardinal_step (nth_open_cardinal keeps_its_reach pick) f.at
        := stats = creatures.stats_of (kind_of index camp)
        := cost =
            geometry.step_cost (step_ms_at camp f.at stats.speed stats.step_ms) f.at toward
            * target_nearby_step_factor ()
        := danced = with_slot index { f ?| at = toward; next_step_at = now + cost } p
        := h = danced.hunter
        ? h.target = index
        ?> danced |> with_hunter { h ?| timers = swing_after_target_moves camp now h.timers }
        |: danced

:= dances (camp : camp) (seed : u32) (tick : i32) (now : i32) (index : i32) (p : pack) : pack =
    ?= camp.dance ?|
    | NeverDances => p
    | DancesLikeCanary =>
        ?
            thinks_now seed index now
            && rng.roll_between 1 100 (key seed tick index (purpose_dance ())) > conv (canary_static_attack_chance ())
        ?> dance_step camp now index (key seed tick (index + 200) (purpose_dance ())) p
        |: p

:= foe_turn (camp : camp) (seed : u32) (tick : i32) (now : i32) (index : i32) (p : pack) : pack =
    := kind = kind_of index camp
    := stats = creatures.stats_of kind
    := f = slot index p
    := moved =
        ? f.returns_at <= now
        ?>
            with_slot index
                { (fresh_foe kind f.spawn) ?|
                    check_until = f.returns_at - canary_unblockable_spawn_delay_ms () + canary_spawn_check_ms ()
                }
                p
        |? now < f.next_step_at
        ?> p
        |? vitality.health f.life <= stats.run_health
        ?>
            := away = terrain.step_away camp.layout (taken_by_others index p) p.hunter.at f.at
            := fled =
                { f ?|
                    at = away
                    next_step_at =
                        now + geometry.step_cost (step_ms_at camp f.at stats.speed stats.step_ms) f.at away
                }
            ? geometry.chebyshev_distance p.hunter.at fled.at >= escape_distance ()
            ?>
                := reset = with_slot index (fresh_foe kind f.spawn) p
                := h = p.hunter
                { reset ?|
                    escapes = p.escapes + 1
                    hunter = { h ?| target = ? h.target = index ?> -1 |: h.target }
                }
            |: with_slot index fled p
        |?
            camp.ranged
            && stats.target_distance > 1
            && distance_to f p <= stats.target_distance
            && geometry.sees f.at p.hunter.at
        ?>
            ? distance_to f p < stats.target_distance
            ?>
                := counted =
                    ? geometry.chebyshev_distance f.at p.hunter.at <= 1
                    ?>
                        ? f.nearby < 2
                        ?> f.nearby + 1
                        |: 2
                    |? f.nearby > 0
                    ?> f.nearby - 1
                    |: 0
                := away = terrain.step_away camp.layout (taken_by_others index p) p.hunter.at f.at
                := cost = geometry.step_cost (step_ms_at camp f.at stats.speed stats.step_ms) f.at away
                := slowed =
                    ? geometry.moved_diagonally f.at away = !- && counted >= 1
                    ?> cost * target_nearby_step_factor ()
                    |: cost
                with_slot index { f ?| at = away; met_target = !+; nearby = counted; next_step_at = now + slowed } p
            |: dances camp seed tick now index (with_slot index { f ?| met_target = !+ } p)
        |? distance_to f p <= 1
        ?> dances camp seed tick now index (with_slot index { f ?| met_target = !+ } p)
        |? geometry.sees f.at p.hunter.at = !-
        ?>
            ? f.acquired_at >= never ()
            ?> p
            |: with_slot index { f ?| acquired_at = never () } p
        |?
            (?= camp.acquisition ?|
                | ChasesAThinkAfterAcquiring => !+
                | ChasesAtOnce => !-)
            && f.acquired_at >= never ()
        ?>
            ? thinks_now seed index now
            ?>
                := first_step_at = now + player_think_ms () + step_ms_at camp f.at stats.speed stats.step_ms
                with_slot index { f ?| acquired_at = now; next_step_at = first_step_at } p
            |: p
        |? camp.ranged && stats.target_distance > 1 && thinks_now seed index now = !-
        ?> p
        |?
            (?= camp.follow ?|
                | FollowsOnThink => !+
                | FollowsAtOnce => !-)
            && now - f.next_step_at >= tick_ms ()
            && thinks_now seed index now = !-
        ?> p
        |:
            := toward = terrain.step_toward camp.layout (taken_by_others index p) p.hunter.at f.at
            := base = step_ms_at camp f.at stats.speed stats.step_ms
            := straight = ? f.met_target ?> base * chase_step_factor () |: base
            := chased =
                with_slot index { f ?| at = toward; next_step_at = now + geometry.step_cost straight f.at toward } p
            := h = chased.hunter
            ? h.target = index
            ?> chased |> with_hunter { h ?| timers = swing_after_target_moves camp now h.timers }
            |: chased
    := g = slot index moved
    ? vitality.health g.life <= stats.run_health
    ?> moved
    |? camp.ranged && creatures.is_ranged kind
    ?> creature_shoots camp seed tick now index (creatures.ranged_attack_of kind) g moved
    |:
        ?= camp.melee ?|
        | MeleeWhenReady =>
            ? distance_to g moved <= 1 && g.strikes_at <= now
            ?> creature_hits_hunter camp seed tick index { g ?| strikes_at = now + creature_strike_ms () } moved
            |: moved
        | MeleeEveryOnceTargeted period =>
            ? distance_to g moved <= 1 && g.strikes_at <= now && now >= camp.wakes_at + period ?>
                := paced = ? now - g.strikes_at < tick_ms () ?> g.strikes_at |: now
                creature_hits_hunter camp seed tick index { g ?| strikes_at = paced + period } moved
            |: moved
        | MeleeWhenReadyEvery period =>
            ? distance_to g moved <= 1 && g.strikes_at <= now ?>
                := paced = ? now - g.strikes_at < tick_ms () ?> g.strikes_at |: now
                creature_hits_hunter camp seed tick index { g ?| strikes_at = paced + period } moved
            |: moved
        | MeleeOnCanaryRounds period =>
            ? distance_to g moved <= 1 && g.strikes_at <= now && now >= camp.wakes_at + period
            ?>
                ? now - g.strikes_at < tick_ms ()
                ?> creature_hits_hunter camp seed tick index { g ?| strikes_at = g.strikes_at + period } moved
                |:
                    with_slot index
                        { g ?| strikes_at = g.strikes_at + (now - g.strikes_at + period - 1) / period * period }
                        moved
            |: moved

:= purpose_search_target () : u32 = 40
:= purpose_change_target () : u32 = 41

:= change_target_percent (kind : creatures.arena_creature) : i32 =
    ?= kind ?|
    | Cyclops => 10
    | Hunter => 10
    | _ => 0

:= damage_strategy_percent (kind : creatures.arena_creature) : i32 =
    ?= kind ?|
    | Cyclops => 30
    | _ => 0

:= aimed_by_canary (camp : camp) (seed : u32) (tick : i32) (now : i32) (index : i32) (p : pack) : foe =
    := f = slot index p
    := kind = kind_of index camp
    := sees_first = ? geometry.sees f.at p.hunter.at ?> 1 |: 0
    := sees_second = ? geometry.sees f.at p.ally.at ?> 2 |: 0
    := seen = sees_first + sees_second
    := entered_second = sees_second = 2 && (f.in_view &&& 2) = 0
    := entered_first = sees_first = 1 && (f.in_view &&& 1) = 0
    := appeared = f.last_x < 0
    := foe_moved = appeared = !- && (f.at.x <> f.last_x || f.at.y <> f.last_y)
    := sector_rank (at : geometry.position) : i32 = (at.y / 16) * 65536 + at.x / 16
    := knight_scanned_first = sector_rank p.hunter.at <= sector_rank p.ally.at
    := appended (newcomer : i32) : i32 = ? f.in_view = 0 ?> newcomer |: f.entrant
    := entrant =
        ? entered_first && entered_second ?>
            ? appeared && now < 1000 ?> 1
            |? knight_scanned_first ?> 0
            |: 1
        |? entered_second ?> (? appeared || foe_moved ?> appended 1 |: 1)
        |? entered_first ?> (? appeared || foe_moved ?> appended 0 |: 0)
        |: f.entrant
    := due = now >= f.retarget_at
    := rolled = conv (rng.roll_between 1 100 (key seed tick index (purpose_change_target ())))
    := acquiring = f.aims_at < 0
    := changing = acquiring = !- && due && rolled <= change_target_percent kind
    := next_due = ? due ?> now + 4000 |: f.retarget_at
    := strategy = conv (rng.roll_between 1 100 (key seed tick index (purpose_search_target ())))
    := other = 1 - entrant
    := other_dealt = ? other = 0 ?> f.damage_first |: f.damage_second
    := d_entrant = geometry.chebyshev_distance (? entrant = 0 ?> p.hunter.at |: p.ally.at) f.at
    := d_other = geometry.chebyshev_distance (? other = 0 ?> p.hunter.at |: p.ally.at) f.at
    := nearest = ? d_other < d_entrant ?> other |: entrant
    := melee = (creatures.stats_of kind).target_distance <= 1
    := aims_at =
        ? seen = 0 || acquiring = !- && changing = !-
        ?> f.aims_at
        |? changing && melee
        ?> (? strategy <= 50 ?> entrant |: other)
        |? changing
        ?> nearest
        |? strategy > 100 - damage_strategy_percent kind
        ?> (? other_dealt > 0 ?> other |: entrant)
        |: nearest
    { f ?|
        aims_at = aims_at
        entrant = entrant
        in_view = seen
        retarget_at = next_due
        last_x = f.at.x
        last_y = f.at.y
    }

:= ally_is_nearer (f : foe) (p : pack) : bool =
    geometry.chebyshev_distance p.ally.at f.at < geometry.chebyshev_distance p.hunter.at f.at

:= foe_acts (camp : camp) (seed : u32) (tick : i32) (now : i32) (index : i32) (p : pack) : pack =
    ? now < camp.wakes_at
    ?>
        ?= camp.idle ?|
        | StandsStill => p
        | WandersLikeCanary => wanders camp seed tick now index p
    |? camp.party > 1 && camp.party_targeting
    ?>
        := aimed = aimed_by_canary camp seed tick now index p
        := q = with_slot index aimed p
        ? aimed.aims_at = 1
        ?> turned (foe_turn camp seed tick now index (turned q))
        |: foe_turn camp seed tick now index q
    |? camp.party > 1 && ally_is_nearer (slot index p) p
    ?> turned (foe_turn camp seed tick now index (turned p))
    |: foe_turn camp seed tick now index p

:= foes_act_where (camp : camp) (seed : u32) (tick : i32) (now : i32) (picked : i32 -> bool) (p : pack) : pack =
    :~ ^ each (i : i32) (q : pack) : pack =
        ? i >= band_size ()
        ?> q
        |? picked i
        ?> each (i + 1) (foe_acts camp seed tick now i q)
        |: each (i + 1) q
    each 0 p

:= foes_act (camp : camp) (seed : u32) (tick : i32) (now : i32) (p : pack) : pack =
    :~ ^ each (i : i32) (q : pack) : pack =
        ? i >= band_size ()
        ?> q
        |: each (i + 1) (foe_acts camp seed tick now i q)
    each 0 p

:= candidate_of (index : i32) (p : pack) (camp : camp) : policy.candidate =
    := kind = kind_of index camp
    := f = slot index p
    {
        is_current = p.hunter.target = index
        distance = distance_to f p
        health_percent = vitality.health f.life * 100 / (creatures.stats_of kind).max_health
    }

:= choose_target (camp : camp) (order : policy.targeting) (p : pack) : i32 =
    := visible index = distance_to (slot index p) p <= sight_range ()
    := better (a : i32) (b : i32) : i32 =
        ? a < 0 ?> b
        |? b < 0 ?> a
        |? policy.prefers_by order (candidate_of a p camp) (candidate_of b p camp) ?> a
        |: b
    := pick index = ? visible index ?> index |: -1
    :~ ^ fold (i : i32) (best : i32) : i32 = ? i >= band_size () ?> best |: fold (i + 1) (better best (pick i))
    fold 1 (pick 0)

:= aimed_by (camp : camp) (order : policy.targeting) (p : pack) : pack =
    := h = p.hunter
    p |> with_hunter { h ?| target = choose_target camp order p }

:= observe (now : i32) (p : pack) : policy.observation =
    :< policy
    := h = p.hunter
    := reach = ? h.target < 0 ?> NoTarget |? distance_to (slot h.target p) p <= 1 ?> InReach |: OutOfReach
    {
        health = quantity.value_of h.health
        heal_ready = cooldowns.can_cast now (vocations.as_cooldown (vocations.knight_heal ())) h.timers
        strike_ready = cooldowns.can_cast now (cooldowns.strike_spell ()) h.timers
        target = reach
    }

:= player_heals
    (camp : camp) (seed : u32) (tick : i32) (slot : readiness.ready readiness.action_slot) (p : pack)
    : pack
    =
    := now = quantity.value_of (readiness.since slot)
    := offense = hunter_of camp
    := amount : i32 =
        conv (
            rng.roll_between
                (conv offense.heal_low)
                (conv offense.heal_high)
                (key seed tick (99 + 100 * p.hunter.call_sign) (purpose_player_heal ()))
        )
    := h = p.hunter
    p
    |> with_hunter { h ?|
        health = quantity.capped (player_max_health camp) (quantity.plus h.health (quantity.hp amount))
        timers = cooldowns.after_cast now (vocations.as_cooldown (vocations.knight_heal ())) h.timers
        potions = h.potions + 1
        next_action_at = quantity.plus (readiness.since slot) (quantity.ms (parity_action_gap_ms ()))
    }

:= player_strikes
    (camp : camp) (seed : u32) (tick : i32) (proof : readiness.ready readiness.attack_group) (p : pack)
    : pack
    =
    :< vitality
    := now = quantity.value_of (readiness.since proof)
    := h = p.hunter
    := target = h.target
    := kind = kind_of target camp
    := stats = creatures.stats_of kind
    := o = hunter_of camp
    := f = slot target p
    := hit =
        combat.melee_hit
            (:< damage ;; Balanced)
            o.level
            o.weapon_attack
            o.weapon_skill
            stats.defense
            stats.armor
            (key seed tick (target + 100 * h.call_sign) (purpose_player_hit ()))
    := timed_hunter = { h ?| timers = cooldowns.after_cast now (cooldowns.strike_spell ()) h.timers }
    := timed = p |> with_hunter timed_hunter
    ?= strike hit f.life ?|
    | Survived wounded =>
        := dealt = vitality.health f.life - vitality.health wounded
        := credited =
            ? h.call_sign = 0 ?> { f ?| life = wounded; damage_first = f.damage_first + dealt }
            |: { f ?| life = wounded; damage_second = f.damage_second + dealt }
        with_slot target credited timed
    | Slain _ =>
        := awaiting = buried_foe kind
        := reset =
            with_slot target
                (
                    ?= camp.rule ?|
                    | Respawning => fresh_foe kind f.spawn
                    | Clearing => buried_foe kind
                    | RespawningAfter delay =>
                        := returns =
                            ? now < f.check_until ?> f.check_until + delay - canary_spawn_check_ms ()
                            |: now + delay
                        { awaiting ?| spawn = f.spawn; returns_at = returns }
                )
                timed
        := drop = creatures.gold_drop_of kind
        := lucky = conv (rng.roll_between 1 100000 (key seed tick target (purpose_loot ()))) <= drop.chance_per_100000
        := coins : i32 =
            ? lucky
            ?> conv (rng.roll_between 1 (conv drop.max_count) (key seed (tick + 1) target (purpose_loot ())))
            |: 0
        { reset ?|
            kills = timed.kills + 1
            experience = timed.experience + stats.experience
            hunter = { timed_hunter ?| target = -1 }
            gold = quantity.plus timed.gold (quantity.gp coins)
        }

:= hunter_steps (camp : camp) (now : i32) (toward : geometry.position) (p : pack) : pack =
    := h = p.hunter
    p
    |> with_hunter { h ?|
        at = toward
        next_step_at =
            now + geometry.step_cost (hunter_step_ms_at camp h.at) h.at toward
        timers = swing_after_step camp now h.timers
    }

:= chase_step_ms_at (camp : camp) (at : geometry.position) : i32 =
    := server = hunter_step_ms_at camp at
    ?= camp.chase_pace ?|
    | ChasesAtTheServerPace => server
    | ChasesAtTheProbePace => ? server > live_chase_step_ms () ?> server |: live_chase_step_ms ()

:= player_approaches (camp : camp) (now : i32) (p : pack) : pack =
    := h = p.hunter
    := toward = terrain.step_toward camp.layout (taken_by_foes p) (slot h.target p).at h.at
    := delays_a_fresh_walk =
        ?= camp.approach ?|
        | ApproachesAfterAFreshWalkDelay => !+
        | ApproachesAtOnce => !-
    ? now < h.next_step_at
    ?> p
    |? delays_a_fresh_walk && now - h.next_step_at >= tick_ms () && geometry.same_tile toward h.at = !-
    ?> p |> with_hunter { h ?| next_step_at = now + geometry.step_cost (chase_step_ms_at camp h.at) h.at toward }
    |:
        := q = hunter_steps camp now toward p
        := k = q.hunter
        q |> with_hunter { k ?| next_step_at = now + geometry.step_cost (chase_step_ms_at camp h.at) h.at toward }

:= threat_rank (f : foe) : i32 = f.at.x * 100000 + f.at.y

:= slot_of_nearest_attacker (p : pack) : foe =
    := adjacent index = distance_to (slot index p) p <= 1
    := earlier (a : i32) (b : i32) : i32 =
        ? a < 0 ?> b |? b < 0 ?> a |? threat_rank (slot b p) < threat_rank (slot a p) ?> b |: a
    := pick index = ? adjacent index ?> index |: -1
    :~ ^ fold (i : i32) (best : i32) : i32 = ? i >= band_size () ?> best |: fold (i + 1) (earlier best (pick i))
    := chosen = fold 1 (pick 0)
    slot (? chosen < 0 ?> 0 |: chosen) p

:= player_retreats
    (camp : camp) (rule : footing_rule) (slot : readiness.ready readiness.action_slot) (p : pack)
    : pack
    =
    := now = quantity.value_of (readiness.since slot)
    := threat = slot_of_nearest_attacker p
    := foes_near (q : geometry.position) : i32 =
        views.counted (\ (f : foe) => geometry.chebyshev_distance f.at q <= 1) p.foes
    := away =
        ?= rule ?|
        | StepAway => terrain.step_away camp.layout (taken_by_foes p) threat.at p.hunter.at
        | StepAwayLikeTheLiveProbe =>
            terrain.step_away_like_the_live_probe camp.layout (taken_by_foes p) threat.at p.hunter.at
        | ScoredStep w => terrain.scored_step camp.layout (taken_by_foes p) foes_near w threat.at p.hunter.at
    := h = p.hunter
    := stuck = geometry.same_tile away h.at
    p
    |> with_hunter { h ?|
        at = away
        next_step_at =
            now + geometry.step_cost (retreat_step_ms_at camp h.at) h.at away
        next_action_at = quantity.plus (readiness.since slot) (quantity.ms (parity_action_gap_ms ()))
        retreats =
            ? stuck
            ?> h.retreats
            |: h.retreats + 1
        cornered =
            ? stuck
            ?> h.cornered + 1
            |: h.cornered
        timers =
            ? stuck
            ?> h.timers
            |: swing_after_step camp now h.timers
    }

:= features (camp : camp) (attackers : i32) (now : i32) (p : pack) : network.inputs =
    := health_fraction =
        quantity.value_of p.hunter.health * network.one () / quantity.value_of (player_max_health camp)
    ? p.hunter.target < 0
    ?> network.inputs_of health_fraction attackers 0 0 !- !- !-
    |:
        := f = slot p.hunter.target p
        := stats = creatures.stats_of (kind_of p.hunter.target camp)
        := o = observe now p
        network.inputs_of health_fraction attackers
            (vitality.health f.life * network.one () / stats.max_health)
            (distance_to f p)
            o.heal_ready
            o.strike_ready
            (vitality.health f.life <= stats.run_health)

:= temperament_of (kind : creatures.arena_creature) : policy.temperament =
    :< policy
    ? (creatures.stats_of kind).run_health > 0 ?> Flees |: Stands

:= crowd_of (camp : camp) (p : pack) : policy.by_temperament i32 =
    :< policy
    := joined (index : i32) (crowd : by_temperament i32) : by_temperament i32 =
        ? distance_to (slot index p) p > 1 ?> crowd
        |:
            ?= temperament_of (kind_of index camp) ?|
            | Stands => { crowd ?| standing = crowd.standing + 1 }
            | Flees => { crowd ?| fleeing = crowd.fleeing + 1 }
    :~ ^ fold (i : i32) (crowd : by_temperament i32) : by_temperament i32 =
        ? i >= band_size ()
        ?> crowd
        |: fold (i + 1) (joined i crowd)
    fold 0 { standing = 0; fleeing = 0 }

:= wants_heal (camp : camp) (b : brain) (attackers : i32) (now : i32) (p : pack) : bool =
    ?= b ?|
    | Rules a => policy.heals (policy.thresholds_of a attackers) (observe now p)
    | Network w => (observe now p).heal_ready && (network.decide w (features camp attackers now p)).heal
    | Temperate r => policy.heals (policy.temperate_thresholds r (crowd_of camp p)) (observe now p)
    | RandomControl => !-

:= after_heal_plan (camp : camp) (b : brain) (attackers : i32) (now : i32) (p : pack) : bool * policy.engagement =
    :< policy
    ?= b ?|
    | Rules a => retreats a attackers, engages (thresholds_of a attackers) (observe now p)
    | Network w =>
        := o = observe now p
        := d = network.decide w (features camp attackers now p)
        := engagement =
            ? d.engage ?>
                ?= o.target ?|
                | InReach => ? o.strike_ready ?> Strike |: Hold
                | OutOfReach => Approach
                | NoTarget => Hold
            |: Hold
        d.retreat, engagement
    | Temperate r =>
        := crowd = crowd_of camp p
        temperate_retreats r crowd, engages (temperate_thresholds r crowd) (observe now p)
    | RandomControl => !-, Hold

:= next_waypoint (route : patrol_route) (p : pack) : pack =
    := h = p.hunter
    p |> with_hunter { h ?| waypoint = ? h.waypoint + 1 >= route.count ?> 0 |: h.waypoint + 1 }

:= patrol_step (camp : camp) (route : patrol_route) (now : i32) (p : pack) : pack =
    ? now < p.hunter.next_step_at ?> p
    |:
        := goal = views.band_at p.hunter.waypoint route.points
        ? geometry.chebyshev_distance goal p.hunter.at <= 1 ?> next_waypoint route p
        |:
            := toward = terrain.step_toward camp.layout (taken_by_foes p) goal p.hunter.at
            ? geometry.same_tile toward p.hunter.at ?> next_waypoint route p
            |: hunter_steps camp now toward p

:= awaiting_return (f : foe) : bool = f.returns_at < never ()

:= east_of (border : i32) (f : foe) : bool = f.spawn.x >= border

:= in_territory (border : i32) (index : i32) (p : pack) : bool =
    east_of border (slot index p) = (p.hunter.call_sign = 0)

:= expected_wait_ms (camp : camp) (now : i32) (index : i32) (p : pack) : i32 =
    := f = slot index p
    := travel =
        geometry.chebyshev_distance f.spawn p.hunter.at * terrain.on_ground camp.layout (hunter_of camp).step_ms
    ? index >= camp.size ?> never ()
    |? awaiting_return f ?> (? f.returns_at - now > travel ?> f.returns_at - now |: travel)
    |? geometry.chebyshev_distance f.spawn p.hunter.at <= 1 ?> never ()
    |: travel

:= claimed_wait_ms (camp : camp) (claims : i32 -> bool) (now : i32) (index : i32) (p : pack) : i32 =
    ? claims index
    ?> expected_wait_ms camp now index p
    |: never ()

:= soonest_claimed_spawn (camp : camp) (claims : i32 -> bool) (now : i32) (p : pack) : i32 =
    := sooner (a : i32) (b : i32) : i32 =
        ? claimed_wait_ms camp claims now b p < claimed_wait_ms camp claims now a p
        ?> b
        |: a
    :~ ^ fold (i : i32) (best : i32) : i32 = ? i >= band_size () ?> best |: fold (i + 1) (sooner best i)
    fold 1 0

:= soonest_spawn (camp : camp) (now : i32) (p : pack) : i32 =
    := sooner (a : i32) (b : i32) : i32 =
        ? expected_wait_ms camp now b p < expected_wait_ms camp now a p
        ?> b
        |: a
    :~ ^ fold (i : i32) (best : i32) : i32 = ? i >= band_size () ?> best |: fold (i + 1) (sooner best i)
    fold 1 0

:= territory_step (camp : camp) (border : i32) (now : i32) (p : pack) : pack =
    ? now < p.hunter.next_step_at ?> p
    |:
        := claims index = in_territory border index p
        := index = soonest_claimed_spawn camp claims now p
        ? claimed_wait_ms camp claims now index p >= never () ?> p
        |:
            := toward = terrain.step_toward camp.layout (taken_by_foes p) (slot index p).spawn p.hunter.at
            ? geometry.same_tile toward p.hunter.at ?> p
            |: hunter_steps camp now toward p

:= sweep_step (camp : camp) (now : i32) (p : pack) : pack =
    ? now < p.hunter.next_step_at ?> p
    |:
        := index = soonest_spawn camp now p
        ? expected_wait_ms camp now index p >= never () ?> p
        |:
            := toward = terrain.step_toward camp.layout (taken_by_foes p) (slot index p).spawn p.hunter.at
            ? geometry.same_tile toward p.hunter.at ?> p
            |: hunter_steps camp now toward p

:| random_move =
    | DrinkPotion
    | EngageTarget
    | StepSomewhere
    | StandStill

:= random_move_of (seed : u32) (tick : i32) (sign : i32) : random_move =
    := pick = rng.roll_between 0 3 (key seed tick (98 + 100 * sign) (purpose_random_control ()))
    ? pick = 0 ?> DrinkPotion |? pick = 1 ?> EngageTarget |? pick = 2 ?> StepSomewhere |: StandStill

:= random_pick (camp : camp) (seed : u32) (tick : i32) (now : i32) (p : pack) : pack =
    ?= random_move_of seed tick p.hunter.call_sign ?|
    | DrinkPotion =>
        ?= readiness.action_gate (quantity.ms now) p.hunter.next_action_at ?|
        | Open slot =>
            ?
                p.hunter.potions < camp.potion_budget
                && cooldowns.can_cast now (vocations.as_cooldown (vocations.knight_heal ())) p.hunter.timers
            ?> player_heals camp seed tick slot p
            |: p
        | ClosedUntil _ => p
    | EngageTarget =>
        ? p.hunter.target < 0 ?> p
        |? distance_to (slot p.hunter.target p) p <= 1 ?>
            ?= readiness.attack_gate (quantity.ms now) p.hunter.timers ?|
            | Open proof => player_strikes camp seed tick proof p
            | ClosedUntil _ => p
        |: player_approaches camp now p
    | StepSomewhere =>
        ? now < p.hunter.next_step_at
        ?> p
        |:
            := k : i32 =
                conv (rng.roll_between 0 7 (key seed tick (97 + 100 * p.hunter.call_sign) (purpose_random_control ())))
            := next = terrain.neighbor k p.hunter.at
            ? terrain.free camp.layout (taken_by_foes p) next ?> hunter_steps camp now next p
            |: p
    | StandStill => p

:= auto_attack (camp : camp) (seed : u32) (tick : i32) (now : i32) (p : pack) : pack =
    ? p.hunter.target < 0 ?> p
    |? distance_to (slot p.hunter.target p) p <= 1 ?>
        ?= readiness.attack_gate (quantity.ms now) p.hunter.timers ?|
        | Open proof => player_strikes camp seed tick proof p
        | ClosedUntil _ => p
    |: p

:= random_acts (camp : camp) (seed : u32) (tick : i32) (now : i32) (p : pack) : pack =
    random_pick camp seed tick now p |> auto_attack camp seed tick now

:= ruled_acts (camp : camp) (t : tactic) (seed : u32) (tick : i32) (now : i32) (p : pack) : pack =
    :< policy
    := attackers = views.counted (\ (f : foe) => distance_to f p <= 1) p.foes
    := aimed = aimed_by camp t.order p
    := healed =
        ?= readiness.action_gate (quantity.ms now) aimed.hunter.next_action_at ?|
        | Open slot =>
            ? aimed.hunter.potions < camp.potion_budget && wants_heal camp t.brain attackers now aimed
            ?> player_heals camp seed tick slot aimed
            |: aimed
        | ClosedUntil _ => aimed
    ? healed.hunter.target < 0 ?>
        ?= t.patrol ?|
        | Stays => healed
        | Patrols route => patrol_step camp route now healed
        | SweepsSpawns => sweep_step camp now healed
        | SweepsTerritory border => territory_step camp border now healed
    |:
        ?= after_heal_plan camp t.brain attackers now healed ?|
        | retreat, engagement =>
            := engage () =
                ?= engagement ?|
                | Strike =>
                    ?= readiness.attack_gate (quantity.ms now) healed.hunter.timers ?|
                    | Open proof => player_strikes camp seed tick proof healed
                    | ClosedUntil _ => healed
                | Approach => player_approaches camp now healed
                | Hold => healed
            ? retreat && now >= healed.hunter.next_step_at ?>
                ?= readiness.action_gate (quantity.ms now) healed.hunter.next_action_at ?|
                | Open slot => player_retreats camp t.footing slot healed
                | ClosedUntil _ => engage ()
            |: engage ()
:= player_acts (camp : camp) (t : tactic) (seed : u32) (tick : i32) (now : i32) (p : pack) : pack =
    ?= t.brain ?|
    | RandomControl => random_acts camp seed tick now (aimed_by camp t.order p)
    | _ => ruled_acts camp t seed tick now p

:= respawn_player (camp : camp) (p : pack) : pack =
    := h = p.hunter
    { p ?|
        hunter = { h ?| at = knight_start camp h.call_sign; health = player_max_health camp; target = -1 }
        deaths = p.deaths + 1
    }

:= recharged (now : i32) (p : pack) : pack =
    := h = p.hunter
    ? now < h.next_charge_at
    ?> p
    |:
        p
        |> with_hunter { h ?|
            block_charges =
                ? h.block_charges < combat.max_block_charges ()
                ?> h.block_charges + 1
                |: h.block_charges
            next_charge_at = now + combat.block_charge_ms ()
        }

:= knight_turn (camp : camp) (t : tactic) (seed : u32) (tick : i32) (now : i32) (p : pack) : pack =
    := h = p.hunter
    ? quantity.at_least (quantity.hp 0) h.health ?> respawn_player camp p
    |? now < h.next_decision_at ?> p
    |: player_acts camp t seed tick now (p |> with_hunter { h ?| next_decision_at = now + client_decision_ms () })

:= measured_entry_ms (index : i32) : i32 =
    ? index = 0 ?> 746
    |? index = 1 ?> 745
    |? index = 2 ?> 618
    |? index = 3 ?> 934
    |? index = 4 ?> 1116
    |? index = 5 ?> 1193
    |? index = 6 ?> 1318
    |? index = 7 ?> 2346
    |? index = 8 ?> 1847
    |: 1520

:= ally_entry_ms (seed : u32) : i32 = measured_entry_ms (conv (rng.roll_between 0 9 (key seed 0 0 (purpose_entry ()))))

:= ally_entered (camp : camp) (seed : u32) (now : i32) (p : pack) : pack =
    ? camp.party > 1 && p.ally_in_world = !- && now >= ally_entry_ms seed
    ?>
        := waiting = p.ally
        := entered = { waiting ?| at = knight_start camp 1; next_decision_at = now }
        now_in_world (with_ally entered p)
    |: p

:= advance (camp : camp) (t : tactic) (seed : u32) (tick : i32) (p : pack) : pack =
    := now = tick * tick_ms ()
    := charged = p |> ally_entered camp seed now |> recharged now
    := both_charged = ? camp.party > 1 ?> turned (recharged now (turned charged)) |: charged
    := knights_act (q : pack) : pack =
        := after_lead = knight_turn camp t seed tick now q
        ? camp.party > 1 && q.ally_in_world
        ?> turned (knight_turn camp t seed tick now (turned after_lead))
        |: after_lead
    ?= camp.view ?|
    | SeesThisTick => both_charged |> foes_act camp seed tick now |> knights_act
    | SeesLastTick => both_charged |> knights_act |> foes_act camp seed tick now
    | SeesAtItsPoll =>
        := phase : i32 = conv (rng.roll_between 0 99 (key seed tick 0 (purpose_poll ())))
        := landing = now - tick_ms () + phase + client_lag_ms ()
        := early (i : i32) : bool = (slot i both_charged).next_step_at <= landing
        both_charged
        |> foes_act_where camp seed tick now early
        |> knights_act
        |> foes_act_where camp seed tick now (\ i => early i = !-)

:= simulate (camp : camp) (t : tactic) (seed : u32) (ticks : i32) : pack =
    :~ ^ loop (tick : i32) (p : pack) : pack =
        ? tick >= ticks ?> p |: loop (tick + 1) (advance camp t seed tick p)
    loop 0 (start camp)

:= clear_run (camp : camp) (t : tactic) (seed : u32) (max_ticks : i32) : i32 * pack =
    := cleared = clearing camp
    :~ ^ loop (tick : i32) (p : pack) : i32 * pack =
        ? tick >= max_ticks || p.kills >= camp.size
        ?> tick * tick_ms (), p
        |: loop (tick + 1) (advance cleared t seed tick p)
    loop 0 (start cleared)

:= score (camp : camp) (t : tactic) (first_seed : u32) (count : i32) : i32 =
    :~ ^ loop (index : i32) (acc : i32) : i32 =
        ? index >= count ?> acc
        |:
            := outcome = simulate camp t (first_seed + conv index) (scenario_ticks ())
            loop (index + 1) (acc + outcome.kills - death_penalty () * outcome.deaths)
    loop 0 0

:= hunt_experience (camp : camp) (t : tactic) (first_seed : u32) (count : i32) : i32 =
    :~ ^ loop (index : i32) (acc : i32) : i32 =
        ? index >= count ?> acc
        |:
            := p = simulate camp t (first_seed + conv index) (scenario_ticks ())
            loop (index + 1) (acc + p.experience - p.deaths * death_experience_penalty ())
    loop 0 0

:= highest_tuned_heal () : i32 = 400

:= potion_price () : quantity.amount quantity.gold_coins = quantity.gp 50
:= all_blessings_price_at_level_30 () : quantity.amount quantity.gold_coins = quantity.gp 14000

:= hunt_profit (p : pack) : quantity.amount quantity.gold_coins =
    quantity.minus
        (quantity.minus p.gold (quantity.scaled (party_potions p) (potion_price ())))
        (quantity.scaled p.deaths (all_blessings_price_at_level_30 ()))

:= profit (camp : camp) (t : tactic) (first_seed : u32) (count : i32) : quantity.amount quantity.gold_coins =
    :~ ^ loop (index : i32) (acc : quantity.amount quantity.gold_coins) : quantity.amount quantity.gold_coins =
        ? index >= count
        ?> acc
        |:
            loop
                (index + 1)
                (quantity.plus acc (hunt_profit (simulate camp t (first_seed + conv index) (scenario_ticks ()))))
    loop 0 (quantity.gp 0)

:= totals (camp : camp) (t : tactic) (first_seed : u32) (count : i32) : i32 * i32 * i32 =
    :~ ^ loop (index : i32) (kills : i32) (escapes : i32) (deaths : i32) : i32 * i32 * i32 =
        ? index >= count ?> kills, escapes, deaths
        |:
            := outcome = simulate camp t (first_seed + conv index) (scenario_ticks ())
            loop (index + 1) (kills + outcome.kills) (escapes + outcome.escapes) (deaths + outcome.deaths)
    loop 0 0 0 0

:= cavebot (order : policy.targeting) : tactic =
    {
        brain = Rules (policy.fixed { heal_below = 120; strike_above = 0 })
        order = order
        footing = StepAway
        patrol = Stays
    }

:= cavebot_with_heal (heal : i32) : tactic =
    {
        brain = Rules (policy.fixed { heal_below = heal; strike_above = 0 })
        order =
            :< policy
            CurrentFirst
        footing = StepAway
        patrol = Stays
    }

:== ledger = { hunt_kills : i32; hunt_deaths : i32; hunt_profit : quantity.amount quantity.gold_coins }

:= ledger_of (camp : camp) (t : tactic) (first_seed : u32) (count : i32) : ledger =
    :~ ^ loop (index : i32) (acc : ledger) : ledger =
        ? index >= count
        ?> acc
        |:
            := p = simulate camp t (first_seed + conv index) (scenario_ticks ())
            loop (index + 1) {
                hunt_kills = acc.hunt_kills + p.kills
                hunt_deaths = acc.hunt_deaths + p.deaths
                hunt_profit = quantity.plus acc.hunt_profit (hunt_profit p)
            }
    loop 0 { hunt_kills = 0; hunt_deaths = 0; hunt_profit = quantity.gp 0 }

:== clear_ledger = { clear_potions : i32; clear_deaths : i32; clear_ms : i32 }

:= clear_ledger_of (camp : camp) (t : tactic) (first_seed : u32) (count : i32) : clear_ledger =
    :~ ^ loop (index : i32) (acc : clear_ledger) : clear_ledger =
        ? index >= count
        ?> acc
        |:
            ?= clear_run camp t (first_seed + conv index) 6000 ?|
            | elapsed, p =>
                loop (index + 1) {
                    clear_potions = acc.clear_potions + party_potions p
                    clear_deaths = acc.clear_deaths + p.deaths
                    clear_ms = acc.clear_ms + elapsed
                }
    loop 0 { clear_potions = 0; clear_deaths = 0; clear_ms = 0 }

:= clear_cost (l : clear_ledger) : quantity.amount quantity.gold_coins =
    quantity.plus
        (quantity.scaled l.clear_potions (potion_price ()))
        (quantity.scaled l.clear_deaths (all_blessings_price_at_level_30 ()))

:= below_the_kill_floor () : i32 = -1000000000

:! kill_score = ()
:! experience_score = ()

:| objective unit =
    | Kills :: objective kill_score
    | Experience :: objective experience_score
    | Profit :: objective quantity.gold_coins
    | ProfitKeepingKills :: i32 -> objective quantity.gold_coins
    | CheapClearWithin :: i32 -> objective quantity.gold_coins

:= measured \* unit.
    (o : objective unit) (camp : camp) (t : tactic) (first_seed : u32) (count : i32)
    : quantity.amount unit
    =
    ?= o ?|
    | Kills => quantity.amount_of (score camp t first_seed count)
    | Experience => quantity.amount_of (hunt_experience camp t first_seed count)
    | Profit => profit camp t first_seed count
    | ProfitKeepingKills floor =>
        := l = ledger_of camp t first_seed count
        ? l.hunt_kills >= floor ?> l.hunt_profit |: quantity.gp (below_the_kill_floor () + l.hunt_kills * 1000)
    | CheapClearWithin limit_ms =>
        := l = clear_ledger_of camp t first_seed count
        ? l.clear_ms <= limit_ms * count
        ?> quantity.minus (quantity.gp 0) (clear_cost l)
        |: quantity.gp (below_the_kill_floor () - l.clear_ms / count)

:= worth \* unit. (o : objective unit) (camp : camp) (t : tactic) (first_seed : u32) (count : i32) : i32 =
    quantity.value_of (measured o camp t first_seed count)
:= tuned_cavebot_heal_for \* unit. (o : objective unit) (camp : camp) (first_seed : u32) (count : i32) : i32 =
    :~ ^ best (heal : i32) (best_heal : i32) (best_score : i32) : i32 =
        ? heal > highest_tuned_heal () ?> best_heal
        |:
            := s = worth o camp (cavebot_with_heal heal) first_seed count
            ? s > best_score ?> best (heal + 10) heal s |: best (heal + 10) best_heal best_score
    best 40 40 (worth o camp (cavebot_with_heal 40) first_seed count)

:= tuned_cavebot_heal (camp : camp) (first_seed : u32) (count : i32) : i32 =
    tuned_cavebot_heal_for Kills camp first_seed count

:= shaped_heal_tuned_for \* unit.
    (o : objective unit) (shape : tactic -> tactic) (camp : camp) (first_seed : u32) (count : i32)
    : i32
    =
    :~ ^ best (heal : i32) (best_heal : i32) (best_score : i32) : i32 =
        ? heal > highest_tuned_heal () ?> best_heal
        |:
            := s = worth o camp (cavebot_with_heal heal |> shape) first_seed count
            ? s > best_score ?> best (heal + 10) heal s |: best (heal + 10) best_heal best_score
    best 50 40 (worth o camp (cavebot_with_heal 40 |> shape) first_seed count)

:= heal_fraction_below (camp : camp) (heal : i32) : i32 =
    network.fraction_below heal (quantity.value_of (player_max_health camp))

:= network_tactic (w : network.weights) : tactic =
    { brain = Network w; order = :< policy ;; CurrentFirst; footing = StepAway; patrol = Stays }

:= cavebot_network (camp : camp) (heal : i32) : network.weights =
    network.threshold_healer (heal_fraction_below camp heal)

:= tactic_with_order (order : policy.targeting) (g : search.genome) : tactic =
    {
        brain = Rules { heal_base = g.first; heal_per_attacker = g.second; strike_above = 0; retreat_at = g.third }
        order = order
        footing = StepAway
        patrol = Stays
    }

:= live_retreat_tactic (heal : i32) (retreat_at : i32) : tactic =
    := evolved_shape : tactic =
        tactic_with_order (:< policy ;; ReachFirst) { first = heal; second = 0; third = retreat_at }
    { evolved_shape ?| footing = StepAwayLikeTheLiveProbe }

:= genes_of
    (g0 : i32) (g1 : i32) (g2 : i32) (g3 : i32) (g4 : i32) (g5 : i32) (g6 : i32) (g7 : i32) (g8 : i32) (g9 : i32)
    (g10 : i32) (g11 : i32)
    : search.vector
    =
    search.vector_of 12 0
    |> search.with_gene 11 g11
    |> search.with_gene 10 g10
    |> search.with_gene 0 g0
    |> search.with_gene 1 g1
    |> search.with_gene 2 g2
    |> search.with_gene 3 g3
    |> search.with_gene 4 g4
    |> search.with_gene 5 g5
    |> search.with_gene 6 g6
    |> search.with_gene 7 g7
    |> search.with_gene 8 g8
    |> search.with_gene 9 g9

:= scored_low () : search.vector = genes_of 40 0 1 -200 -200 -200 -200 -50 -50 -50 -10 -50
:= scored_high () : search.vector = genes_of 400 80 4 200 200 200 200 50 50 50 10 50
:= scored_start () : search.vector = genes_of 143 34 1 50 100 -10 -1 0 0 0 0 0

:= scored_tactic (g : search.vector) : tactic =
    := at i = search.gene g i
    {
        brain = Rules { heal_base = at 0; heal_per_attacker = at 1; strike_above = 0; retreat_at = at 2 }
        order = policy.Scored { current = at 3; reach = at 4; health = at 5; distance = at 6 }
        footing = ScoredStep { away = at 7; room = at 8; crowd = at 9; align = at 10; diagonal = at 11 }
        patrol = Stays
    }
:= tactic_of (g : search.genome) : tactic = tactic_with_order (:< policy ;; CurrentFirst) g

:= temperate_genes
    (heal_base : i32) (per_standing : i32) (per_fleeing : i32) (retreat_standing : i32) (retreat_fleeing : i32)
    : search.vector
    =
    search.vector_of 5 0
    |> search.with_gene 0 heal_base
    |> search.with_gene 1 per_standing
    |> search.with_gene 2 per_fleeing
    |> search.with_gene 3 retreat_standing
    |> search.with_gene 4 retreat_fleeing

:= temperate_low () : search.vector = temperate_genes 0 0 0 1 1
:= temperate_high () : search.vector = temperate_genes 400 200 200 4 4

:= temperate_tactic (order : policy.targeting) (g : search.vector) : tactic =
    := at i = search.gene g i
    {
        brain =
            Temperate {
                heal_base = at 0
                heal_per = { standing = at 1; fleeing = at 2 }
                strike_above = 0
                retreat_at = { standing = at 3; fleeing = at 4 }
            }
        order = order
        footing = StepAway
        patrol = Stays
    }

:= evolve_temperate_for \* unit.
    (o : objective unit) (order : policy.targeting) (start : search.vector) (camp : camp) (search_seed : u32)
    (first_seed : u32) (count : i32) (generations : i32) (pairs : i32)
    : search.vector
    =
    search.evolve_vector
        \ g => worth o camp (temperate_tactic order g) first_seed count
        (temperate_low ())
        (temperate_high ())
        start
        search_seed
        generations
        pairs

:= evolved_on_the_cyclops_spot () : search.genome = { first = 143; second = 34; third = 1 }

:= against_standing_only (g : search.genome) : search.vector =
    temperate_genes g.first g.second 0 g.third (policy.never_retreat ())

:= arena_hunt () : camp =
    :< creatures
    := kinds = views.band (Cyclops, Cyclops, Troll, Troll, Troll, Troll)
    {
        kinds = kinds
        size = 6
        hunter_level = default_hunter_level kinds 6
        rule = RespawningAfter 60000
        layout =
            :< terrain
            ArenaHunt
        potion_budget = unlimited_potions ()
        party = 1
        ally_enters = EntersWithTheKnight
        party_targeting = !-
        wakes_at = 0
        swing = SwingKeepsItsTime
        melee = MeleeWhenReady
        idle = StandsStill
        follow = FollowsAtOnce
        pace = SamplePace
        dance = NeverDances
        view = SeesThisTick
        ground = ScaledFromGrass
        acquisition = ChasesAtOnce
        approach = ApproachesAtOnce
        sight = SightStopsAtUnpassableTiles
        retreat_pace = RetreatsAtTheServerPace
        chase_pace = ChasesAtTheServerPace
        placement = AtLayoutStart
        ranged = views.counted creatures.is_ranged kinds > 0
    }

:= cyclops_hunting_ground () : camp =
    := ground = arena_hunt ()
    { ground ?| kinds = views.band_of (:< creatures ;; Cyclops) }

:= plaza_and_fields_route () : patrol_route =
    {
        points =
            views.band (
                geometry.position 104 86 7,
                geometry.position 125 86 7,
                geometry.position 117 88 7,
                geometry.position 124 96 7,
                geometry.position 119 104 7,
                geometry.position 117 92 7
            )
        count = 6
    }

:= patrolling (route : patrol_route) (t : tactic) : tactic = { t ?| patrol = Patrols route }

:= sweeping_spawns (t : tactic) : tactic = { t ?| patrol = SweepsSpawns }

:= sweeping_territory (border : i32) (t : tactic) : tactic = { t ?| patrol = SweepsTerritory border }

:= random_control () : tactic =
    { brain = RandomControl; order = :< policy ;; CurrentFirst; footing = StepAway; patrol = Stays }

:= cyclops_and_two_trolls_on_the_arena_spot () : camp =
    :< catalog
    camp_of_entries (
        pack_entry (spawn_of CyclopsKind 1 2),
        pack_entry (spawn_of TrollKind 1 2),
        pack_entry (spawn_of TrollKind 1 2)
    )
    |> on_layout (:< terrain ;; ArenaSpot)

:= evolve_rules_for \* unit.
    (o : objective unit) (order : policy.targeting) (start : search.genome) (camp : camp) (search_seed : u32)
    (first_seed : u32) (count : i32) (generations : i32) (offspring : i32)
    : search.genome
    =
    search.evolve
        \ g => worth o camp (tactic_with_order order g) first_seed count
        { first = 0; second = 0; third = 1 }
        { first = 400; second = 60; third = 4 }
        start
        search_seed
        generations
        offspring
        40

:= evolve_tactic_from_for \* unit.
    (o : objective unit) (start : search.genome) (camp : camp) (search_seed : u32) (first_seed : u32) (count : i32)
    (generations : i32) (offspring : i32)
    : search.genome
    =
    search.evolve
        \ g => worth o camp (tactic_of g) first_seed count
        { first = 0; second = 0; third = 1 }
        { first = 400; second = 60; third = 4 }
        start
        search_seed
        generations
        offspring
        40

:= evolve_tactic_from
    (start : search.genome) (camp : camp) (search_seed : u32) (first_seed : u32) (count : i32) (generations : i32)
    (offspring : i32)
    : search.genome
    =
    search.evolve
        \ g => score camp (tactic_of g) first_seed count
        { first = 0; second = 0; third = 1 }
        { first = 400; second = 60; third = 4 }
        start
        search_seed
        generations
        offspring
        40

:= evolve_tactic
    (camp : camp) (search_seed : u32) (first_seed : u32) (count : i32) (generations : i32) (offspring : i32)
    : search.genome
    =
    evolve_tactic_from { first = 120; second = 0; third = 4 } camp search_seed first_seed count generations offspring

:! training = ()
:! held_out = ()

:== seed_range = { first : u32; count : i32 }

:| private seed_block role =
    | TrainingBlock :: seed_range -> seed_block training
    | HeldOutBlock :: seed_range -> seed_block held_out

:= range_of \* role. (b : seed_block role) : seed_range =
    ?= b ?|
    | TrainingBlock r => r
    | HeldOutBlock r => r

:= training_block () : seed_block training = TrainingBlock { first = training_first (); count = training_count () }
:= held_out_block () : seed_block held_out = HeldOutBlock { first = held_out_first (); count = held_out_count () }
:= held_out_slice (count : i32) : seed_block held_out =
    HeldOutBlock { first = held_out_first (); count = ? count < held_out_count () ?> count |: held_out_count () }

:= shaped_cavebot_heal_tuned_on \* unit.
    (o : objective unit) (shape : tactic -> tactic) (camp : camp) (b : seed_block training)
    : i32
    =
    := r = range_of b
    shaped_heal_tuned_for o shape camp r.first r.count

:= cavebot_heal_tuned_on \* unit. (o : objective unit) (camp : camp) (b : seed_block training) : i32 =
    := r = range_of b
    tuned_cavebot_heal_for o camp r.first r.count

:= rules_evolved_on \* unit.
    (o : objective unit) (order : policy.targeting) (start : search.genome) (camp : camp) (search_seed : u32)
    (b : seed_block training) (generations : i32) (offspring : i32)
    : search.genome
    =
    := r = range_of b
    evolve_rules_for o order start camp search_seed r.first r.count generations offspring

:= judged_on \* unit.
    (o : objective unit) (camp : camp) (t : tactic) (b : seed_block held_out)
    : quantity.amount unit
    =
    := r = range_of b
    measured o camp t r.first r.count

:= ledger_on \* role. (camp : camp) (t : tactic) (b : seed_block role) : ledger =
    := r = range_of b
    ledger_of camp t r.first r.count

:= worth_on_training \* unit. (o : objective unit) (camp : camp) (t : tactic) (b : seed_block training) : i32 =
    := r = range_of b
    worth o camp t r.first r.count

:= tactic_evolved_on \* unit.
    (o : objective unit) (start : search.genome) (camp : camp) (search_seed : u32) (b : seed_block training)
    (generations : i32) (offspring : i32)
    : search.genome
    =
    := r = range_of b
    evolve_tactic_from_for o start camp search_seed r.first r.count generations offspring
:= clears_judged_on (camp : camp) (t : tactic) (b : seed_block held_out) : clear_ledger =
    := r = range_of b
    clear_ledger_of camp t r.first r.count

:= route_of_genes (v : search.vector) : patrol_route =
    := at i = geometry.position (search.gene v (2 * i)) (search.gene v (2 * i + 1)) 7
    { points = views.band (at 0, at 1, at 2, at 3, at 4, at 5); count = search.gene v 12 }

:= route_genes (r : patrol_route) : search.vector =
    :~ ^ fill (i : i32) (v : search.vector) : search.vector =
        ? i >= band_size () ?> v
        |:
            := point = views.band_at i r.points
            fill (i + 1) (v |> search.with_gene (2 * i) point.x |> search.with_gene (2 * i + 1) point.y)
    fill 0 (search.vector_of 13 0) |> search.with_gene 12 r.count

:= hunt_route_low () : search.vector = route_genes { points = views.band_of (geometry.position 100 82 7); count = 2 }
:= hunt_route_high () : search.vector = route_genes { points = views.band_of (geometry.position 128 108 7); count = 6 }


:= route_evolved_on
    (camp : camp) (start : patrol_route) (heal : i32) (search_seed : u32) (b : seed_block training) (generations : i32)
    (pairs : i32)
    : patrol_route
    =
    := r = range_of b
    := fitness (v : search.vector) : i32 =
        hunt_experience camp (cavebot_with_heal heal |> patrolling (route_of_genes v)) r.first r.count
    route_of_genes (
        search.evolve_vector fitness
            (hunt_route_low ())
            (hunt_route_high ())
            (route_genes start)
            search_seed
            generations
            pairs
    )

:= central_shuttle_route () : patrol_route =
    {
        points =
            views.band (
                geometry.position 117 92 7,
                geometry.position 116 96 7,
                geometry.position 118 88 7,
                geometry.position 124 92 7,
                geometry.position 109 93 7,
                geometry.position 120 92 7
            )
        count = 2
    }

:= spawn_side_loop_route () : patrol_route =
    {
        points =
            views.band (
                geometry.position 117 88 7,
                geometry.position 124 96 7,
                geometry.position 117 92 7,
                geometry.position 117 92 7,
                geometry.position 117 92 7,
                geometry.position 117 92 7
            )
        count = 3
    }
