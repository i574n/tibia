///- --package .
test search static =
    :< testing

:== genome = { first : i32; second : i32; third : i32 }

:= clamp_between (low : i32) (high : i32) (x : i32) : i32 =
    ? x < low ?> low |? x > high ?> high |: x

:= nudge (seed : u32) (generation : i32) (child : i32) (gene : u32) (spread : i32) (value : i32) : i32 =
    := draw : i32 =
        conv (rng.roll_between 0 (conv (2 * spread)) (rng.roll_key seed (conv generation) (conv child) (100u32 + gene)))
    value + draw - spread

:= mutate
    (seed : u32) (generation : i32) (child : i32) (spread : i32) (low : genome) (high : genome) (g : genome)
    : genome
    =
    {
        first = clamp_between low.first high.first (nudge seed generation child 1u32 spread g.first)
        second = clamp_between low.second high.second (nudge seed generation child 2u32 spread g.second)
        third = clamp_between low.third high.third (nudge seed generation child 3u32 spread g.third)
    }

:= evolve
    (fitness : genome -> i32) (low : genome) (high : genome) (start : genome) (seed : u32) (generations : i32)
    (offspring : i32) (spread : i32)
    : genome
    =
    :~ ^ generation (index : i32) (parent : genome) (parent_score : i32) (width : i32) : genome =
        ? index >= generations
        ?> parent
        |:
            :~ ^ children (child : i32) (best : genome) (best_score : i32) : genome * i32 =
                ? child >= offspring
                ?> best, best_score
                |:
                    := candidate = mutate seed index child width low high parent
                    := score = fitness candidate
                    ? score > best_score
                    ?> children (child + 1) candidate score
                    |: children (child + 1) best best_score
            ?= children 0 parent parent_score ?|
            | best, best_score => generation (index + 1) best best_score (? width > 1 ?> width / 2 |: 1)
    generation 0 start (fitness start) spread

:! vector = array i32

:= vector_of (count : i32) (value : i32) : vector =
    := x : array i32 = create count
    :~ ^ fill (i : i32) : () =
        ? i < count ?>
            set x i value
            fill (i + 1)
    fill 0
    vector x

:= gene (vector v) (i : i32) : i32 = index v i
:= gene_count (vector v) : i32 = length v
:= with_gene (i : i32) (value : i32) (vector v) : vector =
    set v i value
    vector v

:= antithetic_pair
    (seed : u32) (generation : i32) (pair : i32) (width_per_mille : i32) (low : vector) (high : vector)
    (parent : vector)
    : vector * vector
    =
    := n = gene_count parent
    := plus = vector_of n 0
    := minus = vector_of n 0
    :~ ^ fill (i : i32) : () =
        ? i < n ?>
            := range = gene high i - gene low i
            := spread = ? range * width_per_mille / 1000 < 1 ?> 1 |: range * width_per_mille / 1000
            := delta = nudge seed generation pair (conv i) spread 0
            with_gene i (clamp_between (gene low i) (gene high i) (gene parent i + delta)) plus |> ignore
            with_gene i (clamp_between (gene low i) (gene high i) (gene parent i - delta)) minus |> ignore
            fill (i + 1)
    fill 0
    plus, minus

:= evolve_vector
    (fitness : vector -> i32) (low : vector) (high : vector) (start : vector) (seed : u32) (generations : i32)
    (pairs : i32)
    : vector
    =
    :~ ^ generation (index : i32) (parent : vector) (parent_score : i32) (width : i32) : vector =
        ? index >= generations
        ?> parent
        |:
            :~ ^ children (pair : i32) (best : vector) (best_score : i32) : vector * i32 =
                ? pair >= pairs
                ?> best, best_score
                |:
                    ?= antithetic_pair seed index pair width low high parent ?|
                    | plus, minus =>
                        := plus_score = fitness plus
                        := minus_score = fitness minus
                        := best, best_score = ? plus_score > best_score ?> plus, plus_score |: best, best_score
                        ? minus_score > best_score
                        ?> children (pair + 1) minus minus_score
                        |: children (pair + 1) best best_score
            ?= children 0 parent parent_score ?|
            | best, best_score =>
                generation (index + 1) best best_score (? width * 4 / 5 > 10 ?> width * 4 / 5 |: 10)
    generation 0 start (fitness start) 250
:= evolve_vector_resampled
    (fitness : i32 -> vector -> i32) (low : vector) (high : vector) (start : vector) (seed : u32) (generations : i32)
    (pairs : i32)
    : vector
    =
    :~ ^ generation (index : i32) (parent : vector) (width : i32) : vector =
        ? index >= generations
        ?> parent
        |:
            := parent_score = fitness index parent
            :~ ^ children (pair : i32) (best : vector) (best_score : i32) : vector * i32 =
                ? pair >= pairs
                ?> best, best_score
                |:
                    ?= antithetic_pair seed index pair width low high parent ?|
                    | plus, minus =>
                        := plus_score = fitness index plus
                        := minus_score = fitness index minus
                        := best, best_score = ? plus_score > best_score ?> plus, plus_score |: best, best_score
                        ? minus_score > best_score
                        ?> children (pair + 1) minus minus_score
                        |: children (pair + 1) best best_score
            ?= children 0 parent parent_score ?|
            | best, _ => generation (index + 1) best (? width * 4 / 5 > 10 ?> width * 4 / 5 |: 10)
    generation 0 start 250

///> c
test evolve_climbs_a_known_peak =
    := ~seed = 3u32
    := peak (g : genome) : i32 =
        0 - (g.first - 40) * (g.first - 40) - (g.second - 7) * (g.second - 7) - (g.third + 5) * (g.third + 5)
    := low = { first = 0; second = -20; third = -20 }
    := high = { first = 100; second = 20; third = 20 }
    := best = evolve peak low high { first = 0; second = 0; third = 0 } seed 12 16 32
    (peak best > peak { first = 0; second = 0; third = 0 }) |> _assert_eq !+
    (peak best >= -12) |> _assert_eq !+

///> c
test evolve_vector_climbs_a_known_peak_with_antithetic_pairs =
    := ~seed = 3u32
    := target i = ? i = 0 ?> 40 |? i = 1 ?> -7 |? i = 2 ?> 3 |: 90
    := peak (v : vector) : i32 =
        :~ ^ loss (i : i32) (acc : i32) : i32 =
            ? i >= 4
            ?> acc
            |: loss (i + 1) (acc - (gene v i - target i) * (gene v i - target i))
        loss 0 0
    := low = vector_of 4 -100
    := high = vector_of 4 100
    := best = evolve_vector peak low high (vector_of 4 0) seed 20 8
    (peak best > peak (vector_of 4 0), peak best >= -40) |> _assert_eq (!+, !+)
