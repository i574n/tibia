inl total_tries_to (level : i32) : i32 =
    let rec sum (c : i32) (total : i32) : i32 =
        if c > level then total else sum (c + 1) (total + knight_skill_tries_up_to_130 c)
    sum 11 0

inl after_unblessed_death (s : skill) : skill =
    let rec drop (level : i32) (tries : i32) (lost : i32) : skill =
        if lost > tries then
            if level <= 10 then { level = 10; tries = 0 }
            else drop (level - 1) (knight_skill_tries_up_to_130 level) (lost - tries)
        else { level = level; tries = if tries > lost then tries - lost else 0 }
    drop s.level s.tries ((total_tries_to s.level + s.tries) / 10)

///> c
test knight_skill_tries_match_canary_pow_of_the_float_multiplier =
    inl ~level = 30i32
    (
        knight_skill_tries_up_to_130 10,
        knight_skill_tries_up_to_130 11,
        knight_skill_tries_up_to_130 12,
        knight_skill_tries_up_to_130 level,
        knight_skill_tries_up_to_130 60,
        knight_skill_tries_up_to_130 100,
        knight_skill_tries_up_to_130 130,
        total_tries_to level
    )
    |> _assert_eq (0i32, 50i32, 55i32, 305i32, 5335i32, 241501i32, 4214059i32, 2852i32)

///> c
test an_axe_30_knight_loses_a_skill_level_on_death_like_live =
    inl ~level = 30i32
    inl after = after_unblessed_death { level = level; tries = 0 }
    (after.level, after.tries) |> _assert_eq (29i32, 20i32)

///> c
test skill_loss_matches_canary_death_loop_across_levels =
    inl ~tries = 1234i32
    inl at level tries =
        inl after = after_unblessed_death { level = level; tries = tries }
        after.level, after.tries
    (at 60 tries, at 12 3, at 11 0, at 100 50000, at 10 0, at 130 0)
    |> _assert_eq (
        (59i32, 629i32),
        (11i32, 48i32),
        (10i32, 45i32),
        (99i32, 20904i32),
        (10i32, 0i32),
        (128i32, 3409614i32)
    )

///> wgsl
test skill_loss_on_gpu =
    inl ~level = 30i32
    inl after = after_unblessed_death { level = level; tries = 0 }
    if after.level = 29i32 && after.tries = 20i32 && knight_skill_tries_up_to_130 100 = 241501i32 then 0i32 else 1i32
