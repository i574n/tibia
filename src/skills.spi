///- --package .
test skills static =
    :< testing

:== skill = { level : i32; tries : i32 }

:= tries_11_to_18 (level : i32) : i32 =
    ? level <= 11 ?> 50
    |? level <= 12 ?> 55
    |? level <= 13 ?> 60
    |? level <= 14 ?> 66
    |? level <= 15 ?> 73
    |? level <= 16 ?> 80
    |? level <= 17 ?> 88
    |: 97

:= tries_19_to_26 (level : i32) : i32 =
    ? level <= 19 ?> 107
    |? level <= 20 ?> 117
    |? level <= 21 ?> 129
    |? level <= 22 ?> 142
    |? level <= 23 ?> 156
    |? level <= 24 ?> 172
    |? level <= 25 ?> 189
    |: 208

:= tries_27_to_34 (level : i32) : i32 =
    ? level <= 27 ?> 229
    |? level <= 28 ?> 252
    |? level <= 29 ?> 277
    |? level <= 30 ?> 305
    |? level <= 31 ?> 336
    |? level <= 32 ?> 370
    |? level <= 33 ?> 407
    |: 447

:= tries_35_to_42 (level : i32) : i32 =
    ? level <= 35 ?> 492
