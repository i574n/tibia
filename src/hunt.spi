///- --package .
test hunt static =
    open testing

inl melee_reach () : i32 = 1

inl attack (damage : i32) (hunter : geometry.position) (prey_at : geometry.position) (prey : vitality.vitality vitality.alive) : vitality.struck =
    if geometry.within_range (melee_reach ()) hunter prey_at then vitality.strike damage prey else vitality.Survived prey

inl loot (outcome : vitality.struck) (bounty : i32) (held : coins.purse) : coins.purse =
    match outcome with
    | vitality.Slain _ => coins.fewest_coins (coins.total_gold held + bounty)
    | vitality.Survived _ => held

///> c
test adjacent_attack_lands =
    inl ~damage = 40i32
    attack damage (geometry.position 100 100 7) (geometry.position 101 101 7) (vitality.spawn 100)
    |> vitality.survivor_health |> _assert_eq 60i32

///> c
test distant_attack_misses =
    inl ~damage = 40i32
    attack damage (geometry.position 100 100 7) (geometry.position 103 100 7) (vitality.spawn 100)
    |> vitality.survivor_health |> _assert_eq 100i32

///> c
test kill_pays_bounty =
    inl ~damage = 150i32
    inl outcome = attack damage (geometry.position 100 100 7) (geometry.position 100 99 7) (vitality.spawn 100)
    loot outcome 250 (coins.purse 80 0 0) |> coins.total_gold |> _assert_eq 330i32

///> c
test loot_conserves_gold_and_pays_in_fewest_coins_over_1600_purses_and_bounties =
    inl ~limit = 40i32
    let rec check (i : i32) (broken : i32) : i32 =
        if i >= limit * limit then broken
        else
            inl held = coins.purse (i % limit * 37) (i / limit * 3) (i % 7)
            inl bounty = i * 53 % 997
            inl slain = loot (vitality.strike 500 (vitality.spawn 100)) bounty held
            inl kept = loot (vitality.strike 1 (vitality.spawn 100)) bounty held
            inl conserved = coins.total_gold slain = coins.total_gold held + bounty && coins.total_gold kept = coins.total_gold held
            inl fewest = slain.gold < 100 && slain.platinum < 100
            check (i + 1) (if conserved && fewest then broken else broken + 1)
    check 0 0 |> _assert_eq 0i32

///> wgsl
test kill_pays_bounty_on_gpu =
    inl ~damage = 150i32
    inl outcome = attack damage (geometry.position 100 100 7) (geometry.position 100 99 7) (vitality.spawn 100)
    if (loot outcome 250 (coins.purse 80 0 0) |> coins.total_gold) = 330i32 then 0i32 else 1i32
