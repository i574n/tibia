///- --package .
test combat static =
    :< testing

:= unit_scale () : i32 = 4096

:= sub_key (key : rng.roll_key) (index : u32) : rng.roll_key =
    { key ?| purpose = key.purpose * 256u32 + index }

:= uniform_unit (key : rng.roll_key) (index : u32) : i32 =
    conv (rng.draw (sub_key key index) % 4096u32)

:= irwin_hall_twelve (key : rng.roll_key) (attempt : u32) : i32 =
    :~ ^ sum (i : u32) (total : i32) : i32 =
        ? i >= 12u32 ?> total |: sum (i + 1u32) (total + uniform_unit key (attempt * 12u32 + i))
    sum 0u32 0i32

:= truncated_normal_unit (key : rng.roll_key) : i32 =
    :~ ^ attempt (n : u32) : i32 =
        := v = 2048i32 + (irwin_hall_twelve key n - 24576i32) / 4i32
        ? v >= 0i32 && v <= unit_scale () ?> v
        |? n >= 7u32 ?> (? v < 0i32 ?> 0i32 |: unit_scale ())
        |: attempt (n + 1u32)
    attempt 0u32

:= unit_draw_stats (seed : u32) (count : i32) : i32 * i32 * i32 =
    :~ ^ loop (i : i32) (total : i32) (low : i32) (high : i32) : i32 * i32 * i32 =
        ? i >= count ?> total / count, low, high
        |:
            := v = truncated_normal_unit (rng.roll_key seed (conv i) 0u32 9u32)
            loop (i + 1i32) (total + v) (? v < low ?> v |: low) (? v > high ?> v |: high)
    loop 0i32 0i32 (unit_scale ()) 0i32

:= melee_roll (low : i32) (high : i32) (key : rng.roll_key) : i32 =
    low + (truncated_normal_unit key * (high - low) + 2048i32) / unit_scale ()

:= uniform_between (low : i32) (high : i32) (key : rng.roll_key) (index : u32) : i32 =
    conv (rng.roll_between (conv low) (conv high) (sub_key key index))

:= defense_block (defense : i32) (key : rng.roll_key) : i32 =
    uniform_between (defense / 2i32) defense key 200u32

:= armor_block (armor : i32) (key : rng.roll_key) : i32 =
    ? armor > 3i32 ?> uniform_between (armor / 2i32) (armor - (armor % 2i32 + 1i32)) key 201u32
    |? armor > 0i32 ?> 1i32
    |: 0i32

:= blocked_hit (raw : i32) (defense : i32) (armor : i32) (has_block_charge : bool) (key : rng.roll_key) : i32 =
    := after_defense = ? has_block_charge ?> raw - defense_block defense key |: raw
    ? after_defense <= 0i32 ?> 0i32
    |:
        := after_armor = after_defense - armor_block armor key
        ? after_armor <= 0i32 ?> 0i32 |: after_armor

:== gear = { armor : i32; defense : i32 }

:= balanced_defense_percent () : i32 = 75i32
:= shield_scaling_per_mille () : i32 = 160i32

:= shielded_defense (shield_skill : i32) (shield_defense : i32) : i32 =
    (shield_skill * 25i32 + 223i32)
    * shield_defense
    * balanced_defense_percent ()
    * shield_scaling_per_mille ()
    / 10000000i32

:= knight_sample_gear () : gear =
    := brass_helmet = 3i32
    := brass_armor = 8i32
    := brass_legs = 5i32
    := leather_boots = 1i32
    := dwarven_shield = 26i32
    { armor = brass_helmet + brass_armor + brass_legs + leather_boots; defense = shielded_defense 11i32 dwarven_shield }

:= max_block_charges () : i32 = 2i32
:= block_charge_ms () : i32 = 1000i32

:= creature_hit (melee_max : i32) (defender : gear) (shielded : bool) (key : rng.roll_key) : i32 =
    blocked_hit (melee_roll 0i32 melee_max key) defender.defense defender.armor shielded key

:== ranged_attack = { chance_percent : i32; max_damage : i32; range : i32; every_ms : i32 }

:= hunter_arrow () : ranged_attack = { chance_percent = 50; max_damage = 100; range = 7; every_ms = 2000 }

:= ranged_in_reach (attack : ranged_attack) (distance : i32) (sight_clear : bool) : bool =
    distance <= attack.range && sight_clear

:= ranged_fires (attack : ranged_attack) (key : rng.roll_key) : bool =
    uniform_between 1i32 100i32 key 202u32 <= attack.chance_percent

:= ranged_hit_spending_a_charge
    (attack : ranged_attack) (defender : gear) (charges : i32) (key : rng.roll_key)
    : i32 * i32
    =
    blocked_hit (melee_roll 0i32 attack.max_damage key) defender.defense defender.armor !- key,
    ? charges > 0i32
    ?> charges - 1i32
    |: 0i32

:= melee_hit
    (mode : damage.fight_mode) (level : i32) (attack_value : i32) (attack_skill : i32) (defense : i32) (armor : i32)
    (key : rng.roll_key)
    : i32
    =
    := high = damage.max_melee_damage mode attack_value attack_skill level
    := low = ? attack_value > 0i32 ?> level / 5i32 |: 0i32
    blocked_hit (melee_roll low high key) defense armor !+ key

:= swing_stats
    (mode : damage.fight_mode) (level : i32) (attack_value : i32) (attack_skill : i32) (defense : i32) (armor : i32)
    (seed : u32) (swings : i32)
    : i32 * i32
    =
    :~ ^ loop (i : i32) (landed : i32) (total : i32) : i32 * i32 =
        ? i >= swings
        ?> landed, total
        |:
            := hit =
                melee_hit mode level attack_value attack_skill defense armor (rng.roll_key seed (conv i) 1u32 7u32)
            loop (i + 1i32) (? hit > 0i32 ?> landed + 1i32 |: landed) (total + hit)
    loop 0i32 0i32 0i32

:= capped_hit_stats
    (mode : damage.fight_mode) (level : i32) (attack_value : i32) (attack_skill : i32) (defense : i32) (armor : i32)
    (max_health : i32) (seed : u32) (swings : i32)
    : i32 * i32
    =
    :~ ^ loop (i : i32) (health : i32) (landed : i32) (total : i32) : i32 * i32 =
        ? i >= swings
        ?> landed, total
        |:
            := hit =
                melee_hit mode level attack_value attack_skill defense armor (rng.roll_key seed (conv i) 1u32 7u32)
            := taken = ? hit > health ?> health |: hit
            := left = health - taken
            loop
                (i + 1i32)
                ? left <= 0i32
                ?> max_health
                |: left
                ? taken > 0i32
                ?> landed + 1i32
                |: landed
                (total + taken)
    loop 0i32 max_health 0i32 0i32

///> c
test hunter_arrows_skip_the_shield_but_spend_a_block_charge_like_canary_distance_spells =
    := ~shots = 4000i32
    := gear = knight_sample_gear ()
    :~ ^ loop (i : i32) (differ : i32) (spent : i32) (total : i32) : i32 * i32 * i32 =
        ? i >= shots
        ?> differ, spent, total
        |:
            := key = rng.roll_key 9u32 (conv i) 2u32 11u32
            := hurt, left = ranged_hit_spending_a_charge (hunter_arrow ()) gear 2i32 key
            := unshielded = creature_hit (hunter_arrow ()).max_damage gear !- key
            loop
                (i + 1i32)
                ? hurt = unshielded
                ?> differ
                |: differ + 1i32
                ? left = 1i32
                ?> spent + 1i32
                |: spent
                (total + hurt)
    := differ, spent, total = loop 0i32 0i32 0i32 0i32
    := _, empty = ranged_hit_spending_a_charge (hunter_arrow ()) gear 0i32 (rng.roll_key 9u32 0u32 2u32 11u32)
    (differ, spent, empty, total > shots * 30i32) |> _assert_eq (0i32, shots, 0i32, !+)

///> c
test hunter_arrows_need_range_7_and_clear_sight_and_fire_half_the_time =
    := ~range = 7i32
    := arrow = hunter_arrow ()
    :~ ^ fired (i : i32) (count : i32) : i32 =
        ? i >= 10000i32
        ?> count
        |:
            fired
                (i + 1i32)
                ? ranged_fires arrow (rng.roll_key 3u32 (conv i) 4u32 12u32)
                ?> count + 1i32
                |: count
    := shots = fired 0i32 0i32
    (
        ranged_in_reach arrow range !+,
        ranged_in_reach arrow (range + 1i32) !+,
        ranged_in_reach arrow 3i32 !-,
        shots > 4800i32 && shots < 5200i32
    )
    |> _assert_eq (!+, !-, !-, !+)

///> c
test armor_block_follows_canary_bounds =
    := ~armor = 10i32
    := key = rng.roll_key 1u32 2u32 3u32 4u32
    := block = armor_block armor key
    (block >= 5i32 && block <= 9i32) |> _assert_eq !+
    armor_block (armor - 7i32) key |> _assert_eq 1i32
    armor_block (armor - 10i32) key |> _assert_eq 0i32

///> c
test truncated_normal_stays_in_unit_range_with_mean_near_half =
    := ~seed = 11u32
    ?= unit_draw_stats seed 4000i32 ?|
    | mean, low, high =>
        mean |> _assert_eq 2055i32
        low |> _assert_eq 0i32
        high |> _assert_eq 4093i32

///> c
test level_8_knight_rarely_hurts_a_troll =
    := ~seed = 5u32
    ?= swing_stats (:< damage ;; Offensive) 8i32 21i32 11i32 10i32 10i32 seed 2000i32 ?|
    | landed, total =>
        landed |> _assert_eq 435i32
        total |> _assert_eq 1393i32

///> c
test axe_skill_30_hurts_a_troll_often =
    := ~seed = 5u32
    ?= swing_stats (:< damage ;; Offensive) 8i32 21i32 30i32 10i32 10i32 seed 2000i32 ?|
    | landed, total =>
        landed |> _assert_eq 1680i32
        total |> _assert_eq 28222i32

///> c
test balanced_axe_skill_30_matches_live_troll_hits =
    := ~seed = 5u32
    ?= swing_stats (:< damage ;; Balanced) 8i32 21i32 30i32 10i32 10i32 seed 2000i32 ?|
    | landed, total =>
        landed |> _assert_eq 1435i32
        total |> _assert_eq 15398i32

///> wgsl
test balanced_swing_stats_on_gpu =
    := ~seed = 5u32
    ?= swing_stats (:< damage ;; Balanced) 8i32 21i32 30i32 10i32 10i32 seed 2000i32 ?|
    | landed, total => ? landed = 1435i32 && total = 15398i32 ?> 0i32 |: 1i32

///> c
test hits_capped_at_remaining_health_match_live_skeleton_log =
    := ~seed = 5u32
    ?= capped_hit_stats (:< damage ;; Balanced) 8i32 21i32 30i32 10i32 10i32 50i32 seed 2000i32 ?|
    | landed, total =>
        landed |> _assert_eq 1435i32
        total |> _assert_eq 13451i32
