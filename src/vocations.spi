///- --package .
test vocations static =
    :< testing

:! knight = ()
:! paladin = ()
:! sorcerer = ()
:! druid = ()

:| healer v =
    | PaladinHeals :: healer paladin
    | SorcererHeals :: healer sorcerer
    | DruidHeals :: healer druid

:| spell v =
    | WoundCleansing :: spell knight
    | Berserk :: spell knight
    | DivineHealing :: spell paladin
    | LightHealing :: \* v. healer v -> spell v
    | IntenseHealing :: \* v. healer v -> spell v

:== spell_data =
    {
        words : string
        level : i32
        mana : i32
        cooldown_ms : i32
        group_cooldown_ms : i32
        group : cooldowns.spell_group
    }

:= data_of \* v. (s : spell v) : spell_data =
    :< cooldowns
    ?= s ?|
    | WoundCleansing =>
        {
            words = "exura ico"
            level = 8
            mana = 40
            cooldown_ms = 1000
            group_cooldown_ms = 1000
            group = HealingGroup
        }
    | Berserk =>
        { words = "exori"; level = 35; mana = 115; cooldown_ms = 4000; group_cooldown_ms = 2000; group = AttackGroup }
    | DivineHealing =>
        {
            words = "exura san"
            level = 35
            mana = 160
            cooldown_ms = 1000
            group_cooldown_ms = 1000
            group = HealingGroup
        }
    | LightHealing _ =>
        { words = "exura"; level = 8; mana = 20; cooldown_ms = 1000; group_cooldown_ms = 1000; group = HealingGroup }
    | IntenseHealing _ =>
        {
            words = "exura gran"
            level = 20
            mana = 70
            cooldown_ms = 1000
            group_cooldown_ms = 1000
            group = HealingGroup
        }

:= cooldown_id_of \* v. (s : spell v) : cooldowns.spell_id =
    :< cooldowns
    ?= s ?|
    | WoundCleansing => WoundCleansingSpell
    | Berserk => StrikeSpell
    | DivineHealing => LightHealingSpell
    | LightHealing _ => LightHealingSpell
    | IntenseHealing _ => LightHealingSpell

:= as_cooldown \* v. (s : spell v) : cooldowns.spell =
    := d = data_of s
    { id = cooldown_id_of s; group = d.group; own_ms = d.cooldown_ms; group_ms = d.group_cooldown_ms }

:= castable \* v. (level : i32) (mana : i32) (s : spell v) : bool =
    := d = data_of s
    level >= d.level && mana >= d.mana

:= knight_heal () : spell knight = WoundCleansing

///> c
test spell_data_matches_canary_scripts =
    := ~level = 8i32
    castable level 90 WoundCleansing |> _assert_eq !+
    castable level 90 Berserk |> _assert_eq !-
    castable (level + 12) 70 (IntenseHealing DruidHeals) |> _assert_eq !+
    (data_of (LightHealing PaladinHeals)).mana |> _assert_eq 20i32
    (data_of Berserk).cooldown_ms |> _assert_eq 4000i32

///> c
test a_knight_cannot_cast_light_healing fails "Unification failure" =
    := s : spell knight = LightHealing PaladinHeals
    (data_of s).mana

///> c
test a_paladin_cannot_cast_wound_cleansing fails "Unification failure" =
    := s : spell paladin = WoundCleansing
    (data_of s).mana

///> wgsl
test spell_data_on_gpu =
    := ~level = 8i32
    ? castable level 90 WoundCleansing && castable level 90 Berserk = !- && (data_of Berserk).cooldown_ms = 4000i32
    ?> 0i32
    |: 1i32
