test on_the_hunting_ground_walking_pays_and_the_evolved_shuttle_edges_the_hand_route =
    :< hunting_pack
    := camp = arena_hunt ()
    := ~tuned = cavebot_heal_tuned_on Experience camp (training_block ())
    := cavebot = cavebot_with_heal tuned
    := judged (t : tactic) : i32 = quantity.value_of (judged_on Experience camp t (held_out_block ()))
    (
        tuned,
        judged cavebot,
        judged (cavebot |> patrolling (plaza_and_fields_route ())),
        judged (cavebot |> patrolling (spawn_side_loop_route ())),
        judged (cavebot |> sweeping_spawns),
        judged (cavebot |> patrolling (central_shuttle_route ()))
    )
    |> _assert_eq (120i32, 109030i32, 107540i32, 113040i32, 118460i32, 124830i32)

