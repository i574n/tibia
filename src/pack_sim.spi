///> c
test a_corridor_cuts_potions_and_deaths_in_a_cyclops_clear =
    :< hunting_pack
    :< creatures
    := ~first = 1u32
    := open_field = uniform_camp Cyclops
    := corridor = open_field |> on_layout (:< terrain ;; EastCorridor)
    :~ ^ sum (camp : camp) (i : i32) (ms : i32) (potions : i32) (deaths : i32) : i32 * i32 * i32 =
        ? i >= 20 ?> ms / 20, potions * 10 / 20, deaths
        |:
            ?= clear_run camp (cavebot_with_heal 100) (first + conv i) 6000 ?|
            | elapsed, p => sum camp (i + 1) (ms + elapsed) (potions + p.hunter.potions) (deaths + p.deaths)
    := in_the_open = sum open_field 0 0 0 0
    := in_the_corridor = sum corridor 0 0 0 0
    (in_the_open, in_the_corridor) |> _assert_eq ((85915i32, 153i32, 3i32), (85000i32, 65i32, 0i32))
    := _, open_potions, open_deaths = in_the_open
    := _, corridor_potions, corridor_deaths = in_the_corridor
    (corridor_potions < open_potions, corridor_deaths < open_deaths) |> _assert_eq (!+, !+)

///> c
test room_and_corridor_evolved_retreat_dominates_the_fully_tuned_cavebot =
    :< hunting_pack
    :< creatures
    := ~search = 29u32
    := room = uniform_camp Cyclops |> on_layout (:< terrain ;; RoomAndCorridor)
    := heal = cavebot_heal_tuned_on Profit room (training_block ())
    := floor = (ledger_on room (cavebot_with_heal heal) (training_block ())).hunt_kills
    := objective = ProfitKeepingKills floor
    := training t = worth_on_training objective room t (training_block ())
    := held_out t =
        := l = ledger_on room t (held_out_block ())
        l.hunt_kills, quantity.value_of l.hunt_profit
    := evolve order =
        rules_evolved_on objective order { first = heal; second = 0; third = 4 } room search (training_block ()) 6 6
    := current = evolve (:< policy ;; CurrentFirst)
    := reach = evolve (:< policy ;; ReachFirst)
    := current_worth = training (tactic_with_order (:< policy ;; CurrentFirst) current)
    := reach_worth = training (tactic_with_order (:< policy ;; ReachFirst) reach)
    := chosen =
        ? reach_worth > current_worth
        ?> tactic_with_order (:< policy ;; ReachFirst) reach
        |: tactic_with_order (:< policy ;; CurrentFirst) current
    := genes = ? reach_worth > current_worth ?> reach |: current
    := cavebot = held_out (cavebot_with_heal heal)
    := evolved = held_out chosen
    ((heal, floor, genes.first, genes.second, genes.third, reach_worth > current_worth), cavebot, evolved)
    |> _assert_eq ((230i32, 956i32, 207i32, 34i32, 3i32, !+), (942i32, -477181i32), (946i32, -288217i32))
    := base_kills, base_profit = cavebot
    := kills, profit = evolved
    (kills >= base_kills, profit > base_profit) |> _assert_eq (!+, !+)

///> c
test the_arena_spot_clear_takes_the_live_clear_time =
    :< hunting_pack
    :< creatures
    := ~first = 1u32
    := spot = uniform_camp Cyclops |> on_layout (:< terrain ;; ArenaSpot)
    :~ ^ sum (i : i32) (ms : i32) (potions : i32) (deaths : i32) (hits : i32) (taken : i32) : i32 * i32 * i32 * i32 =
        ? i >= 20
        ?> ms / 20, potions * 10 / 20, deaths, taken * 100 / hits
        |:
            ?= clear_run spot (cavebot_with_heal 160) (first + conv i) 6000 ?|
            | elapsed, p =>
                sum
                    (i + 1)
                    (ms + elapsed)
                    (potions + p.hunter.potions)
                    (deaths + p.deaths)
                    (hits + p.hunter.hits_taken)
                    (taken + quantity.value_of p.hunter.damage_taken)
    sum 0 0 0 0 0 0 |> _assert_eq (87600i32, 168i32, 0i32, 3591i32)

///> c
test on_the_arena_spot_retreating_at_two_attackers_saves_potions =
    :< hunting_pack
    :< creatures
    := ~first = 1u32
    := spot = uniform_camp Cyclops |> on_layout (:< terrain ;; ArenaSpot)
    :~ ^ sum (t : tactic) (i : i32) (ms : i32) (potions : i32) (deaths : i32) : i32 * i32 * i32 =
        ? i >= 20 ?> ms / 20, potions * 10 / 20, deaths
        |:
            ?= clear_run spot t (first + conv i) 6000 ?|
            | elapsed, p => sum t (i + 1) (ms + elapsed) (potions + p.hunter.potions) (deaths + p.deaths)
    := rules order n = tactic_with_order order { first = 160; second = 0; third = n }
    := kite order n =
        := t = network_tactic (cavebot_network spot 160 |> network.with_kiting n)
        { t ?| order = order }
    :< policy
    := cavebot = sum (cavebot_with_heal 160) 0 0 0 0
    := retreating = sum (rules ReachFirst 2) 0 0 0 0
    (
        cavebot,
        retreating,
        sum (rules ReachFirst 3) 0 0 0 0,
        sum (rules CurrentFirst 2) 0 0 0 0,
        sum (kite ReachFirst 2) 0 0 0 0
    )
    |> _assert_eq (
        (87600i32, 168i32, 0i32),
        (88545i32, 159i32, 0i32),
        (85610i32, 139i32, 0i32),
        (98605i32, 153i32, 0i32),
        (87500i32, 154i32, 0i32)
    )
    := _, cavebot_potions, cavebot_deaths = cavebot
    := _, retreat_potions, retreat_deaths = retreating
    (retreat_potions < cavebot_potions, retreat_deaths <= cavebot_deaths) |> _assert_eq (!+, !+)

///> c
test on_the_real_arena_map_evolved_rules_save_potions_at_a_slightly_slower_clear =
    :< hunting_pack
    :< creatures
    := ~search = 31u32
    := spot = uniform_camp Cyclops |> on_layout (:< terrain ;; ArenaSpot)
    := tf = training_first ()
    := tc = training_count ()
    := heal = tuned_cavebot_heal_for (CheapClearWithin 1000000) spot tf tc
    := cavebot_ms = (clear_ledger_of spot (cavebot_with_heal heal) tf tc).clear_ms / tc
    := objective = CheapClearWithin (cavebot_ms * 115 / 100)
    := training t = worth objective spot t tf tc
    := evolve order = evolve_rules_for objective order { first = heal; second = 0; third = 4 } spot search tf tc 6 6
    := current = evolve (:< policy ;; CurrentFirst)
    := reach = evolve (:< policy ;; ReachFirst)
    := reach_wins =
        training (tactic_with_order (:< policy ;; ReachFirst) reach)
        > training (tactic_with_order (:< policy ;; CurrentFirst) current)
    := genes = ? reach_wins ?> reach |: current
    := evolved =
        ? reach_wins
        ?> tactic_with_order (:< policy ;; ReachFirst) reach
        |: tactic_with_order (:< policy ;; CurrentFirst) current
    := held t =
        := l = clears_judged_on spot t (held_out_block ())
        l.clear_potions, l.clear_deaths, l.clear_ms / held_out_count ()
    := baseline = held (cavebot_with_heal heal)
    := learned = held evolved
    ((heal, cavebot_ms, genes.first, genes.second, genes.third, reach_wins), baseline, learned)
    |> _assert_eq ((90i32, 88400i32, 88i32, 26i32, 1i32, !+), (1702i32, 0i32, 90140i32), (1070i32, 1i32, 95629i32))
    := base_potions, base_deaths, base_ms = baseline
    := potions, deaths, ms = learned
    (potions < base_potions, deaths <= base_deaths, ms <= base_ms, ms <= cavebot_ms * 115 / 100)
    |> _assert_eq (!+, !-, !-, !+)

///> c
test mixed_arena_camp_evolved_rules_dominate_the_tuned_cavebot_and_kind_aware_cyclops_rules_drink_less =
    :< hunting_pack
    :< policy
    := ~search_seed = 37u32
    := camp = cyclops_and_two_trolls_on_the_arena_spot ()
    := tf = training_first ()
    := tc = training_count ()
    := heal = tuned_cavebot_heal_for (CheapClearWithin 1000000) camp tf tc
    := cavebot_ms = (clear_ledger_of camp (cavebot_with_heal heal) tf tc).clear_ms / tc
    := objective = CheapClearWithin (cavebot_ms * 115 / 100)
    := training t = worth objective camp t tf tc
    := blind order =
        evolve_rules_for objective order { first = heal; second = 0; third = 4 } camp search_seed tf tc 6 6
    := blind_current = blind CurrentFirst
    := blind_reach = blind ReachFirst
    := blind_reach_wins =
        training (tactic_with_order ReachFirst blind_reach) > training (tactic_with_order CurrentFirst blind_current)
    := blind_genes = ? blind_reach_wins ?> blind_reach |: blind_current
    := blind_tactic = tactic_with_order (? blind_reach_wins ?> ReachFirst |: CurrentFirst) blind_genes
    := aware order =
        evolve_temperate_for objective order (temperate_genes heal 0 0 4 4) camp (search_seed + 2u32) tf tc 6 3
    := aware_current = aware CurrentFirst
    := aware_reach = aware ReachFirst
    := aware_reach_wins =
        training (temperate_tactic ReachFirst aware_reach) > training (temperate_tactic CurrentFirst aware_current)
    := aware_genes = ? aware_reach_wins ?> aware_reach |: aware_current
    := aware_tactic = temperate_tactic (? aware_reach_wins ?> ReachFirst |: CurrentFirst) aware_genes
    := gene i = search.gene aware_genes i
    := held t =
        := l = clears_judged_on camp t (held_out_block ())
        l.clear_potions, l.clear_deaths, l.clear_ms / held_out_count ()
    := cavebot = held (cavebot_with_heal heal)
    := blind_evolved = held blind_tactic
    := cyclops_rules = held (tactic_with_order CurrentFirst (evolved_on_the_cyclops_spot ()))
    := cyclops_rules_standing_only =
        held (temperate_tactic CurrentFirst (against_standing_only (evolved_on_the_cyclops_spot ())))
    := aware_evolved = held aware_tactic
    (
        (heal, cavebot_ms, blind_genes.first, blind_genes.second, blind_genes.third, blind_reach_wins),
        (gene 0, gene 1, gene 2, gene 3, gene 4, aware_reach_wins)
    )
    |> _assert_eq ((80i32, 38366i32, 59i32, 5i32, 3i32, !-), (0i32, 62i32, 0i32, 4i32, 2i32, !-))
    (cavebot, blind_evolved, cyclops_rules, cyclops_rules_standing_only, aware_evolved)
    |> _assert_eq (
        (85i32, 0i32, 37668i32),
        (73i32, 0i32, 37559i32),
        (190i32, 0i32, 38608i32),
        (135i32, 0i32, 37806i32),
        (67i32, 1i32, 37866i32)
    )
    := dominates (p, d, ms) (bp, bd, bms) = p <= bp && d <= bd && ms <= bms && (p < bp || d < bd || ms < bms)
    (
        dominates aware_evolved cavebot,
        dominates aware_evolved blind_evolved,
        dominates blind_evolved cavebot,
        dominates cyclops_rules_standing_only cyclops_rules
    )
    |> _assert_eq (!-, !-, !+, !+)

