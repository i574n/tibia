    respawns spawntime |> _assert_eq (94200, 64200, 124200)

:= random_hunt (camp : camp) : tally3 =
    := l = hunting_pack.ledger_on camp (hunting_pack.random_control ()) (hunting_pack.held_out_block ())
    l.hunt_kills, l.hunt_deaths, quantity.value_of l.hunt_profit

:= random_clear () : tally3 =
    := held = hunting_pack.held_out_block ()
    := l = hunting_pack.clears_judged_on (spot_camp ()) (hunting_pack.random_control ()) held
    l.clear_potions, l.clear_deaths, l.clear_ms

:= random_rows (marker : i32) : i32 * tally3 * tally3 =
    := camp = hunting_pack.arena_hunt ()
    ground_xp camp (hunting_pack.random_control ()) + marker, random_hunt camp, random_clear ()

:= random_expected () : i32 * tally3 * tally3 = 57950, (993, 0, -1145455), (7206, 0, 9353800)

///> c
test the_random_control_stays_far_below_every_rule =
    := ~marker = 0i32
    random_rows marker |> _assert_eq (random_expected ())

:= sweeping_heal (camp : camp) : i32 =
    := b = hunting_pack.training_block ()
    hunting_pack.shaped_cavebot_heal_tuned_on (:< hunting_pack ;; Experience) hunting_pack.sweeping_spawns camp b

:= ground_judged (camp : camp) (t : tactic) : tally3 =
    := l = hunting_pack.ledger_on camp t (hunting_pack.held_out_block ())
    ground_xp camp t, l.hunt_deaths, quantity.value_of l.hunt_profit

:= retreat_tactic () : tactic = hunting_pack.tactic_with_order (reach_order ()) { first = 154; second = 26; third = 2 }

:= sweeping_cavebot (heal : i32) : tactic = hunting_pack.cavebot_with_heal heal |> hunting_pack.sweeping_spawns

:= shuttling_cavebot (heal : i32) : tactic =
    hunting_pack.cavebot_with_heal heal |> hunting_pack.patrolling (hunting_pack.central_shuttle_route ())

:= cavebot_rows (camp : camp) (standing : i32) (sweeping : i32) : tally3 * tally3 * tally3 =
    := at = ground_judged camp
    at (hunting_pack.cavebot_with_heal standing), at (sweeping_cavebot sweeping), at (shuttling_cavebot standing)

:= ground_rows (camp : camp) (standing : i32) (sweeping : i32) : row5 =
    := cave, sweep, shuttle = cavebot_rows camp standing sweeping
    := r = retreat_tactic ()
    cave, sweep, shuttle, ground_judged camp r, ground_judged camp (hunting_pack.sweeping_spawns r)

:= ground_experiment (camp : camp) : (i32 * i32) * row5 =
    := ~standing = standing_heal camp
    := sweeping = sweeping_heal camp
    (standing, sweeping), ground_rows camp standing sweeping

:= ground_expected () : (i32 * i32) * row5 =
    (
        (120, 130),
        ((102550, 4, -248017), (127200, 3, -296549), (132200, 2, -281049), (100650, 0, -118297), (120750, 0, -167225))
    )

