test the_current_arena_bundle_pins_rules_and_retreat_potions_and_hits_over_the_held_out_block =
    :< hunting_pack
    := totals (camp : camp) (t : tactic) : i32 * i32 =
        :~ ^ each (i : i32) (potions : i32) (hits : i32) : i32 * i32 =
            ? i >= (range_of (held_out_block ())).count ?> potions, hits
            |:
                := elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (hits + p.hunter.hits_taken)
        each 0 0 0
    := ~kind = :< creatures ;; Cyclops
    := arena = uniform_camp kind |> on_layout (:< terrain ;; ArenaSpot) |> mirroring_the_current_arena
    (totals arena (cavebot_with_heal 160), totals arena (live_retreat_tactic 160 2))
    |> _assert_eq ((1394i32, 6649i32), (1332i32, 6428i32))

///> c
test by_canary_formula_a_cyclops_steps_700_ms_on_arena_ground_and_450_on_the_road_and_the_level_30_knight_500_and_300 =
    :< hunting_pack
    := camp =
        uniform_camp (:< creatures ;; Cyclops)
        |> on_layout (:< terrain ;; ArenaSpot)
        |> stepping_by_canary_formula
    := ~ground = geometry.position 99 99 7
    := road = geometry.position 115 89 7
    := cyclops = creatures.stats_of (:< creatures ;; Cyclops)
    (
        step_ms_at camp ground cyclops.speed cyclops.step_ms,
        step_ms_at camp road cyclops.speed cyclops.step_ms,
        hunter_step_ms_at camp ground,
        hunter_step_ms_at camp road
    )
    |> _assert_eq (700i32, 450i32, 500i32, 300i32)

