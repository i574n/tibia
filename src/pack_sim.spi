test on_the_cyclops_hunting_ground_sweeping_leads_and_stepping_back_buys_cost =
    ground_experiment (hunting_pack.cyclops_hunting_ground ()) |> _assert_eq (ground_expected ())

:= wake_spot (wake : i32) : tally3 * tally3 =
    := spot = spot_camp () |> hunting_pack.waking_at wake
    held_out_totals spot (cavebot_160 ()), held_out_totals spot (retreat_tactic ())

:= wake_rows (wake : i32) : tally3 * tally3 * tally3 =
    := cave, retreat = wake_spot wake
    cave, retreat, held_out_totals (mixed_camp () |> hunting_pack.waking_at wake) (cavebot_160 ())

:= wake_expected () : tally3 * tally3 * tally3 = (1334, 8838000, 6417), (1201, 9040500, 5835), (36, 3710300, 946)

///> c
test the_live_wake_delay_brings_the_arena_clears_toward_the_live_potion_counts =
    := ~wake = hunting_pack.live_wake_ms ()
    wake_rows wake |> _assert_eq (wake_expected ())

:= canary_swings (spot : camp) : tally3 * tally3 =
    := canary = spot |> hunting_pack.swinging_like_canary
    held_out_totals canary (reach_rules 2), held_out_totals canary (cavebot_160 ())

:= swing_rows () : tally3 * tally3 * tally3 =
    := spot = spot_camp () |> hunting_pack.waking_at (hunting_pack.live_wake_ms ())
    := retreat, cavebot = canary_swings spot
    held_out_totals spot (reach_rules 2), retreat, cavebot

:= swing_expected () : tally3 * tally3 * tally3 = (1179, 8968500, 5750), (1232, 9033300, 6020), (1334, 8838000, 6417)

///> c
test after_a_step_the_swing_waits_for_a_think_or_a_move_costing_retreat_half_a_potion_and_rules_nothing =
    swing_rows () |> _assert_eq (swing_expected ())

:= mirrored_spot () : camp = spot_camp () |> hunting_pack.mirroring_the_live_arena

:= cavebot_and_retreat (camp : camp) : tally3 * tally3 =
    held_out_totals camp (cavebot_160 ()), held_out_totals camp (live_retreat ())

:= mirror_rows () : (tally3 * tally3) * (tally3 * tally3) =
    := three = mirrored_spot ()
    cavebot_and_retreat three, cavebot_and_retreat (three |> hunting_pack.sized 2)

:= mirror_expected () : (tally3 * tally3) * (tally3 * tally3) =
    ((1230, 8937100, 5986), (1176, 9424500, 5640)), ((472, 6142500, 2793), (491, 6415400, 2924))

///> c
test mirroring_the_live_arena_predicts_rules_and_retreat_within_the_live_noise_at_two_and_three_cyclops =
    mirror_rows () |> _assert_eq (mirror_expected ())

:== kp3 = kp * kp * kp

:= never_retreating () : tactic =
    hunting_pack.tactic_with_order (reach_order ()) { first = 160; second = 0; third = policy.never_retreat () }

:= first_swing_three (three : camp) : kp3 =
    := at = potions_hits three
    at (cavebot_160 ()), at (never_retreating ()), at (live_retreat ())

:= first_swing_rest (three : camp) : kp3 =
    := two = potions_hits (three |> hunting_pack.sized 2)
    two (cavebot_160 ()), two (live_retreat ()), potions_hits (three |> hunting_pack.waking_at 0) (cavebot_160 ())

:= first_swing_rows () : kp3 * kp3 =
    := three = mirrored_spot ()
    first_swing_three three, first_swing_rest three

:= first_swing_expected () : kp3 * kp3 =
    ((1230, 5986), (1247, 6021), (1176, 5640)), ((472, 2793), (491, 2924), (1529, 7076))

///> c
test a_cyclops_first_swing_waits_one_period_after_it_can_target_which_fits_six_live_means_best =
    first_swing_rows () |> _assert_eq (first_swing_expected ())


:= cavebot_run (c : camp) (i : i32) : pack = hunting_pack.simulate c (cavebot_160 ()) (1001u32 + conv i) 1200

:~ ^ hunter_sums (c : camp) (i : i32) (kills : i32) (hits : i32) : kp =
    ? i >= 5 ?> kills, hits
    |:
        := p = cavebot_run c i
        hunter_sums c (i + 1) (kills + p.score.kills) (hits + p.hunter.tally.hits_taken)

:= hunter_camp (layout : terrain.layout) : camp =
    hunting_pack.clearing (hunting_pack.uniform_camp (:< creatures ;; Hunter) |> hunting_pack.on_layout layout)

:= kills_within (layout : terrain.layout) : kp = hunter_sums (hunter_camp layout) 0 0 0

:= hunter_rows () : kp * kp = kills_within (:< terrain ;; OpenField), kills_within (:< terrain ;; ArenaSpot)

:= cornered_only (rows : kp * kp) : bool * bool =
    := (open_kills, _), (arena_kills, _) = rows
    open_kills = 0, arena_kills > 0

///> c
test a_hunter_keeping_four_tiles_away_only_falls_where_walls_corner_it_and_walking_beside_the_knight_halves_its_pace =
    := rows = hunter_rows ()
    (rows, cornered_only rows) |> _assert_eq (((0, 173), (11, 82)), (!+, !+))

:= placed_at (camp : camp) (dx : i32) (dy : i32) : pack =
    := begun = hunting_pack.start camp
    := k = begun.hunter.at
    hunting_pack.with_slot 0 { (hunting_pack.slot 0 begun) ?| at = { k ?| x = k.x + dx; y = k.y + dy } } begun

:~ ^ foe_turns (camp : camp) (tick : i32) (p : pack) : pack =
    ? tick >= 10 ?> p
    |: foe_turns camp (tick + 1) (hunting_pack.foe_turn camp 1001u32 tick (tick * hunting_pack.tick_ms ()) 0 p)

:= closed_tiles (gap : i32) : i32 =
    := camp = hunter_camp (:< terrain ;; OpenField)
    := placed = placed_at camp gap 0
    geometry.chebyshev_distance (hunting_pack.slot 0 (foe_turns camp 0 placed)).at (hunting_pack.slot 0 placed).at

///> c
test a_hunter_beyond_four_tiles_closes_one_tile_per_think_like_canarys_follow_replanning =
    := ~gap = 8i32
    (closed_tiles gap, (creatures.stats_of (:< creatures ;; Hunter)).step_ms < 1000) |> _assert_eq (1i32, !+)

:= open_cyclops () : camp = cyclops_camp () |> hunting_pack.on_layout (:< terrain ;; OpenField)

:= dancing_cyclops () : camp = hunting_pack.clearing (open_cyclops () |> hunting_pack.dancing_like_canary)

:= dance_landing (camp : camp) (placed : pack) (i : i32) : geometry.position =
    (hunting_pack.slot 0 (hunting_pack.dance_step (hunting_pack.turn_at camp 1001u32 i 0 0) placed)).at

:== sides = bool * bool * bool

:= side_of (k : geometry.position) (moved : geometry.position) : bool * bool =
    moved.x = k.x + 1 && moved.y = k.y, moved.x = k.x && moved.y = k.y + 1

:= tallied_side (acc : sides) (side : bool * bool) : sides =
    := allowed, north, west = acc
    := went_north, went_west = side
    allowed && (went_north || went_west), north || went_north, west || went_west

:~ ^ dance_tries (camp : camp) (placed : pack) (i : i32) (acc : sides) : sides =
    ? i >= 20 ?> acc
    |: dance_tries camp placed (i + 1) (tallied_side acc (side_of placed.hunter.at (dance_landing camp placed i)))

///> c
test an_adjacent_cyclops_dances_only_along_the_two_sides_that_keep_it_next_to_the_knight_like_canary =
    := camp = dancing_cyclops ()
    dance_tries camp (placed_at camp 1 1) 0 (!+, !-, !-) |> _assert_eq (!+, !+, !+)

:== dancer = { camp : camp; placed : pack; seed : u32 }

:= dance_moved (d : dancer) (now : i32) : bool =
    := after = hunting_pack.dances d.camp d.seed (now / hunting_pack.tick_ms ()) now 0 d.placed
    geometry.same_tile (hunting_pack.slot 0 after).at (hunting_pack.slot 0 d.placed).at = !-

:~ ^ dance_thinks (d : dancer) (now : i32) (k : i32) (danced : i32) : i32 =
    ? k >= 200 ?> danced
    |:
        := moved = dance_moved d now
        dance_thinks d (now + hunting_pack.player_think_ms ()) (k + 1) (? moved ?> danced + 1 |: danced)

:= danced_of (seed : u32) : i32 =
    := camp = dancing_cyclops ()
    := d = { camp = camp; placed = placed_at camp 1 1; seed = seed }
    dance_thinks d (hunting_pack.creature_think_phase_ms seed 0) 0 0

///> c
test an_adjacent_cyclops_dances_on_about_one_think_in_ten_like_canarys_static_attack_chance_of_90 =
    := ~seed = 1001u32
    := danced = danced_of seed
    (danced >= 10, danced <= 30) |> _assert_eq (!+, !+)

