test the_random_control_stays_far_below_every_rule =
    :< hunting_pack
    := camp = arena_hunt ()
    := ~marker = 0i32
    := l = ledger_on camp (random_control ()) (held_out_block ())
    := spot = uniform_camp (:< creatures ;; Cyclops) |> on_layout (:< terrain ;; ArenaSpot)
    := clears = clears_judged_on spot (random_control ()) (held_out_block ())
    (
        quantity.value_of (judged_on Experience camp (random_control ()) (held_out_block ())) + marker,
        l.hunt_kills,
        l.hunt_deaths,
        quantity.value_of l.hunt_profit,
        clears.clear_potions,
        clears.clear_deaths,
        clears.clear_ms
    )
    |> _assert_eq (57950i32, 993i32, 0i32, -1145455i32, 7206i32, 0i32, 9353800i32)

///> c
test on_the_cyclops_hunting_ground_sweeping_leads_and_stepping_back_buys_cost =
    :< hunting_pack
    := camp = cyclops_hunting_ground ()
    := ~standing_heal = cavebot_heal_tuned_on Experience camp (training_block ())
    := sweeping_heal = shaped_cavebot_heal_tuned_on Experience sweeping_spawns camp (training_block ())
    := judged (t : tactic) : i32 * i32 * i32 =
        := l = ledger_on camp t (held_out_block ())
        quantity.value_of (judged_on Experience camp t (held_out_block ())),
        l.hunt_deaths,
        quantity.value_of l.hunt_profit
    := retreating = tactic_with_order (:< policy ;; ReachFirst) { first = 154; second = 26; third = 2 }
    (
        standing_heal,
        sweeping_heal,
        judged (cavebot_with_heal standing_heal),
        judged (cavebot_with_heal sweeping_heal |> sweeping_spawns),
        judged (cavebot_with_heal standing_heal |> patrolling (central_shuttle_route ())),
        judged retreating,
        judged (retreating |> sweeping_spawns)
    )
    |> _assert_eq (
        120i32,
        130i32,
        (102550i32, 4i32, -248017i32),
        (127200i32, 3i32, -296549i32),
        (132200i32, 2i32, -281049i32),
        (100650i32, 0i32, -118297i32),
        (120750i32, 0i32, -167225i32)
    )
///> c
test the_live_wake_delay_brings_the_arena_clears_toward_the_live_potion_counts =
    :< hunting_pack
    := ~wake = live_wake_ms ()
    := totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        :~ ^ each (i : i32) (potions : i32) (ms : i32) (hits : i32) : i32 * i32 * i32 =
            ? i >= (range_of (held_out_block ())).count ?> potions, ms, hits
            |:
                := elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (ms + elapsed) (hits + p.hunter.hits_taken)
        each 0 0 0 0
    := spot = uniform_camp (:< creatures ;; Cyclops) |> on_layout (:< terrain ;; ArenaSpot) |> waking_at wake
    := mixed = cyclops_and_two_trolls_on_the_arena_spot () |> waking_at wake
    := retreat = tactic_with_order (:< policy ;; ReachFirst) { first = 154; second = 26; third = 2 }
    (totals spot (cavebot_with_heal 160), totals spot retreat, totals mixed (cavebot_with_heal 160))
    |> _assert_eq ((1334i32, 8838000i32, 6417i32), (1201i32, 9040500i32, 5835i32), (36i32, 3710300i32, 946i32))

///> c
test after_a_step_the_swing_waits_for_a_think_or_a_move_costing_retreat_half_a_potion_and_rules_nothing =
    :< hunting_pack
    := totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        :~ ^ each (i : i32) (potions : i32) (ms : i32) (hits : i32) : i32 * i32 * i32 =
            ? i >= (range_of (held_out_block ())).count ?> potions, ms, hits
            |:
                := elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (ms + elapsed) (hits + p.hunter.hits_taken)
        each 0 0 0 0
    := spot =
        uniform_camp (:< creatures ;; Cyclops) |> on_layout (:< terrain ;; ArenaSpot) |> waking_at (live_wake_ms ())
    := live_retreat = tactic_with_order (:< policy ;; ReachFirst) { first = 160; second = 0; third = 2 }
    (
        totals spot live_retreat,
        totals (spot |> swinging_like_canary) live_retreat,
        totals (spot |> swinging_like_canary) (cavebot_with_heal 160)
    )
    |> _assert_eq ((1179i32, 8968500i32, 5750i32), (1232i32, 9033300i32, 6020i32), (1334i32, 8838000i32, 6417i32))

///> c
test mirroring_the_live_arena_predicts_rules_and_retreat_within_the_live_noise_at_two_and_three_cyclops =
    :< hunting_pack
    := totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        :~ ^ each (i : i32) (potions : i32) (ms : i32) (hits : i32) : i32 * i32 * i32 =
            ? i >= (range_of (held_out_block ())).count ?> potions, ms, hits
            |:
                := elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (ms + elapsed) (hits + p.hunter.hits_taken)
        each 0 0 0 0
    := three =
        uniform_camp (:< creatures ;; Cyclops) |> on_layout (:< terrain ;; ArenaSpot) |> mirroring_the_live_arena
    := two = { three ?| size = 2 }
    (
        totals three (cavebot_with_heal 160),
        totals three (live_retreat_tactic 160 2),
        totals two (cavebot_with_heal 160),
        totals two (live_retreat_tactic 160 2)
    )
    |> _assert_eq (
        (1230i32, 8937100i32, 5986i32),
        (1176i32, 9424500i32, 5640i32),
        (472i32, 6142500i32, 2793i32),
        (491i32, 6415400i32, 2924i32)
    )

///> c
test a_cyclops_first_swing_waits_one_period_after_it_can_target_which_fits_six_live_means_best =
    :< hunting_pack
    := totals (camp : camp) (t : tactic) : i32 * i32 =
        :~ ^ each (i : i32) (potions : i32) (hits : i32) : i32 * i32 =
            ? i >= (range_of (held_out_block ())).count ?> potions, hits
            |:
                := elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (hits + p.hunter.hits_taken)
        each 0 0 0
    := three =
        uniform_camp (:< creatures ;; Cyclops) |> on_layout (:< terrain ;; ArenaSpot) |> mirroring_the_live_arena
    := two = { three ?| size = 2 }
    := bare = three |> waking_at 0
    := reach =
        tactic_with_order (:< policy ;; ReachFirst) { first = 160; second = 0; third = policy.never_retreat () }
    (
        totals three (cavebot_with_heal 160),
        totals three reach,
        totals three (live_retreat_tactic 160 2),
        totals two (cavebot_with_heal 160),
        totals two (live_retreat_tactic 160 2),
        totals bare (cavebot_with_heal 160)
    )
    |> _assert_eq (
        (1230i32, 5986i32),
        (1247i32, 6021i32),
        (1176i32, 5640i32),
        (472i32, 2793i32),
        (491i32, 2924i32),
        (1529i32, 7076i32)
    )


///> c
test a_hunter_keeping_four_tiles_away_only_falls_where_walls_corner_it_and_walking_beside_the_knight_halves_its_pace =
    :< hunting_pack
    :< creatures
    := kills_within (layout : terrain.layout) : i32 * i32 =
        := camp = clearing (uniform_camp Hunter |> on_layout layout)
        :~ ^ each (i : i32) (kills : i32) (hits : i32) : i32 * i32 =
            ? i >= 5 ?> kills, hits
            |:
                := p = simulate camp (cavebot_with_heal 160) (1001u32 + conv i) 1200
                each (i + 1) (kills + p.kills) (hits + p.hunter.hits_taken)
        each 0 0 0
    := open_kills, open_hits = kills_within (:< terrain ;; OpenField)
    := arena_kills, arena_hits = kills_within (:< terrain ;; ArenaSpot)
    (open_kills, open_hits, arena_kills, arena_hits) |> _assert_eq (0i32, 173i32, 11i32, 82i32)
    (open_kills = 0, arena_kills > 0) |> _assert_eq (!+, !+)

///> c
test a_hunter_beyond_four_tiles_closes_one_tile_per_think_like_canarys_follow_replanning =
    :< hunting_pack
    :< creatures
    := camp = clearing (uniform_camp Hunter |> on_layout (:< terrain ;; OpenField))
    := begun = start camp
    := knight_at = begun.hunter.at
    := f = slot 0 begun
    := ~gap = 8i32
    := placed = with_slot 0 { f ?| at = { knight_at ?| x = knight_at.x + gap } } begun
    :~ ^ turns (tick : i32) (p : pack) : pack =
        ? tick >= 10
        ?> p
        |: turns (tick + 1) (foe_turn camp 1001u32 tick (tick * tick_ms ()) 0 p)
    := second_later = turns 0 placed
    (
        geometry.chebyshev_distance (slot 0 second_later).at (slot 0 placed).at,
        (creatures.stats_of Hunter).step_ms < 1000
    )
    |> _assert_eq (1i32, !+)

///> c
test an_adjacent_cyclops_dances_only_along_the_two_sides_that_keep_it_next_to_the_knight_like_canary =
    :< hunting_pack
    :< creatures
    := camp = clearing (uniform_camp Cyclops |> on_layout (:< terrain ;; OpenField) |> dancing_like_canary)
    := begun = start camp
    := knight_at = begun.hunter.at
    := f = slot 0 begun
    := placed = with_slot 0 { f ?| at = { knight_at ?| x = knight_at.x + 1; y = knight_at.y + 1 } } begun
    :~ ^ tries (i : i32) (allowed : bool) (north : bool) (west : bool) : bool * bool * bool =
        ? i >= 20
        ?> allowed, north, west
        |:
            := moved = (slot 0 (dance_step camp 0 0 (key 1001u32 i 200 (purpose_dance ())) placed)).at
            := went_north = moved.x = knight_at.x + 1 && moved.y = knight_at.y
            := went_west = moved.x = knight_at.x && moved.y = knight_at.y + 1
            tries (i + 1) (allowed && (went_north || went_west)) (north || went_north) (west || went_west)
    tries 0 !+ !- !- |> _assert_eq (!+, !+, !+)

///> c
test an_adjacent_cyclops_dances_on_about_one_think_in_ten_like_canarys_static_attack_chance_of_90 =
    :< hunting_pack
    :< creatures
    := camp = clearing (uniform_camp Cyclops |> on_layout (:< terrain ;; OpenField) |> dancing_like_canary)
    := begun = start camp
    := knight_at = begun.hunter.at
    := f = slot 0 begun
    := placed = with_slot 0 { f ?| at = { knight_at ?| x = knight_at.x + 1; y = knight_at.y + 1 } } begun
    := ~seed = 1001u32
    := phase = creature_think_phase_ms seed 0
    :~ ^ thinks (k : i32) (danced : i32) : i32 =
        ? k >= 200
        ?> danced
        |:
            := now = phase + k * player_think_ms ()
            := after = dances camp seed (now / tick_ms ()) now 0 placed
            := moved = geometry.same_tile (slot 0 after).at (slot 0 placed).at = !-
            thinks (k + 1) (? moved ?> danced + 1 |: danced)
    := danced = thinks 0 0
    (danced >= 10, danced <= 30) |> _assert_eq (!+, !+)

