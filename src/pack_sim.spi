    formula_steps ground |> _assert_eq ((700, 450), (500, 300))

:= respawns (spawntime : i32) : tally3 =
    := at = hunting_pack.canary_respawn_ms
    at spawntime, at (spawntime / 2), at (spawntime + 30000)

