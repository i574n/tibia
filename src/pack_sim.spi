///> c
test the_random_control_stays_far_below_every_rule =
    open hunting_pack
    inl camp = arena_hunt ()
    inl ~marker = 0i32
    inl l = ledger_on camp (random_control ()) (held_out_block ())
    inl spot = uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot)
    inl clears = clears_judged_on spot (random_control ()) (held_out_block ())
    (
        quantity.value_of (judged_on Experience camp (random_control ()) (held_out_block ())) + marker,
        l.hunt_kills,
        l.hunt_deaths,
        quantity.value_of l.hunt_profit,
        clears.clear_potions,
        clears.clear_deaths,
        clears.clear_ms
    )
    |> _assert_eq (57950i32, 993i32, 0i32, -1145455i32, 7206i32, 0i32, 9353800i32)

///> c
test on_the_cyclops_hunting_ground_sweeping_leads_and_stepping_back_buys_cost =
    open hunting_pack
    inl camp = cyclops_hunting_ground ()
    inl ~standing_heal = cavebot_heal_tuned_on Experience camp (training_block ())
    inl sweeping_heal = shaped_cavebot_heal_tuned_on Experience sweeping_spawns camp (training_block ())
    inl judged (t : tactic) : i32 * i32 * i32 =
        inl l = ledger_on camp t (held_out_block ())
        quantity.value_of (judged_on Experience camp t (held_out_block ())),
        l.hunt_deaths,
        quantity.value_of l.hunt_profit
    inl retreating = tactic_with_order (open policy in ReachFirst) { first = 154; second = 26; third = 2 }
    (
        standing_heal,
        sweeping_heal,
        judged (cavebot_with_heal standing_heal),
        judged (cavebot_with_heal sweeping_heal |> sweeping_spawns),
        judged (cavebot_with_heal standing_heal |> patrolling (central_shuttle_route ())),
        judged retreating,
        judged (retreating |> sweeping_spawns)
    )
    |> _assert_eq (
        120i32,
        130i32,
        (102550i32, 4i32, -248017i32),
        (127200i32, 3i32, -296549i32),
        (132200i32, 2i32, -281049i32),
        (100650i32, 0i32, -118297i32),
        (120750i32, 0i32, -167225i32)
    )
///> c
test the_live_wake_delay_brings_the_arena_clears_toward_the_live_potion_counts =
    open hunting_pack
    inl ~wake = live_wake_ms ()
    inl totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        let rec each (i : i32) (potions : i32) (ms : i32) (hits : i32) : i32 * i32 * i32 =
            if i >= (range_of (held_out_block ())).count then potions, ms, hits
            else
                inl elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (ms + elapsed) (hits + p.hunter.hits_taken)
        each 0 0 0 0
    inl spot = uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> waking_at wake
    inl mixed = cyclops_and_two_trolls_on_the_arena_spot () |> waking_at wake
    inl retreat = tactic_with_order (open policy in ReachFirst) { first = 154; second = 26; third = 2 }
    (totals spot (cavebot_with_heal 160), totals spot retreat, totals mixed (cavebot_with_heal 160))
    |> _assert_eq ((1334i32, 8838000i32, 6417i32), (1201i32, 9040500i32, 5835i32), (36i32, 3710300i32, 946i32))

///> c
test after_a_step_the_swing_waits_for_a_think_or_a_move_costing_retreat_half_a_potion_and_rules_nothing =
    open hunting_pack
    inl totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        let rec each (i : i32) (potions : i32) (ms : i32) (hits : i32) : i32 * i32 * i32 =
            if i >= (range_of (held_out_block ())).count then potions, ms, hits
            else
                inl elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (ms + elapsed) (hits + p.hunter.hits_taken)
        each 0 0 0 0
    inl spot =
        uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> waking_at (live_wake_ms ())
    inl live_retreat = tactic_with_order (open policy in ReachFirst) { first = 160; second = 0; third = 2 }
    (
        totals spot live_retreat,
        totals (spot |> swinging_like_canary) live_retreat,
        totals (spot |> swinging_like_canary) (cavebot_with_heal 160)
    )
    |> _assert_eq ((1179i32, 8968500i32, 5750i32), (1232i32, 9033300i32, 6020i32), (1334i32, 8838000i32, 6417i32))

///> c
test mirroring_the_live_arena_predicts_rules_and_retreat_within_the_live_noise_at_two_and_three_cyclops =
    open hunting_pack
    inl totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        let rec each (i : i32) (potions : i32) (ms : i32) (hits : i32) : i32 * i32 * i32 =
            if i >= (range_of (held_out_block ())).count then potions, ms, hits
            else
                inl elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (ms + elapsed) (hits + p.hunter.hits_taken)
        each 0 0 0 0
    inl three =
        uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> mirroring_the_live_arena
    inl two = { three with size = 2 }
    (
        totals three (cavebot_with_heal 160),
        totals three (live_retreat_tactic 160 2),
        totals two (cavebot_with_heal 160),
        totals two (live_retreat_tactic 160 2)
    )
    |> _assert_eq (
        (1230i32, 8937100i32, 5986i32),
        (1176i32, 9424500i32, 5640i32),
        (472i32, 6142500i32, 2793i32),
        (491i32, 6415400i32, 2924i32)
    )

///> c
test a_cyclops_first_swing_waits_one_period_after_it_can_target_which_fits_six_live_means_best =
    open hunting_pack
    inl totals (camp : camp) (t : tactic) : i32 * i32 =
        let rec each (i : i32) (potions : i32) (hits : i32) : i32 * i32 =
            if i >= (range_of (held_out_block ())).count then potions, hits
            else
                inl elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (hits + p.hunter.hits_taken)
        each 0 0 0
    inl three =
        uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> mirroring_the_live_arena
    inl two = { three with size = 2 }
    inl bare = three |> waking_at 0
    inl reach =
        tactic_with_order (open policy in ReachFirst) { first = 160; second = 0; third = policy.never_retreat () }
    (
        totals three (cavebot_with_heal 160),
        totals three reach,
        totals three (live_retreat_tactic 160 2),
        totals two (cavebot_with_heal 160),
        totals two (live_retreat_tactic 160 2),
        totals bare (cavebot_with_heal 160)
    )
    |> _assert_eq (
        (1230i32, 5986i32),
        (1247i32, 6021i32),
        (1176i32, 5640i32),
        (472i32, 2793i32),
        (491i32, 2924i32),
        (1529i32, 7076i32)
    )


///> c
test a_hunter_keeping_four_tiles_away_only_falls_where_walls_corner_it_and_walking_beside_the_knight_halves_its_pace =
    open hunting_pack
    open creatures
    inl kills_within (layout : terrain.layout) : i32 * i32 =
        inl camp = clearing (uniform_camp Hunter |> on_layout layout)
        let rec each (i : i32) (kills : i32) (hits : i32) : i32 * i32 =
            if i >= 5 then kills, hits
            else
                inl p = simulate camp (cavebot_with_heal 160) (1001u32 + conv i) 1200
                each (i + 1) (kills + p.kills) (hits + p.hunter.hits_taken)
        each 0 0 0
    inl open_kills, open_hits = kills_within (open terrain in OpenField)
    inl arena_kills, arena_hits = kills_within (open terrain in ArenaSpot)
    (open_kills, open_hits, arena_kills, arena_hits) |> _assert_eq (0i32, 173i32, 11i32, 82i32)
    (open_kills = 0, arena_kills > 0) |> _assert_eq (true, true)

///> c
test a_hunter_beyond_four_tiles_closes_one_tile_per_think_like_canarys_follow_replanning =
    open hunting_pack
    open creatures
    inl camp = clearing (uniform_camp Hunter |> on_layout (open terrain in OpenField))
    inl begun = start camp
    inl knight_at = begun.hunter.at
    inl f = slot 0 begun
    inl ~gap = 8i32
    inl placed = with_slot 0 { f with at = { knight_at with x = knight_at.x + gap } } begun
    let rec turns (tick : i32) (p : pack) : pack =
        if tick >= 10
        then p
        else turns (tick + 1) (foe_turn camp 1001u32 tick (tick * tick_ms ()) 0 p)
    inl second_later = turns 0 placed
    (
        geometry.chebyshev_distance (slot 0 second_later).at (slot 0 placed).at,
        (creatures.stats_of Hunter).step_ms < 1000
    )
    |> _assert_eq (1i32, true)

///> c
test an_adjacent_cyclops_dances_only_along_the_two_sides_that_keep_it_next_to_the_knight_like_canary =
    open hunting_pack
    open creatures
    inl camp = clearing (uniform_camp Cyclops |> on_layout (open terrain in OpenField) |> dancing_like_canary)
    inl begun = start camp
    inl knight_at = begun.hunter.at
    inl f = slot 0 begun
    inl placed = with_slot 0 { f with at = { knight_at with x = knight_at.x + 1; y = knight_at.y + 1 } } begun
    let rec tries (i : i32) (allowed : bool) (north : bool) (west : bool) : bool * bool * bool =
        if i >= 20
        then allowed, north, west
        else
            inl moved = (slot 0 (dance_step camp 0 0 (key 1001u32 i 200 (purpose_dance ())) placed)).at
            inl went_north = moved.x = knight_at.x + 1 && moved.y = knight_at.y
            inl went_west = moved.x = knight_at.x && moved.y = knight_at.y + 1
            tries (i + 1) (allowed && (went_north || went_west)) (north || went_north) (west || went_west)
    tries 0 true false false |> _assert_eq (true, true, true)

///> c
test an_adjacent_cyclops_dances_on_about_one_think_in_ten_like_canarys_static_attack_chance_of_90 =
    open hunting_pack
    open creatures
    inl camp = clearing (uniform_camp Cyclops |> on_layout (open terrain in OpenField) |> dancing_like_canary)
    inl begun = start camp
    inl knight_at = begun.hunter.at
    inl f = slot 0 begun
    inl placed = with_slot 0 { f with at = { knight_at with x = knight_at.x + 1; y = knight_at.y + 1 } } begun
    inl ~seed = 1001u32
    inl phase = creature_think_phase_ms seed 0
    let rec thinks (k : i32) (danced : i32) : i32 =
        if k >= 200
        then danced
        else
            inl now = phase + k * player_think_ms ()
            inl after = dances camp seed (now / tick_ms ()) now 0 placed
            inl moved = geometry.same_tile (slot 0 after).at (slot 0 placed).at = false
            thinks (k + 1) (if moved then danced + 1 else danced)
    inl danced = thinks 0 0
    (danced >= 10, danced <= 30) |> _assert_eq (true, true)

