test the_current_arena_bundle_pins_rules_and_retreat_potions_and_hits_over_the_held_out_block =
    := ~kind = :< creatures ;; Cyclops
    bundle_rows kind |> _assert_eq (bundle_expected ())

:= formula_spot () : camp = spot_camp () |> hunting_pack.stepping_by_canary_formula

:= cyclops_step_ms (camp : camp) (at : geometry.position) : i32 =
    := cyclops = creatures.stats_of (:< creatures ;; Cyclops)
    hunting_pack.step_ms_at camp at cyclops.speed cyclops.step_ms

:= formula_steps (at : geometry.position) : kp * kp =
    := camp = formula_spot ()
    := road = geometry.position 115 89 7
    := hunter = hunting_pack.hunter_step_ms_at camp
    (cyclops_step_ms camp at, cyclops_step_ms camp road), (hunter at, hunter road)

