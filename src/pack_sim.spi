test on_the_hunting_ground_walking_pays_and_the_evolved_shuttle_edges_the_hand_route =
    open hunting_pack
    inl camp = arena_hunt ()
    inl ~tuned = cavebot_heal_tuned_on Experience camp (training_block ())
    inl cavebot = cavebot_with_heal tuned
    inl judged (t : tactic) : i32 = quantity.value_of (judged_on Experience camp t (held_out_block ()))
    (
        tuned,
        judged cavebot,
        judged (cavebot |> patrolling (plaza_and_fields_route ())),
        judged (cavebot |> patrolling (spawn_side_loop_route ())),
        judged (cavebot |> sweeping_spawns),
        judged (cavebot |> patrolling (central_shuttle_route ()))
    )
    |> _assert_eq (120i32, 109030i32, 107540i32, 113040i32, 118460i32, 124830i32)

///> c
test the_current_arena_bundle_pins_rules_and_retreat_potions_and_hits_over_the_held_out_block =
    open hunting_pack
    inl totals (camp : camp) (t : tactic) : i32 * i32 =
        let rec each (i : i32) (potions : i32) (hits : i32) : i32 * i32 =
            if i >= (range_of (held_out_block ())).count then potions, hits
            else
                inl elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (hits + p.hunter.hits_taken)
        each 0 0 0
    inl ~kind = open creatures in Cyclops
    inl arena = uniform_camp kind |> on_layout (open terrain in ArenaSpot) |> mirroring_the_current_arena
    (totals arena (cavebot_with_heal 160), totals arena (live_retreat_tactic 160 2))
    |> _assert_eq ((1394i32, 6649i32), (1332i32, 6428i32))

///> c
test by_canary_formula_a_cyclops_steps_700_ms_on_arena_ground_and_450_on_the_road_and_the_level_30_knight_500_and_300 =
    open hunting_pack
    inl camp =
        uniform_camp (open creatures in Cyclops)
        |> on_layout (open terrain in ArenaSpot)
        |> stepping_by_canary_formula
    inl ~ground = geometry.position 99 99 7
    inl road = geometry.position 115 89 7
    inl cyclops = creatures.stats_of (open creatures in Cyclops)
    (
        step_ms_at camp ground cyclops.speed cyclops.step_ms,
        step_ms_at camp road cyclops.speed cyclops.step_ms,
        hunter_step_ms_at camp ground,
        hunter_step_ms_at camp road
    )
    |> _assert_eq (700i32, 450i32, 500i32, 300i32)

