///> c
test cyclops_pack_healing_below_130_dies_while_170_and_above_tie_on_kills =
    :< hunting_pack
    :< creatures
    := ~first = 1u32
    := camp = uniform_camp Cyclops
    := deaths heal = ?= totals camp (cavebot_with_heal heal) first 100 ?| | _, _, d => d
    := at heal = score camp (cavebot_with_heal heal) first 100
    (deaths 90, deaths 170, at 90, at 130, at 170, at 210)
    |> _assert_eq (127i32, 0i32, -5399i32, -247i32, 950i32, 950i32)

///> c
test cyclops_pack_only_the_warm_started_network_dominates_the_tuned_cavebot_by_a_hair =
    :< hunting_pack
    :< creatures
    := ~search = 11u32
    := camp = uniform_camp Cyclops
    := heal = cavebot_heal_tuned_on Profit camp (training_block ())
    := floor = (ledger_on camp (cavebot_with_heal heal) (training_block ())).hunt_kills
    := objective = ProfitKeepingKills floor
    := training t = worth_on_training objective camp t (training_block ())
    := held_out t =
        := l = ledger_on camp t (held_out_block ())
        l.hunt_kills, quantity.value_of l.hunt_profit
    := g = tactic_evolved_on objective { first = heal; second = 0; third = 4 } camp search (training_block ()) 6 6
    := kiting n = network_tactic (cavebot_network camp heal |> network.with_kiting n)
    := k1, k2, k3 = training (kiting 1), training (kiting 2), training (kiting 3)
    := chosen = ? k1 >= k2 && k1 >= k3 ?> 1 |? k2 >= k3 ?> 2 |: 3
    := cold = network.evolve (\ w => training (network_tactic w)) (network.zero_weights ()) (search + 2u32) 6 6 256
    := warm =
        network.evolve
            \ w => training (network_tactic w)
            (cavebot_network camp heal |> network.with_kiting chosen)
            (search + 4u32)
            6
            6
            64
    := tuned = heal, floor, chosen, g.first, g.second, g.third
    := table =
        held_out (cavebot_with_heal heal),
        held_out (tactic_of g),
        held_out (kiting chosen),
        held_out (network_tactic cold),
        held_out (network_tactic warm)
    (tuned, table)
    |> _assert_eq (
        (160i32, 950i32, 1i32, 160i32, 0i32, 4i32),
        (
            (955i32, -454093i32),
            (955i32, -454093i32),
            (300i32, -31134i32),
            (955i32, -1480893i32),
            (955i32, -452543i32)
        )
    )
    := dominates (k, p) (bk, bp) = k >= bk && p >= bp && (k > bk || p > bp)
    := cavebot, rules, kited, cold_learned, warm_learned = table
    (dominates kited cavebot, dominates rules cavebot, dominates cold_learned cavebot, dominates warm_learned cavebot)
    |> _assert_eq (!-, !-, !-, !+)

///> c
test open_field_clear_predictions_with_kiting_losing_the_monsters =
    :< hunting_pack
    :< creatures
    := ~first = 1u32
    := camp = uniform_camp Cyclops
    :~ ^ sum (t : tactic) (i : i32) (ms : i32) (potions : i32) (deaths : i32) : i32 * i32 * i32 =
        ? i >= 20 ?> ms / 20, potions * 10 / 20, deaths
        |:
            ?= clear_run camp t (first + conv i) 6000 ?|
            | elapsed, p => sum t (i + 1) (ms + elapsed) (potions + p.hunter.potions) (deaths + p.deaths)
    (
        sum (cavebot_with_heal 70) 0 0 0 0,
        sum (network_tactic (cavebot_network camp 70 |> network.with_kiting 3)) 0 0 0 0
    )
    |> _assert_eq ((84740i32, 140i32, 10i32), (137580i32, 141i32, 7i32))

