:= standing_heal (camp : camp) : i32 =
    hunting_pack.cavebot_heal_tuned_on (:< hunting_pack ;; Experience) camp (hunting_pack.training_block ())

:= ground_xp (camp : camp) (t : tactic) : i32 =
    quantity.value_of (hunting_pack.judged_on (:< hunting_pack ;; Experience) camp t (hunting_pack.held_out_block ()))

:= walked (camp : camp) (cavebot : tactic) (route : hunting_pack.patrol_route) : i32 =
    ground_xp camp (cavebot |> hunting_pack.patrolling route)

:= route_rows (camp : camp) (cavebot : tactic) : tally3 =
    := on = walked camp cavebot
    := plaza, loop = on (hunting_pack.plaza_and_fields_route ()), on (hunting_pack.spawn_side_loop_route ())
    plaza, loop, on (hunting_pack.central_shuttle_route ())

:= walking_rows (camp : camp) (tuned : i32) : i32 * i32 * tally3 =
    := cavebot = hunting_pack.cavebot_with_heal tuned
    ground_xp camp cavebot, ground_xp camp (hunting_pack.sweeping_spawns cavebot), route_rows camp cavebot

:= walking_expected () : i32 * (i32 * i32 * tally3) = 120, (109030, 118460, (107540, 113040, 124830))

///> c
test on_the_hunting_ground_walking_pays_and_the_evolved_shuttle_edges_the_hand_route =
    := camp = hunting_pack.arena_hunt ()
    := ~tuned = standing_heal camp
    (tuned, walking_rows camp tuned) |> _assert_eq (walking_expected ())

:= held_out_totals (camp : camp) (t : tactic) : tally3 =
    := ms, potions, _, hits, _ = sums_over camp t (hunting_pack.range_of (hunting_pack.held_out_block ()))
    potions, ms, hits

:= potions_hits (camp : camp) (t : tactic) : kp =
    := potions, _, hits = held_out_totals camp t
    potions, hits

:= live_retreat () : tactic = hunting_pack.live_retreat_tactic 160 2

:= arena_spot_of (kind : creatures.arena_creature) : camp =
    hunting_pack.uniform_camp kind |> hunting_pack.on_layout (:< terrain ;; ArenaSpot)

:= bundle_rows (kind : creatures.arena_creature) : kp * kp =
    := arena = arena_spot_of kind |> hunting_pack.mirroring_the_current_arena
    potions_hits arena (cavebot_160 ()), potions_hits arena (live_retreat ())

:= bundle_expected () : kp * kp = (1394, 6649), (1332, 6428)

