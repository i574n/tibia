///- --package . --timeout 1800000
test pack_sim static =
    :< testing

///> c
test cyclops_hits_on_the_knight_sample_match_the_live_measurement =
    := ~seed = 3u32
    := melee_max = (creatures.stats_of (:< creatures ;; Cyclops)).melee_max
    := gear = combat.knight_sample_gear ()
    :~ ^ loop (i : i32) (landed : i32) (total : i32) (high : i32) : i32 * i32 * i32 =
        ? i >= 2000
        ?> landed, total, high
        |:
            := h =
                combat.creature_hit melee_max gear !+ (
                    rng.roll_key seed (conv i) 0u32 (hunting_pack.purpose_creature_hit ())
                )
            loop (i + 1) (? h > 0 ?> landed + 1 |: landed) (total + h) (? h > high ?> h |: high)
    ?= loop 0 0 0 0 ?|
    | landed, total, high =>
        (gear.armor, gear.defense, total * 100 / landed, high) |> _assert_eq (17i32, 15i32, 3497i32, 86i32)

///> rust
///> c
test golden_seed_7_troll_pack =
    :< hunting_pack
    :< creatures
    := ~seed = 7u32
    := outcome = simulate (uniform_camp Troll) (cavebot (:< policy ;; ReachFirst)) seed (scenario_ticks ())
    outcome.kills |> _assert_eq 6i32
    outcome.escapes |> _assert_eq 18i32
    outcome.deaths |> _assert_eq 0i32

///> c
test current_first_targeting_finishes_fleeing_trolls_over_twenty_seeds =
    :< hunting_pack
    :< creatures
    := ~first = 1u32
    ?=
        totals (uniform_camp Troll) (cavebot (:< policy ;; ReachFirst)) first 20,
        totals (uniform_camp Troll) (cavebot (:< policy ;; CurrentFirst)) first 20
    ?|
    | (reach_kills, reach_escapes, reach_deaths), (current_kills, current_escapes, current_deaths) =>
        reach_kills |> _assert_eq 71i32
        reach_escapes |> _assert_eq 393i32
        reach_deaths |> _assert_eq 0i32
        current_kills |> _assert_eq 303i32
        current_escapes |> _assert_eq 20i32
        current_deaths |> _assert_eq 0i32
        (current_kills > reach_kills && current_escapes < reach_escapes) |> _assert_eq !+

///> c
test mixed_camp_from_the_catalog_over_twenty_seeds =
    :< catalog
    :< hunting_pack
    := ~first = 1u32
    := camp =
        camp_of_entries (
            pack_entry (spawn_of TrollKind 1 2),
            pack_entry (spawn_of GoblinKind 1 2),
            pack_entry (spawn_of TrollKind 1 2)
        )
    ?= totals camp (cavebot (:< policy ;; CurrentFirst)) first 20 ?|
    | kills, escapes, deaths =>
        kills |> _assert_eq 340i32
        escapes |> _assert_eq 1i32
        deaths |> _assert_eq 0i32

