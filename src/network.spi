///- --package .
test network static =
    :< testing

:= one () : i32 = 256
:= input_count () : i32 = 8
:= hidden_count () : i32 = 6
:= output_count () : i32 = 3
:= attacker_unit () : i32 = 85
:= weight_count () : i32 = input_count () * hidden_count () + hidden_count () * output_count ()

:! weights = array i32
:! inputs = array i32

:| feature =
    | HealthFraction
    | Attackers
    | TargetHealth
    | TargetDistance
    | HealReady
    | StrikeReady
    | TargetFleeing
    | Bias

:| output =
    | HealOutput
    | EngageOutput
    | RetreatOutput

:! hidden = i32

:= feature_slot (f : feature) : i32 =
    ?= f ?|
    | HealthFraction => 0
    | Attackers => 1
    | TargetHealth => 2
    | TargetDistance => 3
    | HealReady => 4
    | StrikeReady => 5
    | TargetFleeing => 6
    | Bias => 7

:= output_slot (o : output) : i32 =
    ?= o ?|
    | HealOutput => 0
    | EngageOutput => 1
    | RetreatOutput => 2

:= input_weight_slot (hidden h) (f : feature) : i32 = h * input_count () + feature_slot f

:= output_weight_slot (o : output) (hidden h) : i32 =
    input_count () * hidden_count () + output_slot o * hidden_count () + h

:== decision = { heal : bool; engage : bool; retreat : bool }

:= filled (count : i32) (value : i32) : array i32 =
    := x : array i32 = create count
    :~ ^ fill (i : i32) : () =
        ? i < count ?>
            set x i value
            fill (i + 1)
    fill 0
    x

:= zero_weights () : weights = weights (filled (weight_count ()) 0)

:= weight (weights w) (i : i32) : i32 = index w i

:= inputs_of
    (health_fraction : i32) (attackers : i32) (target_health : i32) (target_distance : i32) (heal_ready : bool)
    (strike_ready : bool) (target_fleeing : bool)
    : inputs
    =
    := x = filled (input_count ()) 0
    := flag b = ? b ?> one () |: 0
    := put f value = set x (feature_slot f) value
    put HealthFraction health_fraction
    put Attackers (attackers * attacker_unit ())
    put TargetHealth target_health
    put TargetDistance ((? target_distance > 7 ?> 7 |: target_distance) * 32)
    put HealReady (flag heal_ready)
    put StrikeReady (flag strike_ready)
    put TargetFleeing (flag target_fleeing)
    put Bias (one ())
    inputs x

:= hidden_unit (w : weights) (inputs x) (j : i32) : i32 =
    :~ ^ sum (i : i32) (total : i32) : i32 =
        ? i >= input_count () ?> total |: sum (i + 1) (total + weight w (j * input_count () + i) * index x i)
    := h = sum 0 0 / one ()
    ? h > 0 ?> h |: 0

:= hidden_layer (w : weights) (x : inputs) : array i32 =
    := hidden = filled (hidden_count ()) 0
    :~ ^ activate (j : i32) : () =
        ? j < hidden_count () ?>
            set hidden j (hidden_unit w x j)
            activate (j + 1)
    activate 0
    hidden

:= output_unit (w : weights) (hidden : array i32) (k : i32) : i32 =
    := offset = input_count () * hidden_count ()
    :~ ^ sum (j : i32) (total : i32) : i32 =
        ? j >= hidden_count ()
        ?> total
        |: sum (j + 1) (total + weight w (offset + k * hidden_count () + j) * index hidden j)
    sum 0 0 / one ()

:= decide (w : weights) (x : inputs) : decision =
    := hidden = hidden_layer w x
    := heal = output_unit w hidden 0
    := engage = output_unit w hidden 1
    := retreat = output_unit w hidden 2
    { heal = heal > 0; engage = engage > 0 && engage >= retreat; retreat = retreat > 0 && retreat > engage }

:= with_weight (i : i32) (value : i32) (weights w) : weights =
    set w i value
    weights w

:= with_input_weight (h : hidden) (f : feature) (value : i32) (w : weights) : weights =
    with_weight (input_weight_slot h f) value w

:= with_output_weight (o : output) (h : hidden) (value : i32) (w : weights) : weights =
    with_weight (output_weight_slot o h) value w

:= fraction_below (heal_below : i32) (max_health : i32) : i32 = (heal_below - 1) * one () / max_health + 1

:= threshold_healer (heal_below_fraction : i32) : weights =
    zero_weights ()
    |> with_input_weight (hidden 0) HealthFraction (0 - one ())
    |> with_input_weight (hidden 0) Bias heal_below_fraction
    |> with_input_weight (hidden 1) Bias (one ())
    |> with_output_weight HealOutput (hidden 0) (one ())
    |> with_output_weight EngageOutput (hidden 1) (one ())

:= with_kiting (min_attackers : i32) (w : weights) : weights =
    w
    |> with_input_weight (hidden 2) Attackers (one ())
    |> with_input_weight (hidden 2) StrikeReady (0 - one ())
    |> with_input_weight (hidden 2) Bias (0 - (min_attackers - 1) * attacker_unit ())
    |> with_output_weight RetreatOutput (hidden 2) (4 * one ())

:= clamp_weight (x : i32) : i32 = ? x < -2048 ?> -2048 |? x > 2048 ?> 2048 |: x

:= mutate (seed : u32) (generation : i32) (child : i32) (spread : i32) (w : weights) : weights =
    := next = filled (weight_count ()) 0
    :~ ^ copy (i : i32) : () =
        ? i < weight_count ()
        ?>
            := draw : i32 =
                conv (
                    rng.roll_between 0
                        (conv (2 * spread))
                        (rng.roll_key seed (conv generation) (conv child) (conv (1000 + i)))
                )
            set next i (clamp_weight (weight w i + draw - spread))
            copy (i + 1)
    copy 0
    weights next

:= evolve
    (fitness : weights -> i32) (start : weights) (seed : u32) (generations : i32) (offspring : i32) (spread : i32)
    : weights
    =
    :~ ^ generation (index : i32) (parent : weights) (parent_score : i32) (width : i32) : weights =
        ? index >= generations
        ?> parent
        |:
            :~ ^ children (child : i32) (best : weights) (best_score : i32) : weights * i32 =
                ? child >= offspring
                ?> best, best_score
                |:
                    := candidate = mutate seed index child width parent
                    := score = fitness candidate
                    ? score > best_score
                    ?> children (child + 1) candidate score
                    |: children (child + 1) best best_score
            ?= children 0 parent parent_score ?|
            | best, best_score => generation (index + 1) best best_score (? width > 4 ?> width * 4 / 5 |: 4)
    generation 0 start (fitness start) spread

///> c
test a_zero_network_holds =
    := ~health = 128i32
    := d = decide (zero_weights ()) (inputs_of health 1 200 1 !+ !+ !-)
    d.heal |> _assert_eq !-
    d.engage |> _assert_eq !-
    d.retreat |> _assert_eq !-

///> c
test a_hand_wired_network_heals_when_low =
    := ~health = 64i32
    := w =
        zero_weights ()
        |> with_input_weight (hidden 0) HealthFraction (-256)
        |> with_input_weight (hidden 0) Bias 128
        |> with_output_weight HealOutput (hidden 0) 256
    (decide w (inputs_of health 0 0 0 !+ !+ !-)).heal |> _assert_eq !+
    (decide w (inputs_of (health + 100) 0 0 0 !+ !+ !-)).heal |> _assert_eq !-

///> c
test a_threshold_healer_heals_below_and_engages_above =
    := ~health = 99i32
    := w = threshold_healer 100
    (decide w (inputs_of health 0 0 1 !+ !+ !-)).heal |> _assert_eq !+
    (decide w (inputs_of (health + 1) 0 0 1 !+ !+ !-)).heal |> _assert_eq !-
    (decide w (inputs_of (health + 1) 0 0 1 !+ !+ !-)).engage |> _assert_eq !+
    (decide w (inputs_of (health + 1) 2 0 1 !+ !+ !-)).retreat |> _assert_eq !-

///> c
test kiting_retreats_only_while_the_strike_recovers =
    := ~health = 400i32
    := w = threshold_healer 100 |> with_kiting 2
    (decide w (inputs_of health 2 0 1 !+ !- !-)).retreat |> _assert_eq !+
    (decide w (inputs_of health 2 0 1 !+ !+ !-)).retreat |> _assert_eq !-
    (decide w (inputs_of health 1 0 1 !+ !- !-)).retreat |> _assert_eq !-
    (decide w (inputs_of health 2 0 1 !+ !+ !-)).engage |> _assert_eq !+

///> c
test an_output_is_not_a_feature fails "Unification failure" =
    zero_weights () |> with_input_weight (hidden 0) HealOutput 1

///> c
test inputs_are_not_weights fails "Unification failure" =
    decide (inputs_of 1 0 0 0 !+ !+ !-) (inputs_of 1 0 0 0 !+ !+ !-)

///> c
test evolution_learns_to_heal_below_a_quarter =
    := ~seed = 5u32
    := score (w : weights) : i32 =
        :~ ^ loop (h : i32) (total : i32) : i32 =
            ? h > 256 ?> total
            |:
                := wanted = h < 64
                := got = (decide w (inputs_of h 0 0 0 !+ !+ !-)).heal
                loop (h + 16) (? wanted = got ?> total + 1 |: total)
        loop 0 0
    := best = evolve score (zero_weights ()) seed 30 12 256
    score best |> _assert_eq 17i32

///> wgsl
test network_decides_on_gpu =
    := ~health = 64i32
    := w =
        zero_weights ()
        |> with_input_weight (hidden 0) HealthFraction (-256)
        |> with_input_weight (hidden 0) Bias 128
        |> with_output_weight HealOutput (hidden 0) 256
    ?
        (decide w (inputs_of health 0 0 0 !+ !+ !-)).heal
        && (decide w (inputs_of (health + 100) 0 0 0 !+ !+ !-)).heal = !-
    ?> 0i32
    |: 1i32
