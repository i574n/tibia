:== bytes = array u8

:= otbm_node_start () : u8 = 254u8
:= otbm_node_end () : u8 = 255u8
:= otbm_escape () : u8 = 253u8
:= otbm_identifier_bytes () : i32 = 4
:= area_node () : i32 = 4
:= tile_node () : i32 = 5
:= item_node () : i32 = 6
:= house_tile_node () : i32 = 14
:= tile_flags_attribute () : i32 = 3
:= tile_flags_attribute_bytes () : i32 = 5
:= protection_zone_flag () : i32 = 1
:= item_attribute () : i32 = 9
:= item_attribute_bytes () : i32 = 3
:= tile_props_before_attributes () : i32 = 2
:= house_tile_props_before_attributes () : i32 = 6
:= item_id_limit () : i32 = 65536
:= node_depth_limit () : i32 = 256

:= appearance_field () : i32 = 1
:= appearance_id_field () : i32 = 1
:= appearance_flags_field () : i32 = 3
:= unpassable_flag () : i32 = 13
:= sight_blocking_flag () : i32 = 15
:= bank_flag () : i32 = 1
:= bank_waypoints_field () : i32 = 1
:= height_flag () : i32 = 27
:= climbable_height_items () : i32 = 3

:= road_ground_speed () : i32 = 100
:= spot_x () : i32 = 1933
:= spot_y () : i32 = 1350
:= spot_z () : i32 = 7
:= spot_radius () : i32 = 45
:= spot_side () : i32 = 2 * spot_radius () + 1
:= row_word_bits () : i32 = 32
:= row_word_count () : i32 = (spot_side () + row_word_bits () - 1) / row_word_bits ()

:= (++) (a : string) (b : string) : string = sm'.(++#) a b

:= byte (b : bytes) (i : i32) : i32 = conv (index b i)

:= filled \* t. (count : i32) (value : t) : array t =
    := x : array t = create count
    :~ ^ fill (i : i32) : () =
        ? i < count ?>
            set x i value
            fill (i + 1)
    fill 0
    x

:~ varint (b : bytes) (start : i32) : u64 * i32 =
    :~ ^ more (i : i32) (value : u64) (shift : i32) : u64 * i32 =
        := c = index b i
        := value = value ||| ((conv (c &&& 127u8) : u64) <<< shift)
        ? c < 128u8 ?> value, i + 1 |: more (i + 1) value (shift + 7)
    more start 0u64 0

:= fold_fields \* state.
    (b : bytes) (start : i32) (stop : i32) (initial : state) (on_varint : state -> i32 -> u64 -> state)
    (on_bytes : state -> i32 -> i32 -> i32 -> state)
    : state
    =
    :~ ^ next (i : i32) (s : state) : state =
        ? i >= stop ?> s
        |:
            := key, i = varint b i
            := number : i32 = conv (key >>> 3)
            := wire = key &&& 7u64
            ? wire = 0u64 ?>
                := value, i = varint b i
                next i (on_varint s number value)
            |? wire = 2u64 ?>
                := size, i = varint b i
                := ends = i + conv size
                next ends (on_bytes s number i ends)
            |? wire = 5u64 ?> next (i + 4) s
            |? wire = 1u64 ?> next (i + 8) s
            |: failwith "map: appearances.dat has an unknown protobuf wire type"
    next start initial

:== item_kinds =
    {
        unpassable : array bool
        sight_blocking : array bool
        ground : array bool
        speed : array i32
        height : array bool
    }

:= item_kinds_of (b : bytes) : item_kinds =
    := kinds =
        {
            unpassable = filled (item_id_limit ()) !-
            sight_blocking = filled (item_id_limit ()) !-
            ground = filled (item_id_limit ()) !-
            speed = filled (item_id_limit ()) 0
            height = filled (item_id_limit ()) !-
        }
    := unpassable_kinds = kinds.unpassable
    := sight_blocking_kinds = kinds.sight_blocking
    := ground_kinds = kinds.ground
    := speeds = kinds.speed
    := height_kinds = kinds.height
    := flags_of (identity : i32) (from : i32) (stop : i32) : () =
        := bank (from : i32) (stop : i32) : () =
            fold_fields b from stop
                ()
                \ () field value =>
                    ? field = bank_waypoints_field ()
                    ?> set speeds identity (conv value)
                \ () _ _ _ => ()
        fold_fields b from stop ()
            (\ () flag value =>
                ? flag = height_flag () ?> set height_kinds identity !+
                ? flag = unpassable_flag () && value <> 0u64 ?> set unpassable_kinds identity !+
                ? flag = sight_blocking_flag () && value <> 0u64 ?> set sight_blocking_kinds identity !+)
            (\ () flag inner_from inner_stop =>
                ? flag = height_flag () ?> set height_kinds identity !+
                ? flag = bank_flag () ?>
                    set ground_kinds identity !+
                    bank inner_from inner_stop)
    := appearance (from : i32) (stop : i32) : () =
        := identity, flags_from, flags_stop =
            fold_fields b from stop
                (-1, -1, -1)
                \ (identity, flags_from, flags_stop) field value =>
                    ? field = appearance_id_field ()
                    ?> conv value, flags_from, flags_stop
                    |: identity, flags_from, flags_stop
                \ (identity, flags_from, flags_stop) field inner_from inner_stop =>
                    ? field = appearance_flags_field ()
                    ?> identity, inner_from, inner_stop
                    |: identity, flags_from, flags_stop
        ? identity >= 0 && identity < item_id_limit () && flags_from >= 0 ?> flags_of identity flags_from flags_stop
    fold_fields b 0
        (length b)
        ()
        \ () _ _ => ()
        \ () field from stop =>
            ? field = appearance_field ()
            ?> appearance from stop
    kinds

:= word_byte (c : u8) : bool =
    (c >= 48u8 && c <= 57u8) || (c >= 65u8 && c <= 90u8) || (c >= 97u8 && c <= 122u8) || c = 95u8

:= ids_with (text : bytes) (needle : string) : array bool =
    := exits = filled (item_id_limit ()) !-
    := size = length text
    := item_open = sm'.utf8_get_bytes "<item"
    := item_close = sm'.utf8_get_bytes "</item>"
    := wanted = sm'.utf8_get_bytes needle
    := single_id = sm'.utf8_get_bytes "id=\""
    := low_id = sm'.utf8_get_bytes "fromid=\""
    := high_id = sm'.utf8_get_bytes "toid=\""
    := matches_at (i : i32) (pattern : bytes) : bool =
        :~ ^ compare (k : i32) : bool =
            ? k >= length pattern ?> !+
            |? i + k >= size ?> !-
            |? index text (i + k) <> index pattern k ?> !-
            |: compare (k + 1)
        compare 0
    := find (from : i32) (stop : i32) (pattern : bytes) : i32 =
        :~ ^ scan (i : i32) : i32 = ? i >= stop ?> -1 |? matches_at i pattern ?> i |: scan (i + 1)
        scan from
    := find_byte (from : i32) (wanted : u8) : i32 =
        :~ ^ scan (i : i32) : i32 = ? i >= size ?> -1 |? index text i = wanted ?> i |: scan (i + 1)
        scan from
    := word_start (i : i32) : bool = i = 0 || word_byte (index text (i - 1)) = !-
    := attribute (from : i32) (stop : i32) (pattern : bytes) : i32 =
        :~ ^ scan (i : i32) : i32 =
            := at = find i stop pattern
            ? at < 0 ?> -1
            |? word_start at ?>
                := digits_from = at + length pattern
                :~ ^ digits (k : i32) (value : i32) : i32 =
                    := c = ? k < size ?> index text k |: 0u8
                    ? c >= 48u8 && c <= 57u8 ?> digits (k + 1) (value * 10 + conv (c - 48u8))
                    |? k > digits_from && c = 34u8 ?> value
                    |: -1
                := value = digits digits_from 0
                ? value >= 0 ?> value |: scan (at + 1)
            |: scan (at + 1)
        scan from
    := mark (low : i32) (high : i32) : () =
        :~ ^ each (identity : i32) : () =
            ? identity <= high ?>
                ? identity >= 0 && identity < item_id_limit () ?> set exits identity !+
                each (identity + 1)
        each low
    :~ ^ items (from : i32) : () =
        := open_at = find from size item_open
        ? open_at >= 0 ?>
            := after = open_at + length item_open
            ? after < size && word_byte (index text after) = !- ?>
                := head_end = find_byte after 62u8
                ? head_end < 0 ?> ()
                |? index text (head_end - 1) = 47u8 ?> items (open_at + 1)
                |:
                    := close_at = find (head_end + 1) size item_close
                    ? close_at < 0 ?> items (open_at + 1)
                    |:
                        ? find (head_end + 1) close_at wanted >= 0 ?>
                            := single = attribute after head_end single_id
                            ? single >= 0 ?> mark single single
                            |:
                                := low = attribute after head_end low_id
                                := high = attribute after head_end high_id
                                ? low >= 0 && high >= 0 ?> mark low high
                        items (close_at + length item_close)
            |: items (open_at + 1)
    items 0
    exits

:== grid =
    {
        blocked : array bool
        sight_blocked : array bool
        road : array bool
        walkable : array bool
        floor_change : array bool
        teleport : array bool
        climbable : array bool
        protection : array bool
        house : array bool
    }

:= walk_tiles (b : bytes) (kinds : item_kinds) (exits : array bool) (teleports : array bool) : grid =
    := side = spot_side ()
    := radius = spot_radius ()
    := blocked = filled (side * side) !+
    := sight_blocked = filled (side * side) !-
    := road = filled (side * side) !-
    := walkable_cells = filled (side * side) !-
    := floor_change_cells = filled (side * side) !-
    := teleport_cells = filled (side * side) !-
    := climbable_cells = filled (side * side) !-
    := protection_cells = filled (side * side) !-
    := house_cells = filled (side * side) !-
    := tile_height_items : array i32 = filled (node_depth_limit ()) 0
    := height_kinds = kinds.height
    := depths = node_depth_limit ()
    := node_kind : array i32 = filled depths 0
    := area_x : array i32 = filled depths 0
    := area_y : array i32 = filled depths 0
    := area_z : array i32 = filled depths 0
    := tile_cell : array i32 = filled depths (-1)
    := tile_ground : array bool = filled depths !-
    := tile_unpassable : array bool = filled depths !-
    := tile_sight_blocking : array bool = filled depths !-
    := tile_exit : array bool = filled depths !-
    := tile_teleport : array bool = filled depths !-
    := tile_protection : array bool = filled depths !-
    := tile_attribute_speed : array i32 = filled depths 0
    := tile_child_speed : array i32 = filled depths 0
    := item_id : array i32 = filled depths (-1)
    := ground_kinds = kinds.ground
    := unpassable_kinds = kinds.unpassable
    := sight_blocking_kinds = kinds.sight_blocking
    := speeds = kinds.speed
    := props_end (from : i32) : i32 =
        :~ ^ scan (i : i32) : i32 =
            := c = index b i
            ? c = otbm_escape () ?> scan (i + 2)
            |? c = otbm_node_start () || c = otbm_node_end () ?> i
            |: scan (i + 1)
        scan from
    := prop_count (from : i32) (stop : i32) : i32 =
        :~ ^ count (i : i32) (total : i32) : i32 =
            ? i >= stop ?> total
            |? index b i = otbm_escape () ?> count (i + 2) (total + 1)
            |: count (i + 1) (total + 1)
        count from 0
    := prop (from : i32) (k : i32) : i32 =
        :~ ^ walk (i : i32) (k : i32) : i32 =
            := at = ? index b i = otbm_escape () ?> i + 1 |: i
            ? k = 0 ?> byte b at |: walk (at + 1) (k - 1)
        walk from k
    := prop_u16 (from : i32) (k : i32) : i32 = prop from k + 256 * prop from (k + 1)
    := tile_kind (kind : i32) : bool = kind = tile_node () || kind = house_tile_node ()
    := note_kind (tile : i32) (identity : i32) : () =
        ? index ground_kinds identity ?> set tile_ground tile !+
        ? index unpassable_kinds identity ?> set tile_unpassable tile !+
        ? index sight_blocking_kinds identity ?> set tile_sight_blocking tile !+
        ? index exits identity ?> set tile_exit tile !+
        ? index teleports identity ?> set tile_teleport tile !+
        ? index height_kinds identity ?> set tile_height_items tile (index tile_height_items tile + 1)
    := note_attribute_item (tile : i32) (identity : i32) : () =
        ? identity >= 0 && identity < item_id_limit () ?>
            note_kind tile identity
            ? index speeds identity > 0 ?> set tile_attribute_speed tile (index speeds identity)
    := note_child_item (tile : i32) (identity : i32) : () =
        ? identity >= 0 && identity < item_id_limit ()
        ?>
            note_kind tile identity
            ? index tile_child_speed tile = 0 && index speeds identity > 0
            ?> set tile_child_speed tile (index speeds identity)
    := nearest_tile (depth : i32) : i32 =
        :~ ^ down (d : i32) : i32 = ? d < 0 ?> -1 |? tile_kind (index node_kind d) ?> d |: down (d - 1)
        down (depth - 1)
    := open_tile (depth : i32) (from : i32) (stop : i32) : () =
        set tile_cell depth (-1)
        := parent = depth - 1
        ? parent >= 0 && index node_kind parent = area_node ()
        ?>
            := dx = index area_x parent + prop from 0 - spot_x ()
            := dy = index area_y parent + prop from 1 - spot_y ()
            ? index area_z parent = spot_z () && dx >= 0 - radius && dx <= radius && dy >= 0 - radius && dy <= radius
            ?>
                set tile_cell depth ((dy + radius) * side + dx + radius)
                set tile_ground depth !-
                set tile_unpassable depth !-
                set tile_sight_blocking depth !-
                set tile_exit depth !-
                set tile_teleport depth !-
                set tile_protection depth !-
                set tile_attribute_speed depth 0
                set tile_child_speed depth 0
                set tile_height_items depth 0
                := count = prop_count from stop
                :~ ^ attributes (offset : i32) : () =
                    ? offset < count ?>
                        := attribute = prop from offset
                        ? attribute = tile_flags_attribute () ?>
                            ? prop from (offset + 1) % 2 = protection_zone_flag () ?> set tile_protection depth !+
                            attributes (offset + tile_flags_attribute_bytes ())
                        |? attribute = item_attribute () ?>
                            note_attribute_item depth (prop_u16 from (offset + 1))
                            attributes (offset + item_attribute_bytes ())
                attributes (
                    ? index node_kind depth = house_tile_node ()
                    ?> house_tile_props_before_attributes ()
                    |: tile_props_before_attributes ()
                )
    := close_node (depth : i32) : () =
        := kind = index node_kind depth
        ? kind = item_node () ?>
            := tile = nearest_tile depth
            ? tile >= 0 && index tile_cell tile >= 0 ?> note_child_item tile (index item_id depth)
        |? tile_kind kind ?>
            := cell = index tile_cell depth
            ? cell >= 0 ?>
                := walkable = index tile_ground depth && index tile_unpassable depth = !-
                set walkable_cells cell walkable
                set floor_change_cells cell (index tile_exit depth)
                set teleport_cells cell (index tile_teleport depth)
                set climbable_cells cell (index tile_height_items depth >= climbable_height_items ())
                set protection_cells cell (index tile_protection depth)
                set house_cells cell (kind = house_tile_node ())
                set blocked cell (walkable = !- || index tile_exit depth || index tile_teleport depth)
                set sight_blocked cell (index tile_sight_blocking depth)
                := attribute_speed = index tile_attribute_speed depth
                := speed = ? attribute_speed > 0 ?> attribute_speed |: index tile_child_speed depth
                set road cell (speed = road_ground_speed ())
    :~ ^ walk (i : i32) (depth : i32) : () =
        ? i < length b
        ?>
            := c = index b i
            ? c = otbm_node_start ()
            ?>
                := kind = byte b (i + 1)
                := depth = depth + 1
                set node_kind depth kind
                := from = i + 2
                := stop = props_end from
                ? kind = area_node ()
                ?>
                    set area_x depth (prop_u16 from 0)
                    set area_y depth (prop_u16 from 2)
                    set area_z depth (prop from 4)
                |? tile_kind kind
                ?> open_tile depth from stop
                |? kind = item_node ()
                ?> set item_id depth (? prop_count from stop >= 2 ?> prop_u16 from 0 |: -1)
                walk stop depth
            |? c = otbm_node_end ()
            ?>
                ? depth >= 0 ?> close_node depth
                walk (i + 1) (depth - 1)
            |: walk (i + 1) depth
    walk (otbm_identifier_bytes ()) (-1)
    {
        blocked = blocked
        sight_blocked = sight_blocked
        road = road
        walkable = walkable_cells
        floor_change = floor_change_cells
        teleport = teleport_cells
        climbable = climbable_cells
        protection = protection_cells
        house = house_cells
    }

:= row_word (cells : array bool) (row : i32) (word : i32) : u32 =
    := side = spot_side ()
    := first = word * row_word_bits ()
    :~ ^ bits (bit : i32) (acc : u32) : u32 =
        ? bit >= row_word_bits () || first + bit >= side ?> acc
        |? index cells (row * side + first + bit) ?> bits (bit + 1) (acc ||| (1u32 <<< bit))
        |: bits (bit + 1) acc
    bits 0 0u32

:= word_mask (word : i32) : u32 =
    := valid = spot_side () - word * row_word_bits ()
    ? valid >= row_word_bits () ?> 4294967295u32 |: (1u32 <<< valid) - 1u32

:~ ^ chain (words : array u32) (word : i32) (lo : i32) (hi : i32) : string =
    ? lo = hi
    ?> sm'.obj_to_string (index words (lo * row_word_count () + word)) ++ "u32"
    |:
        := mid = (lo + hi) / 2
        "if row <= "
        ++ sm'.obj_to_string mid
        ++ " then "
        ++ chain words word lo mid
        ++ " else "
        ++ chain words word (mid + 1) hi

:~ ^ outside_choice (outside_blocked : bool) (word : i32) : string =
    := value = sm'.obj_to_string (? outside_blocked ?> word_mask word |: 0u32) ++ "u32"
    ? word = row_word_count () - 1
    ?> value
    |:
        "if word = "
        ++ sm'.obj_to_string word
        ++ " then "
        ++ value
        ++ " else "
        ++ outside_choice outside_blocked (word + 1)

:~ ^ inside_choice (words : array u32) (word : i32) : string =
    := rows = "(" ++ chain words word 0 (spot_side () - 1) ++ ")"
    ? word = row_word_count () - 1 ?> rows
    |: "if word = " ++ sm'.obj_to_string word ++ " then " ++ rows ++ " else " ++ inside_choice words (word + 1)

:= emit (name : string) (cells : array bool) (outside_blocked : bool) : () =
    := side = spot_side ()
    := count = row_word_count ()
    := words : array u32 = filled (side * count) 0u32
    :~ ^ cells_of (cell : i32) : () =
        ? cell < side * count ?>
            set words cell (row_word cells (cell / count) (cell % count))
            cells_of (cell + 1)
    cells_of 0
    console.write_line ("let " ++ name ++ " (word : i32) (row : i32) : u32 =")
    console.write_line (
        "    if row < 0 || row > "
        ++ sm'.obj_to_string (side - 1)
        ++ " then ("
        ++ outside_choice outside_blocked 0
        ++ ") else "
        ++ inside_choice words 0
    )

:= literal (n : i32) : string = ? n < 0 ?> "(0 - " ++ sm'.obj_to_string (0 - n) ++ ")" |: sm'.obj_to_string n

:= row_spans (cells : array bool) (row : i32) : string =
    := side = spot_side ()
    := radius = spot_radius ()
    := inside (column : i32) : bool = column < side && index cells (row * side + column)
    :~ ^ last_of (column : i32) : i32 = ? inside (column + 1) ?> last_of (column + 1) |: column
    :~ ^ scan (column : i32) (text : string) : string =
        ? column >= side
        ?> text
        |? inside column
        ?>
            := last = last_of column
            := span =
                ? last = column
                ?> "dx = " ++ literal (column - radius)
                |: "(dx >= " ++ literal (column - radius) ++ " && dx <= " ++ literal (last - radius) ++ ")"
            scan (last + 1) (? text = "" ?> span |: text ++ " || " ++ span)
        |: scan (column + 1) text
    scan 0 ""

:= emit_spans (name : string) (cells : array bool) : () =
    := side = spot_side ()
    := radius = spot_radius ()
    :~ ^ rows (row : i32) (text : string) : string =
        ? row >= side
        ?> text
        |:
            := spans = row_spans cells row
            rows
                (row + 1)
                (
                    ? spans = ""
                    ?> text
                    |? text = ""
                    ?> "if dy = " ++ literal (row - radius) ++ " then " ++ spans
                    |: text ++ " elif dy = " ++ literal (row - radius) ++ " then " ++ spans
                )
    := chain = rows 0 ""
    console.write_line ("let " ++ name ++ " (dx : i32) (dy : i32) : bool =")
    console.write_line ("    " ++ (? chain = "" ?> "false" |: chain ++ " else false"))

:= signed_label (n : i32) : string =
    := digits = ? n < 0 ?> "-" ++ sm'.obj_to_string (0 - n) |: "+" ++ sm'.obj_to_string n
    :~ ^ pad (text : string) : string = ? (sm'.length text : i32) >= 4 ?> text |: pad (" " ++ text)
    pad digits

:= walk_dump (cells : array bool) : () =
    := side = spot_side ()
    := radius = spot_radius ()
    console.write_line (
        "walkability around "
        ++ sm'.obj_to_string (spot_x ())
        ++ ","
        ++ sm'.obj_to_string (spot_y ())
        ++ ","
        ++ sm'.obj_to_string (spot_z ())
        ++ " radius "
        ++ sm'.obj_to_string radius
        ++ " (# blocked, . walkable)"
    )
    :~ ^ rows (row : i32) : () =
        ? row < side ?>
            :~ ^ marks (column : i32) (text : string) : string =
                ? column >= side ?> text
                |: marks (column + 1) (text ++ (? index cells (row * side + column) ?> "." |: "#"))
            console.write_line (signed_label (row - radius) ++ " " ++ marks 0 "")
            rows (row + 1)
    rows 0

:= listed (cells : array bool) (label : string) : () =
    := side = spot_side ()
    := radius = spot_radius ()
    :~ ^ columns (column : i32) : () =
        ? column < side
        ?>
            :~ ^ rows (row : i32) : () =
                ? row < side
                ?>
                    ? index cells (row * side + column)
                    ?>
                        console.write_line (
                            sm'.obj_to_string (spot_x () - radius + column)
                            ++ ","
                            ++ sm'.obj_to_string (spot_y () - radius + row)
                            ++ " "
                            ++ label
                        )
                    rows (row + 1)
            rows 0
            columns (column + 1)
    columns 0

:= floor_change_listing (g : grid) (exits : array bool) : () =
    :~ ^ counted (identity : i32) (total : i32) : i32 =
        ? identity >= item_id_limit ()
        ?> total
        |: counted (identity + 1) (? index exits identity ?> total + 1 |: total)
    console.write_line (
        "floor-change tiles on floor "
        ++ sm'.obj_to_string (spot_z ())
        ++ " within radius "
        ++ sm'.obj_to_string (spot_radius ())
        ++ " of "
        ++ sm'.obj_to_string (spot_x ())
        ++ ","
        ++ sm'.obj_to_string (spot_y ())
        ++ " (from "
        ++ sm'.obj_to_string (counted 0 0)
        ++ " floorchange item ids)"
    )
    := any (cells : array bool) : bool =
        :~ ^ scan (i : i32) : bool = ? i >= length cells ?> !- |? index cells i ?> !+ |: scan (i + 1)
        scan 0
    listed g.floor_change "floorchange"
    listed g.teleport "teleport"
    ? any g.floor_change = !- || any g.climbable = !- ?> console.write_line ""
    listed g.climbable "height3"
    ? any g.climbable || any g.protection || any g.house ?> console.write_line ""
    listed g.protection "protection-zone"
    listed g.house "house"

:= main () =
    := read (variable : string) : bytes =
        am'.from_vec (file_system.read_all_bytes (env.get_environment_variable variable))
    := kinds = item_kinds_of (read "TIBIA_MAP_APPEARANCES")
    := items = read "TIBIA_MAP_ITEMS"
    := exits = ids_with items "key=\"floorchange\""
    := teleports = ids_with items "value=\"teleport\""
    := sight_overrides = ids_with items "key=\"blockProjectile\" value=\"1\""
    := sight_blocking_kinds = kinds.sight_blocking
    :~ ^ merge_sight_overrides (identity : i32) : () =
        ? identity < item_id_limit () ?>
            ? index sight_overrides identity ?> set sight_blocking_kinds identity !+
            merge_sight_overrides (identity + 1)
    merge_sight_overrides 0
    := grid = walk_tiles (read "TIBIA_MAP_OTBM") kinds exits teleports
    emit "arena_spot_bits" grid.blocked !+
    emit "arena_road_bits" grid.road !-
    emit "arena_sight_bits" grid.sight_blocked !-
    emit_spans "arena_protection_zone" grid.protection
    walk_dump grid.walkable
    floor_change_listing grid exits
