:= texts () : list string = [ pod_1 (); pod_2 (); pod_3 (); pod_4 (); pod_5 (); pod_6 () ]

:= all_rows () : list acceptance::row =
    listm::concat
        [
            acceptance::rows_of "pod1" (pod_1 ())
            acceptance::rows_of "pod2" (pod_2 ())
            acceptance::rows_of "pod3" (pod_3 ())
            acceptance::rows_of "pod4" (pod_4 ())
            acceptance::rows_of "pod5" (pod_5 ())
            acceptance::rows_of "pod6" (pod_6 ())
        ]

:= all_roofs () : list acceptance::roof = texts () |> listm::map acceptance::roofs_of |> listm::concat

:= verdict_text (ours : string) : string =
    ?= acceptance::report ours [ "RUNFASTW"; "RUNOMPW"; "MOJO" ] (all_rows ()) (all_roofs ()) ?|
    | v, lines =>
        := overall = ? acceptance::verdict_name v = "WON" ?> "WON" |: "NOT-WON"
        sm'::concat_list "\n" lines ++# "\nACCEPTANCE " ++# overall

:= ours_expected () : string =
    "CELL s15M t=1: WON\n"
    ^^ "  pods=3 aa=+0.7% margin=+3.0%\n"
    ^^ "  roofline: 275 tok/s vs 116 needed (+50.0% of measured bandwidth) -> WON\n"
    ^^ "  vs RUNFASTW: n=36 z*100=523 hl=+31.9% ci99=[+28.8%, +35.4%] -> WON\n"
    ^^ "  vs MOJO: n=36 z*100=523 hl=+11.1% ci99=[+9.0%, +14.7%] -> WON\n"
    ^^ "CELL s15M t=4: WON\n"
    ^^ "  pods=3 aa=+2.5% margin=+5.1%\n"
    ^^ "  roofline: 844 tok/s vs 425 needed (+50.0% of measured bandwidth) -> WON\n"
    ^^ "  vs RUNOMPW: n=36 z*100=523 hl=+30.4% ci99=[+24.8%, +38.4%] -> WON\n"
    ^^ "  vs MOJO: n=36 z*100=523 hl=+71.3% ci99=[+64.4%, +78.2%] -> WON\n"
    ^^ "CELL s42M t=1: WON\n"
    ^^ "  pods=3 aa=+0.9% margin=+3.0%\n"
    ^^ "  roofline: 102 tok/s vs 41 needed (+50.0% of measured bandwidth) -> WON\n"
    ^^ "  vs RUNFASTW: n=36 z*100=463 hl=+7.1% ci99=[+5.5%, +8.3%] -> WON\n"
    ^^ "  vs MOJO: n=36 z*100=512 hl=+10.7% ci99=[+8.4%, +13.0%] -> WON\n"
    ^^ "CELL s42M t=4: TIE\n"
    ^^ "  pods=3 aa=+2.1% margin=+4.2%\n"
    ^^ "  roofline: 331 tok/s vs 133 needed (+50.0% of measured bandwidth) -> WON\n"
    ^^ "  vs RUNOMPW: n=36 z*100=205 hl=+1.8% ci99=[-0.6%, +3.3%] -> TIE\n"
    ^^ "  vs MOJO: n=36 z*100=523 hl=+34.9% ci99=[+30.6%, +38.7%] -> WON\n"
    ^^ "CELL s110M t=1: WON\n"
    ^^ "  pods=3 aa=+0.6% margin=+3.0%\n"
