:= all_rows () : list acceptance::row =
    listm::concat [ acceptance::rows_of "pod1" (pod_1 ()); acceptance::rows_of "pod2" (pod_2 ()); acceptance::rows_of "pod3" (pod_3 ()) ]

:= all_roofs () : list acceptance::roof =
    listm::concat [ acceptance::roofs_of (pod_1 ()); acceptance::roofs_of (pod_2 ()); acceptance::roofs_of (pod_3 ()) ]

:= verdict_text (ours : string) : string =
    ?= acceptance::report ours [ "MP3"; "GRID9" ] (all_rows ()) (all_roofs ()) ?|
    | v, lines =>
        := overall = ? acceptance::verdict_name v = "WON" ?> "WON" |: "NOT-WON"
        sm'::concat_list "\n" lines ++# "\nACCEPTANCE " ++# overall

:= ours_expected () : string =
    "CELL s15M t=gpu: TIE\n"
    ^^ "  pods=3 aa=+0.1% margin=+3.0%\n"
    ^^ "  roofline: 1100 tok/s vs 2854 needed (+30.0% of measured bandwidth) -> TIE\n"
    ^^ "  vs MP3: n=36 z*100=523 hl=+411.1% ci99=[+399.3%, +425.7%] -> WON\n"
    ^^ "  vs GRID9: n=36 z*100=523 hl=+23.4% ci99=[+23.2%, +23.6%] -> WON\n"
    ^^ "CELL s42M t=gpu: TIE\n"
    ^^ "  pods=3 aa=+0.2% margin=+3.0%\n"
    ^^ "  roofline: 606 tok/s vs 1061 needed (+30.0% of measured bandwidth) -> TIE\n"
    ^^ "  vs MP3: n=36 z*100=523 hl=+320.3% ci99=[+315.8%, +326.3%] -> WON\n"
    ^^ "  vs GRID9: n=36 z*100=523 hl=+25.7% ci99=[+25.5%, +25.9%] -> WON\n"
    ^^ "CELL s110M t=gpu: TIE\n"
    ^^ "  pods=3 aa=+0.2% margin=+3.0%\n"
    ^^ "  roofline: 324 tok/s vs 402 needed (+30.0% of measured bandwidth) -> TIE\n"
    ^^ "  vs MP3: n=36 z*100=521 hl=+284.8% ci99=[+276.7%, +297.9%] -> WON\n"
    ^^ "  vs GRID9: n=36 z*100=466 hl=+34.4% ci99=[+34.0%, +34.6%] -> WON\n"
    ^^ "ACCEPTANCE NOT-WON"

///> rust
:# tiled_grid_forward_on_three_a40_pods_settles_by_the_rule =
    verdict_text "GRIDT" |> _assert_eq (ours_expected ())
