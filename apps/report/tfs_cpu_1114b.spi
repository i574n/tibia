:= all_rows () : list acceptance::row =
    listm::concat [ acceptance::rows_of "pod1" (pod_1 ()); acceptance::rows_of "pod2" (pod_2 ()); acceptance::rows_of "pod3" (pod_3 ()) ]

:= all_roofs () : list acceptance::roof =
    listm::concat [ acceptance::roofs_of (pod_1 ()); acceptance::roofs_of (pod_2 ()); acceptance::roofs_of (pod_3 ()) ]

:= verdict_text (ours : string) : string =
    ?= acceptance::report ours [ "RUNFASTW"; "RUNOMPW"; "MOJO" ] (all_rows ()) (all_roofs ()) ?|
    | v, lines =>
        := overall = ? acceptance::verdict_name v = "WON" ?> "WON" |: "NOT-WON"
        sm'::concat_list "\n" lines ++# "\nACCEPTANCE " ++# overall

:= ours_expected () : string =
    "CELL s15M t=1: WON\n"
    ^^ "  pods=3 aa=+0.7% margin=+3.0%\n"
    ^^ "  roofline: 286 tok/s vs 108 needed (+50.0% of measured bandwidth) -> WON\n"
    ^^ "  vs RUNFASTW: n=36 z*100=523 hl=+27.4% ci99=[+26.0%, +29.0%] -> WON\n"
    ^^ "  vs MOJO: n=36 z*100=523 hl=+8.0% ci99=[+7.1%, +8.9%] -> WON\n"
    ^^ "CELL s15M t=4: WON\n"
    ^^ "  pods=3 aa=+2.6% margin=+5.2%\n"
    ^^ "  roofline: 860 tok/s vs 374 needed (+50.0% of measured bandwidth) -> WON\n"
    ^^ "  vs RUNOMPW: n=36 z*100=468 hl=+24.2% ci99=[+18.1%, +31.1%] -> WON\n"
    ^^ "  vs MOJO: n=36 z*100=466 hl=+63.4% ci99=[+56.7%, +69.7%] -> WON\n"
    ^^ "CELL s42M t=1: WON\n"
    ^^ "  pods=3 aa=+0.3% margin=+3.0%\n"
    ^^ "  roofline: 107 tok/s vs 34 needed (+50.0% of measured bandwidth) -> WON\n"
    ^^ "  vs RUNFASTW: n=36 z*100=523 hl=+28.5% ci99=[+25.9%, +47.3%] -> WON\n"
    ^^ "  vs MOJO: n=36 z*100=523 hl=+13.6% ci99=[+13.0%, +14.6%] -> WON\n"
    ^^ "CELL s42M t=4: WON\n"
    ^^ "  pods=3 aa=+1.6% margin=+3.2%\n"
    ^^ "  roofline: 345 tok/s vs 126 needed (+50.0% of measured bandwidth) -> WON\n"
    ^^ "  vs RUNOMPW: n=36 z*100=521 hl=+24.1% ci99=[+17.0%, +37.0%] -> WON\n"
    ^^ "  vs MOJO: n=36 z*100=523 hl=+31.7% ci99=[+28.6%, +34.6%] -> WON\n"
    ^^ "CELL s110M t=1: WON\n"
