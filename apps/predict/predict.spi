///- --package .
test predict static =
    open testing

open sm'_operators
open hunting_pack

inl candidate (c : camp) : camp = c

inl table_clear () : i32 = 1
inl table_hunter () : i32 = 2
inl table_hunt () : i32 = 3

inl clears (arm : i32) (camp : camp) (t : tactic) : () =
    inl block = range_of (held_out_block ())
    let rec each (i : i32) : () =
        if i < block.count then
            inl elapsed, p = clear_run camp t (block.first + conv i) 6000
            inl h = p.hunter
            inl code, steps, taken, damage, potions =
                table_clear (), h.retreats, h.hits_taken, quantity.value_of h.damage_taken, h.potions
            console.write_line (
                ""
                ++#? code
                ++# "\t"
                ++#? arm
                ++# "\t"
                ++#? i
                ++# "\t"
                ++#? steps
                ++# "\t"
                ++#? taken
                ++# "\t"
                ++#? damage
                ++# "\t"
                ++#? potions
                ++# "\t"
                ++#? elapsed
            )
            each (i + 1)
    each 0

inl hunters (camp : camp) (t : tactic) : () =
    inl block = range_of (held_out_block ())
    inl cap_ticks = 2000i32
    let rec each (i : i32) : () =
        if i < block.count then
            inl elapsed, p = clear_run camp t (block.first + conv i) cap_ticks
            inl h = p.hunter
            inl code, kills, potions, taken, damage =
                table_hunter (), p.kills, h.potions, h.hits_taken, quantity.value_of h.damage_taken
            inl cleared : i32 = if p.kills >= camp.size then 1 else 0
            console.write_line (
                ""
                ++#? code
                ++# "\t"
                ++#? i
                ++# "\t"
                ++#? kills
                ++# "\t"
                ++#? cleared
                ++# "\t"
                ++#? elapsed
                ++# "\t"
                ++#? potions
                ++# "\t"
                ++#? taken
                ++# "\t"
                ++#? damage
            )
            each (i + 1)
    each 0

inl hunts (camp : camp) (t : tactic) : () =
    inl block = range_of (held_out_block ())
    let rec each (i : i32) : () =
        if i < block.count then
            inl p = simulate camp t (block.first + conv i) (scenario_ticks ())
            inl h = p.hunter
            inl code, kills, taken, damage, potions =
                table_hunt (), p.kills, h.hits_taken, quantity.value_of h.damage_taken, h.potions
            console.write_line (
                ""
                ++#? code
                ++# "\t"
                ++#? i
                ++# "\t"
                ++#? kills
                ++# "\t"
                ++#? taken
                ++# "\t"
                ++#? damage
                ++# "\t"
                ++#? potions
            )
            each (i + 1)
    each 0

///> _
inl main () =
    inl arena =
        uniform_camp (open creatures in Cyclops)
        |> on_layout (open terrain in ArenaSpot)
        |> mirroring_the_current_arena
        |> candidate
    clears 0 arena (cavebot_with_heal 160)
    clears 1 arena (live_retreat_tactic 160 2)
    inl spot =
        uniform_camp (open creatures in Hunter)
        |> on_layout (open terrain in ArenaSpot)
        |> mirroring_the_current_arena
        |> candidate
    hunters spot (cavebot_with_heal 160)
    inl ground = arena_hunt () |> mirroring_the_current_arena |> candidate |> respawning_like_canary 60000
    hunts ground (cavebot_with_heal 160)
    0i32
