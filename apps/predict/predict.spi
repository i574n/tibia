:< sm'_operators
:< hunting_pack

:= candidate (c : camp) : camp = c

:= table_clear () : i32 = 1
:= table_hunter () : i32 = 2
:= table_hunt () : i32 = 3

:= clears (arm : i32) (camp : camp) (t : tactic) : () =
    := block = range_of (held_out_block ())
    :~ ^ each (i : i32) : () =
        ? i < block.count ?>
            := elapsed, p = clear_run camp t (block.first + conv i) 6000
            := h = p.hunter
            := code, steps, taken, damage, potions =
                table_clear (), h.retreats, h.hits_taken, quantity.value_of h.damage_taken, h.potions
            console.write_line (
                ""
                ++#? code
                ++# "\t"
                ++#? arm
                ++# "\t"
                ++#? i
                ++# "\t"
                ++#? steps
                ++# "\t"
                ++#? taken
                ++# "\t"
                ++#? damage
                ++# "\t"
                ++#? potions
                ++# "\t"
                ++#? elapsed
            )
            each (i + 1)
    each 0

:= hunters (camp : camp) (t : tactic) : () =
    := block = range_of (held_out_block ())
    := cap_ticks = 2000i32
    :~ ^ each (i : i32) : () =
        ? i < block.count ?>
            := elapsed, p = clear_run camp t (block.first + conv i) cap_ticks
            := h = p.hunter
            := code, kills, potions, taken, damage =
                table_hunter (), p.kills, h.potions, h.hits_taken, quantity.value_of h.damage_taken
            := cleared : i32 = ? p.kills >= camp.size ?> 1 |: 0
            console.write_line (
                ""
                ++#? code
                ++# "\t"
                ++#? i
                ++# "\t"
                ++#? kills
                ++# "\t"
                ++#? cleared
                ++# "\t"
                ++#? elapsed
                ++# "\t"
                ++#? potions
                ++# "\t"
                ++#? taken
                ++# "\t"
                ++#? damage
            )
            each (i + 1)
    each 0

:= hunts (camp : camp) (t : tactic) : () =
    := block = range_of (held_out_block ())
    :~ ^ each (i : i32) : () =
        ? i < block.count ?>
            := p = simulate camp t (block.first + conv i) (scenario_ticks ())
            := h = p.hunter
            := code, kills, taken, damage, potions =
                table_hunt (), p.kills, h.hits_taken, quantity.value_of h.damage_taken, h.potions
            console.write_line (
                ""
                ++#? code
                ++# "\t"
                ++#? i
                ++# "\t"
                ++#? kills
                ++# "\t"
                ++#? taken
                ++# "\t"
                ++#? damage
                ++# "\t"
                ++#? potions
            )
            each (i + 1)
    each 0

:= main () =
    := arena =
        uniform_camp (:< creatures ;; Cyclops)
        |> on_layout (:< terrain ;; ArenaSpot)
        |> mirroring_the_current_arena
        |> candidate
    clears 0 arena (cavebot_with_heal 160)
    clears 1 arena (live_retreat_tactic 160 2)
    := spot =
        uniform_camp (:< creatures ;; Hunter)
        |> on_layout (:< terrain ;; ArenaSpot)
        |> mirroring_the_current_arena
        |> candidate
    hunters spot (cavebot_with_heal 160)
    := ground = arena_hunt () |> mirroring_the_current_arena |> candidate |> respawning_like_canary 60000
    hunts ground (cavebot_with_heal 160)
    0i32
