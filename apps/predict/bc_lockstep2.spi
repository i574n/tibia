///- --package .
:# bc_lockstep2 static =
    :< testing

:< sm'_operators
:< hunting_pack

:= foe_moved (a : foe) (b : foe) : bool = a::at::x <> b::at::x || a::at::y <> b::at::y

:= foe_bits (a : foe) (b : foe) : i32 =
    := hurt = vitality::health a::life <> vitality::health b::life
    bc_lockstep::bit (foe_moved a b) 1024
    + bc_lockstep::bit hurt 2048
    + bc_lockstep::bit (a::strikes_at <> b::strikes_at) 4096

:= foe_mask_at (a : pack) (b : pack) (i : i32) : i32 =
    := f, g = fixed_views::band_at i a::foes, fixed_views::band_at i b::foes
    foe_bits f g + bc_lockstep::bit (f::next_step_at <> g::next_step_at) 8192

:~ ^ foe_mask_from (a : pack) (b : pack) (i : i32) (acc : i32) : i32 =
    ? i >= 6
    ?> acc
    |: foe_mask_from a b (i + 1) (acc ||| foe_mask_at a b i)

:= full_mask (a : pack) (b : pack) : i32 = bc_lockstep::pack_mask a b ||| foe_mask_from a b 0 0

:== split = { tick : i32; mask : i32; prev : pack }

:= found (tick : i32) (m : i32) (prev : pack) : split = { tick = tick; mask = m; prev = prev }

:= t_step (l : bc_lockstep::lock) (tick : i32) (p : pack) : pack = bc_lockstep::teacher_step l tick p

:= s_step (l : bc_lockstep::lock) (tick : i32) (p : pack) : pack = bc_lockstep::student_step l tick p

:~ ^ lockstep (l : bc_lockstep::lock) (tick : i32) (prev : pack) (pt : pack) (ps : pack) : split =
    := m = full_mask pt ps
    ? m <> 0 || tick >= scenario_ticks ()
    ?> found tick m prev
    |: lockstep l (tick + 1) pt (t_step l tick pt) (s_step l tick ps)

:= flag (b : bool) : string =
    ? b
    ?> "1"
    |: "0"

:= plan_text (t : plan) (s : plan) : string =
    := tr, ts = t
    := sr, ss = s
    "\tretreat\t"
    ++# flag tr
    ++# flag sr
    ++# "\tengage\t"
    ++# flag (bc_dataset::engages ts)
    ++# flag (bc_dataset::engages ss)

:= heal_text (b : beat) (r : bc_onpolicy::run) (aimed : pack) : string =
    := ht, hs = bc_heal::heals_of b r aimed
    "\theal\t" ++# flag ht ++# flag hs

:= aimed_plans (b : beat) (r : bc_onpolicy::run) (aimed : pack) : string =
    := t, s = bc_onpolicy::plans_of b r::sb (attackers_of aimed) aimed
    plan_text t s

:= view_aimed (b : beat) (r : bc_onpolicy::run) (prev : pack) : pack * pack =
    := q = bc_decision_point::knight_view b prev
    q, aimed_by b::camp r::d::order q

:= decisions_text (b : beat) (r : bc_onpolicy::run) (prev : pack) : string =
    := q, aimed = view_aimed b r prev
    "decides\t" ++# flag (bc_dataset::decides b::now q) ++# aimed_plans b r aimed ++# heal_text b r aimed

:= split_of (camp : camp) (s : tactic) (seed : u32) : split =
    lockstep { camp = camp; s = s; seed = seed } 0 (start camp) (start camp) (start camp)

:= split_text (camp : camp) (s : tactic) (i : i32) (x : split) : string =
    := r = bc_onpolicy::run_of camp s s::brain i
    decisions_text (bc_onpolicy::beat_at camp r::seed (x::tick - 1)) r x::prev

:= seed_row (camp : camp) (s : tactic) (i : i32) : () =
    := seed = held_out_first () + conv i
    := x = split_of camp s seed
    bc_lockstep::row seed x::tick x::mask
    console::write_line ("at_split\t" ++#? seed ++# "\t" ++# split_text camp s i x)

:~ ^ seeds_from (camp : camp) (s : tactic) (i : i32) : () =
    ? i < bc_run::seed_count () ?>
        seed_row camp s i
        seeds_from camp s (i + 1)

:= main () =
    := w = bc_train::quantized (bc_run::trained (bc_dagger::aggregated (bc_run::pairs_from (training_first ()))))
    seeds_from (bc_run::bc_camp ()) (bc_eval::student_tactic w) 0
    0i32
