///- --package .
:# bc_heal static =
    :< testing

:< sm'_operators
:< hunting_pack

:== tally = { mh : i32; xh : i32; hn : i32; potions : i32; kills : i32; deaths : i32 }

:= zero_tally () : tally = { mh = 0; xh = 0; hn = 0; potions = 0; kills = 0; deaths = 0 }

:= heal_add (c : tally) (teacher : bool) (student : bool) : tally =
    { c ?|
        mh = c::mh + bc_direction::one_if (teacher && student = !-)
        xh = c::xh + bc_direction::one_if (student && teacher = !-)
        hn = c::hn + 1
    }

:= heals_of (b : beat) (r : bc_onpolicy::run) (aimed : pack) : bool * bool =
    := attackers = attackers_of aimed
    wants_heal b (bc_run::teacher ())::brain attackers aimed, wants_heal b r::sb attackers aimed

:= tallied (b : beat) (r : bc_onpolicy::run) (p : pack) (c : tally) : tally =
    := aimed = aimed_by b::camp r::d::order p
    ? (observe b::now aimed)::heal_ready ?>
        := t, s = heals_of b r aimed
        heal_add c t s
    |: c

:= noted (r : bc_onpolicy::run) (tick : i32) (p : pack) (c : tally) : tally =
    := b = bc_onpolicy::beat_at r::camp r::seed tick
    ? bc_dataset::decides b::now p
    ?> tallied b r p c
    |: c

:= scored (p : pack) (c : tally) : tally =
    { c ?|
        potions = c::potions + p::hunter::tally::potions
        kills = c::kills + p::score::kills
        deaths = c::deaths + p::score::deaths
    }

:~ ^ rolled (r : bc_onpolicy::run) (tick : i32) (p : pack) (c : tally) : tally =
    ? tick >= scenario_ticks ()
    ?> scored p c
    |: rolled r (tick + 1) (bc_direction::stepped r tick p) (noted r tick p c)

:~ ^ seeds_from (camp : camp) (d : tactic) (student : brain) (i : i32) (c : tally) : tally =
    ? i >= bc_run::seed_count ()
    ?> c
    |: seeds_from camp d student (i + 1) (rolled (bc_onpolicy::run_of camp d student i) 0 (start camp) c)

:= score_row (driver : string) (c : tally) : () =
    console::write_line (
        driver ++# "\tpotions\t" ++#? c::potions ++# "\tkills\t" ++#? c::kills ++# "\tdeaths\t" ++#? c::deaths
    )

:= report (driver : string) (c : tally) : () =
    bc_direction::rate_row driver "missed_heal" c::mh c::hn
    bc_direction::rate_row driver "extra_heal" c::xh c::hn
    score_row driver c

:= diagnose (camp : camp) (student : tactic) : () =
    report "dagger_student_drives" (seeds_from camp student student::brain 0 (zero_tally ()))
    report "teacher_drives" (seeds_from camp (bc_run::teacher ()) student::brain 0 (zero_tally ()))

:= main () =
    := w = bc_train::quantized (bc_run::trained (bc_dagger::aggregated (bc_run::pairs_from (training_first ()))))
    diagnose (bc_run::bc_camp ()) (bc_eval::student_tactic w)
    0i32
