///- --package .
:# bc_decision_point static =
    :< testing

:< sm'_operators
:< hunting_pack

:== tally = { mr : i32; xr : i32; tr : i32; ae : i32; an : i32; mh : i32; xh : i32; hn : i32 }

:= zero_tally () : tally = { mr = 0; xr = 0; tr = 0; ae = 0; an = 0; mh = 0; xh = 0; hn = 0 }

:= at_poll (b : beat) (both : pack) : pack = foes_act_where b (early_mask both (poll_landing b)) both

:= knight_view (b : beat) (p : pack) : pack =
    := both = charged_both b p
    ?= b::camp::timing::view ?|
    | SeesThisTick => foes_act b::camp b::seed b::tick b::now both
    | SeesLastTick => both
    | SeesAtItsPoll => at_poll b both

:= heal_add (c : tally) (t : bool) (s : bool) : tally =
    { c ?|
        mh = c::mh + bc_direction::one_if (t && s = !-)
        xh = c::xh + bc_direction::one_if (s && t = !-)
        hn = c::hn + 1
    }

:= heal_part (c : tally) (b : beat) (r : bc_onpolicy::run) (aimed : pack) : tally =
    ? (observe b::now aimed)::heal_ready ?>
        := t, s = bc_heal::heals_of b r aimed
        heal_add c t s
    |: c

:= plan_add (c : tally) (d : bc_direction::tally) : tally =
    { c ?| mr = c::mr + d::mr; xr = c::xr + d::xr; tr = c::tr + d::tr; ae = c::ae + d::ae; an = c::an + d::an }

:= plan_diff (t : plan) (s : plan) : bc_direction::tally = bc_direction::both_add (bc_direction::zero_tally ()) t s

:= plan_part (c : tally) (b : beat) (r : bc_onpolicy::run) (aimed : pack) : tally =
    ? bc_dataset::targeted aimed ?>
        := t, s = bc_onpolicy::plans_of b r::sb (attackers_of aimed) aimed
        plan_add c (plan_diff t s)
    |: c

:= tallied (b : beat) (r : bc_onpolicy::run) (q : pack) (c : tally) : tally =
    := aimed = aimed_by b::camp r::d::order q
    heal_part (plan_part c b r aimed) b r aimed

:= noted (r : bc_onpolicy::run) (tick : i32) (p : pack) (c : tally) : tally =
    := b = bc_onpolicy::beat_at r::camp r::seed tick
    := q = knight_view b p
    ? bc_dataset::decides b::now q
    ?> tallied b r q c
    |: c

:~ ^ rolled (r : bc_onpolicy::run) (tick : i32) (p : pack) (c : tally) : tally =
    ? tick >= scenario_ticks ()
    ?> c
    |: rolled r (tick + 1) (bc_direction::stepped r tick p) (noted r tick p c)

:~ ^ seeds_from (camp : camp) (d : tactic) (student : brain) (i : i32) (c : tally) : tally =
    ? i >= bc_run::seed_count ()
    ?> c
    |: seeds_from camp d student (i + 1) (rolled (bc_onpolicy::run_of camp d student i) 0 (start camp) c)

:= plan_rows (driver : string) (c : tally) : () =
    bc_direction::rate_row driver "in_tick_missed_retreat" c::mr c::tr
    bc_direction::rate_row driver "in_tick_extra_retreat" c::xr c::tr
    bc_direction::rate_row driver "in_tick_stance_when_teacher_stays" c::ae c::an

:= report (driver : string) (c : tally) : () =
    plan_rows driver c
    bc_direction::rate_row driver "in_tick_missed_heal" c::mh c::hn
    bc_direction::rate_row driver "in_tick_extra_heal" c::xh c::hn

:= diagnose (camp : camp) (student : tactic) : () =
    report "dagger_student_drives" (seeds_from camp student student::brain 0 (zero_tally ()))
    report "teacher_drives" (seeds_from camp (bc_run::teacher ()) student::brain 0 (zero_tally ()))

:= main () =
    := w = bc_train::quantized (bc_run::trained (bc_dagger::aggregated (bc_run::pairs_from (training_first ()))))
    diagnose (bc_run::bc_camp ()) (bc_eval::student_tactic w)
    0i32
