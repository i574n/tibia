///- --package .
test offscreen static =
    :< testing

:< sm'_operators

:== launch = { exe : string; directory : string; arguments : string; desktop : string; timeout_seconds : i32 }

:| parsed =
    | Ready : launch
    | MissingExe
    | MissingValue : string
    | BadTimeout : string
    | UnknownFlag : string

:| outcome =
    | Exited : u32 * u32
    | TimedOut : u32 * u32
    | NoDesktop : u32
    | NotStarted : u32

:= defaults () : launch = { exe = ""; directory = ""; arguments = ""; desktop = "tibia-probe"; timeout_seconds = 120 }

:~ ^ parse_from (args : list string) (l : launch) : parsed =
    ?= args ?|
    | Nil => ? l.exe = "" ?> MissingExe |: Ready l
    | Cons (flag, Nil) => MissingValue flag
    | Cons (flag, Cons (value, rest)) =>
        ? flag = "--exe" ?> parse_from rest { l ?| exe = value }
        |? flag = "--directory" ?> parse_from rest { l ?| directory = value }
        |? flag = "--arguments" ?> parse_from rest { l ?| arguments = value }
        |? flag = "--desktop" ?> parse_from rest { l ?| desktop = value }
        |? flag = "--timeout-seconds"
        ?>
            ?= convert.try_convert value ?|
            | Some seconds => parse_from rest { l ?| timeout_seconds = seconds }
            | None => BadTimeout value
        |: UnknownFlag flag

:= parse (args : list string) : parsed = parse_from args (defaults ())

:= command_line (l : launch) : string =
    := quoted = "\"" ++# l.exe ++# "\""
    ? l.arguments = "" ?> quoted |: quoted ++# " " ++# l.arguments

:= station_desktop (l : launch) : string = "WinSta0\\" ++# l.desktop

:= report (l : launch) (o : outcome) : list string =
    := finished (pid : u32) (code : u32) : string =
        "offscreen: pid " ++#? pid ++# " exit " ++#? code ++# " on desktop " ++# l.desktop
    ?= o ?|
    | Exited (pid, code) => [ finished pid code ]
    | TimedOut (pid, code) => [ "offscreen: killed after " ++#? l.timeout_seconds ++# " s"; finished pid code ]
    | NoDesktop error => [ "CreateDesktop failed: " ++#? error ]
    | NotStarted error => [ "CreateProcess failed: " ++#? error ]

:= exit_code_of (o : outcome) : i32 =
    ?= o ?|
    | Exited _ => 0
    | TimedOut _ => 0
    | NoDesktop _ => 1
    | NotStarted _ => 1

:= killed_exit_code () : u32 = 124

:= win32_declarations () =
    global """
        #[link(name = "user32")]
        unsafe extern "system" {
            safe fn CreateDesktopW(
                name: *const u16, device: *const u16, mode: *const u8, flags: u32, access: u32, attributes: *const u8,
            ) -> i64;
            safe fn CloseDesktop(desktop: i64) -> i32;
        }
        unsafe extern "system" {
            safe fn GetLastError() -> u32;
            safe fn GetProcessId(process: i64) -> u32;
            safe fn WaitForSingleObject(handle: i64, milliseconds: u32) -> u32;
            safe fn TerminateProcess(process: i64, code: u32) -> i32;
            safe fn GetExitCodeProcess(process: i64, code: *mut u32) -> i32;
            safe fn CloseHandle(handle: i64) -> i32;
            safe fn CreateProcessW(
                application: *const u16, command_line: *mut u16, process_attributes: *const u8,
                thread_attributes: *const u8, inherit: i32, flags: u32, environment: *const u8, directory: *const u16,
                startup: *const StartupInfo, information: *mut ProcessInformation,
            ) -> i32;
        }
        #[repr(C)]
        #[derive(Default)]
        struct StartupInfo {
            cb: u32, reserved: usize, desktop: usize, title: usize, x: u32, y: u32, x_size: u32, y_size: u32,
            x_chars: u32, y_chars: u32, fill: u32, flags: u32, show: u16, reserved2_size: u16, reserved2: usize,
            input: i64, output: i64, error: i64,
        }
        #[repr(C)]
        #[derive(Default, Clone, Copy)]
        struct ProcessInformation { process: i64, thread: i64, process_id: u32, thread_id: u32 }
        """

:! wide = $'Vec<u16>'
:! wide_pointer = $'*const u16'
:! wide_mutable_pointer = $'*mut u16'
:! address = $'usize'
:! startup_info = $'StartupInfo'
:! process_information = $'std::cell::Cell<ProcessInformation>'
:! information_pointer = $'*mut ProcessInformation'
:! exit_code_cell = $'std::cell::Cell<u32>'
:! byte_pointer = $'*const u8'

:= wide_of (text : string) : wide =
    win32_declarations ()
    $'(&*!text).encode_utf16().chain(std::iter::once(0)).collect::<Vec<u16>>()' : wide

:= wide_start (text : wide) : wide_pointer = $'!text.as_ptr()' : wide_pointer

:= wide_mutable_start (text : wide) : wide_mutable_pointer = $'!text.as_ptr().cast_mut()' : wide_mutable_pointer

:= wide_address (text : wide) : address = $'!text.as_ptr().addr()' : address

:= create_desktop_at (name : wide_pointer) : i64 =
    $'CreateDesktopW(!name, std::ptr::null(), std::ptr::null(), 0, 0x01FF, std::ptr::null())' : i64

:= close_desktop (desktop : i64) : () =
    win32_declarations ()
    ignore ($'CloseDesktop(!desktop)' : i32)

:= last_error () : u32 =
    win32_declarations ()
    $'GetLastError()' : u32

:= startup_size () : u32 = $'u32::try_from(std::mem::size_of::<StartupInfo>()).unwrap()' : u32

:= startup_on (size : u32) (desktop : address) : startup_info =
    $'StartupInfo { cb: !size, desktop: !desktop, ..Default::default() }' : startup_info

:= information_empty () : process_information =
    $'std::cell::Cell::new(ProcessInformation::default())' : process_information

:= no_bytes () : byte_pointer = $'std::ptr::null::<u8>()' : byte_pointer

:= information_start (information : process_information) : information_pointer =
    $'!information.as_ptr()' : information_pointer

:= create_process_at
    (application : wide_pointer) (command : wide_mutable_pointer) (directory : wide_pointer) (startup : startup_info)
    (information : information_pointer) (none : byte_pointer)
    : i32
    =
    $'CreateProcessW(!application, !command, !none, !none, 0, 0, !none, !directory, &!startup, !information)' : i32

:= information_process (information : process_information) : i64 = $'!information.get().process' : i64

:= information_thread (information : process_information) : i64 = $'!information.get().thread' : i64

:= close_handle (handle : i64) : () = ignore ($'CloseHandle(!handle)' : i32)

:= exit_code_empty () : exit_code_cell = $'std::cell::Cell::new(0u32)' : exit_code_cell

:= exit_code_read (process : i64) (cell : exit_code_cell) : () =
    ignore ($'GetExitCodeProcess(!process, !cell.as_ptr())' : i32)

:= exit_code_value (cell : exit_code_cell) : u32 = $'!cell.get()' : u32

:= create_desktop (name : string) : i64 =
    := wide_name = wide_of name
    create_desktop_at (wide_start wide_name)

:= start_on (station : string) (exe : string) (line : string) (directory : string) : i64 =
    := folder =
        ? directory <> "" ?> directory
        |:
            ?= file_system.directory_get_parent exe |> optionm'.unbox ?|
            | Some parent => parent
            | None => ""
    := application, command, directory_wide, desktop = wide_of exe, wide_of line, wide_of folder, wide_of station
    := information = information_empty ()
    := startup = startup_on (startup_size ()) (wide_address desktop)
    := created =
        create_process_at
            (wide_start application) (wide_mutable_start command) (wide_start directory_wide) startup
            (information_start information) (no_bytes ())
    ? created = 0 ?> 0
    |:
        close_handle (information_thread information)
        information_process information

:= process_id (process : i64) : u32 =
    win32_declarations ()
    $'GetProcessId(!process)' : u32

:= wait_for (process : i64) (milliseconds : u32) : u32 =
    win32_declarations ()
    $'WaitForSingleObject(!process, !milliseconds)' : u32

:= terminate (process : i64) (code : u32) : () =
    win32_declarations ()
    ignore ($'TerminateProcess(!process, !code)' : i32)

:= exit_status (process : i64) : u32 =
    win32_declarations ()
    := cell = exit_code_empty ()
    exit_code_read process cell
    exit_code_value cell

:= close_process (process : i64) : () =
    win32_declarations ()
    close_handle process

:= run_on_desktop (l : launch) : outcome =
    := desktop = create_desktop l.desktop
    ? desktop = 0
    ?> NoDesktop (last_error ())
    |:
        := process = start_on (station_desktop l) l.exe (command_line l) l.directory
        := o =
            ? process = 0
            ?> NotStarted (last_error ())
            |:
                := pid = process_id process
                := waited = wait_for process (conv l.timeout_seconds * 1000u32)
                := timed_out = waited <> 0
                ? timed_out ?> terminate process (killed_exit_code ())
                := code = exit_status process
                close_process process
                ? timed_out ?> TimedOut (pid, code) |: Exited (pid, code)
        close_desktop desktop
        o

:= arguments () : list string =
    :~ ^ collect (i : i32) (found : list string) : list string =
        ?= env.try_command_line_argument i ?|
        | Some value => collect (i + 1) (value :: found)
        | None => listm.rev found
    collect 0 Nil

///> lua
///> rust
test flags_fill_the_launch_and_keep_the_script_defaults =
    ?= parse [ "--exe"; "C:\\otc\\otclient.exe"; "--arguments"; "--mode probe" ] ?|
    | Ready l =>
        l.desktop |> _assert_eq "tibia-probe"
        l.timeout_seconds |> _assert_eq 120i32
        command_line l |> _assert_eq "\"C:\\otc\\otclient.exe\" --mode probe"
        station_desktop l |> _assert_eq "WinSta0\\tibia-probe"
    | _ => _assert_eq "ready" "not ready"

///> lua
///> rust
test bad_input_names_its_cause =
    := missing : bool =
        ?= parse [ "--desktop"; "x" ] ?|
        | MissingExe => !+
        | _ => !-
    missing |> _assert_eq !+
    := bad : string =
        ?= parse [ "--exe"; "a.exe"; "--timeout-seconds"; "soon" ] ?|
        | BadTimeout value => value
        | _ => ""
    bad |> _assert_eq "soon"
    := dangling : string =
        ?= parse [ "--exe" ] ?|
        | MissingValue flag => flag
        | _ => ""
    dangling |> _assert_eq "--exe"

///> lua
///> rust
test reports_match_run_offscreen_ps1 =
    := base = defaults ()
    := l : launch = { base ?| exe = "a.exe"; timeout_seconds = 30 }
    := lines : i32 = listm.length (report l (TimedOut (77u32, 124u32)))
    lines |> _assert_eq 2i32
    report l (Exited (77u32, 0u32)) |> _assert_eq [ "offscreen: pid 77 exit 0 on desktop tibia-probe" ]
    report l (TimedOut (77u32, 124u32))
    |> _assert_eq [ "offscreen: killed after 30 s"; "offscreen: pid 77 exit 124 on desktop tibia-probe" ]

///> rust
test a_hidden_desktop_runs_a_program_and_reports_its_exit_code =
    := windows = platform.is_windows ()
    := desktop = ? windows ?> create_desktop "spiral-offscreen-test" |: 1
    (desktop <> 0) |> _assert_eq !+
    := process =
        ? windows
        ?> start_on "WinSta0\\spiral-offscreen-test" "C:\\Windows\\System32\\cmd.exe" "cmd.exe /c exit 3" ""
        |: 1
    (process <> 0) |> _assert_eq !+
    := waited = ? windows ?> wait_for process 10000u32 |: 0u32
    := code = ? windows ?> exit_status process |: 3u32
    ? windows ?>
        close_process process
        close_desktop desktop
    (waited, code) |> _assert_eq (0u32, 3u32)

///> _
:= main () =
    := code =
        ?= parse (arguments ()) ?|
        | Ready l =>
            := o = run_on_desktop l
            listm.iter console.write_line (report l o)
            exit_code_of o
        | MissingExe =>
            console.write_line "offscreen: --exe is required"
            2
        | MissingValue flag =>
            console.write_line ("offscreen: " ++# flag ++# " needs a value")
            2
        | BadTimeout value =>
            console.write_line ("offscreen: --timeout-seconds is not a number: " ++# value)
            2
        | UnknownFlag flag =>
            console.write_line ("offscreen: unknown flag " ++# flag)
            2
    $'std::process::exit(!code)' : ()
