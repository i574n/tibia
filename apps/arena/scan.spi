:< sm'_operators
:= mark_of (marks_unloaded : bool) (f : client.footing) : string =
    ?= f ?|
    | Unknown => ? marks_unloaded ?> "?" |: "#"
    | Blocked => "#"
    | _ => "."

:= scan_row (marks_unloaded : bool) (centre : client.spot) (radius : i32) (dy : i32) : string =
    :~ ^ cells (dx : i32) (row : string) : string =
        ? dx > radius
        ?> row
        |:
            := cell =
                ? dx = 0 && dy = 0
                ?> "K"
                |: mark_of marks_unloaded (client.footing_at { centre ?| x = centre.x + dx; y = centre.y + dy })
            cells (dx + 1) (row ++# cell)
    cells (0 - radius) ""

:= scan (marks_unloaded : bool) (radius : i32) : () =
    := centre = client.player_spot ()
    := legend =
        ? marks_unloaded
        ?> " (# wall or blocked, . walkable, ? not loaded by the client, K knight)"
        |: " (# wall or blocked, . walkable, K knight)"
    probe.note ("scan around " ++# probe.described centre ++# legend)
    :~ ^ rows (dy : i32) : () =
        ? dy <= radius ?>
            := row = scan_row marks_unloaded centre radius dy
            := signed = (? dy >= 0 ?> "+" |: "") ++#? dy
            probe.note (sm'.pad_left 3 ' ' signed ++# " " ++# row)
            rows (dy + 1)
    rows (0 - radius)

:= main () =
    := ~radius = 12i32
    := marks_unloaded = client.env_is "TIBIA_SCAN_MARKS_UNLOADED" "1"
    := scan_then_finish () =
        scan marks_unloaded radius
        probe.finish "scanned"
    probe.started (\ () => client.after 2500 scan_then_finish) 40000
    0i32
