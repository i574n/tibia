:! native_position = $'any'

:! creature = $'any'

:! crowd = $'any'

:== spot = { x : i32; y : i32; z : i32 }

:= after (ms : i32) (f : () -> ()) : () = $'scheduleEvent(!f, !ms)' : ()

:= now_ms () : i32 = $'g_clock.millis()' : i32

:= wall_seconds () : i32 = $'os.time()' : i32

:= env_i32 (name : string) (fallback : i32) : i32 = $'tonumber(os.getenv(!name) or "") or (!fallback)' : i32

:= env_text (name : string) (fallback : string) : string = $'os.getenv(!name) or (!fallback)' : string

:= seed_random_from_clock () : () = $'math.randomseed(os.time())' : ()

:= env_is (name : string) (value : string) : bool = $'os.getenv(!name) == (!value)' : bool

:= spot_of (p : native_position) : spot = { x = $'!p.x' : i32; y = $'!p.y' : i32; z = $'!p.z' : i32 }

:= player_spot () : spot = spot_of ($'g_game.getLocalPlayer():getPosition()' : native_position)

:= player_positioned () : bool = $'g_game.getLocalPlayer():getPosition() ~= nil' : bool

:= player_present () : bool = $'g_game.getLocalPlayer() ~= nil and g_game.isOnline()' : bool

:= player_name () : string = $'g_game.getLocalPlayer():getName()' : string

:= player_health () : i32 = $'g_game.getLocalPlayer():getHealth()' : i32

:= player_max_health () : i32 = $'g_game.getLocalPlayer():getMaxHealth()' : i32

:= player_shield_skill () : i32 = $'g_game.getLocalPlayer():getSkillLevel(Skill.Shielding)' : i32

:= player_mana () : i32 = $'g_game.getLocalPlayer():getMana()' : i32

:= player_experience () : i32 = $'g_game.getLocalPlayer():getExperience()' : i32

:= player_walking () : bool = $'g_game.getLocalPlayer():isWalking()' : bool

:= player_zone () : string =
    $'(function() local p = g_game.getLocalPlayer(); return tostring(p.isInProtectionZone and p:isInProtectionZone() \
        or "?") end)()' : string

:| footing =
    | Free
    | Ramp
    | Occupied
    | Blocked
    | Unknown

:= footing_at (s : spot) : footing =
    := x, y, z = s.x, s.y, s.z
    inl code = $'(function() local tile = g_map.getTile({ x = !x, y = !y, z = !z }); if not tile then return 4 elseif \
        tile:isWalkable() and not tile:hasFloorChange() then return 0 elseif tile:isWalkable() then return 1 elseif \
        tile:isWalkable(true) then return 2 else return 3 end end)()' : i32
    ? code = 0 ?> Free |? code = 1 ?> Ramp |? code = 2 ?> Occupied |? code = 3 ?> Blocked |: Unknown

:= spectators (s : spot) : crowd =
    := x, y, z = s.x, s.y, s.z
    $'g_map.getSpectators({ x = !x, y = !y, z = !z }, false)' : crowd

:= crowd_size (c : crowd) : i32 = $'##(!c)' : i32

:= member (c : crowd) (index : i32) : creature = $'(!c)[!index]' : creature

:= positioned_monster (c : creature) : bool = $'(!c):isMonster() and (!c):getPosition() ~= nil' : bool

:= live_monster (c : creature) : bool = $'(!c):isMonster() and not (!c):isDead() and (!c):getPosition() ~= nil' : bool

:= creature_spot (c : creature) : spot = spot_of ($'(!c):getPosition()' : native_position)

:= creature_name (c : creature) : string = $'(!c):getName()' : string

:= creature_health_percent (c : creature) : i32 = $'(!c):getHealthPercent()' : i32

:= same_creature (a : creature) (b : creature) : bool = $'(!a) == (!b)' : bool

:= attacking () : creature = $'g_game.getAttackingCreature()' : creature

:= attacking_anyone () : bool = $'g_game.isAttacking()' : bool

:= attacking_short () : string =
    $'(function() local a = g_game.getAttackingCreature(); if not a then return "nothing" end; return a:getName() .. \
        " " .. a:getHealthPercent() .. "%" end)()' : string

:= attacking_described () : string =
    $'(function() local a = g_game.getAttackingCreature(); if not a then return "nothing" end; local p = \
        a:getPosition(); return a:getName() .. " " .. a:getHealthPercent() .. "% at " .. string.format("%d,%d,%d", \
        p.x, p.y, p.z) end)()' : string

:= monsters_described (s : spot) : string =
    := x, y, z = s.x, s.y, s.z
    $'(function() local parts = {}; for _, c in ipairs(g_map.getSpectators({ x = !x, y = !y, z = !z }, false)) do if \
        c:isMonster() and not c:isDead() and c:getPosition() ~= nil then local p = c:getPosition(); \
        table.insert(parts, string.format("%s %d%% %d,%d", c:getName(), c:getHealthPercent(), p.x, p.y)) end end; if \
        ##parts == 0 then return "none" end; return table.concat(parts, "; ") end)()' : string

:= attack (c : creature) : () = $'g_game.attack(!c)' : ()

:= cancel_attack () : () = $'g_game.cancelAttack()' : ()

:= chase_on () : bool = $'g_game.getChaseMode() == ChaseOpponent' : bool

:= chasing (on : bool) : () =
    $'(function(mode) if g_game.getChaseMode() ~= mode then g_game.setChaseMode(mode) end end)((!on) and \
        ChaseOpponent or DontChase)' : ()

:= fight_balanced () : () = $'g_game.setFightMode(FightBalanced)' : ()

:= fight_mode_text () : string = $'tostring(g_game.getFightMode())' : string

:= drink (item : i32) : bool = $'g_game.useInventoryItemWith(!item, g_game.getLocalPlayer()) ~= false' : bool

:= step (dx : i32) (dy : i32) : bool =
    $'g_game.walk(({ ["0,-1"] = North, ["1,0"] = East, ["0,1"] = South, ["-1,0"] = West, ["1,-1"] = NorthEast, \
        ["1,1"] = SouthEast, ["-1,1"] = SouthWest, ["-1,-1"] = NorthWest })[(!dx) .. "," .. (!dy)]) ~= false' : bool

:= talk (text : string) : () = $'g_game.talk(!text)' : ()

:= disable_client_bot (character_key : string) : () =
    $'(function(key) local s = g_settings.getNode("bot") or {}; s[key] = { enabled = false }; \
        g_settings.setNode("bot", s); g_settings.save() end)(!character_key)' : ()

:= enable_client_bot (character_key : string) (config : string) : () =
    $'(function(key, config) local s = g_settings.getNode("bot") or {}; s[key] = { enabled = true, config = config }; \
        g_settings.setNode("bot", s); g_settings.save() end)(!character_key, !config)' : ()

:= start_client_bot (character_key : string) (config : string) : () =
    enable_client_bot character_key config
    $'modules.game_bot.refresh()' : ()

:= instrument_game_calls () : lua.native_table =
    $'(function() local s = { attack = 0, cancel = 0, guarded = 0, other = {} }; local nativeAttack, nativeCancel, \
        nativeCancelAndFollow, nativeCancelFollow = g_game.attack, g_game.cancelAttack, g_game.cancelAttackAndFollow, \
        g_game.cancelFollow; g_game.attack = function(...) s.attack = s.attack + 1 return nativeAttack(...) end; if \
        nativeCancel then g_game.cancelAttack = function(...) s.cancel = s.cancel + 1 return nativeCancel(...) end \
        end; if nativeCancelAndFollow then g_game.cancelAttackAndFollow = function(...) s.cancel = s.cancel + 1 \
        return nativeCancelAndFollow(...) end end; g_game.cancelFollow = function(...) if not \
        g_game.getFollowingCreature() then s.guarded = s.guarded + 1 return end return nativeCancelFollow(...) end; \
        for _, name in ipairs({ "stop", "walk", "autoWalk", "forceWalk", "turn", "follow", "cancelFollow", \
        "setChaseMode", "setFightMode", "useInventoryItemWith", "useWith", "move", "look", "talk", "equipItem" }) do \
        local native = g_game[name]; if native then g_game[name] = function(...) s.other[name] = (s.other[name] or 0) \
        + 1 return native(...) end end end; return s end)()' : lua.native_table

:= game_call_report (s : lua.native_table) : string =
    $'(function(s) local p = g_game.getLocalPlayer(); local function idAt(slot) local item = \
        p:getInventoryItem(slot); return item and tostring(item:getId()) or "-" end; local a = \
        g_game.getAttackingCreature(); local parts = {}; for name, count in pairs(s.other) do table.insert(parts, \
        name .. "=" .. count) end; table.sort(parts); local d = "-"; if a then local q, r = a:getPosition(), \
        p:getPosition(); d = tostring(math.max(math.abs(q.x - r.x), math.abs(q.y - r.y))) end; return \
        string.format("diag attack calls %d cancels %d hands %s target distance %s chase %s fight %s", s.attack, \
        s.cancel, idAt(InventorySlotLeft) .. "/" .. idAt(InventorySlotRight), d, tostring(g_game.getChaseMode()), \
        tostring(g_game.getFightMode())) .. " calls " .. table.concat(parts, " ") .. " guarded cancelFollow " .. \
        s.guarded end)(!s)' : string

:= parity_summary () : string = $'ArenaParity and ArenaParity.summary() or ""' : string

:= remember (t : lua.native_table) (c : creature) : () = $'(!t)[(!c):getId()] = (!c)' : ()

:= forget_dead (t : lua.native_table) : i32 =
    $'(function(t) local n = 0; for id, c in pairs(t) do if c:isDead() then n = n + 1; t[id] = nil end end; return n \
        end)(!t)' : i32

:= new_creature_slot () : lua.native_table = $'{}' : lua.native_table

:= slot_occupied (slot : lua.native_table) : bool = $'(!slot).creature ~= nil' : bool

:= slot_creature (slot : lua.native_table) : creature = $'(!slot).creature' : creature

:= occupy_slot (slot : lua.native_table) (c : creature) : () = $'(!slot).creature = !c' : ()

:= empty_slot (slot : lua.native_table) : () = $'(!slot).creature = nil' : ()

:= creature_id (c : creature) : i32 = $'(!c):getId()' : i32

:= creature_is_monster (c : creature) : bool = $'(!c):isMonster()' : bool

:= creature_is_local_player (c : creature) : bool = $'(!c):isLocalPlayer()' : bool

:= creature_positioned (c : creature) : bool = $'(!c):getPosition() ~= nil' : bool

:= creature_dead (c : creature) : bool = $'(!c):isDead()' : bool

:= position_known (p : native_position) : bool = $'(!p) ~= nil' : bool

:= player_speed () : string = $'tostring(g_game.getLocalPlayer():getSpeed())' : string

:= on_position_change (f : creature -> native_position -> native_position -> ()) : () =
    $'local handler = function(c, n, o) (!f)(c)(n)(o) end; connect(Creature, { onPositionChange = handler }); \
        connect(LocalPlayer, { onPositionChange = handler })' : ()

:= online () : bool = $'g_game.isOnline()' : bool

:= log_out () : () = $'g_game.safeLogout()' : ()

:= exit_client () : () = $'g_app.exit()' : ()

:= hidden_requested () : bool = env_is "TIBIA_PROBE_HIDDEN" "1"

:= hide_window () : () =
    $'g_window.move({ x = -32000, y = -32000 })' : ()
    $'g_window.hide()' : ()

:= mute () : () =
    $'g_settings.set("enableAudio", false)' : ()
    $'if g_sounds then g_sounds.setAudioEnabled(false); g_sounds.stopAll() end' : ()

:= write_log_line (line : string) : () =
    $'TibiaProbeLog = TibiaProbeLog or {}' : ()
    $'table.insert(TibiaProbeLog, !line)' : ()
    $'g_logger.info(!line)' : ()
    $'g_resources.writeFileContents("/tibia-probe.log", table.concat(TibiaProbeLog, string.char(10)) .. \
        string.char(10))' : ()

:== session = { character : string; on_start : () -> (); on_error : string -> (); on_text : string -> string -> () }

:= log_in (s : session) : () =
    := on_start, on_error, on_text, character = s.on_start, s.on_error, s.on_text, s.character
    $'g_game.setClientVersion(1511)' : ()
    $'g_game.setProtocolVersion(g_game.getClientProtocolVersion(1511))' : ()
    $'g_game.chooseRsa("127.0.0.1")' : ()
    $'connect(g_game, { onGameStart = !on_start, onLoginError = function(message) (!on_error)(tostring(message)) end, \
        onTextMessage = function(mode, text) (!on_text)(tostring(mode))(tostring(text)) end })' : ()
    := account = "@god"
    := session_key = "@god\ngod"
    $'g_game.loginWorld(!account, "god", "OTServBR-Global", "127.0.0.1", 7172, !character, "", !session_key)' : ()
