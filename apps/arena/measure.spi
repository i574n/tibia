:< sm'_operators
:= health_potion () : i32 = 266
:= swing_ms () : i32 = 2000
:= potion_gap_ms () : i32 = 1000
:= tick_ms () : i32 = 100
:= run_ms () : i32 = 200000

:== bench =
    {
        hits : mut (list i32)
        taken : mut (list i32)
        misses : mut i32
        kills : mut i32
        potions : mut i32
        pending_hit : mut i32
        target : lua.native_table
        start_experience : mut i32
        started_at : mut i32
        done : mut i32
    }

:= bump (cell : mut i32) : () = cell <- (*cell + 1)

:= report (b : bench) (label : string) : () =
    := potions = *b.potions
    probe.note (("potions " ++#? potions))
    := landed, misses, kills = samples.sample_count b.hits, *b.misses, *b.kills
    := total, median = samples.sample_total b.hits, samples.sample_median b.hits
    := plus, health = client.player_experience () - *b.start_experience, client.player_health ()
    := swings = landed + misses
    := landed_share = ? swings > 0 ?> (conv landed : f64) * 100.0 / (conv swings : f64) |: 0.0
    := mean_landed = ? landed > 0 ?> (conv total : f64) / (conv landed : f64) |: 0.0
    probe.note (
        label ++# ": swings " ++#? swings ++# " landed " ++#? landed ++# " (" ++# sm'.format_fixed 1 landed_share
        ++# "%) mean landed " ++# sm'.format_fixed 2 mean_landed ++# " median " ++#? median ++# " total " ++#? total
        ++# " kills " ++#? kills ++# " experience +" ++#? plus ++# " health " ++#? health
    )
    probe.note ("hits " ++# samples.samples_joined b.hits)
    := count, taken_total, taken_median, taken_max =
        samples.sample_count b.taken,
        samples.sample_total b.taken,
        samples.sample_median b.taken,
        samples.sample_max b.taken
    := taken_mean = ? count > 0 ?> (conv taken_total : f64) / (conv count : f64) |: 0.0
    probe.note (
        "taken: count " ++#? count ++# " mean " ++# sm'.format_fixed 2 taken_mean ++# " median " ++#? taken_median
        ++# " max " ++#? taken_max ++# " total " ++#? taken_total
    )
    probe.note ("taken " ++# samples.samples_joined b.taken)

:= tick (b : bench) (potion_below : i32) : () =
    :~ ^ go (last_swing_at : i32) (last_potion_at : i32) : () =
        ? client.player_present () = !-
        ?> probe.finish_once_without_parity b.done "offline"
        |:
            := now = client.now_ms ()
            ? client.slot_occupied b.target && client.creature_dead (client.slot_creature b.target)
            ?>
                bump b.kills
                := kills, plus =
                    *b.kills, client.player_experience () - *b.start_experience
                probe.note (("kill " ++#? kills ++# " confirmed dead, experience +" ++#? plus))
                client.empty_slot b.target
            := last_swing_at =
                ? client.slot_occupied b.target = !-
                ?>
                    := here = client.player_spot ()
                    := people = client.spectators here
                    := seen = probe.nearest_monster here people
                    ? seen.found && seen.distance <= 1 ?>
                        := target = client.member people seen.index
                        client.occupy_slot b.target target
                        client.attack target
                        probe.stored b.pending_hit 0
                        now
                    |: last_swing_at
                |? now - last_swing_at >= swing_ms ()
                ?>
                    := target = client.slot_creature b.target
                    ?
                        client.creature_positioned target
                        && probe.chebyshev (client.creature_spot target) (client.player_spot ()) <= 1
                        && client.player_health () > 0
                        && *b.pending_hit = 0
                    ?> bump b.misses
                    probe.stored b.pending_hit 0
                    now
                |: last_swing_at
            := last_potion_at =
                ? client.player_health () < potion_below && now - last_potion_at >= potion_gap_ms () ?>
                    client.drink (health_potion ()) |> ignore
                    bump b.potions
                    now
                |: last_potion_at
            ? now - *b.started_at > run_ms () ?>
                report b "end"
                probe.finish_once_without_parity b.done "measure complete"
            |: client.after (tick_ms ()) (\ () => go last_swing_at last_potion_at)
    go (*b.started_at) 0

:= main () =
    := b : bench =
        {
            hits = samples.new_samples ()
            taken = samples.new_samples ()
            misses = mut 0
            kills = mut 0
            potions = mut 0
            pending_hit = mut 0
            target = client.new_creature_slot ()
            start_experience = mut 0
            started_at = mut 0
            done = mut 0
        }
    := potion_below = client.env_i32 "TIBIA_MEASURE_POTION_BELOW" 90
    := on_text (mode : string) (text : string) : () =
        := amount = combat_text.hit_amount text
        := lost = combat_text.damage_taken text
        ? lost >= 0 ?> samples.sample b.taken lost
        |? amount >= 0 ?>
            samples.sample b.hits amount
            probe.stored b.pending_hit 1
            ? sm'.contains "critical" text ?> probe.note ("critical: " ++# text)
        |? sm'.contains "You died" text ?>
            ? client.player_present () ?> report b "death"
            client.after 500 (\ () => probe.finish_once_without_parity b.done "death")
            probe.note (("server text [" ++# mode ++# "]: " ++# text))
        |? sm'.contains "You lose" text = !- ?> probe.note (("server text [" ++# mode ++# "]: " ++# text))
    := ready () =
        := name, health = client.player_name (), client.player_health ()
        probe.note (("in game as " ++# name ++# " health " ++#? health))
        client.after 1000 (\ () =>
            client.chasing !-
            client.fight_balanced ()
            := mode, at = client.fight_mode_text (), probe.described (client.player_spot ())
            probe.note (("fight mode " ++# mode ++# " at " ++# at))
            probe.stored b.start_experience (client.player_experience ())
            probe.stored b.started_at (client.now_ms ())
            tick b potion_below
            )
    probe.started_as (probe.knight ()) on_text ready 260000 \ () => probe.finish_once_without_parity b.done "timeout"
    0i32
