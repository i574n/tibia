:< sm'_operators
:= walk_away_ms () : i32 = 1300
:= measure_ms () : i32 = 45000

:= step_kind (chasing : bool) (is_knight : bool) (diagonal : bool) (near : bool) : string =
    := base = (? is_knight ?> "knight-" |: "") ++# (? diagonal ?> "diagonal" |: "straight")
    ? chasing && is_knight = !- ?> base ++# (? near ?> "-adjacent" |: "-chasing") |: base

:= record
    (chasing : bool) (stamps : lua.native_table) (intervals : lua.native_table) (c : client.creature)
    (new_position : client.native_position) (old_position : client.native_position)
    : ()
    =
    ? client.position_known new_position && client.position_known old_position ?>
        := is_knight = client.creature_is_local_player c
        ? client.creature_is_monster c || is_knight ?>
            := n, o = client.spot_of new_position, client.spot_of old_position
            := dx = ? n.x > o.x ?> n.x - o.x |: o.x - n.x
            := dy = ? n.y > o.y ?> n.y - o.y |: o.y - n.y
            ? n.z = o.z && dx + dy <> 0 && dx <= 1 && dy <= 1 ?>
                := now = client.now_ms ()
                := id = client.creature_id c
                := near = client.player_present () && probe.chebyshev n (client.player_spot ()) <= 1
                := kind = step_kind chasing is_knight (dx = 1 && dy = 1) near
                := previous_at, measured = lua.stamp_at stamps id, lua.stamp_kind stamps id
                lua.stamp stamps id now kind
                ? previous_at >= 0 ?>
                    := interval = now - previous_at
                    lua.labeled_sample intervals measured interval
                    := name, from, to = client.creature_name c, probe.described o, probe.described n
                    probe.note (
                        name
                        ++# " "
                        ++#? id
                        ++# " "
                        ++# kind
                        ++# " step "
                        ++# from
                        ++# " -> "
                        ++# to
                        ++# "; interval after its "
                        ++# measured
                        ++# " step "
                        ++#? interval
                        ++# " ms"
                    )

:= direction_of (n : i32) : i32 = ? n > 0 ?> 1 |? n < 0 ?> -1 |: 0

:= walk_away () : () =
    :~ ^ go () : () =
        ? client.player_present () ?>
            := here = client.player_spot ()
            := people = client.spectators here
            := seen = probe.nearest_monster here people
            ? seen.found && seen.distance <= 2 && client.player_walking () = !- ?>
                := there = client.creature_spot (client.member people seen.index)
                := sx, sy = direction_of (here.x - there.x), direction_of (here.y - there.y)
                ? sx <> 0 || sy <> 0 ?> client.step sx sy |> ignore
            client.after (walk_away_ms ()) go
    go ()

:= knight_walk_poll_ms () : i32 = 50
:= knight_walk_leg () : i32 = 5

:= walk_back_and_forth () : () =
    :~ ^ go (dx : i32) (left : i32) (waits : i32) : () =
        ? client.player_present () ?>
            ? client.player_walking () ?>
                ? waits % 40 = 39 ?>
                    probe.note (
                        "knight walk still walking at " ++# probe.described (client.player_spot ()) ++# " after "
                        ++#? (waits + 1) ++# " polls"
                    )
                client.after (knight_walk_poll_ms ()) (\ () => go dx left (waits + 1))
            |? left = 0 ?> go (0 - dx) (knight_walk_leg ()) 0
            |:
                ? client.step dx 0 = !- ?>
                    probe.note (
                        "knight walk step " ++#? dx ++# " refused at " ++# probe.described (client.player_spot ())
                    )
                client.after (knight_walk_poll_ms ()) (\ () => go dx (left - 1) 0)
        |: probe.note "knight walk stopped: no player in game"
    := start_at = ? client.player_positioned () ?> probe.described (client.player_spot ()) |: "nil"
    := walking = ? client.player_walking () ?> "yes" |: "no"
    probe.note (
        "knight walk starts at " ++# start_at ++# " speed " ++# client.player_speed () ++# " walking " ++# walking
    )
    go (0 - 1) (knight_walk_leg ()) 0

:= main () =
    := chasing = client.env_is "TIBIA_STEPS_CHASE" "1"
    := walking = client.env_is "TIBIA_STEPS_KNIGHT_WALK" "1"
    := stamps, intervals = lua.new_table (), lua.new_table ()
    client.on_position_change (record chasing stamps intervals)
    := on_text (mode : string) (text : string) : () =
        probe.note (("server text [" ++# mode ++# "]: " ++# text))
    := ready () =
        := name = client.player_name ()
        := at = ? client.player_positioned () ?> probe.described (client.player_spot ()) |: "nil"
        := speed = client.player_speed ()
        probe.note (("in game as " ++# name ++# " at " ++# at ++# " speed " ++# speed))
        ? chasing ?> client.after 2000 walk_away
        ? walking ?> client.after 2000 walk_back_and_forth
        client.after (measure_ms ()) (\ () =>
            probe.note ("end: " ++# lua.labeled_summary intervals)
            probe.finish "steps measured"
            )
    probe.started_as (probe.knight ()) on_text ready 90000 (\ () => probe.finish "timeout")
    0i32
