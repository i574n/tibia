inl run_ms () : i32 = 150000
inl summary_every () : i32 = 100

type tally = {ticks : i32; heals : i32; strikes : i32; holds : i32; kills : i32; retreats : i32; cornered : i32; gated : i32; lowest : i32}

type pace = {start_experience : i32; started_at : lua.native_table; full_experience : i32}

inl empty () : tally = {ticks = 0; heals = 0; strikes = 0; holds = 0; kills = 0; retreats = 0; cornered = 0; gated = 0; lowest = 999}

inl counted (health : i32) (t : tally) : tally = {t with ticks = t.ticks + 1; lowest = if health < t.lowest then health else t.lowest}

inl elapsed (p : pace) : i32 = client.now_ms () - lua.cell_value p.started_at

inl gained (p : pace) : i32 = client.player_experience () - p.start_experience

inl summary (p : pace) (t : tally) : string =
    inl ticks, heals, strikes, holds, retreats, cornered, gated, kills, lowest = t.ticks, t.heals, t.strikes, t.holds, t.retreats, t.cornered, t.gated, t.kills, t.lowest
    inl health, plus = client.player_health (), gained p
    $'string.format("ticks %d heals %d strikes %d holds %d retreats %d cornered %d gated %d kills %d health %d lowest %d experience +%d", !ticks, !heals, !strikes, !holds, !retreats, !cornered, !gated, !kills, !health, !lowest, !plus)' : string

inl due_for_summary (t : tally) : bool = t.ticks % summary_every () = 0

inl pace_from_environment (start_experience : i32) (started_at : lua.native_table) : pace =
    {start_experience = start_experience; started_at = started_at; full_experience = lua.env_i32 "TIBIA_ARENA_FULL_EXPERIENCE" 90}

inl finish_or_continue (p : pace) (t : tally) (on_cleared : () -> ()) (continue : () -> ()) : () =
    if elapsed p > run_ms () then
        probe.note (lua.joined "end: " (summary p t))
        probe.finish_reporting_parity "run complete"
    elif gained p >= p.full_experience then
        inl at = elapsed p
        probe.note ($'string.format("cleared at %d ms", !at)' : string)
        probe.note (lua.joined "cleared: " (summary p t))
        on_cleared ()
        probe.finish_reporting_parity "cleared"
    else continue ()
