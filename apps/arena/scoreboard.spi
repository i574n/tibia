///- --package .
test scoreboard static =
    open testing

open sm'_operators
inl run_ms () : i32 = client.env_i32 "TIBIA_ARENA_RUN_MS" 150000
inl probe_timeout_ms () : i32 = run_ms () + 50000
inl summary_every () : i32 = 100

type tally =
    {
        ticks : i32
        heals : i32
        strikes : i32
        holds : i32
        kills : i32
        retreats : i32
        cornered : i32
        gated : i32
        lowest : i32
    }

type pace = { start_experience : i32; started_at : lua.native_table; full_experience : i32 }

inl empty () : tally =
    { ticks = 0; heals = 0; strikes = 0; holds = 0; kills = 0; retreats = 0; cornered = 0; gated = 0; lowest = 999 }

inl counted (health : i32) (t : tally) : tally =
    { t with ticks = t.ticks + 1; lowest = if health < t.lowest then health else t.lowest }

inl elapsed (p : pace) : i32 = client.now_ms () - lua.cell_value p.started_at

inl gained (p : pace) : i32 = client.player_experience () - p.start_experience

inl summary_text (health : i32) (plus : i32) (t : tally) : string =
    inl ticks, heals, strikes, holds, retreats, cornered, gated, kills, lowest =
        t.ticks, t.heals, t.strikes, t.holds, t.retreats, t.cornered, t.gated, t.kills, t.lowest
    "ticks "
    ++#? ticks
    ++# " heals "
    ++#? heals
    ++# " strikes "
    ++#? strikes
    ++# " holds "
    ++#? holds
    ++# " retreats "
    ++#? retreats
    ++# " cornered "
    ++#? cornered
    ++# " gated "
    ++#? gated
    ++# " kills "
    ++#? kills
    ++# " health "
    ++#? health
    ++# " lowest "
    ++#? lowest
    ++# " experience +"
    ++#? plus

inl summary (p : pace) (t : tally) : string = summary_text (client.player_health ()) (gained p) t

inl due_for_summary (t : tally) : bool = t.ticks % summary_every () = 0

inl trace_every () : i32 = 10

inl due_for_trace (t : tally) : bool = t.ticks % trace_every () = 0

inl pace_from_environment (start_experience : i32) (started_at : lua.native_table) : pace =
    {
        start_experience = start_experience
        started_at = started_at
        full_experience = client.env_i32 "TIBIA_ARENA_FULL_EXPERIENCE" 90
    }

inl finish_or_continue (p : pace) (t : tally) (on_cleared : () -> ()) (continue : () -> ()) : () =
    if elapsed p > run_ms () then
        probe.note (lua.joined "end: " (summary p t))
        probe.finish_reporting_parity "run complete"
    elif gained p >= p.full_experience then
        inl at = elapsed p
        probe.note (("cleared at " ++#? at ++# " ms"))
        probe.note (lua.joined "cleared: " (summary p t))
        on_cleared ()
        probe.finish_reporting_parity "cleared"
    else continue ()

///> lua
///> c
test counted_ticks_and_keeps_the_lowest_health =
    inl t = empty () |> counted 400 |> counted 180 |> counted 300
    (t.ticks, t.lowest, due_for_trace t, due_for_summary t, due_for_summary (empty ()))
    |> _assert_eq (3i32, 180i32, false, false, true)

///> lua
///> c
test summary_text_lists_every_counter_in_order =
    inl base = empty ()
    { base with ticks = 100; heals = 4; strikes = 9; kills = 3; lowest = 210 }
    |> summary_text 377 675
    |> _assert_eq (
        "ticks 100 heals 4 strikes 9 holds 0 retreats 0 cornered 0 gated 0 "
        ++# "kills 3 health 377 lowest 210 experience +675"
    )
