///- --package .
test lua static =
    :< testing

:< sm'_operators

:! native_table = $'any'

:= joined (a : string) (b : string) : string = a ++# b

:= shown (n : i32) : string = "" ++#? n

:= random_between (low : i32) (high : i32) : i32 = $'math.random(!low, !high)' : i32

:= new_table () : native_table = $'{}' : native_table

:= sample (samples : native_table) (value : i32) : () = $'table.insert(!samples, !value)' : ()

:= sample_count (samples : native_table) : i32 = $'##(!samples)' : i32

inl sample_total (samples : native_table) : i32 = $'(function(s) local n = 0; for _, v in ipairs(s) do n = n + v end; \
    return n end)(!samples)' : i32

inl sample_max (samples : native_table) : i32 = $'(function(s) local n = 0; for _, v in ipairs(s) do if v > n then n \
    = v end end; return n end)(!samples)' : i32

:= sample_median (samples : native_table) : i32 =
    $'(function(s) local sorted = {}; for i, v in ipairs(s) do sorted[i] = v end; table.sort(sorted); return ##sorted \
        > 0 and sorted[math.floor((##sorted + 1) / 2)] or 0 end)(!samples)' : i32

:= samples_joined (samples : native_table) : string = $'table.concat(!samples, ",")' : string

:= contains (text : string) (needle : string) : bool = sm'.contains needle text

inl add_to (counts : native_table) (key : i32) (amount : i32) : () = $'(!counts)[!key] = ((!counts)[!key] or 0) + \
    (!amount)' : ()

:= amount_at (counts : native_table) (key : i32) : i32 = $'(!counts)[!key] or 0' : i32

:= new_cell (initial : i32) : native_table = $'{ value = !initial }' : native_table

:= cell_value (c : native_table) : i32 = $'(!c).value' : i32

:= set_cell (c : native_table) (v : i32) : () = $'(!c).value = (!v)' : ()

///> lua
test samples_report_count_total_max_median_and_joined =
    := s = new_table ()
    sample s 5
    sample s 1
    sample s 9
    sample s 7
    (sample_count s, sample_total s, sample_max s, sample_median s, samples_joined s)
    |> _assert_eq (4i32, 22i32, 9i32, 5i32, "5,1,9,7")

///> lua
test text_matching_reads_needles =
    := text = "A troll loses 12 hitpoints due to your attack."
    (contains text "due to your", contains text "critical") |> _assert_eq (!+, !-)

///> lua
test cells_hold_a_value_between_calls =
    := c = new_cell 3
    set_cell c (cell_value c + 4)
    (cell_value c, joined "a" "b") |> _assert_eq (7i32, "ab")
