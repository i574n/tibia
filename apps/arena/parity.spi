:< sm'_operators

:= action_gap_ms () : i32 = 250

:= view_half_width () : i32 = 7

:= view_half_height () : i32 = 5

:= within (limit : i32) (a : i32) (b : i32) : bool = a - b <= limit && b - a <= limit

:= summary_text (allowed : i32) (dropped : i32) : string =
    "parity: gap " ++#? action_gap_ms () ++# " ms, view " ++#? (view_half_width () * 2 + 1) ++# "x"
    ++#? (view_half_height () * 2 + 1) ++# ", actions allowed " ++#? allowed ++# " dropped " ++#? dropped

:= main () : () =
    := last_action_at = mut (0i32 - 1000000)
    := allowed = mut 0i32
    := dropped = mut 0i32
    := admit () : bool =
        := now = hooks.clock_ms ()
        ? now - *last_action_at < action_gap_ms () ?>
            dropped <- *dropped + 1
            !-
        |:
            last_action_at <- now
            allowed <- *allowed + 1
            !+
    := game = hooks.game ()
    := native_turn = hooks.field_function game "turn"
    := login_ended = mut !-
    hooks.on_game_start \ () =>
        hooks.after 300 \ () =>
            ? hooks.online () && *login_ended = !- ?>
                hooks.turn_south native_turn
                login_ended <- !+
                hooks.log_info
                    "[tibia-probe] parity: login protection ended for every competitor by one turn after login"
    := gate0 owner name =
        := original = hooks.field_function owner name
        ? hooks.is_function original ?>
            hooks.replace0 owner name (\ () =>
                ? admit () ?>
                    hooks.call0 original
                    !+
                |: !-
                )
    := gate1 owner name =
        := original = hooks.field_function owner name
        ? hooks.is_function original ?>
            hooks.replace1 owner name (\ a =>
                ? admit () ?>
                    hooks.call1 original a
                    !+
                |: !-
                )
    := gate2 owner name =
        := original = hooks.field_function owner name
        ? hooks.is_function original ?>
            hooks.replace2 owner name (\ (a, b) =>
                ? admit () ?>
                    hooks.call2 original a b
                    !+
                |: !-
                )
    := gate3 owner name =
        := original = hooks.field_function owner name
        ? hooks.is_function original ?>
            hooks.replace3 owner name (\ (a, b, c) =>
                ? admit () ?>
                    hooks.call3 original a b c
                    !+
                |: !-
                )
    gate1 game "attack"
    gate1 game "follow"
    gate1 game "walk"
    gate1 game "turn"
    gate1 game "talk"
    gate3 game "talkChannel"
    gate1 game "use"
    gate2 game "useWith"
    gate1 game "useInventoryItem"
    gate2 game "useInventoryItemWith"
    gate3 game "move"
    gate0 game "cancelAttack"
    gate0 game "cancelAttackAndFollow"
    := player_class = hooks.local_player_class ()
    ? hooks.present player_class ?> gate2 player_class "autoWalk"
    := native_spectators = hooks.field_function (hooks.map_api ()) "getSpectators"
    hooks.replace_spectators (\ (center, multi) =>
        := found = hooks.spectators_of native_spectators center multi
        := player = hooks.local_player ()
        ? hooks.present player = !- ?> found
        |:
            := origin = hooks.position_of player
            ? hooks.present origin = !- ?> found
            |:
                := visible = hooks.new_list ()
                := ox, oy, oz = hooks.position_x origin, hooks.position_y origin, hooks.position_z origin
                loop.for' { from = 1i32; nearTo = hooks.list_length found + 1 } (\ i =>
                    := c = hooks.list_at found i
                    := p = hooks.position_of c
                    ? hooks.present p ?>
                        := near_x = within (view_half_width ()) (hooks.position_x p) ox
                        := near_y = within (view_half_height ()) (hooks.position_y p) oy
                        ? hooks.position_z p = oz && near_x && near_y ?> hooks.list_push visible c
                    )
                visible
        )
    hooks.publish_parity (\ () => summary_text *allowed *dropped)
