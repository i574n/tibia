:< sm'_operators
:= watch_ms () : i32 = 30000
:= sample_ms () : i32 = 50

:= watch (done : mut i32) (started_at : i32) : () =
    :~ ^ go (has_last : bool) (last : client.spot) (steps : i32) : () =
        ? client.player_present () = !- ?> probe.finish_once_without_parity done "offline"
        |:
            := elapsed = client.now_ms () - started_at
            := here = client.player_spot ()
            := people = client.spectators here
            := seen = probe.nearest_monster here people
            := arrived, has_last, last, steps =
                ? seen.found ?>
                    := at = client.creature_spot (client.member people seen.index)
                    := moved = has_last = !- || at.x <> last.x || at.y <> last.y
                    := steps = ? moved && has_last ?> steps + 1 |: steps
                    ? moved ?>
                        := from, distance = probe.described at, seen.distance
                        probe.note (
                            "path t="
                            ++#? elapsed
                            ++# " ms monster at "
                            ++# from
                            ++# " distance "
                            ++#? distance
                            ++# " step "
                            ++#? steps
                        )
                    seen.distance <= 1, !+, (? moved ?> at |: last), steps
                |: !-, has_last, last, steps
            ? arrived ?>
                := knight = probe.described here
                probe.note ("arrived at " ++#? elapsed ++# " ms after " ++#? steps ++# " steps, knight at " ++# knight)
                probe.finish_once_without_parity done "arrived"
            |? elapsed > watch_ms () ?>
                probe.note (("not arrived after " ++#? elapsed ++# " ms, " ++#? steps ++# " steps"))
                probe.finish_once_without_parity done "not arrived"
            |: client.after (sample_ms ()) \ () => go has_last last steps
    go !- { x = 0; y = 0; z = 0 } 0

:= main () =
    := done = mut 0
    := on_text (mode : string) (text : string) : () = probe.note (("server text [" ++# mode ++# "]: " ++# text))
    := ready () =
        client.after 1500 (\ () =>
            := name, at = client.player_name (), probe.described (client.player_spot ())
            probe.note (("in game as " ++# name ++# " at " ++# at ++# " (path check, standing, no attack)"))
            watch done (client.now_ms ())
            )
    client.disable_client_bot (probe.bot_profile ())
    probe.started_as (probe.knight ()) on_text ready 60000 (\ () => probe.finish_once_without_parity done "timeout")
    0i32
