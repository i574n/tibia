:< sm'_operators
:= orders_of (text : string) : array string =
    text |> sm'.split ";" |> array |> am'.choose \ part => ? part = "" ?> None |: Some part

:= order_count (orders : array string) : i32 = am'.length orders

:= order_at (orders : array string) (position : i32) : string = am'.index (position - 1) orders

:= list_creatures () : () =
    := people = client.spectators (client.player_spot ())
    := size = client.crowd_size people
    :~ ^ each (index : i32) : () =
        ? index <= size ?>
            := c = client.member people index
            := name = client.creature_name c
            := monster = ? client.creature_is_monster c ?> "true" |: "false"
            := at = probe.described (client.creature_spot c)
            probe.note (("sees " ++# name ++# " monster=" ++# monster ++# " at " ++# at))
            each (index + 1)
    each 1

:= main () =
    := summon_at = client.env_text "TIBIA_SUMMON_AT" "1932, 1352"
    := orders = orders_of (client.env_text "TIBIA_SUMMON_ORDERS" "green frog,3,,2")
    := on_text (mode : string) (text : string) : () = probe.note ("server text: " ++# text)
    := ready () =
        probe.note ("in game as " ++# client.player_name ())
        client.after 1500 (\ () =>
            probe.note ("at " ++# probe.described (client.player_spot ()))
            client.talk ("/pos " ++# summon_at ++# ", 7")
            := count = order_count orders
            :~ ^ schedule (index : i32) : () =
                ? index <= count ?>
                    := order = order_at orders index
                    client.after (1200 + 500 * (index - 1)) (\ () => client.talk ("/m " ++# order))
                    schedule (index + 1)
            schedule 1
            client.after 4000 (\ () =>
                list_creatures ()
                probe.finish "summoned"
                )
            )
    probe.started_as (probe.game_master ()) on_text ready 60000 (\ () => probe.finish "timeout")
    0i32
