:< sm'_operators

:= silent_table (silent : list string) : hooks.host =
    := table = hooks.new_list ()
    listm.iter (\ (name : string) => hooks.set_field table name (\ () => 0i32)) silent
    hooks.set_field table "cancel" \ () => ()
    table

:= silence_network () : () =
    hooks.set_g_http (silent_table [ "get"; "post"; "download"; "ws" ])
    hooks.set_http (silent_table [ "get"; "getJSON"; "post"; "postJSON"; "download" ])

:= main () : () =
    silence_network ()
    hooks.set_spiral_bot_dofile \ (path : string) => hooks.call_for_value (hooks.current_dofile ()) path
