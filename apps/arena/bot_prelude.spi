:< sm'_operators

:= silence_network () : () =
    := silent = \ () => 0i32
    := nothing = \ () => ()
    := http = hooks.new_list ()
    hooks.set_field http "get" silent
    hooks.set_field http "post" silent
    hooks.set_field http "download" silent
    hooks.set_field http "ws" silent
    hooks.set_field http "cancel" nothing
    hooks.set_g_http http
    := plain = hooks.new_list ()
    hooks.set_field plain "get" silent
    hooks.set_field plain "getJSON" silent
    hooks.set_field plain "post" silent
    hooks.set_field plain "postJSON" silent
    hooks.set_field plain "download" silent
    hooks.set_field plain "cancel" nothing
    hooks.set_http plain

:= main () : () =
    silence_network ()
    hooks.set_spiral_bot_dofile (\ (path : string) => hooks.call_for_value (hooks.current_dofile ()) path)
