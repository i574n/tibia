:< sm'_operators
:= watch_ms () : i32 = 100
:= observe_ms () : i32 = 10000
:= run_ms () : i32 = 150000

:== watch =
    {
        start_experience : i32
        started_at : i32
        full_experience : i32
        lowest : mut i32
        cleared : mut i32
        done : mut i32
    }

:== bot = { config : string; banner : string; diagnostics : () -> string }

:= gained (w : watch) : i32 = client.player_experience () - w.start_experience

:= note_lowest (w : watch) (health : i32) : () =
    ? health < *w.lowest ?> probe.stored w.lowest health

:= clear_if_full (w : watch) (health : i32) (at : i32) : bool =
    ? *w.cleared = 0 && gained w >= w.full_experience
    ?>
        probe.stored w.cleared 1
        := plus, lowest = gained w, *w.lowest
        probe.note (("cleared at " ++#? at ++# " ms"))
        probe.note (
            ("cleared: experience +" ++#? plus ++# " health " ++#? health ++# " lowest health " ++#? lowest)
        )
        probe.finish_once w.done "cleared"
        !+
    |: !-

:= watch_every_tick (w : watch) : () =
    :~ ^ go () : () =
        ? *w.done = 0 && client.player_present () ?>
            := health = client.player_health ()
            note_lowest w health
            ? clear_if_full w health (client.now_ms () - w.started_at) = !- ?> client.after (watch_ms ()) go
    go ()

:= observe (b : bot) (w : watch) : () =
    :~ ^ go () : () =
        ? *w.done = 0
        ?>
            ? client.player_present () = !-
            ?> probe.finish_once w.done "offline"
            |:
                := health = client.player_health ()
                note_lowest w health
                := elapsed = client.now_ms () - w.started_at
                ? clear_if_full w health elapsed = !-
                ?>
                    := seconds, plus, lowest, attacking, at =
                        elapsed / 1000,
                        gained w,
                        *w.lowest,
                        client.attacking_short (),
                        probe.described (client.player_spot ())
                    probe.note (
                        "t="
                        ++#? seconds
                        ++# "s experience +"
                        ++#? plus
                        ++# " health "
                        ++#? health
                        ++# " lowest "
                        ++#? lowest
                        ++# " attacking "
                        ++# attacking
                        ++# " at "
                        ++# at
                    )
                    := diagnostics = b.diagnostics ()
                    ? (diagnostics <> "") ?> probe.note diagnostics
                    ? elapsed > run_ms () ?>
                        probe.note (("end: experience +" ++#? plus ++# " lowest health " ++#? lowest))
                        probe.finish_once w.done "run complete"
                    |: client.after (observe_ms ()) go
    go ()

:= run (b : bot) : () =
    := done = mut 0
    := lowest = mut 999
    := cleared = mut 0
    := full_experience = client.env_i32 "TIBIA_ARENA_FULL_EXPERIENCE" 90
    := logged_in_at = mut 0
    := on_text (mode : string) (text : string) : () =
        := t = client.now_ms () - *logged_in_at
        ? *done = 1 && sm'.contains "health potion" text
        ?>
            probe.note (
                ("server text after finish (potion not counted) [" ++# mode ++# "] @t+" ++#? t)
            )
        |: probe.note (("server text [" ++# mode ++# "]: " ++# text ++# " @t+" ++#? t))
    := ready () =
        := name, health, banner = client.player_name (), client.player_health (), b.banner
        probe.note (("in game as " ++# name ++# " health " ++#? health ++# " " ++# banner))
        logged_in_at <- (client.now_ms ())
        client.after (probe.start_delay_ms ()) \ () =>
            client.fight_balanced ()
            client.start_client_bot (probe.bot_profile ()) b.config
            := t = client.now_ms () - *logged_in_at
            probe.note (("client bot starts @t+" ++#? t))
            := w : watch =
                {
                    start_experience = client.player_experience ()
                    started_at = client.now_ms ()
                    full_experience = full_experience
                    lowest = lowest
                    cleared = cleared
                    done = done
                }
            watch_every_tick w
            observe b w
    client.disable_client_bot (probe.bot_profile ())
    probe.started_as (probe.knight ()) on_text ready 200000 (\ () => probe.finish_once done "timeout")
