:< sm'_operators
:= health_potion () : i32 = 266
:= step_ms () : i32 = 650
:= tick_ms () : i32 = 100

:| move =
    | Drink
    | Engage
    | StepSomewhere
    | Stand

:= move_of (pick : i32) : move =
    ? pick = 0
    ?> Drink
    |? pick = 1
    ?> Engage
    |? pick = 2
    ?> StepSomewhere
    |: Stand

:== heading = { dx : i32; dy : i32; diagonal : bool }

:= heading_of (k : i32) : heading =
    ? k = 1 ?> { dx = 0; dy = -1; diagonal = !- }
    |? k = 2 ?> { dx = 1; dy = 0; diagonal = !- }
    |? k = 3 ?> { dx = 0; dy = 1; diagonal = !- }
    |? k = 4 ?> { dx = -1; dy = 0; diagonal = !- }
    |? k = 5 ?> { dx = 1; dy = -1; diagonal = !+ }
    |? k = 6 ?> { dx = 1; dy = 1; diagonal = !+ }
    |? k = 7 ?> { dx = -1; dy = 1; diagonal = !+ }
    |: { dx = -1; dy = -1; diagonal = !+ }

:== arena = { pace : scoreboard.pace; engaged : lua.native_table }

:= tick (a : arena) (first : scoreboard.tally) : () =
    :~ ^ go (t : scoreboard.tally) (next_step_at : i32) : () =
        ? client.player_present () = !-
        ?> probe.finish_reporting_parity "offline"
        |:
            := now = client.now_ms ()
            := health = client.player_health ()
            := t = scoreboard.counted health t
            ? health <= 0
            ?>
                probe.note ("dead: " ++# scoreboard.summary a.pace t)
                probe.finish_reporting_parity "death"
            |:
                := t = { t ?| kills = t.kills + client.forget_dead a.engaged }
                := t, next_step_at =
                    ?= move_of (lua.random_between 0 3) ?|
                    | Drink =>
                        := at = scoreboard.elapsed a.pace
                        ? client.drink (health_potion ())
                        ?>
                            probe.note (("heal (potion) at health " ++#? health ++# " t=" ++#? at))
                            { t ?| heals = t.heals + 1 }, next_step_at
                        |:
                            probe.note (
                                ("heal dropped by the action gate at health " ++#? health)
                            )
                            t, next_step_at
                    | Engage =>
                        := here = client.player_spot ()
                        := people = client.spectators here
                        := seen = probe.nearest_monster here people
                        ? seen.found
                        ?>
                            client.chasing !+
                            := target = client.member people seen.index
                            ? client.same_creature (client.attacking ()) target = !-
                            ?>
                                client.attack target
                                client.remember a.engaged target
                                := name, at, from =
                                    client.creature_name target,
                                    probe.described (client.creature_spot target),
                                    probe.described here
                                probe.note (
                                    "strike "
                                    ++# name
                                    ++# " at "
                                    ++# at
                                    ++# " from "
                                    ++# from
                                    ++# " health "
                                    ++#? health
                                )
                            { t ?| strikes = t.strikes + 1 }, next_step_at
                        |: t, next_step_at
                    | StepSomewhere =>
                        ? now >= next_step_at && client.player_walking () = !-
                        ?>
                            := h = heading_of (lua.random_between 1 8)
                            ? client.step h.dx h.dy
                            ?> { t ?| retreats = t.retreats + 1 }, now + step_ms () * (? h.diagonal ?> 3 |: 1)
                            |: { t ?| gated = t.gated + 1 }, next_step_at
                        |: t, next_step_at
                    | Stand => { t ?| holds = t.holds + 1 }, next_step_at
                ? scoreboard.due_for_summary t ?>
                    := at = probe.described (client.player_spot ())
                    probe.note (scoreboard.summary a.pace t ++# " player at " ++# at)
                scoreboard.finish_or_continue a.pace t
                    \ () => ()
                    \ () => client.after (tick_ms ()) \ () => go t next_step_at
    go first 0

:= main () =
    client.seed_random_from_clock ()
    := started_at = mut 0
    := engaged = lua.new_table ()
    := on_text (mode : string) (text : string) : () =
        := t = client.now_ms () - *started_at
        probe.note (("server text [" ++# mode ++# "] t=" ++#? t ++# ": " ++# text))
    := ready () =
        := name, health, mana = client.player_name (), client.player_health (), client.player_mana ()
        probe.note (("in game as " ++# name ++# " health " ++#? health ++# " mana " ++#? mana))
        client.after 1500 \ () =>
            := start_experience = client.player_experience ()
            client.chasing !-
            client.fight_balanced ()
            client.after 1000 \ () =>
                := at, every = probe.described (client.player_spot ()), tick_ms ()
                probe.note (
                    "random control starts at "
                    ++# at
                    ++# " (drink, engage, random step or stand, equal odds every "
                    ++#? every
                    ++# " ms)"
                )
                started_at <- (client.now_ms ())
                tick
                    { pace = scoreboard.pace_from_environment start_experience started_at; engaged = engaged }
                    (scoreboard.empty ())
    client.disable_client_bot (probe.bot_profile ())
    probe.started_as (probe.knight ()) on_text ready 200000 (\ () => probe.finish_reporting_parity "timeout")
    0i32
