:< sm'_operators
:== meter =
    {
        enabled : bool
        adjacent_ms : mut i32
        hits : mut i32
        last_tick : mut i32
        ms_by_count : array i32
    }

:= from_environment () : meter =
    {
        enabled = client.env_is "TIBIA_ARENA_ADJACENCY" "1"
        adjacent_ms = mut 0
        hits = mut 0
        last_tick = mut (0 - 1)
        ms_by_count = ;[ 0i32; 0i32; 0i32; 0i32 ]
    }

:= adjacent_monsters (here : client.spot) (people : client.crowd) : i32 =
    := size = client.crowd_size people
    :~ ^ count (index : i32) (n : i32) : i32 =
        ? index > size
        ?> n
        |:
            := c = client.member people index
            count
                (index + 1)
                ? client.live_monster c && probe.chebyshev (client.creature_spot c) here <= 1
                ?> n + 1
                |: n
    count 1 0

:= start_positions (here : client.spot) (people : client.crowd) : string =
    := size = client.crowd_size people
    :~ ^ seen (index : i32) (text : string) : string =
        ? index > size ?> text
        |:
            := c = client.member people index
            ? client.positioned_monster c ?>
                := at = probe.described (client.creature_spot c)
                seen (index + 1) (? (text = "") ?> at |: text ++# " " ++# at)
            |: seen (index + 1) text
    "start positions: knight " ++# probe.described here ++# " monsters " ++# seen 1 ""

:= on_tick (m : meter) (now : i32) (here : client.spot) (people : client.crowd) : () =
    ? m.enabled ?>
        := last = *m.last_tick
        ? last < 0 ?> probe.note (start_positions here people)
        |:
            := adjacent = adjacent_monsters here people
            probe.stored m.adjacent_ms (*m.adjacent_ms + adjacent * (now - last))
            := slot = ? adjacent > 3 ?> 3 |: adjacent
            set m.ms_by_count slot (index m.ms_by_count slot + (now - last))
        probe.stored m.last_tick now

:= on_text (m : meter) (elapsed : i32) (text : string) : () =
    ? m.enabled && sm'.contains "due to an attack" text ?>
        probe.stored m.hits (*m.hits + 1)
        ? client.player_present () ?>
            := here = client.player_spot ()
            := adjacent = adjacent_monsters here (client.spectators here)
            probe.note (("hit at " ++#? elapsed ++# " ms with " ++#? adjacent ++# " adjacent"))

:= on_cleared (m : meter) () : () =
    ? m.enabled
    ?>
        := adjacent_ms, hits = *m.adjacent_ms, *m.hits
        := per_second = (conv hits : f64) * 1000.0 / (conv (? adjacent_ms > 1 ?> adjacent_ms |: 1) : f64)
        probe.note (
            "adjacency: " ++#? adjacent_ms ++# " monster-ms adjacent, " ++#? hits ++# " landed hits, "
            ++# sm'.format_fixed 3 per_second ++# " landed hits per adjacent monster-second"
        )
        := none, one, two, three =
            index m.ms_by_count 0,
            index m.ms_by_count 1,
            index m.ms_by_count 2,
            index m.ms_by_count 3
        probe.note (
            "adjacent time by count: 0 " ++#? none ++# " 1 " ++#? one ++# " 2 " ++#? two ++# " 3 " ++#? three ++# " ms"
        )
