:< sm'_operators
:= health_potion () : i32 = 266
:= heal_cooldown_ms () : i32 = 1000
:= swing_ms () : i32 = 2000
:= step_ms () : i32 = 650
:= tick_ms () : i32 = 100
:= cornered_report_every () : i32 = 50

:== plan = { heal_below : i32; strike_above : i32; retreat_at : i32; kite_at : i32; reach_first : bool }

:== clocks = { last_heal_at : i32; next_step_at : i32 }

:== arena =
    {
        plan : plan
        pace : scoreboard.pace
        engaged : lua.native_table
        last_swing : mut i32
        meter : adjacency.meter
    }

:== sighting = { found : bool; index : i32; distance : i32 }

:= plan_from_environment () : plan =
    {
        heal_below = client.env_i32 "TIBIA_ARENA_HEAL_BELOW" 120
        strike_above = client.env_i32 "TIBIA_ARENA_STRIKE_ABOVE" 40
        retreat_at = client.env_i32 "TIBIA_ARENA_RETREAT_AT" 0
        kite_at = client.env_i32 "TIBIA_ARENA_KITE_AT" 0
        reach_first = client.env_is "TIBIA_ARENA_TARGETING" "reach"
    }

:= finish (reason : string) : () = probe.finish_reporting_parity reason


:= candidate_of (current : client.creature) (c : client.creature) (distance : i32) : policy.candidate =
    {
        is_current = client.same_creature c current
        distance = distance
        health_percent = client.creature_health_percent c
    }

:= sight (a : arena) (here : client.spot) (people : client.crowd) : sighting =
    := current = client.attacking ()
    := prefers (x : policy.candidate) (y : policy.candidate) : bool =
        ? a.plan.reach_first
        ?> policy.prefers_by (:< policy ;; ReachFirst) x y
        |: policy.prefers_by (:< policy ;; CurrentFirst) x y
    := size = client.crowd_size people
    :~ ^ scan (index : i32) (best : sighting) : sighting =
        ? index > size
        ?> best
        |:
            := c = client.member people index
            ? client.live_monster c
            ?>
                := d = probe.chebyshev (client.creature_spot c) here
                := better =
                    ? best.found = !-
                    ?> !+
                    |:
                        prefers
                            (candidate_of current c d)
                            (candidate_of current (client.member people best.index) best.distance)
                scan (index + 1) (? better ?> { found = !+; index = index; distance = d } |: best)
            |: scan (index + 1) best
    scan 1 { found = !-; index = 0; distance = 999 }

:== threat = { attackers : i32; found : bool; index : i32 }

:= threat_rank (s : client.spot) : i32 = s.x * 100000 + s.y

:= threats (here : client.spot) (people : client.crowd) : threat =
    := size = client.crowd_size people
    :~ ^ scan (index : i32) (t : threat) : threat =
        ? index > size
        ?> t
        |:
            := c = client.member people index
            ? client.live_monster c && probe.chebyshev (client.creature_spot c) here <= 1
            ?>
                := closer =
                    t.found = !-
                    || threat_rank (client.creature_spot c)
                       < threat_rank (client.creature_spot (client.member people t.index))
                scan (index + 1) {
                    attackers = t.attackers + 1
                    found = !+
                    index =
                        ? closer
                        ?> index
                        |: t.index
                }
            |: scan (index + 1) t
    scan 1 { attackers = 0; found = !-; index = 0 }

:= direction_of (n : i32) : i32 = ? n > 0 ?> 1 |? n < 0 ?> -1 |: 0

:== offset = { dx : i32; dy : i32; present : bool }

:= candidate_step (sx : i32) (sy : i32) (slot : i32) : offset =
    ? slot = 0 ?> { dx = sx; dy = sy; present = !+ }
    |? slot = 1 ?> { dx = sx; dy = 0; present = !+ }
    |? slot = 2 ?> { dx = 0; dy = sy; present = !+ }
    |? slot = 3 ?> { dx = 1; dy = sy; present = sx = 0 }
    |? slot = 4 ?> { dx = -1; dy = sy; present = sx = 0 }
    |? slot = 5 ?> { dx = sx; dy = 1; present = sy = 0 }
    |: { dx = sx; dy = -1; present = sy = 0 }

:= usable (o : offset) : bool = o.present && (o.dx <> 0 || o.dy <> 0)

:= footing_label (f : client.footing) : string =
    ?= f ?|
    | Free => "walk"
    | Ramp => "walk"
    | Occupied => "creature"
    | Blocked => "blocked"
    | Unknown => "none"

:= slots () : i32 = 7

:= retreat_footing (s : client.spot) : client.footing =
    ? terrain.arena_world_protected s.x s.y ?> :< client ;; Blocked |: client.footing_at s

:= retreat_label (s : client.spot) : string =
    ? terrain.arena_world_protected s.x s.y ?> "zone" |: footing_label (client.footing_at s)

:| retreat =
    | Stepped
    | Gated
    | Cornered

:= near_monsters (here : client.spot) (people : client.crowd) : string =
    := size = client.crowd_size people
    :~ ^ seen (index : i32) (text : string) : string =
        ? index > size ?> text
        |:
            := c = client.member people index
            ? client.live_monster c && probe.chebyshev (client.creature_spot c) here <= 2 ?>
                := at = probe.described (client.creature_spot c)
                seen (index + 1) (? text = "" ?> at |: text ++# " " ++# at)
            |: seen (index + 1) text
    seen 1 ""

:= step_away
    (a : arena) (here : client.spot) (danger : client.spot) (people : client.crowd) (cornered_so_far : i32)
    : retreat * i32
    =
    client.chasing !-
    := sx = direction_of (here.x - danger.x)
    := sy = direction_of (here.y - danger.y)
    := now = client.now_ms ()
    :~ ^ attempt (slot : i32) : retreat * i32 =
        ? slot >= slots ()
        ?> Cornered, 0
        |:
            := o = candidate_step sx sy slot
            ?
                usable o
                && (
                    ?= retreat_footing { here ?| x = here.x + o.dx; y = here.y + o.dy } ?|
                    | Free => !+
                    | _ => !-
                )
            ?>
                ? client.step o.dx o.dy ?>
                    := dx, dy, t = o.dx, o.dy, scoreboard.elapsed a.pace
                    := from = probe.described here
                    := near = near_monsters here people
                    probe.note (
                        "step away from "
                        ++# from
                        ++# " by "
                        ++#? dx
                        ++# ","
                        ++#? dy
                        ++# " @t+"
                        ++#? t
                        ++# " near "
                        ++# near
                    )
                    Stepped, now + step_ms () * (? o.dx <> 0 && o.dy <> 0 ?> 3 |: 1)
                |: Gated, 0
            |: attempt (slot + 1)
    := outcome, next_step_at = attempt 0
    ?= outcome ?|
    | Cornered =>
        ? (cornered_so_far + 1) % cornered_report_every () = 1
        ?>
            := size = client.crowd_size people
            :~ ^ around (index : i32) (text : string) : string =
                ? index > size
                ?> text
                |:
                    := c = client.member people index
                    ? client.positioned_monster c && probe.chebyshev (client.creature_spot c) here <= 1
                    ?>
                        around
                            (index + 1)
                            (
                                ? (text = "")
                                ?> probe.described (client.creature_spot c)
                                |: text ++# " " ++# probe.described (client.creature_spot c)
                            )
                    |: around (index + 1) text
            :~ ^ rejected (slot : i32) (text : string) : string =
                ? slot >= slots ()
                ?> text
                |:
                    := o = candidate_step sx sy slot
                    ? usable o
                    ?>
                        := dx, dy = o.dx, o.dy
                        := label = retreat_label { here ?| x = here.x + o.dx; y = here.y + o.dy }
                        := item = ("" ++#? dx ++# "," ++#? dy ++# ":" ++# label)
                        rejected
                            (slot + 1)
                            ? (text = "")
                            ?> item
                            |: text ++# " " ++# item
                    |: rejected (slot + 1) text
            := at, from, adjacent, candidates =
                probe.described here, probe.described danger, around 1 "", rejected 0 ""
            probe.note (
                "cornered at "
                ++# at
                ++# " threat "
                ++# from
                ++# " adjacent ["
                ++# adjacent
                ++# "] candidates ["
                ++# candidates
                ++# "]"
            )
        outcome, next_step_at
    | _ => outcome, next_step_at

:= network_code
    (p : plan) (health : i32) (attackers : i32) (target_health : i32) (target_distance : i32) (heal_ready : bool)
    (strike_ready : bool)
    : i32
    =
    := max_health = client.player_max_health ()
    := healer = network.threshold_healer (network.fraction_below p.heal_below max_health)
    := w = ? p.kite_at > 0 ?> network.with_kiting p.kite_at healer |: healer
    := x =
        network.inputs_of
            (health * network.one () / max_health)
            attackers
            (target_health * network.one () / 100)
            target_distance
            heal_ready
            strike_ready
            !-
    := d = network.decide w x
    (? d.heal ?> 1 |: 0) + (? d.engage ?> 2 |: 0) + (? d.retreat ?> 4 |: 0)

:= tick (a : arena) (first : scoreboard.tally) (first_clocks : clocks) : () =
    :~ ^ go (t : scoreboard.tally) (k : clocks) : () =
        ? client.player_present () = !-
        ?> finish "offline"
        |:
            := now = client.now_ms ()
            := health = client.player_health ()
            := t = scoreboard.counted health t
            ? health <= 0
            ?>
                probe.note ("dead: " ++# scoreboard.summary a.pace t)
                finish "death"
            |:
                := t = { t ?| kills = t.kills + client.forget_dead a.engaged }
                := here = client.player_spot ()
                := people = client.spectators here
                adjacency.on_tick a.meter now here people
                := seen = sight a here people
                := target_code : i32 = ? seen.found = !- ?> 0 |? seen.distance <= 1 ?> 1 |: 2
                := heal_ready = now - k.last_heal_at >= heal_cooldown_ms ()
                := drink (t : scoreboard.tally) (k : clocks) : scoreboard.tally * clocks =
                    ? client.drink (health_potion ()) ?>
                        probe.note (("heal (potion) at health " ++#? health))
                        { t ?| heals = t.heals + 1 }, { k ?| last_heal_at = now }
                    |:
                        probe.note (("heal dropped by the action gate at health " ++#? health))
                        t, k
                := engage (chasing : bool) (t : scoreboard.tally) : scoreboard.tally =
                    ? client.chase_on () <> chasing ?>
                        := turned, at_ms = (? chasing ?> "on" |: "off"), scoreboard.elapsed a.pace
                        probe.note (("chase " ++# turned ++# " @t+" ++#? at_ms))
                    client.chasing chasing
                    := target = client.member people seen.index
                    ? client.same_creature (client.attacking ()) target = !-
                    ?>
                        client.attack target
                        client.remember a.engaged target
                        := verb = ? chasing ?> "approach" |: "strike"
                        := name = client.creature_name target
                        := at = probe.described (client.creature_spot target)
                        := from = probe.described here
                        := engaged_ms = scoreboard.elapsed a.pace
                        probe.note (
                            verb
                            ++# " "
                            ++# name
                            ++# " at "
                            ++# at
                            ++# " from "
                            ++# from
                            ++# " health "
                            ++#? health
                            ++# " @t+"
                            ++#? engaged_ms
                        )
                    { t ?| strikes = t.strikes + 1 }
                := hold (t : scoreboard.tally) : scoreboard.tally =
                    ? client.attacking_anyone () && target_code = 1 ?>
                        client.cancel_attack ()
                        probe.note (("hold at health " ++#? health))
                    { t ?| holds = t.holds + 1 }
                := danger = threats here people
                := can_step = danger.found && now >= k.next_step_at && client.player_walking () = !-
                := retreat_now (t : scoreboard.tally) (k : clocks) : bool * scoreboard.tally * clocks =
                    := threat = client.creature_spot (client.member people danger.index)
                    := outcome, next_step_at = step_away a here threat people t.cornered
                    ?= outcome ?|
                    | Stepped => !+, { t ?| retreats = t.retreats + 1 }, { k ?| next_step_at = next_step_at }
                    | Gated => !-, { t ?| gated = t.gated + 1 }, k
                    | Cornered => !-, { t ?| cornered = t.cornered + 1 }, k
                := t, k =
                    ? a.plan.kite_at > 0 ?>
                        := strike_ready = now - *a.last_swing >= swing_ms ()
                        := target_health =
                            ? seen.found ?> client.creature_health_percent (client.member people seen.index) |: 0
                        := distance = ? seen.found ?> seen.distance |: 0
                        := code =
                            network_code a.plan health danger.attackers target_health distance heal_ready strike_ready
                        := t, k = ? code % 2 = 1 && heal_ready ?> drink t k |: t, k
                        := retreated, t, k = ? (code / 4) % 2 = 1 && can_step ?> retreat_now t k |: !-, t, k
                        ? retreated ?> t, k
                        |? (code / 2) % 2 = 1 && seen.found ?> engage (target_code = 2) t, k
                        |: hold t, k
                    |:
                        := thresholds : policy.thresholds =
                            { heal_below = a.plan.heal_below; strike_above = a.plan.strike_above }
                        := reach =
                            ? target_code = 1 ?> :< policy ;; InReach
                            |? target_code = 2 ?> :< policy ;; OutOfReach
                            |: :< policy ;; NoTarget
                        := seen_by_policy : policy.observation =
                            { health = health; heal_ready = heal_ready; strike_ready = !+; target = reach }
                        := t, k = ? policy.heals thresholds seen_by_policy ?> drink t k |: t, k
                        := adaptive : policy.adaptive =
                            {
                                heal_base = 0
                                heal_per_attacker = 0
                                strike_above = 0
                                retreat_at = a.plan.retreat_at
                            }
                        := may_retreat =
                            a.plan.retreat_at > 0 && policy.retreats adaptive danger.attackers && can_step
                        := retreated, t, k = ? may_retreat ?> retreat_now t k |: !-, t, k
                        ? retreated ?> t, k
                        |:
                            := decision = policy.engagement_code (policy.engages thresholds seen_by_policy)
                            ? decision = 1 || decision = 2 ?> engage (decision = 2) t, k |: hold t, k
                ? scoreboard.due_for_trace t ?>
                    := spot = client.player_spot ()
                    := sx, sy = spot.x, spot.y
                    := label = ("seen at " ++#? sx ++# "," ++#? sy ++# ": ")
                    probe.note (label ++# client.monsters_described spot)
                ? scoreboard.due_for_summary t ?>
                    := attacking = client.attacking_described ()
                    := at = probe.described (client.player_spot ())
                    := zone = client.player_zone ()
                    := summary = scoreboard.summary a.pace t
                    := detail = (" attacking " ++# attacking ++# " player at " ++# at ++# " pz " ++# zone)
                    probe.note (summary ++# detail)
                := next_tick () = client.after (tick_ms ()) (\ () => go t k)
                scoreboard.finish_or_continue a.pace t (adjacency.on_cleared a.meter) next_tick
    go first first_clocks

:= main () =
    := p = plan_from_environment ()
    := started_at = mut 0
    := last_swing = mut (0 - swing_ms ())
    := engaged = lua.new_table ()
    := meter = adjacency.from_environment ()
    := shield_seen = mut 0
    := logged_in_at = mut 0
    := on_text (mode : string) (text : string) : () =
        ? sm'.contains "due to your" text ?> last_swing <- (client.now_ms ())
        := t = client.now_ms () - *started_at
        probe.note (("server text [" ++# mode ++# "]: " ++# text ++# " @t+" ++#? t))
        := shield = client.player_shield_skill ()
        ? shield <> *shield_seen ?>
            shield_seen <- shield
            probe.note (("shield skill " ++#? shield ++# " @t+" ++#? t))
        adjacency.on_text meter t text
    := on_move (c : client.creature) (new_position : client.native_position) (old_position : client.native_position)
        : ()
        =
        := known = client.position_known new_position && client.position_known old_position
        ? *started_at = 0 && known && client.creature_is_monster c ?>
            := n, id = client.spot_of new_position, client.creature_id c
            := x, y, since_login = n.x, n.y, client.now_ms () - *logged_in_at
            probe.note (("monster " ++#? id ++# " moved to " ++#? x ++# "," ++#? y ++# " @login+" ++#? since_login))
        |? *started_at > 0 && known ?>
            := who =
                ? client.creature_is_local_player c ?> "knight"
                |? client.same_creature (client.attacking ()) c ?> "target"
                |: ""
            ? who <> "" ?>
                := n, at_ms = client.spot_of new_position, client.now_ms () - *started_at
                := x, y = n.x, n.y
                probe.note ((who ++# " moved to " ++#? x ++# "," ++#? y ++# " @t+" ++#? at_ms))
    := ready () =
        := name, health, mana = client.player_name (), client.player_health (), client.player_mana ()
        probe.note (("in game as " ++# name ++# " health " ++#? health ++# " mana " ++#? mana))
        logged_in_at <- (client.now_ms ())
        client.on_position_change on_move
        client.after (probe.start_delay_ms () - probe.settle_ms ()) \ () =>
            := start_experience = client.player_experience ()
            client.chasing !-
            client.fight_balanced ()
            client.after (probe.settle_ms ()) \ () =>
                := at = probe.described (client.player_spot ())
                := heal_below, strike_above, kite_at, retreat_at =
                    p.heal_below, p.strike_above, p.kite_at, p.retreat_at
                := targeting = client.env_text "TIBIA_ARENA_TARGETING" "current"
                := wall = client.wall_seconds ()
                probe.note (
                    "policy starts at "
                    ++# at
                    ++# " thresholds heal<"
                    ++#? heal_below
                    ++# " strike>="
                    ++#? strike_above
                    ++# " kite at "
                    ++#? kite_at
                    ++# " retreat at "
                    ++#? retreat_at
                    ++# " targeting "
                    ++# targeting
                    ++# " wall "
                    ++#? wall
                )
                started_at <- (client.now_ms ())
                := a : arena =
                    {
                        plan = p
                        pace = scoreboard.pace_from_environment start_experience started_at
                        engaged = engaged
                        last_swing = last_swing
                        meter = meter
                    }
                tick a (scoreboard.empty ()) { last_heal_at = 0 - heal_cooldown_ms (); next_step_at = 0 }
    client.disable_client_bot (probe.bot_profile ())
    probe.started_as (probe.knight ()) on_text ready (scoreboard.probe_timeout_ms ()) (\ () => finish "timeout")
    0i32
