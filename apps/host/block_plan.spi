///- --package .
test block_plan static =
    open testing

union run_outcome =
    | Completed
    | Crashed

union run_fate =
    | Counted
    | Rerun
    | Missing

type progress = { stage : i32; run : i32; retried : bool; counted : i32; missing : i32 }

inl outcome_of_experience (experience : string) : run_outcome = if experience = "" then Crashed else Completed

inl fate_of (retried : bool) (o : run_outcome) : run_fate =
    match o with
    | Completed => Counted
    | Crashed => if retried then Missing else Rerun

inl starting () : progress = { stage = 0; run = 0; retried = false; counted = 0; missing = 0 }

inl finished (runs : array i32) (p : progress) : bool = p.stage >= length runs

inl after (runs : array i32) (p : progress) (o : run_outcome) : progress =
    inl advanced (counted : i32) (missing : i32) : progress =
        if p.run + 1 >= index runs p.stage
        then { stage = p.stage + 1; run = 0; retried = false; counted = counted; missing = missing }
        else { stage = p.stage; run = p.run + 1; retried = false; counted = counted; missing = missing }
    match fate_of p.retried o with
    | Rerun => { p with retried = true }
    | Counted => advanced (p.counted + 1) p.missing
    | Missing => advanced p.counted (p.missing + 1)

union stage_step =
    | InstallProbe : string
    | Runs : i32
    | RemoveProbe
    | KeepTrace : string

inl probed_stage (probe : string) (runs : i32) (trace : string) : list stage_step =
    [ InstallProbe probe; Runs runs; RemoveProbe; KeepTrace trace ]

inl plain_stage (runs : i32) : list stage_step = [ Runs runs ]

inl runs_of (steps : list stage_step) : i32 =
    listm.fold (fun total step => match step with Runs n => total + n | _ => total) 0 steps

inl probe_left_installed (steps : list stage_step) : bool =
    listm.fold
        fun installed step =>
            match step with
            | InstallProbe _ => true
            | RemoveProbe => false
            | _ => installed
        false
        steps

inl stages_of (first : i32) (second : i32) : array i32 =
    inl runs : array i32 = create 2
    set runs 0 first
    set runs 1 second
    runs

///> c
///> lua
///> gleam
test a_crash_is_rerun_once_then_counted_missing =
    inl ~empty = ""
    outcome_of_experience empty |> _assert_eq Crashed
    outcome_of_experience "675" |> _assert_eq Completed
    fate_of false Completed |> _assert_eq Counted
    fate_of false Crashed |> _assert_eq Rerun
    fate_of true Crashed |> _assert_eq Missing
    fate_of true Completed |> _assert_eq Counted

///> c
///> lua
///> gleam
test a_block_runs_every_stage_in_order =
    inl ~first = 2i32
    inl runs = stages_of first 1
    inl p1 = after runs (starting ()) Completed
    (p1.stage, p1.run, p1.counted) |> _assert_eq (0i32, 1i32, 1i32)
    inl p2 = after runs p1 Crashed
    (p2.stage, p2.run, p2.retried) |> _assert_eq (0i32, 1i32, true)
    inl p3 = after runs p2 Completed
    (p3.stage, p3.run, p3.counted, p3.retried) |> _assert_eq (1i32, 0i32, 2i32, false)
    finished runs p3 |> _assert_eq false
    inl p4 = after runs p3 Completed
    (p4.stage, p4.counted, p4.missing) |> _assert_eq (2i32, 3i32, 0i32)
    finished runs p4 |> _assert_eq true

///> c
///> lua
///> gleam
test two_crashes_count_one_run_missing =
    inl ~first = 1i32
    inl runs = stages_of first 1
    inl p = after runs (after runs (starting ()) Crashed) Crashed
    (p.stage, p.counted, p.missing) |> _assert_eq (1i32, 0i32, 1i32)

///> c
///> lua
///> gleam
test a_probed_stage_removes_its_probe_and_keeps_the_trace =
    inl ~runs = 10i32
    inl steps = probed_stage "lead_trace.lua" runs "lead-trace.log"
    runs_of steps |> _assert_eq 10i32
    probe_left_installed steps |> _assert_eq false
    probe_left_installed [ InstallProbe "lead_trace.lua"; Runs runs ] |> _assert_eq true
    runs_of (plain_stage runs) |> _assert_eq 10i32
