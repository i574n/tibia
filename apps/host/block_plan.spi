///- --package .
test block_plan static =
    :< testing

:| run_outcome =
    | Completed
    | Crashed

:| run_fate =
    | Counted
    | Rerun
    | Missing

:== progress = { stage : i32; run : i32; retried : bool; counted : i32; missing : i32 }

:= outcome_of_experience (experience : string) : run_outcome = ? experience = "" ?> Crashed |: Completed

:= fate_of (retried : bool) (o : run_outcome) : run_fate =
    ?= o ?|
    | Completed => Counted
    | Crashed => ? retried ?> Missing |: Rerun

:= starting () : progress = { stage = 0; run = 0; retried = !-; counted = 0; missing = 0 }

:= finished (runs : array i32) (p : progress) : bool = p.stage >= length runs

:= after (runs : array i32) (p : progress) (o : run_outcome) : progress =
    := advanced (counted : i32) (missing : i32) : progress =
        ? p.run + 1 >= index runs p.stage
        ?> { stage = p.stage + 1; run = 0; retried = !-; counted = counted; missing = missing }
        |: { stage = p.stage; run = p.run + 1; retried = !-; counted = counted; missing = missing }
    ?= fate_of p.retried o ?|
    | Rerun => { p ?| retried = !+ }
    | Counted => advanced (p.counted + 1) p.missing
    | Missing => advanced p.counted (p.missing + 1)

:| stage_step =
    | InstallProbe : string
    | Runs : i32
    | RemoveProbe
    | KeepTrace : string

:= probed_stage (probe : string) (runs : i32) (trace : string) : list stage_step =
    [ InstallProbe probe; Runs runs; RemoveProbe; KeepTrace trace ]

:= plain_stage (runs : i32) : list stage_step = [ Runs runs ]

:= runs_of (steps : list stage_step) : i32 =
    listm.fold (\ total step => ?= step ?| Runs n => total + n | _ => total) 0 steps

:= probe_left_installed (steps : list stage_step) : bool =
    listm.fold
        \ installed step =>
            ?= step ?|
            | InstallProbe _ => !+
            | RemoveProbe => !-
            | _ => installed
        !-
        steps

:= stages_of (first : i32) (second : i32) : array i32 =
    := runs : array i32 = create 2
    set runs 0 first
    set runs 1 second
    runs

///> c
///> lua
///> gleam
test a_crash_is_rerun_once_then_counted_missing =
    := ~empty = ""
    outcome_of_experience empty |> _assert_eq Crashed
    outcome_of_experience "675" |> _assert_eq Completed
    fate_of !- Completed |> _assert_eq Counted
    fate_of !- Crashed |> _assert_eq Rerun
    fate_of !+ Crashed |> _assert_eq Missing
    fate_of !+ Completed |> _assert_eq Counted

///> c
///> lua
///> gleam
test a_block_runs_every_stage_in_order =
    := ~first = 2i32
    := runs = stages_of first 1
    := p1 = after runs (starting ()) Completed
    (p1.stage, p1.run, p1.counted) |> _assert_eq (0i32, 1i32, 1i32)
    := p2 = after runs p1 Crashed
    (p2.stage, p2.run, p2.retried) |> _assert_eq (0i32, 1i32, !+)
    := p3 = after runs p2 Completed
    (p3.stage, p3.run, p3.counted, p3.retried) |> _assert_eq (1i32, 0i32, 2i32, !-)
    finished runs p3 |> _assert_eq !-
    := p4 = after runs p3 Completed
    (p4.stage, p4.counted, p4.missing) |> _assert_eq (2i32, 3i32, 0i32)
    finished runs p4 |> _assert_eq !+

///> c
///> lua
///> gleam
test two_crashes_count_one_run_missing =
    := ~first = 1i32
    := runs = stages_of first 1
    := p = after runs (after runs (starting ()) Crashed) Crashed
    (p.stage, p.counted, p.missing) |> _assert_eq (1i32, 0i32, 1i32)

///> c
///> lua
///> gleam
test a_probed_stage_removes_its_probe_and_keeps_the_trace =
    := ~runs = 10i32
    := steps = probed_stage "lead_trace.lua" runs "lead-trace.log"
    runs_of steps |> _assert_eq 10i32
    probe_left_installed steps |> _assert_eq !-
    probe_left_installed [ InstallProbe "lead_trace.lua"; Runs runs ] |> _assert_eq !+
    runs_of (plain_stage runs) |> _assert_eq 10i32
