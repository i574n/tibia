///- --package .
test activity static =
    open testing

type counts =
    {
        server_potions : i32
        own_potions : i32
        own_other : i32
        retreats : i32
        gated_walks : i32
        allowed : option i32
        dropped : option i32
    }

inl foreign_potions (c : counts) : i32 = c.server_potions - c.own_potions

inl own_actions (c : counts) : i32 = c.own_potions + c.own_other + c.retreats + c.gated_walks

inl foreign_actions (c : counts) : option i32 =
    match c.allowed, c.dropped with
    | Some allowed, Some dropped => Some (allowed + dropped - own_actions c)
    | _ => None

///> c
///> lua
///> gleam
test foreign_activity_follows_the_arena_check =
    inl ~server = 6i32
    inl c =
        {
            server_potions = server
            own_potions = 5
            own_other = 9
            retreats = 2
            gated_walks = 1
            allowed = Some 15
            dropped = Some 2
        }
    foreign_potions c |> _assert_eq 1i32
    own_actions c |> _assert_eq 17i32
    foreign_actions c |> _assert_eq (Some 0i32)
    foreign_actions { c with allowed = None } |> _assert_eq None
