///- --package .
test arena_host static =
    :< testing

:< sm'_operators

:| host_event =
    | WindowGranted
    | WindowLost
    | WorldReady
    | WorldCrashed
    | RunEnded : block_plan.run_outcome
    | RunTimedOut

:| host_command =
    | StartWorld
    | RestartWorld
    | ResetCharacter
    | StartRun : i32 * i32
    | StopRun
    | Record : block_plan.run_fate
    | ReleaseWindow

:| host_phase =
    | AwaitingWindow
    | StartingWorld
    | Running
    | Ended

:== host = { phase : host_phase; runs : array i32; progress : block_plan.progress }

:= opened (runs : array i32) : host = { phase = AwaitingWindow; runs = runs; progress = block_plan.starting () }

:= next_run (h : host) : list host_command = [ ResetCharacter; StartRun (h.progress.stage, h.progress.run) ]

:= settled (h : host) (o : block_plan.run_outcome) : host * list host_command =
    := fate = block_plan.fate_of h.progress.retried o
    := progress = block_plan.after h.runs h.progress o
    := moved = { h ?| progress = progress }
    ? block_plan.finished h.runs progress
    ?> { moved ?| phase = Ended }, [ Record fate; ReleaseWindow ]
    |: moved, Record fate :: next_run moved

:= step (h : host) (e : host_event) : host * list host_command =
    := crashed : block_plan.run_outcome = :< block_plan ;; Crashed
    ?= h.phase, e ?|
    | Ended, _ => h, []
    | _, WindowLost => { h ?| phase = Ended }, []
    | AwaitingWindow, WindowGranted => { h ?| phase = StartingWorld }, [ StartWorld ]
    | StartingWorld, WorldReady => { h ?| phase = Running }, next_run h
    | Running, RunEnded o => settled h o
    | Running, RunTimedOut =>
        ?= settled h crashed ?|
        | after_crash, commands => after_crash, StopRun :: commands
    | Running, WorldCrashed =>
        ?= settled h crashed ?|
        | after_crash, commands =>
            ?= after_crash.phase ?|
            | Ended => after_crash, commands
            | _ =>
                { after_crash ?| phase = StartingWorld },
                [ Record (block_plan.fate_of h.progress.retried crashed); RestartWorld ]
    | StartingWorld, WorldCrashed => h, [ RestartWorld ]
    | _, _ => h, []

:= fate_text (fate : block_plan.run_fate) : string =
    :< block_plan
    ?= fate ?|
    | Counted => "counted"
    | Rerun => "rerun"
    | Missing => "missing"

:= command_text (c : host_command) : string =
    ?= c ?|
    | StartWorld => "start-world"
    | RestartWorld => "restart-world"
    | ResetCharacter => "reset"
    | StartRun (stage, run) => "run " ++#? stage ++# "." ++#? run
    | StopRun => "stop"
    | Record fate => fate_text fate
    | ReleaseWindow => "release"

:= logged (log : string) (commands : list host_command) : string =
    := text =
        listm.fold
            \ line (c : host_command) => ? line = "" ?> command_text c |: line ++# ", " ++# command_text c
            ""
            commands
    ? text = "" ?> log |? log = "" ?> text |: log ++# " | " ++# text

:~ ^ played (h : host) (events : list host_event) (log : string) : string =
    ?= events ?|
    | Nil => log
    | Cons (e, rest) =>
        ?= step h e ?|
        | next, commands => played next rest (logged log commands)

:| world_reaction =
    | Finishes : block_plan.run_outcome
    | TimesOut
    | CrashesWorld

:= reaction_event (r : world_reaction) : host_event =
    ?= r ?|
    | Finishes o => RunEnded o
    | TimesOut => RunTimedOut
    | CrashesWorld => WorldCrashed

:~ ^ reacted (commands : list host_command) (script : list world_reaction) (events : list host_event)
    : list host_event * list world_reaction
    =
    ?= commands ?|
    | Nil => listm.rev events, script
    | Cons (c, rest) =>
        ?= c ?|
        | StartWorld => reacted rest script (WorldReady :: events)
        | RestartWorld => reacted rest script (WorldReady :: events)
        | StartRun _ =>
            ?= script ?|
            | Cons (r, later) => reacted rest later (reaction_event r :: events)
            | Nil => reacted rest Nil (WindowLost :: events)
        | _ => reacted rest script events

:~ ^ simulated (h : host) (pending : list host_event) (script : list world_reaction) (log : string) : string =
    ?= pending ?|
    | Nil => log
    | Cons (e, rest) =>
        ?= step h e ?|
        | next, commands =>
            ?= reacted commands script Nil ?|
            | events, left =>
                := queued =
                    listm.fold (\ (queue : list host_event) (x : host_event) => x :: queue) events (listm.rev rest)
                simulated next queued left (logged log commands)

///> lua
///> gleam
test a_clean_block_resets_before_every_run_and_releases_its_window =
    := ~first = 2i32
    := h = opened (block_plan.stages_of first 1)
    := completed = RunEnded (:< block_plan ;; Completed)
    played h [ WindowGranted; WorldReady; completed; completed; completed ] ""
    |> _assert_eq "start-world | reset, run 0.0 | counted, reset, run 0.1 | counted, reset, run 1.0 | counted, release"

///> lua
///> gleam
test a_timed_out_run_is_stopped_and_rerun_once_then_counted_missing =
    := ~first = 1i32
    := h = opened (block_plan.stages_of first 1)
    played h [ WindowGranted; WorldReady; RunTimedOut; RunTimedOut; RunEnded (:< block_plan ;; Completed) ] ""
    |> _assert_eq (
        "start-world | reset, run 0.0 | stop, rerun, reset, run 0.0 | stop, missing, reset, run 1.0 | counted, "
        ^^ "release"
    )

///> lua
///> gleam
test a_world_crash_restarts_the_world_and_resets_the_character_before_the_rerun =
    := ~first = 1i32
    := h = opened (block_plan.stages_of first 1)
    := completed = RunEnded (:< block_plan ;; Completed)
    played h [ WindowGranted; WorldReady; WorldCrashed; WorldReady; completed; completed ] ""
    |> _assert_eq (
        "start-world | reset, run 0.0 | rerun, restart-world | reset, run 0.0 | counted, reset, run 1.0 | "
        ^^ "counted, release"
    )

///> lua
///> gleam
test a_lost_window_ends_the_block_and_later_events_change_nothing =
    := ~first = 1i32
    := h = opened (block_plan.stages_of first 1)
    played h [ WindowGranted; WorldReady; WindowLost; RunEnded (:< block_plan ;; Completed); WindowGranted ] ""
    |> _assert_eq "start-world | reset, run 0.0"

///> lua
///> gleam
test a_scripted_world_drives_a_whole_block_through_the_executor =
    := ~first = 2i32
    := h = opened (block_plan.stages_of first 1)
    := completed = Finishes (:< block_plan ;; Completed)
    simulated h [ WindowGranted ] [ completed; TimesOut; completed; CrashesWorld; completed ] ""
    |> _assert_eq (
        "start-world | reset, run 0.0 | counted, reset, run 0.1 | stop, rerun, reset, run 0.1 | "
        ^^ "counted, reset, run 1.0 | rerun, restart-world | reset, run 1.0 | counted, release"
    )

///> lua
///> gleam
test a_world_that_stops_answering_ends_the_block =
    := ~first = 1i32
    := h = opened (block_plan.stages_of first 1)
    simulated h [ WindowGranted ] [ Finishes (:< block_plan ;; Completed) ] ""
    |> _assert_eq "start-world | reset, run 0.0 | counted, reset, run 1.0"

:| host_message r =
    | Event : host_event
    | Trace : r

:= runs_of_plan (plan : list i32) : array i32 =
    := n : i32 = listm.length plan
    := runs : array i32 = create n
    :~ ^ fill (i : i32) (rest : list i32) : () =
        ?= rest ?|
        | Cons (head, tail) =>
            set runs i head
            fill (i + 1) tail
        | Nil => ()
    fill 0 plan
    runs

:= host_actor \* r. (answer : r -> string -> ()) (plan : list i32)
    : step_runtime.actor (list i32 * option host * string) (host_message r)
    =
    {
        init = \ () => plan, None, ""
        handle = \ (state : list i32 * option host * string) (message : host_message r) =>
            ?= state ?|
            | kept_plan, current, log =>
                := h : host =
                    ?= current ?|
                    | Some running => running
                    | None => opened (runs_of_plan kept_plan)
                ?= message ?|
                | Event e =>
                    ?= step h e ?|
                    | next, commands => step_runtime.Continue (kept_plan, Some next, logged log commands)
                | Trace to =>
                    answer to log
                    step_runtime.Continue (kept_plan, Some h, log)
    }
:= host_trace \* a r.
    (start : step_runtime.actor (list i32 * option host * string) (host_message r) -> a)
    (post : a -> host_message r -> ())
    (ask : a -> (r -> host_message r) -> string)
    (answer : r -> string -> ())
    (plan : list i32)
    (events : list host_event)
    : string
    =
    := actor = start (host_actor answer plan)
    listm.iter (\ (e : host_event) => post actor (Event e)) events
    ask actor Trace

///> gleam
///> lua
test the_host_step_runs_inside_an_actor_and_gives_the_same_trace_on_every_backend =
    := ~first = 1i32
    := plan = [ first; 1i32 ]
    := completed = RunEnded (:< block_plan ;; Completed)
    := events = [ WindowGranted; WorldReady; completed; completed ]
    run_target \|
        | Gleam => \ () =>
            host_trace step_runtime.otp_start otp_actor.send
                \ inbox request => otp_actor.call inbox 10000i32 request
                erlang_process.send plan events
        | _ =>
            \ () => host_trace step_runtime.spawn step_runtime.send step_runtime.call step_runtime.reply plan events
    |> _assert_eq "start-world | reset, run 0.0 | counted, reset, run 1.0 | counted, release"
