///- --package .
test arena_host static =
    open testing

open sm'_operators

union host_event =
    | WindowGranted
    | WindowLost
    | WorldReady
    | WorldCrashed
    | RunEnded : block_plan.run_outcome
    | RunTimedOut

union host_command =
    | StartWorld
    | RestartWorld
    | ResetCharacter
    | StartRun : i32 * i32
    | StopRun
    | Record : block_plan.run_fate
    | ReleaseWindow

union host_phase =
    | AwaitingWindow
    | StartingWorld
    | Running
    | Ended

type host = { phase : host_phase; runs : array i32; progress : block_plan.progress }

inl opened (runs : array i32) : host = { phase = AwaitingWindow; runs = runs; progress = block_plan.starting () }

inl next_run (h : host) : list host_command = [ ResetCharacter; StartRun (h.progress.stage, h.progress.run) ]

inl settled (h : host) (o : block_plan.run_outcome) : host * list host_command =
    inl fate = block_plan.fate_of h.progress.retried o
    inl progress = block_plan.after h.runs h.progress o
    inl moved = { h with progress = progress }
    if block_plan.finished h.runs progress
    then { moved with phase = Ended }, [ Record fate; ReleaseWindow ]
    else moved, Record fate :: next_run moved

inl step (h : host) (e : host_event) : host * list host_command =
    inl crashed : block_plan.run_outcome = open block_plan in Crashed
    match h.phase, e with
    | Ended, _ => h, []
    | _, WindowLost => { h with phase = Ended }, []
    | AwaitingWindow, WindowGranted => { h with phase = StartingWorld }, [ StartWorld ]
    | StartingWorld, WorldReady => { h with phase = Running }, next_run h
    | Running, RunEnded o => settled h o
    | Running, RunTimedOut =>
        match settled h crashed with
        | after_crash, commands => after_crash, StopRun :: commands
    | Running, WorldCrashed =>
        match settled h crashed with
        | after_crash, commands =>
            match after_crash.phase with
            | Ended => after_crash, commands
            | _ =>
                { after_crash with phase = StartingWorld },
                [ Record (block_plan.fate_of h.progress.retried crashed); RestartWorld ]
    | StartingWorld, WorldCrashed => h, [ RestartWorld ]
    | _, _ => h, []

inl fate_text (fate : block_plan.run_fate) : string =
    open block_plan
    match fate with
    | Counted => "counted"
    | Rerun => "rerun"
    | Missing => "missing"

inl command_text (c : host_command) : string =
    match c with
    | StartWorld => "start-world"
    | RestartWorld => "restart-world"
    | ResetCharacter => "reset"
    | StartRun (stage, run) => "run " ++#? stage ++# "." ++#? run
    | StopRun => "stop"
    | Record fate => fate_text fate
    | ReleaseWindow => "release"

inl logged (log : string) (commands : list host_command) : string =
    inl text =
        listm.fold
            fun line (c : host_command) => if line = "" then command_text c else line ++# ", " ++# command_text c
            ""
            commands
    if text = "" then log elif log = "" then text else log ++# " | " ++# text

let rec played (h : host) (events : list host_event) (log : string) : string =
    match events with
    | Nil => log
    | Cons (e, rest) =>
        match step h e with
        | next, commands => played next rest (logged log commands)

union world_reaction =
    | Finishes : block_plan.run_outcome
    | TimesOut
    | CrashesWorld

inl reaction_event (r : world_reaction) : host_event =
    match r with
    | Finishes o => RunEnded o
    | TimesOut => RunTimedOut
    | CrashesWorld => WorldCrashed

let rec reacted (commands : list host_command) (script : list world_reaction) (events : list host_event)
    : list host_event * list world_reaction
    =
    match commands with
    | Nil => listm.rev events, script
    | Cons (c, rest) =>
        match c with
        | StartWorld => reacted rest script (WorldReady :: events)
        | RestartWorld => reacted rest script (WorldReady :: events)
        | StartRun _ =>
            match script with
            | Cons (r, later) => reacted rest later (reaction_event r :: events)
            | Nil => reacted rest Nil (WindowLost :: events)
        | _ => reacted rest script events

let rec simulated (h : host) (pending : list host_event) (script : list world_reaction) (log : string) : string =
    match pending with
    | Nil => log
    | Cons (e, rest) =>
        match step h e with
        | next, commands =>
            match reacted commands script Nil with
            | events, left =>
                inl queued =
                    listm.fold (fun (queue : list host_event) (x : host_event) => x :: queue) events (listm.rev rest)
                simulated next queued left (logged log commands)

///> lua
///> gleam
test a_clean_block_resets_before_every_run_and_releases_its_window =
    inl ~first = 2i32
    inl h = opened (block_plan.stages_of first 1)
    inl completed = RunEnded (open block_plan in Completed)
    played h [ WindowGranted; WorldReady; completed; completed; completed ] ""
    |> _assert_eq "start-world | reset, run 0.0 | counted, reset, run 0.1 | counted, reset, run 1.0 | counted, release"

///> lua
///> gleam
test a_timed_out_run_is_stopped_and_rerun_once_then_counted_missing =
    inl ~first = 1i32
    inl h = opened (block_plan.stages_of first 1)
    played h [ WindowGranted; WorldReady; RunTimedOut; RunTimedOut; RunEnded (open block_plan in Completed) ] ""
    |> _assert_eq (
        "start-world | reset, run 0.0 | stop, rerun, reset, run 0.0 | stop, missing, reset, run 1.0 | counted, "
        ^^ "release"
    )

///> lua
///> gleam
test a_world_crash_restarts_the_world_and_resets_the_character_before_the_rerun =
    inl ~first = 1i32
    inl h = opened (block_plan.stages_of first 1)
    inl completed = RunEnded (open block_plan in Completed)
    played h [ WindowGranted; WorldReady; WorldCrashed; WorldReady; completed; completed ] ""
    |> _assert_eq (
        "start-world | reset, run 0.0 | rerun, restart-world | reset, run 0.0 | counted, reset, run 1.0 | "
        ^^ "counted, release"
    )

///> lua
///> gleam
test a_lost_window_ends_the_block_and_later_events_change_nothing =
    inl ~first = 1i32
    inl h = opened (block_plan.stages_of first 1)
    played h [ WindowGranted; WorldReady; WindowLost; RunEnded (open block_plan in Completed); WindowGranted ] ""
    |> _assert_eq "start-world | reset, run 0.0"

///> lua
///> gleam
test a_scripted_world_drives_a_whole_block_through_the_executor =
    inl ~first = 2i32
    inl h = opened (block_plan.stages_of first 1)
    inl completed = Finishes (open block_plan in Completed)
    simulated h [ WindowGranted ] [ completed; TimesOut; completed; CrashesWorld; completed ] ""
    |> _assert_eq (
        "start-world | reset, run 0.0 | counted, reset, run 0.1 | stop, rerun, reset, run 0.1 | "
        ^^ "counted, reset, run 1.0 | rerun, restart-world | reset, run 1.0 | counted, release"
    )

///> lua
///> gleam
test a_world_that_stops_answering_ends_the_block =
    inl ~first = 1i32
    inl h = opened (block_plan.stages_of first 1)
    simulated h [ WindowGranted ] [ Finishes (open block_plan in Completed) ] ""
    |> _assert_eq "start-world | reset, run 0.0 | counted, reset, run 1.0"

union host_message r =
    | Event : host_event
    | Trace : r

inl runs_of_plan (plan : list i32) : array i32 =
    inl n : i32 = listm.length plan
    inl runs : array i32 = create n
    let rec fill (i : i32) (rest : list i32) : () =
        match rest with
        | Cons (head, tail) =>
            set runs i head
            fill (i + 1) tail
        | Nil => ()
    fill 0 plan
    runs

inl host_actor forall r. (answer : r -> string -> ()) (plan : list i32)
    : step_runtime.actor (list i32 * option host * string) (host_message r)
    =
    {
        init = plan, None, ""
        handle = fun (state : list i32 * option host * string) (message : host_message r) =>
            match state with
            | kept_plan, current, log =>
                inl h : host =
                    match current with
                    | Some running => running
                    | None => opened (runs_of_plan kept_plan)
                match message with
                | Event e =>
                    match step h e with
                    | next, commands => step_runtime.Continue (kept_plan, Some next, logged log commands)
                | Trace to =>
                    answer to log
                    step_runtime.Continue (kept_plan, Some h, log)
    }
inl host_trace forall a r.
    (start : step_runtime.actor (list i32 * option host * string) (host_message r) -> a)
    (post : a -> host_message r -> ())
    (ask : a -> (r -> host_message r) -> string)
    (answer : r -> string -> ())
    (plan : list i32)
    (events : list host_event)
    : string
    =
    inl actor = start (host_actor answer plan)
    listm.iter (fun (e : host_event) => post actor (Event e)) events
    ask actor Trace

///> gleam
///> lua
test the_host_step_runs_inside_an_actor_and_gives_the_same_trace_on_every_backend =
    inl ~first = 1i32
    inl plan = [ first; 1i32 ]
    inl completed = RunEnded (open block_plan in Completed)
    inl events = [ WindowGranted; WorldReady; completed; completed ]
    run_target function
        | Gleam => fun () =>
            host_trace step_runtime.otp_start otp_actor.send
                fun inbox request => otp_actor.call inbox 10000i32 request
                erlang_process.send plan events
        | _ =>
            fun () => host_trace step_runtime.spawn step_runtime.send step_runtime.call step_runtime.reply plan events
    |> _assert_eq "start-world | reset, run 0.0 | counted, reset, run 1.0 | counted, release"
