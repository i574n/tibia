///- --package .
test scenario static =
    :< testing

:< sm'_operators

:== order = { name : string; count : i32 }

:| mix =
    | Mix : list order
    | BadOrder : string

:= order_of (part : string) : option order =
    := fields = part |> sm'.split ":" |> array
    ? am'.length fields <> 2
    ?> None
    |:
        ?= convert.try_convert (sm'.trim (am'.index 1 fields)) ?|
        | Some count => Some { name = sm'.trim (am'.index 0 fields); count = count }
        | None => None

:= mix_of (monster : string) (count : i32) : mix =
    ? sm'.contains ":" monster
    ?>
        := parts = monster |> sm'.split "," |> array
        :~ ^ collect (i : i32) (orders : list order) : mix =
            ? i < 0
            ?> Mix orders
            |:
                := part = am'.index i parts
                ?= order_of part ?|
                | Some o => collect (i - 1) (o :: orders)
                | None => BadOrder part
        collect (am'.length parts - 1) Nil
    |: Mix [ { name = monster; count = count } ]

:= summon_orders (orders : list order) (radius : i32) : string =
    := entry (o : order) : string = o.name ++# "," ++#? o.count ++# ",," ++#? radius
    ?= orders ?|
    | Cons (head, tail) => listm.fold (\ text o => text ++# ";" ++# entry o) (entry head) tail
    | Nil => ""

:= total_count (orders : list order) : i32 = listm.fold (\ total (o : order) => total + o.count) 0 orders

///> lua
///> gleam
test a_single_monster_and_a_mixed_camp_give_the_harness_orders =
    := ~radius = 2i32
    ?= mix_of "troll" 3 ?|
    | Mix orders =>
        summon_orders orders radius |> _assert_eq "troll,3,,2"
        total_count orders |> _assert_eq 3i32
    | BadOrder part => failwith part
    ?= mix_of "troll:2, cyclops:1" 0 ?|
    | Mix orders =>
        summon_orders orders radius |> _assert_eq "troll,2,,2;cyclops,1,,2"
        total_count orders |> _assert_eq 3i32
    | BadOrder part => failwith part

///> lua
///> gleam
test a_count_that_is_not_a_number_names_its_part =
    := ~monster = "troll:2,cyclops:x"
    mix_of monster 0 |> _assert_eq (BadOrder "cyclops:x")
