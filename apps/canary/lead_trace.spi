///- --package .
test lead_trace static =
    :< testing

:< sm'_operators

:== watch = { id : u32; x : i32; y : i32 }

:= emit (line : string) : () = file_system.append_all_text "lead-trace.log" (line ++# "\n")

:= spot_text (x : i32) (y : i32) : string = "" ++#? x ++# "," ++#? y

:= watch_of (id : u32) (watched : list watch) : option watch =
    listm.fold (\ found (w : watch) =>
        ?= found ?|
        | Some _ => found
        | None => ? w.id = id ?> Some w |: None
        ) None watched

:= moved_to (id : u32) (x : i32) (y : i32) (watched : list watch) : list watch =
    listm.map (\ (w : watch) => ? w.id = id ?> { id = w.id; x = x; y = y } |: w) watched

:= holder_of (p : canary.position) : string =
    := t = canary.tile_at p
    ? canary.tile_present t = !- ?> "none"
    |:
        := top = canary.tile_top_creature t
        ? canary.creature_present top ?> "" ++#? canary.creature_id top |: "free"

///> lua
///> c
test watches_follow_moves =
    := watched = Cons ({ id = 301u32; x = 1931i32; y = 1353i32 }, Nil)
    := moved = moved_to 301u32 1931i32 1352i32 watched
    (?= watch_of 301u32 moved ?| Some w => w.y | None => 0i32) |> _assert_eq 1352i32

:= main () : () =
    := centre = canary.position 1931 1352 7
    := reach = 11i32
    := trace_ms = 10000i32
    := boxed_x, boxed_y = 1931i32, 1353i32
    := exit = canary.position 1931 1352 7
    := walk_check_ms = 750i32
    := knight_since : mut (option f64) = mut None
    := knight_at : mut (option (i32 * i32)) = mut None
    := knight_targeted = mut !-
    := watched : mut (list watch) = mut Nil
    := since () : i32 =
        ?= *knight_since ?|
        | Some t => conv (canary.system_time () - t)
        | None => -1i32
    := check_boxed (id : u32) (think_since : i32) (think_exit : string) : () =
        := c = canary.creature_by_id id
        := now = since ()
        ? canary.creature_present c && now >= 0i32 ?>
            := at = canary.creature_position c
            emit (
                "lead-trace boxed-check " ++#? id ++# " at " ++# spot_text (canary.position_x at) (canary.position_y at)
                ++# " exit " ++# holder_of exit ++# " think-exit " ++# think_exit ++# " think @knight+" ++#? think_since
                ++# " @knight+" ++#? now
            )
    := think = canary.creature_event "LeadTraceThink"
    canary.on_creature_think think (\ c =>
        := now = since ()
        ? now >= 0i32 && now <= trace_ms ?>
            := at = canary.creature_position c
            := x, y = canary.position_x at, canary.position_y at
            := id = canary.creature_id c
            emit ("lead-trace think " ++#? id ++# " at " ++# spot_text x y ++# " @knight+" ++#? now)
            ? x = boxed_x && y = boxed_y ?>
                := think_exit = holder_of exit
                emit ("lead-trace boxed-think " ++#? id ++# " exit " ++# think_exit ++# " @knight+" ++#? now)
                canary.add_event (\ () => check_boxed id now think_exit) walk_check_ms
        !+
        )
    canary.register_creature_event think
    := poll = canary.global_event "LeadTracePoll"
    canary.on_think poll (\ _ =>
        := knight_present = mut !-
        := crowd = canary.spectators centre reach
        loop.for' { from = 0i32; nearTo = am'.length crowd } (\ i =>
            := c = am'.index i crowd
            := id = canary.creature_id c
            := at = canary.creature_position c
            := x, y = canary.position_x at, canary.position_y at
            ? canary.creature_is_player c ?>
                := knight = canary.creature_name c = "Knight Sample"
                ? knight ?>
                    knight_present <- !+
                    := target = canary.creature_target c
                    := known = ?= *knight_since ?| Some _ => !+ | None => !-
                    ? known && canary.creature_present target && *knight_targeted = !- ?>
                        knight_targeted <- !+
                        emit ("lead-trace knight targets " ++#? canary.creature_id target ++# " @knight+" ++#? since ())
                ?= *knight_since, *knight_at ?|
                | None, _ ?& knight =>
                    knight_since <- Some (canary.system_time ())
                    knight_at <- Some (x, y)
                    := stamp = date_time.now () |> date_time.format "%Y%m%d-%H%M%S"
                    emit ("lead-trace run " ++# stamp ++# " knight seen at " ++# spot_text x y ++# " @knight+0")
                | _, Some (kx, ky) ?& knight && (kx <> x || ky <> y) =>
                    := now = since ()
                    ? now <= trace_ms ?> emit ("lead-trace knight moved to " ++# spot_text x y ++# " @knight+" ++#? now)
                    knight_at <- Some (x, y)
                | _ => ()
            |? canary.creature_is_monster c ?>
                ?= watch_of id *watched ?|
                | None =>
                    canary.creature_register_event c "LeadTraceThink"
                    watched <- Cons ({ id = id; x = x; y = y }, *watched)
                    emit (
                        "lead-trace monster " ++#? id ++# " " ++# canary.creature_name c ++# " starts at "
                        ++# spot_text x y ++# " @knight+" ++#? since ()
                    )
                | Some seen =>
                    ? seen.x <> x || seen.y <> y ?>
                        := now = since ()
                        ? now <= trace_ms ?>
                            emit (
                                "lead-trace monster " ++#? id ++# " moved to " ++# spot_text x y ++# " @knight+" ++#? now
                            )
                        watched <- moved_to id x y *watched
            )
        := known = ?= *knight_since ?| Some _ => !+ | None => !-
        ? known && *knight_present = !- ?>
            emit ("lead-trace knight gone @knight+" ++#? since ())
            knight_since <- None
            knight_at <- None
            knight_targeted <- !-
            watched <- Nil
        !+
        )
    canary.think_interval poll 50
    canary.register_global_event poll
