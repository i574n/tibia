:# wgsl_attn_probe static =
    :< testing

:= declare () : () =
    global "@group(0) @binding(3) var<storage, read> spiral_input: array<u32>;"

:= word (i : u32) : u32 =
    run_target \|
        | Wgsl => \ () =>
            declare ()
            $'spiral_input[!i]' : u32
        | _ => \ () => failwith "wgsl_attn_probe.word / the input binding exists only on Wgsl"

:= lane () : u32 =
    run_target \|
        | Wgsl => \ () => $'spiral_lane' : u32
        | _ => \ () => failwith "wgsl_attn_probe.lane / exists only on Wgsl"

:= float_word (i : u32) : f32 = convert::f32_of_bits (word i)

:= fused (a : f32) (b : f32) (c : f32) : f32 = $'fma(!a, !b, !c)' : f32

:= dim () : u32 = word 0u32

:= hs () : u32 = dim () / word 3u32

:= kv_dim () : u32 = dim () * word 4u32 / word 3u32

:= rms_base () : u32 = 7u32 + word 5u32 * dim ()

:= wq_base () : u32 = rms_base () + word 2u32 * dim ()

:= wk_base () : u32 = wq_base () + word 2u32 * dim () * dim ()

:= wv_base () : u32 = wk_base () + word 2u32 * dim () * kv_dim ()

:= emb_of_pos (pos : u32) : u32 = 7u32 + (pos + 1u32) * dim ()

:= input_words () : u32 =
    run_target \|
        | Wgsl => \ () =>
            declare ()
            $'arrayLength(&spiral_input)' : u32
        | _ => \ () => failwith "wgsl_attn_probe.input_words / the input binding exists only on Wgsl"

:= rope_base () : u32 = input_words () - word 6u32 * dim ()

:~ sum_squares (x : u32) (j : u32) (s : f32) : f32 =
    ? j = dim ()
    ?> s
    |:
        := v = float_word (x + j)
        sum_squares x (j + 1u32) (fused v v s)

:~ inv_rms (x : u32) : f32 =
    := shifted = sum_squares x 0u32 0f32 / conv (dim ()) + 0.00001f32
    1f32 / $'sqrt(!shifted)' : f32

:~ row_dot (base : u32) (x : u32) (inv : f32) (row : u32) (j : u32) (s : f32) : f32 =
    ? j = dim ()
    ?> s
    |:
        := xb = float_word (rms_base () + j) * (inv * float_word (x + j))
        row_dot base x inv row (j + 1u32) (fused (float_word (base + row * dim () + j)) xb s)

:~ proj (base : u32) (pos : u32) (row : u32) : f32 =
    := x = emb_of_pos pos
    row_dot base x (inv_rms x) row 0u32 0f32

:~ rope_at (base : u32) (pos : u32) (i : u32) : f32 =
    := even = i - i % 2u32
    := at = rope_base () + pos * dim () + even
    := c = float_word at
    := s = float_word (at + 1u32)
    := v0 = proj base pos even
    := v1 = proj base pos (even + 1u32)
    ? i = even
    ?> $'fma(!v0, !c, -(!v1 * !s))' : f32
    |: $'fma(!v0, !s, !v1 * !c)' : f32

:~ score_dot (t : u32) (i : u32) (s : f32) : f32 =
    ? i = hs ()
    ?> s
    |: score_dot t (i + 1u32) (fused (rope_at (wq_base ()) 1u32 i) (rope_at (wk_base ()) t i) s)

:~ score (t : u32) : f32 =
    := width = conv (hs ()) : f32
    score_dot t 0u32 0f32 / $'sqrt(!width)' : f32

:~ att_of (t : u32) : f32 =
    := s0 = score 0u32
    := s1 = score 1u32
    := mx = ? s0 > s1 ?> s0 |: s1
    := e0 = $'exp(!s0 - !mx)' : f32
    := e1 = $'exp(!s1 - !mx)' : f32
    := total = (0f32 + e0) + e1
    ? t = 0u32 ?> e0 / total |: e1 / total

:~ out_of (i : u32) : f32 =
    := s0 = fused (att_of 0u32) (proj (wv_base ()) 0u32 i) 0f32
    fused (att_of 1u32) (proj (wv_base ()) 1u32 i) s0

:= bits (v : f32) : i32 = conv (convert::bits_of_f32 v)

:= main () : i32 =
    := l = lane ()
    := d = dim ()
    := kv = kv_dim ()
    ? l < d
    ?> bits (rope_at (wq_base ()) 1u32 l)
    |:
        ? l < d + kv
        ?> bits (rope_at (wk_base ()) 1u32 (l - d))
        |:
            ? l < d + kv + 2u32
            ?> bits (att_of (l - d - kv))
            |:
                ? l < d + kv + 2u32 + hs ()
                ?> bits (out_of (l - d - kv - 2u32))
                |: 0i32
