:# wgsl_forward static =
    :< testing

:= declare () : () =
    global "@group(0) @binding(3) var<storage, read> spiral_input: array<u32>;"

:= declare_scratch () : () =
    global "@group(0) @binding(1) var<storage, read_write> fwd_scratch: array<f32>;"

:= word (i : u32) : u32 =
    run_target \|
        | Wgsl => \ () =>
            declare ()
            $'spiral_input[!i]' : u32
        | _ => \ () => failwith "wgsl_forward.word / the input binding exists only on Wgsl"

:= lane () : u32 =
    run_target \|
        | Wgsl => \ () => $'spiral_lane' : u32
        | _ => \ () => failwith "wgsl_forward.lane / exists only on Wgsl"

:= sc (i : u32) : f32 =
    run_target \|
        | Wgsl => \ () =>
            declare_scratch ()
            $'fwd_scratch[!i]' : f32
        | _ => \ () => failwith "wgsl_forward.sc / the scratch binding exists only on Wgsl"

:= sc_set (i : u32) (v : f32) : () =
    run_target \|
        | Wgsl => \ () =>
            declare_scratch ()
            $'fwd_scratch[!i] = !v' : ()
        | _ => \ () => failwith "wgsl_forward.sc_set / the scratch binding exists only on Wgsl"

:= barrier () : () =
    run_target \|
        | Wgsl => \ () =>
            $'storageBarrier()' : ()
            $'workgroupBarrier()' : ()
        | _ => \ () => failwith "wgsl_forward.barrier / exists only on Wgsl"

:= float_word (i : u32) : f32 = convert::f32_of_bits (word i)

:= fused (a : f32) (b : f32) (c : f32) : f32 = $'fma(!a, !b, !c)' : f32

:= steps () : u32 = 20u32

:= dim () : u32 = word 0u32

:= hidden () : u32 = word 1u32

:= layers () : u32 = word 2u32

:= hs () : u32 = dim () / word 3u32

:= kv_dim () : u32 = dim () * word 4u32 / word 3u32

:= kv_mul () : u32 = word 3u32 / word 4u32

:= vocab () : u32 = word 5u32

:= rms_base () : u32 = 7u32 + vocab () * dim ()

:= wq_base () : u32 = rms_base () + layers () * dim ()

:= wk_base () : u32 = wq_base () + layers () * dim () * dim ()

:= wv_base () : u32 = wk_base () + layers () * dim () * kv_dim ()

:= wo_base () : u32 = wv_base () + layers () * dim () * kv_dim ()

:= ffn_rms_base () : u32 = wo_base () + layers () * dim () * dim ()

:= w1_base () : u32 = ffn_rms_base () + layers () * dim ()

:= w2_base () : u32 = w1_base () + layers () * dim () * hidden ()

:= w3_base () : u32 = w2_base () + layers () * dim () * hidden ()

:= final_rms_base () : u32 = w3_base () + layers () * dim () * hidden ()

:= rope_base () : u32 = final_rms_base () + dim () + word 6u32 * hs ()

:= xb_at () : u32 = dim ()

:= q_at () : u32 = 2u32 * dim ()

:= hb_at () : u32 = 3u32 * dim ()

:= logits_at () : u32 = 3u32 * dim () + hidden ()

:= saved_at () : u32 = logits_at () + vocab ()

:= saved_count () : u32 = ? vocab () < 512u32 ?> vocab () |: 512u32

:= toks_at () : u32 = saved_at () + saved_count ()

:= kc_at () : u32 = toks_at () + steps ()

:= vc_at () : u32 = kc_at () + layers () * steps () * kv_dim ()

:= region () : u32 = vc_at () + layers () * steps () * kv_dim ()

:= cache_row (layer : u32) (t : u32) : u32 = (layer * steps () + t) * kv_dim ()

:~ sum_squares (g : u32) (j : u32) (acc : f32) : f32 =
    ? j = dim ()
    ?> acc
    |:
        := v = sc (g + j)
        sum_squares g (j + 1u32) (fused v v acc)

:~ norm_row (g : u32) (gain : u32) (j : u32) : f32 =
    := shifted = sum_squares g 0u32 0f32 / conv (dim ()) + 0.00001f32
    := inv = 1f32 / $'sqrt(!shifted)' : f32
    float_word (gain + j) * (inv * sc (g + j))

:~ dot (g : u32) (base : u32) (row : u32) (n : u32) (src : u32) (j : u32) (acc : f32) : f32 =
    ? j = n
    ?> acc
    |: dot g base row n src (j + 1u32) (fused (float_word (base + row * n + j)) (sc (g + src + j)) acc)

:~ roped (g : u32) (base : u32) (pos : u32) (r : u32) : f32 =
    := even = r - r % 2u32
    := at = rope_base () + pos * dim () + even
    := c = float_word at
    := sn = float_word (at + 1u32)
    := v0 = dot g base even (dim ()) (xb_at ()) 0u32 0f32
    := v1 = dot g base (even + 1u32) (dim ()) (xb_at ()) 0u32 0f32
    ? r = even
    ?> $'fma(!v0, !c, -(!v1 * !sn))' : f32
    |: $'fma(!v0, !sn, !v1 * !c)' : f32

:~ score (g : u32) (layer : u32) (head : u32) (t : u32) (j : u32) (acc : f32) : f32 =
    ? j = hs () ?>
        := width = conv (hs ()) : f32
        acc / $'sqrt(!width)' : f32
    |:
        score g layer head t
            (j + 1u32)
            (
                fused
                    (sc (g + q_at () + head * hs () + j))
                    (sc (g + kc_at () + cache_row layer t + head / kv_mul () * hs () + j))
                    acc
            )

:~ max_score (g : u32) (layer : u32) (head : u32) (pos : u32) (t : u32) (m : f32) : f32 =
    ? t > pos
    ?> m
    |:
        := v = score g layer head t 0u32 0f32
        max_score g layer head pos (t + 1u32) (? v > m ?> v |: m)

:~ exp_sum (g : u32) (layer : u32) (head : u32) (pos : u32) (mx : f32) (t : u32) (acc : f32) : f32 =
    ? t > pos
    ?> acc
    |:
        := v = score g layer head t 0u32 0f32
        := e = $'exp(!v - !mx)' : f32
        exp_sum g layer head pos mx (t + 1u32) (acc + e)

:~ mix
    (g : u32) (layer : u32) (head : u32) (pos : u32) (mx : f32) (total : f32) (col : u32) (t : u32) (acc : f32)
    : f32
    =
    ? t > pos
    ?> acc
    |:
        := v = score g layer head t 0u32 0f32
        := e = $'exp(!v - !mx)' : f32
        := a = e / total
        mix g layer head pos mx total col (t + 1u32) (fused a (sc (g + vc_at () + cache_row layer t + col)) acc)

:~ stage_row (g : u32) (stage : u32) (layer : u32) (pos : u32) (i : u32) : () =
    := d = dim ()
    := kv = kv_dim ()
    ? stage = 0u32
    ?> sc_set (g + xb_at () + i) (norm_row g (rms_base () + layer * d) i)
    |:
        ? stage = 1u32 ?>
            ? i < d
            ?> sc_set (g + q_at () + i) (roped g (wq_base () + layer * d * d) pos i)
            |:
                ? i < d + kv ?>
                    sc_set
                        (g + kc_at () + cache_row layer pos + (i - d))
                        (roped g (wk_base () + layer * d * kv) pos (i - d))
                |:
                    sc_set
                        (g + vc_at () + cache_row layer pos + (i - d - kv))
                        (dot g (wv_base () + layer * d * kv) (i - d - kv) d (xb_at ()) 0u32 0f32)
        |:
            ? stage = 2u32 ?>
                := head = i / hs ()
                := col = head / kv_mul () * hs () + i % hs ()
                := mx = max_score g layer head pos 1u32 (score g layer head 0u32 0u32 0f32)
                sc_set
                    (g + xb_at () + i)
                    (mix g layer head pos mx (exp_sum g layer head pos mx 0u32 0f32) col 0u32 0f32)
            |:
                ? stage = 3u32
                ?> sc_set (g + i) (sc (g + i) + dot g (wo_base () + layer * d * d) i d (xb_at ()) 0u32 0f32)
                |:
                    ? stage = 4u32
                    ?> sc_set (g + xb_at () + i) (norm_row g (ffn_rms_base () + layer * d) i)
                    |:
                        ? stage = 5u32 ?>
                            := h1 = dot g (w1_base () + layer * d * hidden ()) i d (xb_at ()) 0u32 0f32
                            := h3 = dot g (w3_base () + layer * d * hidden ()) i d (xb_at ()) 0u32 0f32
                            := gate = 1f32 + $'exp(-!h1)' : f32
                            sc_set (g + hb_at () + i) (h1 * (1f32 / gate) * h3)
                        |:
                            ? stage = 6u32 ?>
                                sc_set
                                    (g + i)
                                    (
                                        sc (g + i)
                                        + dot g (w2_base () + layer * d * hidden ()) i (hidden ()) (hb_at ()) 0u32 0f32
                                    )
                            |:
                                ? stage = 7u32
                                ?> sc_set (g + xb_at () + i) (norm_row g (final_rms_base ()) i)
                                |: sc_set (g + logits_at () + i) (dot g 7u32 i d (xb_at ()) 0u32 0f32)

:~ fill (g : u32) (stage : u32) (layer : u32) (pos : u32) (size : u32) (local : u32) (k : u32) (rounds : u32) : () =
    ? k = rounds
    ?> ()
    |:
        := r = local + 64u32 * k
        ? r < size ?> stage_row g stage layer pos r |: ()
        fill g stage layer pos size local (k + 1u32) rounds

:= run_stage (g : u32) (stage : u32) (layer : u32) (pos : u32) (size : u32) (local : u32) : () =
    fill g stage layer pos size local 0u32 ((size + 63u32) / 64u32)
    barrier ()

:~ layer_loop (g : u32) (pos : u32) (local : u32) (layer : u32) : () =
    ? layer = layers ()
    ?> ()
    |:
        run_stage g 0u32 layer pos (dim ()) local
        run_stage g 1u32 layer pos (dim () + 2u32 * kv_dim ()) local
        run_stage g 2u32 layer pos (dim ()) local
        run_stage g 3u32 layer pos (dim ()) local
        run_stage g 4u32 layer pos (dim ()) local
        run_stage g 5u32 layer pos (hidden ()) local
        run_stage g 6u32 layer pos (dim ()) local
        layer_loop g pos local (layer + 1u32)

:~ argmax (g : u32) (i : u32) (best : u32) : u32 =
    ? i = vocab ()
    ?> best
    |: argmax g (i + 1u32) (? sc (g + logits_at () + i) > sc (g + logits_at () + best) ?> i |: best)

:~ save_logits (g : u32) (local : u32) (k : u32) (rounds : u32) : () =
    ? k = rounds
    ?> ()
    |:
        := r = local + 64u32 * k
        ? r < saved_count () ?> sc_set (g + saved_at () + r) (sc (g + logits_at () + r)) |: ()
        save_logits g local (k + 1u32) rounds

:~ load_embedding (g : u32) (tok : u32) (local : u32) (k : u32) (rounds : u32) : () =
    ? k = rounds
    ?> ()
    |:
        := r = local + 64u32 * k
        ? r < dim () ?> sc_set (g + r) (float_word (7u32 + tok * dim () + r)) |: ()
        load_embedding g tok local (k + 1u32) rounds

:~ pos_loop (g : u32) (local : u32) (pos : u32) (tok : u32) : () =
    ? pos = steps ()
    ?> ()
    |:
        load_embedding g tok local 0u32 ((dim () + 63u32) / 64u32)
        barrier ()
        layer_loop g pos local 0u32
        run_stage g 7u32 0u32 pos (dim ()) local
        run_stage g 8u32 0u32 pos (vocab ()) local
        ? pos = 0u32 ?> save_logits g local 0u32 ((saved_count () + 63u32) / 64u32) |: ()
        ? local = 0u32 ?> sc_set (g + toks_at () + pos) (conv (argmax g 1u32 0u32) : f32) |: ()
        barrier ()
        pos_loop g local (pos + 1u32) (conv (sc (g + toks_at () + pos)) : u32)

:= bits (v : f32) : i32 = conv (convert::bits_of_f32 v)

:= main () : i32 =
    := l = lane ()
    := g = l / 64u32 * region ()
    pos_loop g (l % 64u32) 0u32 1u32
    ? l < saved_count ()
    ?> bits (sc (g + saved_at () + l))
    |:
        ? l < saved_count () + steps ()
        ?> (conv (sc (g + toks_at () + (l - saved_count ()))) : i32)
        |: 0i32
