type bins = {zero : i32; one : i32; two : i32; three : i32}

inl binned (adjacent : i32) (amount : i32) (b : bins) : bins =
    if adjacent = 0 then {b with zero = b.zero + amount}
    elif adjacent = 1 then {b with one = b.one + amount}
    elif adjacent = 2 then {b with two = b.two + amount}
    else {b with three = b.three + amount}

inl plus (a : bins) (b : bins) : bins = {zero = a.zero + b.zero; one = a.one + b.one; two = a.two + b.two; three = a.three + b.three}

inl main () =
    open hunting_pack
    inl bare = uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> mirroring_the_live_arena |> waking_at 0
    inl cleared = clearing bare
    inl rules = cavebot_with_heal 160
    inl empty : bins = {zero = 0; one = 0; two = 0; three = 0}
    inl histogram (seed : u32) : bins * bins =
        let rec loop (tick : i32) (p : pack) (time : bins) (hits : bins) : bins * bins =
            if tick >= 6000 || p.kills >= cleared.size then time, hits
            else
                inl adjacent = views.counted (fun (f : foe) => distance_to f p <= 1 && vitality.health f.life > 0) p.foes
                inl q = advance cleared rules seed tick p
                loop (tick + 1) q (binned adjacent (tick_ms ()) time) (binned adjacent (q.hunter.hits_taken - p.hunter.hits_taken) hits)
        loop 0 (start cleared) empty empty
    let rec each (i : i32) (time : bins) (hits : bins) : bins * bins =
        if i >= (range_of (held_out_block ())).count then time, hits
        else
            inl t, h = histogram ((range_of (held_out_block ())).first + conv i)
            each (i + 1) (plus time t) (plus hits h)
    inl time, hits = each 0 empty empty
    inl t0, t1, t2, t3, h0, h1, h2, h3 = time.zero, time.one, time.two, time.three, hits.zero, hits.one, hits.two, hits.three
    $'printf("clears 100 adjacent ms by count 0 %d 1 %d 2 %d 3 %d; landed hits by count 0 %d 1 %d 2 %d 3 %d\\n", !t0, !t1, !t2, !t3, !h0, !h1, !h2, !h3)' : ()
    0i32
