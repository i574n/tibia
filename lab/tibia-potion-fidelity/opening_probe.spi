inl main () =
    open hunting_pack
    inl three = uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> mirroring_the_live_arena |> waking_at 0
    let rec each (i : i32) (potions : i32) (hits : i32) (taken : i32) (ms : i32) : i32 * i32 * i32 * i32 =
        if i >= (range_of (held_out_block ())).count then potions, hits, taken, ms
        else
            inl elapsed, p = clear_run three (cavebot_with_heal 160) ((range_of (held_out_block ())).first + conv i) 6000
            each (i + 1) (potions + p.hunter.potions) (hits + p.hunter.hits_taken) (taken + quantity.value_of p.hunter.damage_taken) (ms + elapsed)
    inl potions, hits, taken, ms = each 0 0 0 0 0
    $'printf("clears 100 potions %d landed_hits %d damage %d clear_ms %d\\n", !potions, !hits, !taken, !ms)' : ()
    0i32
