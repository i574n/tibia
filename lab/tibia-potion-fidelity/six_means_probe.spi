inl report (label : string) (potions : i32) (hits : i32) (taken : i32) : () =
    $'printf("%s potions %d landed_hits %d damage %d\\n", !label, !potions, !hits, !taken)' : ()

inl main () =
    open hunting_pack
    inl totals (camp : camp) (t : tactic) : i32 * i32 * i32 =
        let rec each (i : i32) (potions : i32) (hits : i32) (taken : i32) : i32 * i32 * i32 =
            if i >= (range_of (held_out_block ())).count then potions, hits, taken
            else
                inl elapsed, p = clear_run camp t ((range_of (held_out_block ())).first + conv i) 6000
                each (i + 1) (potions + p.hunter.potions) (hits + p.hunter.hits_taken) (taken + quantity.value_of p.hunter.damage_taken)
        each 0 0 0 0
    inl three = uniform_camp (open creatures in Cyclops) |> on_layout (open terrain in ArenaSpot) |> mirroring_the_live_arena
    inl two = {three with size = 2}
    inl bare = three |> waking_at 0
    inl reach = tactic_with_order (open policy in ReachFirst) {first = 160; second = 0; third = policy.never_retreat ()}
    inl show (label : string) (camp : camp) (t : tactic) : () =
        inl potions, hits, taken = totals camp t
        report label potions hits taken
    show "three_rules" three (cavebot_with_heal 160)
    show "three_reach" three reach
    show "three_retreat" three (live_retreat_tactic 160 2)
    show "two_rules" two (cavebot_with_heal 160)
    show "two_retreat" two (live_retreat_tactic 160 2)
    show "bare_rules" bare (cavebot_with_heal 160)
    0i32
